<Application
    x:Class="TheGuideToTheNewEden.WPF.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Exit="OnExit"
    ShutdownMode="OnExplicitShutdown"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Controls/GlobalControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Controls/CardControlStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Controls/SettingCardStyles.xaml" />
                <!--  左侧导航的彩色矢量图标（由 design/branding/icons 生成，见 NavIcons.xaml 头注释）  -->
                <ResourceDictionary Source="pack://application:,,,/Resources/NavIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/Languages/zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>