<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Controls.PagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <Button
            x:Name="PrevButton"
            MinWidth="72"
            Content="{DynamicResource Characters.Prev}" />
        <TextBlock
            x:Name="PageText"
            Margin="12,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Button
            x:Name="NextButton"
            MinWidth="72"
            Content="{DynamicResource Characters.Next}" />
    </StackPanel>
</UserControl>
