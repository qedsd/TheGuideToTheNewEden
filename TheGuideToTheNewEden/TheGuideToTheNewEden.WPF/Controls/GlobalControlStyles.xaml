<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全局默认控件样式：这里放"整个应用统一生效"的隐式样式（不带 x:Key，按 TargetType 匹配）。
        本字典在 App.xaml 里必须排在 ui:ControlsDictionary 之后，才能覆盖 WPF-UI 的默认样式。
        
        注意（历次踩坑结论，详见 REFACTORING.md §9）：
        1. 自带 ControlTemplate 的样式会整体替换库的默认样式，模板里的颜色一律显式写主题资源
        （{DynamicResource TextFillColor*Brush} 等），否则深浅色下会退回系统色/原生模板；
        2. 不确定的隐式样式不要 BasedOn（如 {x:Type ListBoxItem}），找不到会在页面构造时抛 XamlParseException；
        3. ContentPresenter 在 HeaderedContentControl 的模板里必须写 ContentSource="Header"。
    -->

    <!--  TabItem：选中态 = 圆角底色 + 主题色下划线 + 半粗字重；悬停 = 更浅底色；右侧 Margin 提供标签间距  -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Bd"
                        Margin="2,2"
                        Padding="14,8"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,0"
                        CornerRadius="6">
                        <!--  ContentSource 必须指向 Header，否则标签文字不显示  -->
                        <!--
                            加粗只作用于 Header（见触发器对 HeaderPresenter 的设置）；
                            FontWeight 是可继承属性，直接设在 TabItem 上会把整个标签内容页都变粗
                        -->
                        <ContentPresenter
                            x:Name="HeaderPresenter"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        表格外观（Fluent 化）——供各页面在 `*GridStyle` 里引用。
        背景：WPF-UI 的 DataGrid 模板用自定义 PassiveScrollViewer 替换了标准模板，横向滚动条不随内容溢出出现，
        因此宽表格继续用**原生模板**（列会自动收缩铺满、滚动条原生可用），外观靠下面这三个样式对齐 Fluent 观感。
    -->
    <Style x:Key="FluentColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="FluentDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <!--  行选中时高亮由行样式负责，单元格保持透明以去掉原生蓝色块  -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FluentDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <!--  行高：默认行很矮（约 18px），抬到与表头一致，内容更高时仍会自动撑开  -->
        <Setter Property="MinHeight" Value="36" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        FlowDocument：RichTextBox 里的文字用它自己的字体，**不继承**控件树的字体，
        WPF 的默认值是 Georgia / 16（实测），与界面其余部分（Microsoft YaHei UI / 14）明显不一致。
        这里显式对齐：字体取系统消息字体（随系统/语言变化），字号取与 WPF-UI 基础字号一致的 14。
    -->
    <Style TargetType="FlowDocument">
        <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--
        列表项铺满整行 + Fluent 选中/悬停观感。
        自带模板、显式给主题色（不 BasedOn 隐式 ListBoxItem 样式：无法确认 WPF-UI 是否为标准类型提供
        可 StaticResource 到的隐式样式，找不到会在页面构造时抛 XamlParseException）。
        关键用途：**局部 ItemContainerStyle 只为设 Stretch 会整体顶掉隐式样式**，选中态退回系统蓝
        （REFACTORING.md §9 第 18 条）——需要 Stretch 的列表一律引用本样式。
    -->
    <Style x:Key="StretchListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bd"
                        Margin="2,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        翻译相关页面共用的"字段标签 / 详情标签"（阶段 46 起先在翻译面板里定义，阶段 47 频道翻译页也要用，
        因此提升为**全局键控样式**——与 StretchListItem 同样的处理：跨页面复用的样式必须放全局，
        StaticResource 找不到会在页面构造时抛 XamlParseException）。
    -->
    <Style x:Key="TranslationFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="TranslationDetailLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,2" />
    </Style>

    <!--
        实体名"链接"按钮（KB 列表、KB 详情页的攻击者/受害者等共用）。
        原先是 `KillListControl` 的局部样式，KB 详情页也要用同类链接，故提升为**全局键控样式**——
        与 StretchListItem / TranslationFieldLabel 同样的处理：跨页面复用的样式必须放全局，
        否则 StaticResource 找不到会在页面构造时抛 XamlParseException。
    -->
    <Style x:Key="KbLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Content}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{TemplateBinding ToolTip}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Slider：全局左右分色（左侧主题色填充、右侧 Fluent 灰轨道），基于 WPF-UI 隐式样式。
        关键机制（MapPage 实测踩坑 + WPF-UI 源码实锤）：WPF-UI 的隐式 Slider 样式用 Orientation Trigger 设置 Template
        （水平滑条永远触发 → 普通 Template Setter 永远被覆盖）；因此本样式同样用 Orientation Trigger 设模板
        （派生样式的 Trigger 优先于基样式的 Trigger）。
        模板复制 WPF-UI 的 UiHorizontalSlider，仅把 DecreaseRepeatButton（Thumb 左侧）换成主题色填充条；
        右侧露出的 TrackBackground（SliderTrackFill）即灰色轨道，Thumb 沿用 WPF-UI 原生——风格与全局 Fluent 完全一致。
        填充色必须用 AccentFillColorDefaultBrush 而非 SystemAccentColorPrimaryBrush（WPF-UI 源码实锤）：
        后者随主题字典加载（= Windows 系统强调色），ApplicationAccentColorManager.Apply 换应用内主题色时不更新该键；
        前者会被实时更新（Dark 主题取 secondaryAccent、Light 取 primaryAccent），是 Fluent 控件的标准强调填充。
    -->
    <Style x:Key="SliderFillAccentStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid
                        Height="4"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="HorizontalSliderFillTemplate" TargetType="Slider">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar
                x:Name="TopTick"
                Grid.Row="0"
                Height="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Placement="Top"
                SnapsToDevicePixels="True"
                Visibility="Collapsed" />
            <Border
                x:Name="TrackBackground"
                Grid.Row="1"
                Height="4"
                Margin="0"
                Background="{DynamicResource SliderTrackFill}"
                BorderThickness="0"
                CornerRadius="2" />
            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillAccentStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource UiSliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource UiSliderButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
            <TickBar
                x:Name="BottomTick"
                Grid.Row="2"
                Height="6"
                Fill="{DynamicResource SliderTickBarFill}"
                Placement="Bottom"
                SnapsToDevicePixels="True"
                Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackFillPointerOver}" />
                <Setter TargetName="Thumb" Property="Foreground" Value="{DynamicResource SliderThumbBackgroundPointerOver}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource HorizontalSliderFillTemplate}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource UiVerticalSlider}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
