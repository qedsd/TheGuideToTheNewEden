<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Controls.SpinnerIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    IsHitTestVisible="False">

    <!--
        行内加载指示：自绘旋转图标（不用 ProgressBar/ProgressRing——WPF-UI 隐式样式下有栈溢出史，见 REFACTORING §9 第 17 条）。
        FontSize / Foreground 由使用方设置：它们是继承属性，会直接作用到里面的 SymbolIcon。
    -->
    <ui:SymbolIcon
        x:Name="Icon"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        RenderTransformOrigin="0.5,0.5"
        Symbol="ArrowSync24">
        <ui:SymbolIcon.RenderTransform>
            <RotateTransform x:Name="SpinRotate" />
        </ui:SymbolIcon.RenderTransform>
    </ui:SymbolIcon>
</UserControl>
