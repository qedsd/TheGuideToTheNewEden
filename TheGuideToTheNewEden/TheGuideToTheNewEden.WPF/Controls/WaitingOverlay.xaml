<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Controls.WaitingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    Visibility="Collapsed">

    <!--  半透明遮罩：铺满内容区并拦截点击（对应 WinUI 版 ShowWaiting 的全屏等待态）  -->
    <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}">
        <Border
            Width="360"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <!--  自绘旋转图标作加载指示：不用 ProgressBar/ProgressRing（WPF-UI 隐式样式下有栈溢出史，见 REFACTORING §9）  -->
                <ui:SymbolIcon
                    x:Name="SpinIcon"
                    HorizontalAlignment="Center"
                    FontSize="34"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    RenderTransformOrigin="0.5,0.5"
                    Symbol="ArrowSync24">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform x:Name="SpinRotate" />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>

                <TextBlock
                    x:Name="MessageText"
                    Margin="0,16,0,0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <ui:Button
                    x:Name="CancelButton"
                    MinWidth="96"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Click="OnCancelClick"
                    Content="{DynamicResource General_Cancel}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
