    <sys:String x:Key="AiSettingPage_Protocol">Protocol</sys:String>
    <sys:String x:Key="AiSettingPage_Protocol_Desc">Pick the provider protocol. Most Chinese providers use "OpenAI compatible"; for Bedrock/Vertex put a gateway in front and speak OpenAI.</sys:String>
