    <sys:String x:Key="AiSettingPage_Generation">Generation and caching</sys:String>
    <sys:String x:Key="AiSettingPage_Temperature">Temperature</sys:String>
    <sys:String x:Key="AiSettingPage_Temperature_Desc">0–0.3 is recommended for translation; 0 means the parameter is not sent (some reasoning models reject it).</sys:String>
    <sys:String x:Key="AiSettingPage_MaxTokens">Max output tokens</sys:String>
    <sys:String x:Key="AiSettingPage_MaxTokens_Desc">0 means the parameter is not sent and the server default applies (recommended for reasoning models).</sys:String>
    <sys:String x:Key="AiSettingPage_Timeout">Timeout (s)</sys:String>
