    <!--  阶段 118：ESI 通用网关（esi_search / esi_describe / esi_read / esi_write）  -->
    <sys:String x:Key="AssistantTool_esi_search">ESI 检索</sys:String>
    <sys:String x:Key="AssistantTool_esi_describe">ESI 参数说明</sys:String>
    <sys:String x:Key="AssistantTool_esi_read">ESI 只读调用</sys:String>
    <sys:String x:Key="AssistantTool_esi_write">ESI 写操作</sys:String>
    <sys:String x:Key="AssistantSettingPage_Esi">ESI 全量访问</sys:String>
    <sys:String x:Key="AssistantSettingPage_Esi_Desc">把 ESI 的全部 197 个操作开放给助手：只读端点直接执行，写端点每次都要你确认；专用工具优先，网关覆盖其余长尾能力。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiEnabled">启用 ESI 通用网关</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiEnabled_Desc">关闭后 4 个 esi_* 工具直接拒绝调用（专用工具不受影响）。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiWrites">允许 ESI 写操作</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiWrites_Desc">关闭后只允许只读端点。开启也不等于免确认：每次写操作仍会弹出确认卡片。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiEnrich">把 ID 补成名称</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiEnrich_Desc">ESI 返回里大量是裸 ID（钱包对手方、联系人、声望来源、资产类型与地点…）。开启后会自动补成「名称 (id)」，答案才读得懂；关闭则原样返回 ID（省下本地库查询）。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiMaxPages">一次最多取几页</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiMaxPages_Desc">助手在 allPages=true 时最多连续取几页（默认 10）。资产、蓝图这类多页数据靠它取全；整星域订单那种几百页的量级仍请用市场／倒货页。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiMaxResultChars">单条结果字符上限</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiMaxResultChars_Desc">单次工具结果回填给模型的字符上限（默认 3500，调大更费 token）。超长内容会自动截断并在结果里注明。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiErrorLimitFloor">错误配额阈值</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiErrorLimitFloor_Desc">ESI 会因短时间内错误过多而临时封禁。剩余错误配额低于该值时助手停止调用（默认 10，0 = 不检查）。</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiDeniedPaths">禁止调用的路径</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiDeniedPaths_Tip">每行一条，支持 * 通配；例如 /characters/*/mail</sys:String>
    <sys:String x:Key="AssistantSettingPage_EsiDeniedPaths_Desc">命中的端点永远不会被调用（用户确认也绕不过）。留空 = 不禁止任何端点。建议按需加入敏感写操作，例如 /characters/*/mail、/fleets/。</sys:String>

