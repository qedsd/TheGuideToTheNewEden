        <GradientStop Offset="0" Color="#172DD4BF" />
        <GradientStop Offset="1" Color="#002DD4BF" />
    </RadialGradientBrush>

    <!-- ============ 品牌符号（两处共用：迷你 Logo + 右侧大环）============ -->
    <!--  品牌符号（星门环 + 罗盘星）  -->
    <LinearGradientBrush x:Key="Banner.Symbol" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF14B8A6" />
        <GradientStop Offset="0.5" Color="#FF0EA5E9" />
        <GradientStop Offset="1" Color="#FF6366F1" />
    </LinearGradientBrush>

