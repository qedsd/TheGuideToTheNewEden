        <GradientStop Offset="0" Color="#2638BDF8" />
        <GradientStop Offset="0.6" Color="#0E38BDF8" />
        <GradientStop Offset="1" Color="#0038BDF8" />
    </RadialGradientBrush>

    <!--  星云 2（右上）  -->
