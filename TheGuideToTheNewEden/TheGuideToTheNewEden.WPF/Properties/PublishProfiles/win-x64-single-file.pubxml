<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布配置（Windows x64）：
  · SelfContained=true            —— 自带 .NET 8 运行时，目标机无需安装 .NET；
  · PublishSingleFile=true        —— 所有托管程序集打进一个 exe；
  · IncludeNativeLibrariesForSelfExtract=true
                                  —— SkiaSharp / WPF 的原生 DLL 也进 exe，运行时自动解压；
  · IncludeAllContentForSelfExtract=true
                                  —— Resources（Configs / Database / Manuals 等）与 log4net.config
                                     也进 exe；**这是"目录里只剩一个 exe"的关键**。
  · PublishTrimmed=false          —— WPF 不支持裁剪，开启会导致反射/资源找不到；
  · PublishReadyToRun=false       —— 单文件 + R2R 收益有限，优先稳定与体积可控；
  · EnableCompressionInSingleFile=true
                                  —— 实测 369MB → 134MB（数据库/运行时压缩率高），首次启动约 2.5s；
                                     代价是首次启动要把内容解压到临时目录（体积约 359MB）。

  重要：IncludeAllContentForSelfExtract=true 时，程序启动会把内容解压到
  %TEMP%\.net\TheGuideToTheNewEden\<hash>\，AppContext.BaseDirectory 指向该解压目录；
  业务代码里按 BaseDirectory 找 Resources 的逻辑无需改动。首次启动会慢一些，
  之后同一 exe 复用同一份解压缓存（临时目录被系统清理后会重新解压）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- VS「发布」窗口识别为文件夹发布；纯 dotnet CLI 发布时该属性无副作用。 -->
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 项目引用的 Core / ZKB.NET 仍会产出 .pdb；关掉后发布目录里只留一个 exe。 -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-single\</PublishDir>
  </PropertyGroup>

  <!--
    项目引用的 Core / ZKB.NET 会把自己的 .pdb 也放进发布列表。
    CopyOutputSymbolsToPublishDirectory 只压得住当前项目的符号，所以在发布链上再兜底删一次，
    保证发布目录里真的只剩一个 exe（挂点同 csproj 的 log4net 去重：ComputeResolvedFilesToPublishList 之后、
    冲突检查之前）。
  -->
  <Target Name="RemovePdbsFromSingleFilePublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
