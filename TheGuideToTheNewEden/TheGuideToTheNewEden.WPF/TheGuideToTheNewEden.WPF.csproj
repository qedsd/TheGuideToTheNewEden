<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!--  平台版本必须显式写 10.0.19041：LiveCharts 传递依赖的 SkiaSharp.Views.WPF 3.119.0
		      只提供 net462 / net8.0-windows10.0.19041 资产，写成 net10.0-windows（隐含 TPV=7.0）
		      会回退到 .NET Framework 资产（NU1701）或直接报 NU1202。  -->
		<!--  目标框架定在 net8（LTS）而不是 net10：实测在未更新的 Windows 10 21H1（19043.985）上，
		      .NET 9/10 的 WPF 一启动就崩（0x80131506，KERNELBASE 里的运行时 fail-fast），
		      而同一台机器上 .NET Framework / .NET 6 / .NET 8 的 WPF 都正常，控制台程序也正常。
		      即 .NET 9 起的 WPF 与该系统补丁级别不兼容，用 net8 可覆盖这些老系统。  -->
		<TargetFramework>net8.0-windows10.0.19041</TargetFramework>
		<RootNamespace>TheGuideToTheNewEden</RootNamespace>
		<AssemblyName>TheGuideToTheNewEden</AssemblyName>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AssemblyVersion>4.0.0.0</AssemblyVersion>
		<Version>4.0.0</Version>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WPF-UI" Version="4.3.0" />
		<!--  托盘与系统通知：与 WinUI 版一致使用 H.NotifyIcon（WinUI 版为 H.NotifyIcon.WinUI）
		      2.4.1 只带 net10.0-windows / net462 资产，net8 下会回退到 .NET Framework 资产（NU1701）；
		      2.3.0 是最后一个带 net8.0-windows 资产的版本，故锁在这个版本。  -->
		<PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<!--  邮件正文 HTML 渲染（替代 WebView2）  -->
		<PackageReference Include="HtmlRenderer.WPF" Version="1.6.1" />
		<!--  市场历史图表（替代 Syncfusion 图表）；SkiaSharp/HarfBuzz 由它传递  -->
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheGuideToTheNewEden.Core\TheGuideToTheNewEden.Core.csproj" />
		<!--  角色工作区左栏的 ZKB 概览卡（与 WinUI 版同源，netstandard2.1，可直接引用）  -->
		<ProjectReference Include="..\ZKB.NET\ZKB.NET.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
		<Resource Include="Assets\logo_32.png" />
		<Resource Include="Assets\logo_128.png" />
	</ItemGroup>

	<!--
	  运行时数据资源（配置与数据库）体积约 100MB，直接复制会在仓库中重复一份。
	  这里以“链接”方式引用 WinUI 项目的资源文件：构建时仍各自拷贝到输出目录，
	  运行时互不影响，仓库不重复存储。
	-->
	<ItemGroup>
		<Content Include="..\TheGuideToTheNewEden.WinUI\TheGuideToTheNewEden.WinUI\Resources\Configs\**\*.*" Exclude="..\TheGuideToTheNewEden.WinUI\TheGuideToTheNewEden.WinUI\Resources\Configs\log4net.config">
			<Link>Resources\Configs\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- Core.Log.Init() 从程序根目录读取 log4net.config，需单独放到输出根。 -->
		<Content Include="..\TheGuideToTheNewEden.WinUI\TheGuideToTheNewEden.WinUI\Resources\Configs\log4net.config">
			<Link>log4net.config</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\TheGuideToTheNewEden.WinUI\TheGuideToTheNewEden.WinUI\Resources\Database\**\*.*">
			<Link>Resources\Database\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\TheGuideToTheNewEden.WinUI\TheGuideToTheNewEden.WinUI\Resources\default.mp3">
			<Link>Resources\default.mp3</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
	  发布（dotnet publish）时 NETSDK1152：Core 项目自带的 log4net.config 会随项目引用被
	  “传递复制”到发布根目录，与上面显式链接的 WinUI Resources\Configs\log4net.config 相对路径相同
	  （两者都落到发布根 log4net.config），发布因此直接失败；而 dotnet build 不校验重复输出，
	  两份同样落到输出根、只按复制顺序留下一份，所以该冲突只在发布路径上暴露。

	  Core.Log.Init() 从程序根目录读 log4net.config，本项目的基准是「WinUI Resources\Configs 版」
	  （<file value="Log\" />，与文档中 Log\yyyyMMdd.txt 的路径一致），Core 版写的是
	  %LocalAppData%\...\Logs\，不应作为本项目的配置。因此这里把来自 Core 目录的那一份从传参列表里摘掉
	  （上面显式链接的那份不受影响），让 build 与 publish 都只留一份、且是同一份。
	-->
	<PropertyGroup>
		<!-- 锚定 Core 那份的完整路径（必须归一化掉 "..\"，项元数据 FullPath 是规范化的绝对路径）。 -->
		<_CoreProjectLog4NetConfigFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\TheGuideToTheNewEden.Core\log4net.config'))</_CoreProjectLog4NetConfigFullPath>
	</PropertyGroup>

	<!-- 列表合并进 AllItemsFullPathWithTargetPath 之前先摘掉，保证 bin 输出也只有一份。 -->
	<Target Name="ExcludeCoreLog4NetConfigFromOutput"
	        BeforeTargets="GetCopyToOutputDirectoryItems">
		<ItemGroup>
			<ContentWithTargetPath Remove="@(ContentWithTargetPath)"
			                       Condition="'%(ContentWithTargetPath.FullPath)' == '$(_CoreProjectLog4NetConfigFullPath)'" />
			<_AllChildProjectItemsWithTargetPath Remove="@(_AllChildProjectItemsWithTargetPath)"
			                                     Condition="'%(FullPath)' == '$(_CoreProjectLog4NetConfigFullPath)'" />
			<AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)"
			                                Condition="'%(FullPath)' == '$(_CoreProjectLog4NetConfigFullPath)'" />
		</ItemGroup>
	</Target>

	<!-- 发布：ComputeResolvedFilesToPublishList 已把两份都放进 ResolvedFileToPublish，在其后、冲突检查之前移除。 -->
	<Target Name="ExcludeCoreLog4NetConfigFromPublish"
	        AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
			                       Condition="'%(ResolvedFileToPublish.FullPath)' == '$(_CoreProjectLog4NetConfigFullPath)'" />
		</ItemGroup>
	</Target>

</Project>