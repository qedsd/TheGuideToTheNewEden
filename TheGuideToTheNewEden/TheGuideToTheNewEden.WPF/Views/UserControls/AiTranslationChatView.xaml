<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.AiTranslationChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            气泡里的文字用**只读富文本**（RichTextPresenter = RichTextBox）：
            每条原文/译文都能像网页一样任意拖选其中一段复制。
        -->
        <Style x:Key="ChatRichText" TargetType="{x:Type controls:RichTextPresenter}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ChatRichTextSecondary" TargetType="{x:Type controls:RichTextPresenter}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  会话列表项：铺满 + 悬停/选中观感（与全站列表一致）  -->
        <Style
            x:Key="ChatSessionItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  ============ 已配置：左对话列表 + 右对话记录 ============  -->
        <Grid Margin="12" Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：对话列表 ============  -->
            <controls:CardControl
                Grid.Column="0"
                Margin="0,0,6,0"
                Header="{DynamicResource AiTranslation_Chat_Sessions}">
                <Grid>
                    <ListBox
                        x:Name="SessionList"
                        HorizontalContentAlignment="Stretch"
                        ItemContainerStyle="{StaticResource ChatSessionItem}"
                        ItemsSource="{Binding Sessions}"
                        PreviewMouseRightButtonDown="OnSessionPreviewMouseRightButtonDown"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="OnRenameSessionClick" Header="{DynamicResource AiTranslation_Chat_Rename}" />
                                <MenuItem Click="OnDeleteSessionClick" Header="{DynamicResource AiTranslation_Chat_Delete}" />
                                <MenuItem Click="OnClearSessionClick" Header="{DynamicResource AiTranslation_Chat_Clear}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Preview}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding UpdatedText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource AiTranslation_Chat_NoSessions}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>

                <controls:CardControl.Footer>
                    <ui:Button
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Click="OnNewSessionClick"
                        Content="{DynamicResource AiTranslation_Chat_New}"
                        Icon="{ui:SymbolIcon Add24}" />
                </controls:CardControl.Footer>
            </controls:CardControl>

            <!--  ============ 右：对话记录 ============  -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:CardControl Grid.Row="0">
                    <controls:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  标题：双击（或点铅笔按钮）就地改名；改名时换成输入框  -->
                            <Grid Grid.Column="0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    MouseLeftButtonDown="OnTitleMouseLeftButtonDown"
                                    Text="{Binding SessionTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{DynamicResource AiTranslation_Chat_Rename_Tip}"
                                    Visibility="{Binding SelectedSession.IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBox
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    KeyDown="OnTitleKeyDown"
                                    LostFocus="OnTitleLostFocus"
                                    Text="{Binding SelectedSession.TitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding SelectedSession.IsRenaming, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                AutomationProperties.Name="{DynamicResource AiTranslation_Chat_Rename}"
                                Click="OnRenameClick"
                                Icon="{ui:SymbolIcon Edit24}"
                                ToolTip="{DynamicResource AiTranslation_Chat_Rename}"
                                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}" />

                            <TextBlock
                                Grid.Column="2"
                                MaxWidth="320"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding PendingText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </controls:CardControl.Header>

                    <Grid>
                        <ScrollViewer
                            x:Name="TranscriptScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <!--  不用 ListBox：列表项的选中语义会跟"在气泡里拖选文字"打架  -->
                            <ItemsControl x:Name="Transcript" ItemsSource="{Binding SelectedSession.Turns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <!--  原文气泡：**靠右**；超过三行时只显示前三行 + 「展开」  -->
                                            <Border
                                                MaxWidth="560"
                                                Padding="10,8"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource ChatLabel}" Text="{DynamicResource AiTranslation_Chat_Original}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ChatLabel}"
                                                            Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                    <controls:RichTextPresenter
                                                        Margin="0,4,0,0"
                                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                        Text="{Binding OriginalDisplay, Mode=OneWay}">
                                                        <controls:RichTextPresenter.Style>
                                                            <Style BasedOn="{StaticResource ChatRichText}" TargetType="{x:Type controls:RichTextPresenter}">
                                                                <!--  折叠：三行高度（约 3 × 19px）；展开：不限高  -->
                                                                <Setter Property="MaxHeight" Value="58" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOriginalExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="100000" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:RichTextPresenter.Style>
                                                    </controls:RichTextPresenter>
                                                    <ui:Button
                                                        Margin="0,4,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        Appearance="Transparent"
                                                        Click="OnToggleOriginalClick"
                                                        Content="{Binding ExpandLabel}"
                                                        FontSize="12"
                                                        Visibility="{Binding CanExpandOriginal, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  译文气泡：**靠左**；生成中在译文位置显示行内转圈  -->
                                            <Border
                                                Margin="0,6,0,0"
                                                Padding="10,8"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource ChatLabel}" Text="{DynamicResource AiTranslation_Chat_Translation}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ChatLabel}"
                                                            Text="{Binding TimeText}" />
                                                        <controls:SpinnerIcon
                                                            Width="14"
                                                            Height="14"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                            IsActive="{Binding ShowPendingBadge}" />
                                                    </StackPanel>

                                                    <controls:RichTextPresenter
                                                        Margin="0,4,0,0"
                                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                        Text="{Binding TranslationDisplay, Mode=OneWay}"
                                                        Visibility="{Binding ShowTranslationBubble, Converter={StaticResource BoolToVis}}">
                                                        <controls:RichTextPresenter.Style>
                                                            <Style BasedOn="{StaticResource ChatRichText}" TargetType="{x:Type controls:RichTextPresenter}">
                                                                <!--  收起：五行高度（约 5 × 19px）；展开：不限高  -->
                                                                <Setter Property="MaxHeight" Value="96" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTranslationExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="100000" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:RichTextPresenter.Style>
                                                    </controls:RichTextPresenter>

                                                    <!--  译文超过五行时的「展开 / 收起」（与原文气泡同一套做法）  -->
                                                    <ui:Button
                                                        Margin="0,4,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        Appearance="Transparent"
                                                        Click="OnToggleTranslationClick"
                                                        Content="{Binding TranslationExpandLabel}"
                                                        FontSize="12"
                                                        Visibility="{Binding CanExpandTranslation, Converter={StaticResource BoolToVis}}" />

                                                    <!--  还没有任何增量时，在译文位置显示"正在翻译…"  -->
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{DynamicResource AiTranslation_Chat_Generating}"
                                                        Visibility="{Binding ShowPendingHint, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                        Text="{Binding Error}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}" />

                                                    <!--
                                                        底部一行：左边是模型/耗时/token（以及本次命中的术语），
                                                        最右侧只放一个"复制译文"的图标按钮——与 token 信息同一水平线。
                                                    -->
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Meta}"
                                                                Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding HasGlossary, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{DynamicResource TranslationPage_GlossaryHits}" />
                                                                <controls:RichTextPresenter
                                                                    Style="{StaticResource ChatRichTextSecondary}"
                                                                    Text="{Binding GlossaryText, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <ui:Button
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Appearance="Transparent"
                                                            AutomationProperties.Name="{DynamicResource TranslationPage_CopyTranslation}"
                                                            Click="OnCopyTranslationClick"
                                                            Icon="{ui:SymbolIcon Copy24}"
                                                            ToolTip="{DynamicResource TranslationPage_CopyTranslation}"
                                                            Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource AiTranslation_Chat_EmptyTip}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ShowSessionEmptyTip, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <controls:CardControl.Footer>
                        <Grid>
                            <!--  **一个对话只有一个上下文开关**：勾上后本对话每次翻译都带上下文（不限条数）  -->
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{DynamicResource AiTranslation_Chat_UseContext}"
                                IsChecked="{Binding SelectedSession.UseContext, Mode=TwoWay}"
                                IsEnabled="{Binding HasSession}"
                                ToolTip="{DynamicResource AiTranslation_Chat_UseContext_Tip}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ContextInfoText}" />
                        </Grid>
                    </controls:CardControl.Footer>
                </controls:CardControl>

                <!--  ============ 输入 ============  -->
                <controls:CardControl
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Header="{DynamicResource AiTranslation_Chat_Input}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  源语言（可"自动"）  -->
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ChatLabel}"
                                    Text="{DynamicResource TranslationPage_SourceLanguage}" />
                                <ComboBox
                                    Width="120"
                                    Margin="6,0,0,0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding SourceLanguageOptions}"
                                    SelectedValue="{Binding SourceLanguage, Mode=TwoWay}"
                                    SelectedValuePath="Code" />
                            </StackPanel>

                            <!--  对调源/目标语言  -->
                            <ui:Button
                                Grid.Column="1"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                AutomationProperties.Name="{DynamicResource TranslationPage_SwapLanguages}"
                                Click="OnSwapLanguagesClick"
                                Icon="{ui:SymbolIcon ArrowSwap24}"
                                ToolTip="{DynamicResource TranslationPage_SwapLanguages}" />

                            <!--  目标语言  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ChatLabel}"
                                    Text="{DynamicResource TranslationPage_TargetLanguage}" />
                                <ComboBox
                                    Width="140"
                                    Margin="6,0,0,0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding TargetLanguageOptions}"
                                    SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                                    SelectedValuePath="Code" />
                            </StackPanel>

                            <!--  目标选「自动检测」（目标位置上的 auto，语义是"译成另一种语言"）时才需要：这一对语言之间自动互译  -->
                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsAutoTarget, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ChatLabel}"
                                    Text="{DynamicResource TranslationPage_Pair}"
                                    ToolTip="{DynamicResource TranslationPage_Pair_Tip}" />
                                <ComboBox
                                    Width="110"
                                    Margin="6,0,0,0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding PairOptions}"
                                    SelectedValue="{Binding PairA, Mode=TwoWay}"
                                    SelectedValuePath="Code"
                                    ToolTip="{DynamicResource TranslationPage_Pair_Tip}" />
                                <ui:Button
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Appearance="Transparent"
                                    AutomationProperties.Name="{DynamicResource TranslationPage_SwapPair}"
                                    Click="OnSwapPairClick"
                                    Icon="{ui:SymbolIcon ArrowSwap24}"
                                    ToolTip="{DynamicResource TranslationPage_SwapPair}" />
                                <ComboBox
                                    Width="110"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding PairOptions}"
                                    SelectedValue="{Binding PairB, Mode=TwoWay}"
                                    SelectedValuePath="Code"
                                    ToolTip="{DynamicResource TranslationPage_Pair_Tip}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="4"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding EndpointSummary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding EndpointSummary}" />
                        </Grid>

                        <ui:TextBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            MinHeight="70"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            PlaceholderText="{DynamicResource TranslationPage_Ai_Input_Tip}"
                            PreviewKeyDown="OnInputPreviewKeyDown"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <controls:CardControl.Footer>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource TranslationPage_AiManualHint}"
                                ToolTip="{DynamicResource TranslationPage_AiManualHint_Tip}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Margin="4,0"
                                    Appearance="Primary"
                                    Click="OnTranslateClick"
                                    Content="{DynamicResource TranslationPage_Translate}"
                                    Icon="{ui:SymbolIcon Send24}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnStopClick"
                                    Content="{DynamicResource TranslationPage_Ai_Stop}"
                                    Icon="{ui:SymbolIcon Stop24}"
                                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnClearInputClick"
                                    Content="{DynamicResource TranslationPage_Clear}"
                                    Icon="{ui:SymbolIcon Eraser24}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnPopWindowClick"
                                    Content="{DynamicResource TranslationPage_PopWindow}"
                                    Icon="{ui:SymbolIcon WindowNew24}"
                                    Visibility="{Binding CanPopWindow, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </controls:CardControl.Footer>
                </controls:CardControl>
            </Grid>
        </Grid>

        <!--  ============ 未配置：整页引导（先配置再使用） ============  -->
        <Border
            Margin="12"
            Padding="24"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="6"
            Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVis}}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Settings24" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource TranslationPage_Ai_NotConfigured_Title}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding NotConfiguredText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{DynamicResource TranslationPage_Ai_NotConfigured_Support}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="4,0"
                        Appearance="Primary"
                        Click="OnConfigureClick"
                        Content="{DynamicResource TranslationPage_Ai_GoConfigure}"
                        Icon="{ui:SymbolIcon Settings24}" />
                    <ui:Button
                        Margin="4,0"
                        Click="OnRecheckClick"
                        Content="{DynamicResource TranslationPage_Ai_Recheck}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
