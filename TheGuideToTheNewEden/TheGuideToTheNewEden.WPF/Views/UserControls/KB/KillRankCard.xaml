<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.KB.KillRankCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    Width="172"
    Background="Transparent">

    <UserControl.Resources>
        <converters:UrlToImageConverter x:Key="UrlImage" />
    </UserControl.Resources>

    <!--  排名卡片：最贵击杀 / 最高击杀 / 超期击杀 共用  -->
    <Border
        Padding="8"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Cursor="Hand"
        MouseLeftButtonUp="OnClicked"
        ToolTip="{Binding Item.Name, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  排名 + 图片 + 名称  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Width="20"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Item.No, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <Image
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Source="{Binding Item.ImageUrl, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource UrlImage}}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Item.Name, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Item.SubTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!--  击杀数  -->
            <StackPanel
                x:Name="KillsRow"
                Grid.Row="1"
                Margin="0,6,0,0"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource StatistTopAllTimePage_Kills}" />
                <TextBlock
                    Margin="4,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Item.Kills, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <!--  估价（仅"最贵击杀"有值）  -->
            <TextBlock
                x:Name="ValueRow"
                Grid.Row="2"
                Margin="0,4,0,0"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                Text="{Binding Item.ValueText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
