<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.KB.KillStreamSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kb="clr-namespace:TheGuideToTheNewEden.WPF.Models.KB"
    xmlns:kbControls="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.KB"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  由 KillStreamPage 的设置按钮以 ToolWindow 弹窗承载；DataContext = 宿主页的 KillStreamViewModel（同一份 Config）  -->
    <TabControl VerticalContentAlignment="Stretch">
        <!--  通用设置  -->
        <TabItem Header="{DynamicResource SettingPage_General}">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ZKBSettingPage_AutoConnect}" />
                <ui:ToggleSwitch
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Config.AutoConnect, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Text="{DynamicResource ZKBSettingPage_Notify}" />
                <ui:ToggleSwitch
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Config.Notify, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Text="{DynamicResource ZKBSettingPage_MinNotifyValue}" />
                <ui:NumberBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="200"
                    HorizontalAlignment="Left"
                    Minimum="0"
                    SmallChange="1000000"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding Config.MinNotifyValue, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Text="{DynamicResource ZKBSettingPage_MaxKBItems}" />
                <ui:NumberBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Width="200"
                    HorizontalAlignment="Left"
                    Minimum="1"
                    SmallChange="10"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding Config.MaxKBItems, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Text="{DynamicResource ZKBSettingPage_SortWay}" />
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="200"
                    HorizontalAlignment="Left"
                    SelectedIndex="{Binding Config.SortWay, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource ZKBSettingPage_SortWay_UploadTime}" />
                    <ComboBoxItem Content="{DynamicResource ZKBSettingPage_SortWay_CreateTime}" />
                </ComboBox>
            </Grid>
        </TabItem>

        <!--  过滤设置  -->
        <TabItem Header="{DynamicResource ZKBHomePage_Setting_Filter}">
            <TabControl Margin="12,8,12,8" VerticalContentAlignment="Stretch">
                <TabItem Header="{DynamicResource ZKBHomePage_Setting_Filter_Location}">
                    <kbControls:KbFilterPairControl
                        Margin="0,6,0,0"
                        Categories="{x:Static kb:KbCategories.Location}"
                        Items="{Binding Config.Locations}"
                        Mode="{Binding Config.LocationMode, Mode=TwoWay}"
                        PlaceholderText="{DynamicResource ZKBHomePage_Setting_Filter_SearchLocation}" />
                </TabItem>
                <TabItem Header="{DynamicResource ZKBHomePage_Setting_Filter_Ship}">
                    <kbControls:KbShipFilterControl
                        Margin="0,6,0,0"
                        Mode="{Binding Config.ShipMode, Mode=TwoWay}"
                        SelectedTypes="{Binding Config.Ships}" />
                </TabItem>
                <TabItem Header="{DynamicResource ZKBHomePage_Setting_Filter_Victim}">
                    <kbControls:KbFilterPairControl
                        Margin="0,6,0,0"
                        Categories="{x:Static kb:KbCategories.Role}"
                        Items="{Binding Config.Victims}"
                        Mode="{Binding Config.VictimMode, Mode=TwoWay}"
                        PlaceholderText="{DynamicResource ZKBHomePage_Setting_Filter_SearchRole}" />
                </TabItem>
                <TabItem Header="{DynamicResource ZKBHomePage_Setting_Filter_Attacker}">
                    <kbControls:KbFilterPairControl
                        Margin="0,6,0,0"
                        Categories="{x:Static kb:KbCategories.Role}"
                        Items="{Binding Config.Attackers}"
                        Mode="{Binding Config.AttackerMode, Mode=TwoWay}"
                        PlaceholderText="{DynamicResource ZKBHomePage_Setting_Filter_SearchRole}" />
                </TabItem>
            </TabControl>
        </TabItem>
    </TabControl>
</UserControl>
