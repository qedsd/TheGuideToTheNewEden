<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.KB.KillListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <UserControl.Resources>
        <converters:TypeImageConverter x:Key="TypeImg" Size="32" />
        <converters:IskConverter x:Key="Isk" />
        <converters:DateTimeToLocalConverter x:Key="LocalTime" />
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />

        <!--  实体名"链接"按钮  -->
        <Style x:Key="KbLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock
                            Text="{TemplateBinding Content}"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{TemplateBinding Foreground}"
                            ToolTip="{TemplateBinding ToolTip}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  单元格文本  -->
        <Style x:Key="KbCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="KbCellSecondary"
            BasedOn="{StaticResource KbCell}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style
            x:Key="KbGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style
            x:Key="KbRowStyle"
            BasedOn="{StaticResource FluentDataGridRowStyle}"
            TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
        </Style>
    </UserControl.Resources>

    <!--  外层 ScrollViewer 提供整表滚动（阶段 22 的方案：列固定宽 + MinWidth 绑视口宽）  -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ui:DataGrid
            x:Name="Grid"
            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
            ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RowStyle="{StaticResource KbRowStyle}"
            Style="{StaticResource KbGridStyle}">
            <ui:DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="OnOpenBrowserClick" Header="{DynamicResource KBListControl_OpenBrowser}" />
                </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
                <!--  时间（时间 + 日期两行）  -->
                <DataGridTemplateColumn Width="92" Header="{DynamicResource KBListControl_Time}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource KbCell}"
                                    Text="{Binding SKBDetail.KillmailTime, Converter={StaticResource LocalTime}, ConverterParameter=HH:mm:ss}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource KbCellSecondary}"
                                    Text="{Binding SKBDetail.KillmailTime, Converter={StaticResource LocalTime}, ConverterParameter=yyyy-MM-dd}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  估价  -->
                <DataGridTemplateColumn Width="86" Header="{DynamicResource KBListControl_TotalValue}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Style="{StaticResource KbCell}"
                                Text="{Binding SKBDetail.Zkb.TotalValue, Converter={StaticResource Isk}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  飞船 / 建筑  -->
                <DataGridTemplateColumn Width="176" Header="{DynamicResource KBListControl_Type}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Source="{Binding SKBDetail.Victim.ShipTypeId, Converter={StaticResource TypeImg}}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding Type.TypeName}"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="ship" />
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding Group.GroupName}"
                                        FontSize="12"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="group" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  位置（星系 + 安全等级 / 星域）  -->
                <DataGridTemplateColumn Width="176" Header="{DynamicResource KBListControl_Location}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding SolarSystem.SolarSystemName}"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="system" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SolarSystem.Security, StringFormat={}{0:0.0}}" />
                                </StackPanel>
                                <Button
                                    Click="OnEntityClick"
                                    Content="{Binding Region.RegionName}"
                                    FontSize="12"
                                    Style="{StaticResource KbLinkButton}"
                                    Tag="region" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  受害者  -->
                <DataGridTemplateColumn Width="176" Header="{DynamicResource KBListControl_Victim}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <Button
                                    Click="OnEntityClick"
                                    Content="{Binding Victim.Name}"
                                    Style="{StaticResource KbLinkButton}"
                                    Tag="victim" />
                                <TextBlock Style="{StaticResource KbCellSecondary}" Text="{Binding Victim, Converter={StaticResource CategoryEnum}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  最后一击  -->
                <DataGridTemplateColumn Width="176" Header="{DynamicResource KBListControl_FinalBlow}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <Button
                                    Click="OnEntityClick"
                                    Content="{Binding FinalBlow.Name}"
                                    Style="{StaticResource KbLinkButton}"
                                    Tag="finalblow" />
                                <TextBlock Style="{StaticResource KbCellSecondary}" Text="{Binding FinalBlow, Converter={StaticResource CategoryEnum}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </ScrollViewer>
</UserControl>
