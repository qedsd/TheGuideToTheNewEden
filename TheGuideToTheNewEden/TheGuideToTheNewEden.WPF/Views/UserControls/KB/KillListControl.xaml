<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.KB.KillListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ctl="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    FontSize="12">

    <UserControl.Resources>
        <converters:TypeImageConverter x:Key="TypeImg" Size="32" />
        <converters:IskConverter x:Key="Isk" />
        <converters:DateTimeToLocalConverter x:Key="LocalTime" />
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />

        <!--  实体名"链接"按钮 KbLinkButton 已提升为全局样式（Controls/GlobalControlStyles.xaml），
              KB 详情页的攻击者 / 受害者链接共用同一份定义  -->

        <!--  单元格文本  -->
        <Style x:Key="KbCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="KbCellSecondary"
            BasedOn="{StaticResource KbCell}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style
            x:Key="KbGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style
            x:Key="KbRowStyle"
            BasedOn="{StaticResource FluentDataGridRowStyle}"
            TargetType="DataGridRow">
            <!--  单击行打开 KB 详情（与 WinUI 的 IsItemClickEnabled 行为一致）；行内 KbLinkButton 是 ButtonBase，会自行处理 MouseLeftButtonUp，不会误触发行事件  -->
            <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
        </Style>
    </UserControl.Resources>

    <!--  外层 ScrollViewer 提供整表滚动（阶段 22 的方案：列固定宽 + MinWidth 绑视口宽）  -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ui:DataGrid
            x:Name="Grid"
            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
            ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
            RowStyle="{StaticResource KbRowStyle}"
            Style="{StaticResource KbGridStyle}">
            <ui:DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="OnOpenBrowserClick" Header="{DynamicResource KBListControl_OpenBrowser}" />
                </ContextMenu>
            </ui:DataGrid.ContextMenu>
            <ui:DataGrid.Columns>
                <!--  时间（时间 + 日期两行）  -->
                <DataGridTemplateColumn Width="92" Header="{DynamicResource KBListControl_Time}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource KbCell}"
                                    Text="{Binding SKBDetail.KillmailTime, Converter={StaticResource LocalTime}, ConverterParameter=HH:mm:ss}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource KbCellSecondary}"
                                    Text="{Binding SKBDetail.KillmailTime, Converter={StaticResource LocalTime}, ConverterParameter=yyyy-MM-dd}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  估价  -->
                <DataGridTemplateColumn Width="86" Header="{DynamicResource KBListControl_TotalValue}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource KbCell}"
                                Text="{Binding SKBDetail.Zkb.TotalValue, Converter={StaticResource Isk}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  飞船 / 建筑  -->
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource KBListControl_Type}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <!--  异步取图：转换器走 WIC 同步下载会让每行都卡 UI 线程  -->
                                <Image
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    ctl:AsyncImage.Size="32"
                                    ctl:AsyncImage.TypeId="{Binding SKBDetail.Victim.ShipTypeId}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding Type.TypeName}"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="ship" />
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding Group.GroupName}"
                                        FontSize="12"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="group" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  位置（星系 + 安全等级 / 星域）  -->
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource KBListControl_Location}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding SolarSystem.SolarSystemName}"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="system" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SolarSystem.Security, StringFormat={}{0:0.0}}" />
                                </StackPanel>
                                <Button
                                    Click="OnEntityClick"
                                    Content="{Binding Region.RegionName}"
                                    FontSize="12"
                                    Style="{StaticResource KbLinkButton}"
                                    Tag="region" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  受害者：身份图（头像/徽标）+ 势力徽标 + 名称/势力名（对齐 WinUI 的 KBListCharacterControl）  -->
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource KBListControl_Victim}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    ctl:AsyncImage.IdName="{Binding Victim}"
                                    ctl:AsyncImage.Size="64" />
                                <Image
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    ctl:AsyncImage.IdName="{Binding VictimFctionName}"
                                    ctl:AsyncImage.Size="64" />
                                <StackPanel
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center">
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding Victim.Name}"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="victim" />
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding VictimFctionName.Name}"
                                        FontSize="12"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="victimfaction" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  最后一击：同上，名称后附击杀者人数（WinUI 的 "( N )"）  -->
                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource KBListControl_FinalBlow}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    ctl:AsyncImage.IdName="{Binding FinalBlow}"
                                    ctl:AsyncImage.Size="64" />
                                <Image
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    ctl:AsyncImage.IdName="{Binding FinalBlowFctionName}"
                                    ctl:AsyncImage.Size="64" />
                                <StackPanel
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Click="OnEntityClick"
                                            Content="{Binding FinalBlow.Name}"
                                            Style="{StaticResource KbLinkButton}"
                                            Tag="finalblow" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SKBDetail.Attackers.Count, StringFormat={}({0})}" />
                                    </StackPanel>
                                    <Button
                                        Click="OnEntityClick"
                                        Content="{Binding FinalBlowFctionName.Name}"
                                        FontSize="12"
                                        Style="{StaticResource KbLinkButton}"
                                        Tag="finalblowfaction" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </ScrollViewer>
</UserControl>
