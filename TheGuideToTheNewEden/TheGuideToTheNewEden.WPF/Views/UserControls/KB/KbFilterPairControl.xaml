<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.KB.KbFilterPairControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:kbControls="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.KB"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />

        <DataTemplate x:Key="FilterItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Id}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Converter={StaticResource CategoryEnum}}" />
                <ui:Button
                    Grid.Column="2"
                    Padding="2"
                    Appearance="Transparent"
                    Click="OnRemoveClick"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{DynamicResource General_Remove}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{DynamicResource ZKBHomePage_Setting_FilterMode}" />
            <ComboBox
                x:Name="ModeCombo"
                Grid.Column="1"
                Width="180"
                SelectedIndex="0">
                <ComboBoxItem Content="{DynamicResource ZKBHomePage_Setting_FilterMode_None}" />
                <ComboBoxItem Content="{DynamicResource ZKBHomePage_Setting_FilterMode_Include}" />
                <ComboBoxItem Content="{DynamicResource ZKBHomePage_Setting_FilterMode_Exclude}" />
            </ComboBox>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,6"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{DynamicResource General_Add}" />
        <kbControls:IdNameSearchBox
            x:Name="ItemSearchBox"
            Grid.Row="2"
            Categories="{Binding Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
            PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ItemSelected="OnItemSelected" />
        <ListBox
            Grid.Row="3"
            MinHeight="120"
            Margin="0,8,0,0"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            ItemContainerStyle="{StaticResource StretchListItem}"
            ItemTemplate="{StaticResource FilterItemTemplate}"
            ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>
