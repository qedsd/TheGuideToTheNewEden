<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.MapNavigationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  由星图页以 ToolWindow 承载；DataContext = 星图页的 MapPageViewModel（与主图共用同一份状态）  -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:SecurityToBrushConverter x:Key="SecurityBrush" />

        <!--  导航结果行  -->
        <DataTemplate x:Key="NavResultTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    
                    Text="{Binding Index}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    
                    Text="{Binding Node.Name}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{Binding Node.Security, Converter={StaticResource SecurityBrush}}"
                    Text="{Binding SecurityText}" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="12"
                    
                    Text="{Binding DistanceLy, StringFormat={}{0:N1} ly}" />
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontSize="12"
                    
                    Text="{Binding FuelText}" />
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    FontSize="12"
                    
                    Text="{Binding NavTypeText}" />
            </Grid>
        </DataTemplate>

        <!--  航点 / 规避节点行  -->
        <DataTemplate x:Key="NavNodeTemplate">
            <Grid Margin="0,1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="12"
                        
                        Text="{Binding RegionName}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{Binding Security, Converter={StaticResource SecurityBrush}}"
                    Text="{Binding Security, StringFormat={}{0:0.0}}" />
                <Button
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RemoveNavNode_Click"
                    
                    ToolTip="{DynamicResource General_Remove}">
                    <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  左：航线节点  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,11,12,8">
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource MapPage_Waypoints}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0,12,9">
                    <Grid>
                        <ui:TextBox
                            x:Name="NavSearchBox"
                            Height="31"
                            ClearButtonEnabled="True"
                            
                            PlaceholderText="{DynamicResource MapPage_NavSearchPlaceholder}"
                            TextChanged="NavSearchBox_TextChanged" />
                        <Popup
                            x:Name="NavSearchPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=NavSearchBox}"
                            StaysOpen="False">
                            <Border
                                Width="360"
                                MaxHeight="250"
                                Margin="0,4,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ListBox
                                    x:Name="NavSearchResultsList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SelectionChanged="NavSearchResultsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="10"
                                                    
                                                    Text="{Binding RegionName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <ui:Button
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Appearance="Transparent"
                        Click="AddFromMap_Click"
                        Content="{DynamicResource MapPage_AddFromMap}"
                         />
                </StackPanel>

                <TabControl
                    x:Name="NodeTabs"
                    Grid.Row="2"
                    Margin="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="NodeTabs_SelectionChanged">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource MapPage_Waypoints}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    
                                    Text="{Binding Waypoints.Count}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox
                            Margin="0,4,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource NavNodeTemplate}"
                            ItemsSource="{Binding Waypoints}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource MapPage_Avoid}" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    
                                    Text="{Binding AvoidSystems.Count}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox
                            Margin="0,4,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource NavNodeTemplate}"
                            ItemsSource="{Binding AvoidSystems}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!--  中：概览 + 结果  -->
        <Grid Grid.Column="1" Margin="10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource MapPage_RouteOverview}" />
                    </DockPanel>
                    <UniformGrid Margin="0,8,0,0" Columns="5">
                        <Border
                            Margin="0,0,6,0"
                            Padding="9,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="9.5"
                                    
                                    Text="{DynamicResource MapPage_Nav_TotalJumps}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding NavTotalHops}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,6,0"
                            Padding="9,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="9.5"
                                    
                                    Text="{DynamicResource MapPage_Nav_Gate}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding NavGateHops}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,6,0"
                            Padding="9,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="9.5"
                                    
                                    Text="{DynamicResource MapPage_Nav_Capital}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding NavCapitalHops}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Margin="0,0,6,0"
                            Padding="9,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="9.5"
                                    
                                    Text="{DynamicResource MapTool_Cover_Distance}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding NavDistanceLy, StringFormat={}{0:0.0} ly}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="9,7"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="9.5"
                                    
                                    Text="{DynamicResource MapTool_Cover_Fuel}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding NavFuel, StringFormat={}{0:N0}}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="12,10,12,6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{DynamicResource MapPage_RouteDetail}" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="12,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            
                            Text="#" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            
                            Text="{DynamicResource MapTool_System}" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="12"
                            
                            Text="{DynamicResource MapTool_Security}" />
                        <TextBlock
                            Grid.Column="3"
                            FontSize="12"
                            
                            Text="{DynamicResource MapTool_Cover_Distance}" />
                        <TextBlock
                            Grid.Column="4"
                            FontSize="12"
                            
                            Text="{DynamicResource MapTool_Cover_Fuel}" />
                        <TextBlock
                            Grid.Column="5"
                            FontSize="12"
                            
                            Text="{DynamicResource MapPage_NavType}" />
                    </Grid>
                    <ListBox
                        x:Name="NavResultList"
                        Grid.Row="2"
                        Margin="6,0,6,6"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource NavResultTemplate}"
                        ItemsSource="{Binding NavResult}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="NavResult_SelectionChanged" />
                </Grid>
            </Border>
        </Grid>

        <!--  右：参数 / 操作 / 交付  -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <CheckBox
                            x:Name="CapitalToggle"
                            Checked="CapitalToggle_Changed"
                            Content="{DynamicResource MapPage_CapitalMode}"
                            Unchecked="CapitalToggle_Changed" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding CapitalMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="12"
                                
                                Text="{DynamicResource MapTool_Cover_Ship}" />
                            <ComboBox
                                x:Name="JumpShipCombo"
                                Margin="0,4,0,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding JumpShips}"
                                SelectedItem="{Binding JumpShip, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,8,0,3"
                                FontSize="12"
                                
                                Text="{DynamicResource MapTool_Cover_Jdc}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding SkillLevels}"
                                SelectedItem="{Binding JumpDriveCalibration, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,8,0,3"
                                FontSize="12"
                                
                                Text="{DynamicResource MapTool_Cover_Jfc}" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding SkillLevels}"
                                SelectedItem="{Binding JumpFuelConservation, Mode=TwoWay}" />
                            <StackPanel Visibility="{Binding ShowJumpFreighters, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Margin="0,8,0,3"
                                    FontSize="12"
                                    
                                    Text="{DynamicResource MapTool_Cover_Jf}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    IsTextSearchEnabled="False"
                                    ItemsSource="{Binding SkillLevels}"
                                    SelectedItem="{Binding JumpFreighters, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{DynamicResource MapPage_UseGates}"
                                IsChecked="{Binding UseGates, Mode=TwoWay}" />
                            <CheckBox
                                Margin="0,6,0,0"
                                Content="{DynamicResource MapPage_PreferCheaper}"
                                IsChecked="{Binding PreferCheaper, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,9,0,3"
                                FontSize="12"
                                
                                Text="{DynamicResource MapPage_MaxLy}" />
                            <ui:NumberBox
                                HorizontalAlignment="Stretch"
                                Maximum="20"
                                Minimum="1"
                                SpinButtonPlacementMode="Hidden"
                                Value="{Binding MaxLy, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Click="ComputeRoute_Click"
                            Content="{DynamicResource MapPage_Compute}" />
                        <ui:Button
                            Margin="0,7,0,0"
                            HorizontalAlignment="Stretch"
                            Appearance="Secondary"
                            Click="ClearRoute_Click"
                            Content="{DynamicResource MapPage_ClearRoute}"
                             />
                        <TextBlock
                            x:Name="NavErrorText"
                            Margin="0,7,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,8,0,0"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{DynamicResource MapPage_SetInGame}" />
                        <ComboBox
                            Margin="0,7,0,0"
                            DisplayMemberPath="CharacterName"
                            ItemsSource="{Binding AutopilotCharacters}"
                            SelectedItem="{Binding AutopilotCharacter, Mode=TwoWay}" />
                        <ui:Button
                            Margin="0,7,0,0"
                            HorizontalAlignment="Stretch"
                            Click="SetAutopilot_Click"
                            Content="{DynamicResource MapPage_SetInGame}"
                             />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  等待遮罩：只覆盖导航窗口，不再借用主窗口的全屏遮罩  -->
        <controls:WaitingOverlay
            x:Name="NavWaiting"
            Grid.ColumnSpan="3"
            Margin="-12,0,-12,-12"
            Panel.ZIndex="100" />
    </Grid>
</UserControl>
