<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.OneJumpCoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style
            x:Key="CoverGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  中心星系：窗口内搜索 / 从星图取当前  -->
        <Border
            Grid.Row="0"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock
                        Margin="0,0,0,5"
                        FontSize="11"
                        
                        Text="{DynamicResource MapTool_Cover_Center}" />
                    <Grid>
                        <ui:TextBox
                            x:Name="CenterSearchBox"
                            Height="32"
                            ClearButtonEnabled="True"
                            GotKeyboardFocus="CenterSearchBox_GotKeyboardFocus"
                            PlaceholderText="{DynamicResource MapTool_Cover_SearchPlaceholder}"
                            TextChanged="CenterSearchBox_TextChanged" />
                        <Popup
                            x:Name="CenterSearchPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=CenterSearchBox}"
                            StaysOpen="False">
                            <Border
                                Width="380"
                                MaxHeight="260"
                                Margin="0,4,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ListBox
                                    x:Name="CenterSearchResultsList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SelectionChanged="CenterSearchResultsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock FontSize="12" Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="10"
                                                    
                                                    Text="{Binding RegionName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Margin="0,17,14,0"
                    VerticalAlignment="Top"
                    Appearance="Secondary"
                    Click="UseMapCenter_Click"
                    Content="{DynamicResource MapTool_Cover_UseMapCenter}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="0,17,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_MaxJump}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding MaxJumpText}" />
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_PerLyFuel}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding PerLyFuelText}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  舰船 / 技能 / 操作  -->
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_Ship}" />
                        <ComboBox
                            x:Name="ShipCombo"
                            Width="200"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding JumpShips}"
                            SelectedItem="{Binding Ship, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_Jdc}" />
                        <ComboBox
                            Width="96"
                            IsTextSearchEnabled="False"
                            ItemsSource="{Binding SkillLevels}"
                            SelectedItem="{Binding JumpDriveCalibration, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_Jfc}" />
                        <ComboBox
                            Width="96"
                            IsTextSearchEnabled="False"
                            ItemsSource="{Binding SkillLevels}"
                            SelectedItem="{Binding JumpFuelConservation, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0" Visibility="{Binding ShowJumpFreighters, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            
                            Text="{DynamicResource MapTool_Cover_Jf}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            Width="108"
                            IsTextSearchEnabled="False"
                            ItemsSource="{Binding SkillLevels}"
                            SelectedItem="{Binding JumpFreighters, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:SpinnerIcon
                        x:Name="BusyIcon"
                        Margin="0,0,8,0"
                        IsActive="{Binding IsBusy}" />
                    <ui:Button
                        Appearance="Primary"
                        Click="Compute_Click"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource MapTool_Cover_Compute}" />
                    <ui:Button
                        Margin="7,0,0,0"
                        Appearance="Secondary"
                        Click="Clear_Click"
                        Icon="{ui:SymbolIcon SquareEraser20}"
                        ToolTip="{DynamicResource MapTool_Cover_Clear}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:DataGrid
            Grid.Row="2"
            Margin="0,8,0,0"
            ItemsSource="{Binding Items}"
            Style="{StaticResource CoverGridStyle}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn
                    Width="48"
                    Binding="{Binding No}"
                    Header="{DynamicResource MapTool_No}" />
                <DataGridTextColumn
                    Width="190"
                    Binding="{Binding Name}"
                    Header="{DynamicResource MapTool_System}" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding RegionName}"
                    Header="{DynamicResource MapTool_Region}" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding SecurityText}"
                    Header="{DynamicResource MapTool_Security}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding DistanceLy, StringFormat={}{0:N2}}"
                    Header="{DynamicResource MapTool_Cover_Distance}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding Fuel, StringFormat={}{0:N2}}"
                    Header="{DynamicResource MapTool_Cover_Fuel}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SovName}"
                    Header="{DynamicResource MapTool_Sov}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</UserControl>
