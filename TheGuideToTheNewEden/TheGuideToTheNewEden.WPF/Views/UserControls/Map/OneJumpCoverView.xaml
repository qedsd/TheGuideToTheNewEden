<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.OneJumpCoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style
            x:Key="CoverGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                Text="{DynamicResource MapTool_Cover_Ship}" />
            <ComboBox
                x:Name="ShipCombo"
                Width="240"
                Margin="6,0,0,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding JumpShips}"
                SelectedItem="{Binding Ship, Mode=TwoWay}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{DynamicResource MapTool_Cover_Jdc}" />
            <ui:NumberBox
                Width="64"
                Margin="6,0,0,0"
                Maximum="5"
                Minimum="0"
                Value="{Binding JumpDriveCalibration, Mode=TwoWay}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{DynamicResource MapTool_Cover_Jfc}" />
            <ui:NumberBox
                Width="64"
                Margin="6,0,0,0"
                Maximum="5"
                Minimum="0"
                Value="{Binding JumpFuelConservation, Mode=TwoWay}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{DynamicResource MapTool_Cover_Jf}"
                Visibility="{Binding ShowJumpFreighters, Converter={StaticResource BoolToVis}}" />
            <ui:NumberBox
                Width="64"
                Margin="6,0,0,0"
                Maximum="5"
                Minimum="0"
                Value="{Binding JumpFreighters, Mode=TwoWay}"
                Visibility="{Binding ShowJumpFreighters, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="{DynamicResource MapTool_Cover_Center}" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding CenterText}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource MapTool_Cover_MaxJump}" />
            <TextBlock
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding MaxJumpText}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource MapTool_Cover_PerLyFuel}" />
            <TextBlock
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding PerLyFuelText}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="Compute_Click"
                Content="{DynamicResource MapTool_Cover_Compute}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Target24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:Button
                Margin="8,0,0,0"
                Click="Clear_Click"
                Content="{DynamicResource MapTool_Cover_Clear}" />
            <controls:SpinnerIcon
                x:Name="BusyIcon"
                Margin="10,0,0,0"
                IsActive="{Binding IsBusy}" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Summary}" />
        </StackPanel>

        <ui:DataGrid
            Grid.Row="3"
            Margin="0,10,0,0"
            ItemsSource="{Binding Items}"
            Style="{StaticResource CoverGridStyle}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn
                    Width="48"
                    Binding="{Binding No}"
                    Header="{DynamicResource MapTool_No}" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Name}"
                    Header="{DynamicResource MapTool_System}" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding RegionName}"
                    Header="{DynamicResource MapTool_Region}" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding SecurityText}"
                    Header="{DynamicResource MapTool_Security}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding DistanceLy, StringFormat={}{0:N2}}"
                    Header="{DynamicResource MapTool_Cover_Distance}" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding Fuel, StringFormat={}{0:N2}}"
                    Header="{DynamicResource MapTool_Cover_Fuel}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SovName}"
                    Header="{DynamicResource MapTool_Sov}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</UserControl>
