<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.JumpBridgeSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <Style
            x:Key="BridgeGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CheckBox
            Grid.Row="0"
            VerticalAlignment="Center"
            Content="{DynamicResource MapTool_Bridge_Show}"
            IsChecked="{Binding ShowInMap, Mode=TwoWay}" />

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource MapTool_Bridge_Hint}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <ui:TextBox
                x:Name="System1Box"
                Width="190"
                PlaceholderText="{DynamicResource MapTool_Bridge_System1}" />
            <ui:TextBox
                x:Name="System2Box"
                Width="190"
                Margin="8,0,0,0"
                PlaceholderText="{DynamicResource MapTool_Bridge_System2}" />
            <ui:Button
                Margin="8,0,0,0"
                Appearance="Primary"
                Click="Add_Click"
                Content="{DynamicResource MapTool_Bridge_Add}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:DataGrid
            Grid.Row="3"
            Margin="0,10,0,0"
            ItemsSource="{Binding Rows}"
            Style="{StaticResource BridgeGridStyle}">
            <ui:DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name1}"
                    Header="{DynamicResource MapTool_Bridge_System1}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name2}"
                    Header="{DynamicResource MapTool_Bridge_System2}" />
                <DataGridTemplateColumn Width="80" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button
                                Padding="6,2"
                                Appearance="Transparent"
                                Click="Remove_Click"
                                Content="{DynamicResource MapTool_Bridge_Remove}"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</UserControl>
