<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.MapSystemDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style
            x:Key="DetailGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding Name}" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SecurityText}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_Id}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SystemIdText}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Region}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding RegionName}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Sov}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SovName}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_Power}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Power, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_Workforce}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Workforce, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_MagmaticGas}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding MagmaticGas, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_SuperionicIce}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SuperionicIce, StringFormat={}{0:N0}}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TabControl>
                <TabItem Header="{DynamicResource MapTool_Detail_Statistic}">
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_ShipKills}" />
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding ShipKillsText}" />
                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_PodKills}" />
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding PodKillsText}" />
                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_NpcKills}" />
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding NpcKillsText}" />
                        <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_Jumps}" />
                        <TextBlock Style="{StaticResource DetailValue}" Text="{Binding JumpsText}" />
                    </WrapPanel>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Upgrade}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding UpgradeRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="{DynamicResource MapTool_Name}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Power, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_Power}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Workforce, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_Workforce}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding MagmaticGas, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_MagmaticGas}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding SuperionicIce, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_SuperionicIce}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Planet}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding PlanetRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding PlanetName}"
                                Header="{DynamicResource MapTool_Name}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding PlanetId}"
                                Header="{DynamicResource MapTool_Detail_PlanetId}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Power, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_Power}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Workforce, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_Workforce}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding MagmaticGas, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_MagmaticGas}" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding SuperionicIce, StringFormat={}{0:N0}}"
                                Header="{DynamicResource MapTool_Resource_SuperionicIce}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Celestial}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding CelestialRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="{DynamicResource MapTool_Name}" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding TypeName}"
                                Header="{DynamicResource MapTool_Detail_Type}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding ItemId}"
                                Header="{DynamicResource MapTool_Detail_ItemId}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Neighbor}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding NeighborRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Name}"
                                Header="{DynamicResource MapTool_System}" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding RegionName}"
                                Header="{DynamicResource MapTool_Region}" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding SecurityText}"
                                Header="{DynamicResource MapTool_Security}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding SovName}"
                                Header="{DynamicResource MapTool_Sov}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>
            </TabControl>

            <Border Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <controls:SpinnerIcon IsActive="{Binding IsLoading}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource MapPage_Loading}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
