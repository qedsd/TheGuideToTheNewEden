<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.MapSystemDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:models="clr-namespace:TheGuideToTheNewEden.WPF.Models.Wormhole"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style
            x:Key="DetailGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailStatCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <DataTemplate x:Key="ActiveEntityTemplate" DataType="{x:Type models:ActiveEntityItem}">
            <Button
                Margin="0,2"
                Padding="4"
                HorizontalAlignment="Stretch"
                Click="OnZkbEntityClick"
                Style="{DynamicResource SettingsRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        controls:AsyncImage.Source="{Binding ImageUrl}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Text="{Binding Count}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding LastActiveText}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ShipStatTemplate" DataType="{x:Type models:ShipTypeStatItem}">
            <Button
                Margin="0,2"
                Padding="4"
                HorizontalAlignment="Stretch"
                Click="OnShipButtonClick"
                Style="{DynamicResource SettingsRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Margin="0,0,10,0"
                        controls:AsyncImage.Source="{Binding ImageUrl}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Text="{Binding Count}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SecurityText}" />
            </StackPanel>

            <!--  鍥哄畾璇ユ槦绯诲埌涓婚〉锛圥3 鍙傛暟鍖栫璐达細map + 鏄熺郴 ID锛? -->
            <ui:Button
                Grid.Column="1"
                MinWidth="34"
                MinHeight="30"
                Padding="0"
                VerticalAlignment="Top"
                AutomationProperties.Name="{DynamicResource Home.Quick.PinCurrent}"
                Click="PinSystem_Click"
                ToolTip="{DynamicResource Home.Quick.PinCurrent}">
                <ui:Button.Icon>
                    <ui:SymbolIcon FontSize="18" Symbol="Pin24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Detail_Id}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SystemIdText}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Region}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding RegionName}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Sov}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SovName}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_Power}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Power, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_Workforce}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Workforce, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_MagmaticGas}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding MagmaticGas, StringFormat={}{0:N0}}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource MapTool_Resource_SuperionicIce}" />
            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding SuperionicIce, StringFormat={}{0:N0}}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TabControl>
                <TabItem Header="{DynamicResource MapTool_Detail_Statistic}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_ShipKills}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding ShipKillsText}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_StatRange}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_PodKills}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding PodKillsText}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_StatRange}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_NpcKills}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding NpcKillsText}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_StatRange}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0" Style="{StaticResource DetailStatCard}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_Jumps}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="{Binding JumpsText}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource MapTool_Detail_StatRange}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>


                            <Border Margin="0,10,0,0" Style="{StaticResource DetailStatCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource MapTool_Detail_ZkbTitle}" />
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ZkbStatusText}" />
                                    </DockPanel>

                                    <StackPanel Visibility="{Binding ZkbHasData, Converter={StaticResource BoolToVis}}">
                                        <UniformGrid Margin="0,10,0,0" Columns="3">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource WormholePage_ZKB_Kills}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding ZkbKillsText}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource WormholePage_ZKB_Isk}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="{Binding ZkbIskText}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource WormholePage_ZKB_Span}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding ZkbSpanText}" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock
                                            Margin="0,14,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_MostActiveCharacters}" />
                                        <ItemsControl ItemTemplate="{StaticResource ActiveEntityTemplate}" ItemsSource="{Binding ZkbTopCharacters}" />

                                        <TextBlock
                                            Margin="0,10,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_MostActiveCorporations}" />
                                        <ItemsControl ItemTemplate="{StaticResource ActiveEntityTemplate}" ItemsSource="{Binding ZkbTopCorporations}" />

                                        <TextBlock
                                            Margin="0,10,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_MostActiveAlliances}" />
                                        <ItemsControl ItemTemplate="{StaticResource ActiveEntityTemplate}" ItemsSource="{Binding ZkbTopAlliances}" />

                                        <TextBlock
                                            Margin="0,10,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_TopShips}" />
                                        <ItemsControl ItemTemplate="{StaticResource ShipStatTemplate}" ItemsSource="{Binding ZkbTopShips}" />

                                        <TextBlock
                                            Margin="0,12,0,0"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_ActivityChart}" />
                                        <TextBlock
                                            Margin="0,2,0,4"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource WormholePage_ZKB_ActivityChartNote}" />
                                        <lvc:CartesianChart
                                            Height="240"
                                            LegendPosition="Bottom"
                                            Series="{Binding ZkbActivitySeries}"
                                            XAxes="{Binding ZkbXAxes}"
                                            YAxes="{Binding ZkbYAxes}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Planet}">
                    <TabControl Margin="0">
                        <TabItem Header="{DynamicResource MapTool_Detail_UpgradeSupported}">
                            <ui:DataGrid
                                Margin="0,10,0,0"
                                ItemsSource="{Binding SupportedUpgradeRows}"
                                Style="{StaticResource DetailGridStyle}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="{DynamicResource MapTool_Name}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Power, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Power}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Workforce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Workforce}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding MagmaticGas, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_MagmaticGas}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding SuperionicIce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_SuperionicIce}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </TabItem>

                        <TabItem Header="{DynamicResource MapTool_Detail_UpgradeUnsupported}">
                            <ui:DataGrid
                                Margin="0,10,0,0"
                                ItemsSource="{Binding UnsupportedUpgradeRows}"
                                Style="{StaticResource DetailGridStyle}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name}"
                                        Header="{DynamicResource MapTool_Name}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Power, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Power}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Workforce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Workforce}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding MagmaticGas, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_MagmaticGas}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding SuperionicIce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_SuperionicIce}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </TabItem>

                        <TabItem Header="{DynamicResource MapTool_Detail_PlanetDetail}">
                            <ui:DataGrid
                                Margin="0,10,0,0"
                                ItemsSource="{Binding PlanetRows}"
                                Style="{StaticResource DetailGridStyle}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding PlanetName}"
                                        Header="{DynamicResource MapTool_Name}" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding PlanetId}"
                                        Header="{DynamicResource MapTool_Detail_PlanetId}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Power, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Power}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Workforce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_Workforce}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding MagmaticGas, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_MagmaticGas}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding SuperionicIce, StringFormat={}{0:N0}}"
                                        Header="{DynamicResource MapTool_Resource_SuperionicIce}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Celestial}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding CelestialRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="{DynamicResource MapTool_Name}" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding TypeName}"
                                Header="{DynamicResource MapTool_Detail_Type}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding ItemId}"
                                Header="{DynamicResource MapTool_Detail_ItemId}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>

                <TabItem Header="{DynamicResource MapTool_Detail_Neighbor}">
                    <ui:DataGrid
                        Margin="0,10,0,0"
                        ItemsSource="{Binding NeighborRows}"
                        Style="{StaticResource DetailGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding Name}"
                                Header="{DynamicResource MapTool_System}" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding RegionName}"
                                Header="{DynamicResource MapTool_Region}" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding SecurityText}"
                                Header="{DynamicResource MapTool_Security}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding SovName}"
                                Header="{DynamicResource MapTool_Sov}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </TabItem>
            </TabControl>

            <Border Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <controls:SpinnerIcon IsActive="{Binding IsLoading}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource MapPage_Loading}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
