<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.SovGroupSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.Map"
    xmlns:pickers="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    ScrollViewer.CanContentScroll="False">

    <!--
        注意：本视图文字颜色全部硬编码（白 #FFFFFF / 灰 #9CA3AF），不使用主题画刷。
        原因：工具窗作用域内 WPF-UI 主题画刷（TextFillColor*Brush）解析不可靠——
        同一画刷在不同列表里渲染深浅不一（实测出现黑字），而窗口外观恒定深色，
        故整个视图按深色外观固定配色。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!--  列表选中态：浅灰微高亮（对齐频道预警的频道列表），覆盖 WPF-UI 默认的强主题色  -->
        <Style x:Key="SovListContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SovSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!--
            分组名输入框：原生 TextBox + 自带最小模板（ui:TextBox 的库模板在此上下文曾渲染黑字）。
            文字/光标走主题画刷；前景色由 ToolWindow 根部注入并沿可视树继承，深浅主题自动跟随。
        -->
        <Style x:Key="SovNameBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource MapTool_Sov_Hint}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,8"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="Save_Click"
                Content="{DynamicResource MapTool_Sov_Save}" />
            <ui:Button
                Margin="8,0,0,0"
                Click="Reload_Click"
                Content="{DynamicResource MapTool_Sov_Reload}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--  三列：所有联盟（分配成员）｜分组（管理）｜分组详细（选中分组的成员列表）  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!--  列 1：所有联盟  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource MapTool_Sov_AlliancesSection}" />
                <ui:TextBox
                    Grid.Row="1"
                    Margin="0,6,0,6"
                    PlaceholderText="{DynamicResource MapTool_Sov_Filter}"
                    TextChanged="FilterBox_TextChanged" />
                <ListBox
                    x:Name="AllianceList"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SovListContainerStyle}"
                    ItemsSource="{Binding Alliances}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Background="{Binding DisplayBrush}"
                                        PreviewMouseLeftButtonDown="Swatch_Click"
                                        Style="{StaticResource SovSwatchStyle}"
                                        Tag="{Binding}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding AllianceName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Count, Mode=OneWay}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        Click="Join_Click"
                                        Content="{DynamicResource MapTool_Sov_Join}"
                                        Tag="{Binding}"
                                        Visibility="{Binding ShowJoin, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!--  列 2：分组列表与管理  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource MapTool_Sov_GroupsSection}" />
                    <ui:Button
                        Margin="10,0,0,0"
                        Appearance="Secondary"
                        Click="NewGroup_Click"
                        Content="{DynamicResource MapTool_Sov_NewGroup}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <ListBox
                    x:Name="GroupList"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SovListContainerStyle}"
                    ItemsSource="{Binding Groups}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="GroupList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Background="{Binding DisplayBrush}"
                                        PreviewMouseLeftButtonDown="Swatch_Click"
                                        Style="{StaticResource SovSwatchStyle}"
                                        Tag="{Binding}" />
                                    <TextBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        MinWidth="60"
                                        Style="{StaticResource SovNameBoxStyle}"
                                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding MemberCountText, Mode=OneWay}" />
                                    <Border
                                        Grid.Column="3"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="DeleteGroup_Click"
                                        Tag="{Binding}">
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="✕" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!--  列 3：分组详细（选中分组的成员，与列 1 同款行：色块｜名称｜领地数｜移出）  -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource MapTool_Sov_Details}" />
                <TextBlock
                    x:Name="MemberPlaceholder"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    VerticalAlignment="Top"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource MapTool_Sov_NoGroupSelected}" />
                <ListBox
                    x:Name="MemberList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SovListContainerStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Background="{Binding DisplayBrush}"
                                        PreviewMouseLeftButtonDown="Swatch_Click"
                                        Style="{StaticResource SovSwatchStyle}"
                                        Tag="{Binding}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Count, Mode=OneWay}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        Click="RemoveMember_Click"
                                        Content="{DynamicResource MapTool_Sov_Leave}"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!--  自定义颜色弹层（复用通用 ColorPickerView：ARGB 滑杆/数值 + HEX 输入）  -->
        <Popup
            x:Name="ColorPopup"
            AllowsTransparency="True"
            Placement="MousePoint"
            StaysOpen="False">
            <Border
                Padding="12"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Width="260">
                    <pickers:ColorPickerView x:Name="Picker" />
                    <ui:Button
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Primary"
                        Click="PickerOk_Click"
                        Content="{DynamicResource MapTool_Sov_Ok}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
