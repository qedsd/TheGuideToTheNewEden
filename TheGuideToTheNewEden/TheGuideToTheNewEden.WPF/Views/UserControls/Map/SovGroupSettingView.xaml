<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Map.SovGroupSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False">

    <UserControl.Resources>
        <converters:SovGroupColorConverter x:Key="GroupColor" />
        <Style
            x:Key="GroupGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource MapTool_Sov_Hint}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="Save_Click"
                Content="{DynamicResource MapTool_Sov_Save}" />
            <ui:Button
                Margin="8,0,0,0"
                Click="Reset_Click"
                Content="{DynamicResource MapTool_Sov_Reset}" />
            <ui:Button
                Margin="8,0,0,0"
                Click="Reload_Click"
                Content="{DynamicResource MapTool_Sov_Reload}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock
                x:Name="StatusText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:DataGrid
            Grid.Row="2"
            Margin="0,10,0,0"
            ItemsSource="{Binding Groups}"
            Style="{StaticResource GroupGridStyle}">
            <ui:DataGrid.Columns>
                <DataGridTemplateColumn Width="44" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding GroupId, Converter={StaticResource GroupColor}}"
                                CornerRadius="4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding AllianceName}"
                    Header="{DynamicResource MapTool_Sov_Alliance}"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding Count}"
                    Header="{DynamicResource MapTool_Sov_Count}"
                    IsReadOnly="True" />
                <DataGridTemplateColumn Width="140" Header="{DynamicResource MapTool_Sov_Group}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:NumberBox
                                Width="110"
                                Margin="0,2"
                                Maximum="9999"
                                Minimum="1"
                                Value="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <TextBlock
            Grid.Row="3"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
