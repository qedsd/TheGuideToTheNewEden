<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.IndustryProductionChainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TheGuideToTheNewEden.WPF.ViewModels.Industry">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="IndustryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="IndustryMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="IndustryMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="IndustryMetricValueCompact"
            BasedOn="{StaticResource IndustryMetricValue}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style
            x:Key="IndustryProfitText"
            BasedOn="{StaticResource IndustryMetricValueCompact}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProfitIsPositive}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProfit}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="IndustryDataGrid"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="IndustrySmallChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style
            x:Key="IndustryFlatItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <DataTemplate x:Key="IndustryNodeTemplate" DataType="{x:Type vm:IndustryPlanNodeViewModel}">
            <Grid Margin="{Binding IndentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="OnToggleNodeClick"
                    Tag="{Binding}"
                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronDown24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronRight24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </ui:Button>

                <Border
                    x:Name="NodeCard"
                    Grid.Column="1"
                    Margin="0,1,4,1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTip="{Binding QuantityText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Accent"
                            Grid.Column="0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            CornerRadius="3,0,0,3" />

                        <Grid
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <ui:SymbolIcon
                                x:Name="BuildIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Symbol="Wrench24"
                                Visibility="{Binding IsBuild, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon
                                x:Name="BuyIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Database24"
                                Visibility="{Binding IsBuy, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon
                                x:Name="InventionIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Symbol="DataSunburst24"
                                Visibility="{Binding IsInvention, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Margin="0,7,8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid
                                    x:Name="DecisionChip"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                    <Border
                                        x:Name="DecisionBg"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        CornerRadius="4"
                                        Opacity="0.18" />
                                    <TextBlock
                                        x:Name="DecisionLabel"
                                        Margin="7,1"
                                        FontSize="10"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Text="{Binding DecisionText}" />
                                </Grid>
                                <TextBlock
                                    x:Name="ActivityLabel"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Text="{Binding ActivityText}" />
                            </StackPanel>

                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding QuantityText}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding RunsText}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding MeTeText}" />
                            </StackPanel>

                            <controls:RatioBar
                                Height="3"
                                Margin="0,5,0,0"
                                BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Ratio="{Binding CostSharePercent}"
                                ToolTip="{Binding CostShareHint}"
                                TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            Margin="0,7,10,7"
                            HorizontalAlignment="Right">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding FullBuildCostText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding MarketText}"
                                ToolTip="{Binding MarketLevelsText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DecisionKey}" Value="buy">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="invention">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="stock">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="surplus">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="jobs">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="mixed">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityText}" Value="发明">
                    <Setter TargetName="ActivityLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityText}" Value="反应">
                    <Setter TargetName="ActivityLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IndustryCostSliceTemplate">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Name}" />
                <controls:RatioBar
                    x:Name="SliceBar"
                    Grid.Column="1"
                    Height="4"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Ratio="{Binding Percent}"
                    TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding PercentText}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="job">
                    <Setter TargetName="SliceBar" Property="BarBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="stock">
                    <Setter TargetName="SliceBar" Property="BarBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="IndustryNodeDetailTemplate" DataType="{x:Type vm:IndustryPlanNodeViewModel}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource IndustrySmallChip}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DecisionText}" />
                        </Border>
                        <Border Style="{StaticResource IndustrySmallChip}" Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                x:Name="DetailActivityLabel"
                                FontSize="10.5"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Text="{Binding ActivityText}" />
                        </Border>
                        <Border Style="{StaticResource IndustrySmallChip}" Visibility="{Binding HasMeTe, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding MeTeText}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding QuantityText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{Binding StockText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasStock, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding RunsText}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="{Binding FullCostLabel}"
                                ToolTip="{Binding FullCostHint}" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding FullBuildCostText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="现金支出（需购买）"
                                ToolTip="需购买材料（扣除角色资产/在制/上游剩余）+ 任务费用。" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding CashCostText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="任务费用（已含）"
                                ToolTip="任务费用（Job Cost），已包含在总成本和现金支出中。" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding JobCostText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="作业耗时" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding JobTimeText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Style="{StaticResource IndustryLabel}"
                        Text="成本构成"
                        ToolTip="占总成本比例；任务费用已包含在内；库存抵扣是库存材料市值。" />
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="采购材料"
                            ToolTip="需购买材料（现金支出部分）。" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Ratio="{Binding MaterialShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding MaterialShare, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="任务费用"
                            ToolTip="已包含在总成本和现金支出中。" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemFillColorCautionBrush}"
                            Ratio="{Binding JobShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding JobShare, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="库存抵扣"
                            ToolTip="库存材料市值；总成本 − 现金支出。" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemFillColorSuccessBrush}"
                            Ratio="{Binding StockShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StockShare, StringFormat={}{0:0}%}" />
                    </Grid>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="总成本 = 材料全量市值（含库存）+ 任务费用；现金支出 = 需购买材料 + 任务费用；库存抵扣 = 两者差额。"
                        TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding HasInventionData, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource IndustryLabel}" Text="发明数据" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding InventionText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding InventionCostHint}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding InventionWarning}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasInventionWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding DecryptorText}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="市场参考" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding MarketText}"
                        ToolTip="{Binding MarketLevelsText}" />
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding MarketVolumeText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMarketVolumeWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding UnitPriceText, StringFormat=参考单价 {0}}" />

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="节点操作" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,6,0"
                            Appearance="Secondary"
                            Click="OnForceBuildClick"
                            Content="强制制造" />
                        <ui:Button
                            Margin="0,0,6,0"
                            Appearance="Secondary"
                            Click="OnForceBuyClick"
                            Content="强制采购" />
                        <ui:Button
                            Appearance="Secondary"
                            Click="OnBlacklistClick"
                            Content="加入黑名单" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="直接输入" />
                    <ui:DataGrid
                        MaxHeight="220"
                        ItemsSource="{Binding Children}"
                        Style="{StaticResource IndustryDataGrid}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="物品" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding QuantityText}"
                                Header="需要 / 产出 / 采购" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </StackPanel>
            </ScrollViewer>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ActivityText}" Value="发明">
                    <Setter TargetName="DetailActivityLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityText}" Value="反应">
                    <Setter TargetName="DetailActivityLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="0" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Border
                                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                            CornerRadius="8"
                                            Opacity="0.1" />
                                        <Grid Margin="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="12.5"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding TargetSummary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Orientation="Horizontal">
                                                        <Border Style="{StaticResource IndustrySmallChip}">
                                                            <TextBlock
                                                                FontSize="9.5"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding MarketStatusText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource IndustrySmallChip}">
                                                            <TextBlock
                                                                FontSize="9.5"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding CharacterStatusText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <UniformGrid
                                                    Grid.Row="1"
                                                    Margin="0,6,0,0"
                                                    Columns="4"
                                                    Rows="2">
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="目标项"
                                                            ToolTip="目标行数；单次产出见标题中的 ×请求 → 产出。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryTargets}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="总流程" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryRuns}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="任务费用（已含）"
                                                            ToolTip="任务费用（Job Cost），已包含在总成本和现金支出中。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryJobCost}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="总成本"
                                                            ToolTip="材料全量市值（含库存中的材料）+ 任务费用。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryFullBuild}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="现金支出（需购买）"
                                                            ToolTip="需购买材料（扣除角色资产/在制/上游剩余）+ 任务费用。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryCash}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="库存抵扣（市值）"
                                                            ToolTip="总成本 − 现金支出，等于库存中已拥有材料的市场估值。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryStock}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="参考收入"
                                                            ToolTip="按实际产出数量 × 参考单价（优先最高买价）。" />
                                                        <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding SummaryRevenue}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,14,4">
                                                        <TextBlock
                                                            Style="{StaticResource IndustryMetricLabel}"
                                                            Text="利润 / 利润率"
                                                            ToolTip="利润 = 参考收入 − 总成本；括号内为利润率（利润 / 参考收入）。" />
                                                        <TextBlock
                                                            FontSize="13"
                                                            Style="{StaticResource IndustryProfitText}"
                                                            Text="{Binding SummaryProfit}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Margin="0,5,0,0"
                                                    FontSize="9.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="总成本 = 材料全量市值（含库存）+ 任务费用；现金支出 = 需购买材料 + 任务费用；库存抵扣 = 两者差额。"
                                                    TextWrapping="Wrap" />
                                            </Grid>

                                            <StackPanel
                                                Grid.Column="1"
                                                Width="300"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="成本构成"
                                                    ToolTip="占总成本比例；任务费用已包含在内；库存抵扣是库存材料市值。" />
                                                <ItemsControl
                                                    Margin="0,4,0,0"
                                                    ItemTemplate="{StaticResource IndustryCostSliceTemplate}"
                                                    ItemsSource="{Binding CostSlices}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                                <ui:Button
                                                    Height="32"
                                                    Margin="0,0,0,6"
                                                    Click="OnCopyClick"
                                                    Icon="{ui:SymbolIcon DocumentSettings16}"
                                                    ToolTip="复制采购" />
                                                <ui:Button
                                                    Height="32"
                                                    Click="OnExportClick"
                                                    Icon="{ui:SymbolIcon ArrowDown24}"
                                                    ToolTip="导出 CSV" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="440" />
                                    </Grid.ColumnDefinitions>

                                    <controls:CardControl
                                        Grid.Column="0"
                                        Padding="10,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="DataSunburst24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="BOM / 成本" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:CardControl.Header>

                                        <Grid>
                                            <ListBox
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource IndustryFlatItem}"
                                                ItemTemplate="{StaticResource IndustryNodeTemplate}"
                                                ItemsSource="{Binding FlatNodes}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                SelectedItem="{Binding SelectedNode, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="添加目标并计算后，这里会展开完整 BOM">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </controls:CardControl>

                                    <controls:CardControl
                                        Grid.Column="2"
                                        Padding="14,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="DataUsage24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="节点详情" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="在 BOM / 成本中选择一个节点">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ContentControl Content="{Binding SelectedNode}" ContentTemplate="{StaticResource IndustryNodeDetailTemplate}" />
                                        </Grid>
                                    </controls:CardControl>
                                </Grid>
                            </Grid>
</UserControl>