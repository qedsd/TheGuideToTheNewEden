<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.CompareMarketResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="RootResult"
    Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:PercentOrDashConverter x:Key="PercentOrDash" />
        <converters:PriceOrDashConverter x:Key="PriceOrDash" />

        <Style x:Key="ResultCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="ResultNumberCellStyle"
            BasedOn="{StaticResource ResultCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <!--  内层 Tab：第一个永远是"全部"（完整矩阵），其后是"被选为最优"的市场（简表）  -->
    <TabControl ItemsSource="{Binding Tabs, ElementName=RootResult}">
        <TabControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" />
                </StackPanel>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <Grid>
                    <!--  "全部"：完整价格矩阵（列在 code-behind 里构造：11 个固定列 + 每市场 2 列）  -->
                    <!--  不套外层 ScrollViewer：外层会以无限高度测量、废掉行虚拟化（§9 第 49 条）  -->
                    <ui:DataGrid
                        x:Name="MatrixGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Rows}"
                        Loaded="OnMatrixGridLoaded"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        Tag="matrix"
                        Visibility="{Binding IsAll, Converter={StaticResource BoolToVis}}" />

                    <!--  单个市场：该市场为最优的物品简表（列固定，直接写在这里）  -->
                    <ui:DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding SimpleRows}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        Visibility="{Binding IsAll, Converter={StaticResource InverseBoolToVis}}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="200"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource ResultCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColItem}" />
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="70"
                                Binding="{Binding Amount, StringFormat={}{0:N0}}"
                                ElementStyle="{StaticResource ResultNumberCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColAmount}" />
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="70"
                                Binding="{Binding Volume, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource ResultNumberCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColVolume}" />
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="90"
                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource ResultNumberCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColUnitPrice}" />
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="100"
                                Binding="{Binding Subtotal, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource ResultNumberCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColSubtotal}" />
                            <DataGridTextColumn
                                Width="Auto"
                                MinWidth="90"
                                Binding="{Binding AdvantagePercent, Converter={StaticResource PercentOrDash}}"
                                ElementStyle="{StaticResource ResultNumberCellStyle}"
                                Header="{DynamicResource CompareMarketPage_ColAdvantage}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
