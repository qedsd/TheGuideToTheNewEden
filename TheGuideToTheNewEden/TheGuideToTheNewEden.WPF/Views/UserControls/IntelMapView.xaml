<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.IntelMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    ClipToBounds="True"
    MouseDoubleClick="Root_MouseDoubleClick"
    MouseLeftButtonDown="Root_MouseLeftButtonDown"
    MouseLeftButtonUp="Root_MouseLeftButtonUp"
    MouseMove="Root_MouseMove"
    PreviewMouseWheel="Root_PreviewMouseWheel">

    <Grid
        x:Name="Root"
        Background="Transparent"
        ClipToBounds="True">
        <!--  地图世界：缩放/平移只作用于这一层，HUD/提示不跟着缩放  -->
        <Grid x:Name="Viewport" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PanTransform" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Canvas x:Name="LineCanvas" IsHitTestVisible="False" />
            <Canvas
                x:Name="MapCanvas"
                Background="Transparent"
                SizeChanged="MapCanvas_SizeChanged" />
            <Canvas x:Name="LabelCanvas" IsHitTestVisible="False" />
            <Canvas x:Name="TempCanvas" IsHitTestVisible="False" />
        </Grid>

        <!--  悬停卡片  -->
        <Border
            x:Name="TipBorder"
            MaxWidth="260"
            Padding="9,7"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="7"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TipTextBlock"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <!--  几何离群星系：只贴边提示，仍在 N 跳数据集合里  -->
        <StackPanel
            x:Name="OutlierPanel"
            Width="112"
            Margin="0,38,8,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
