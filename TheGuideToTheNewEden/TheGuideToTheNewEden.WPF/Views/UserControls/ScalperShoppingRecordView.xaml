<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.ScalperShoppingRecordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <UserControl.Resources>
        <converters:FileNameConverter x:Key="FileName" />

        <Style x:Key="RecordCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="RecordNumberCellStyle"
            BasedOn="{StaticResource RecordCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：记录文件列表  -->
        <Border
            Grid.Column="0"
            Margin="12,12,6,12"
            Padding="10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource BusinessPage_ShoppingRecord_All}" />
                    <ui:Button
                        HorizontalAlignment="Right"
                        Click="OnDeleteClick"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="{DynamicResource General_RemoveSelected}" />
                </Grid>

                <ListBox
                    x:Name="RecordList"
                    Grid.Row="1"
                    IsSynchronizedWithCurrentItem="False"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                    SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Converter={StaticResource FileName}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--  右：记录明细  -->
        <Border
            Grid.Column="1"
            Margin="6,12,12,12"
            Padding="10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource BusinessPage_ShoppingRecord_Detail}" />
                    <ui:Button
                        HorizontalAlignment="Right"
                        Click="OnAddToCartClick"
                        Icon="{ui:SymbolIcon Cart24}"
                        ToolTip="{DynamicResource BusinessPage_AddSelectedToShoppingCart}" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <ui:DataGrid
                        x:Name="RecordItemsGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Items}"
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        ScrollViewer.CanContentScroll="True"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding InvType.TypeName}"
                                ElementStyle="{StaticResource RecordCellStyle}"
                                Header="{DynamicResource BusinessPage_Type}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ROI, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource BusinessPage_ROIPercent}" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding NetProfit, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource BusinessPage_NetProfit}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding BuyPrice, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource BusinessPage_SourceBuyPrice}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding SellPrice, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource BusinessPage_DestinationSellPrice}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Quantity, StringFormat={}{0:N0}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource General_Quantity}" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Volume, StringFormat={}{0:N2}}"
                                ElementStyle="{StaticResource RecordNumberCellStyle}"
                                Header="{DynamicResource BusinessPage_Volume}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
