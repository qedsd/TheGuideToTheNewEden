<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.IndustryScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    d:DesignHeight="760"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ScheduleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ScheduleValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ScheduleSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="ScheduleBarStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Opacity="0.22"
                                SnapsToDevicePixels="True" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActivityKey}" Value="invention">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityKey}" Value="reaction">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.86" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaterialChip" TargetType="Border">
            <Setter Property="Margin" Value="0,1,3,1" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0D9EBCCC" />
            <Setter Property="BorderBrush" Value="#339EBCCC" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="buy">
                    <Setter Property="Background" Value="#1AF0A13A" />
                    <Setter Property="BorderBrush" Value="#44F0A13A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="stock">
                    <Setter Property="Background" Value="#1A4ADE80" />
                    <Setter Property="BorderBrush" Value="#444ADE80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="upstream">
                    <Setter Property="Background" Value="#145BC8D6" />
                    <Setter Property="BorderBrush" Value="#3A5BC8D6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="target">
                    <Setter Property="Background" Value="#22F0A13A" />
                    <Setter Property="BorderBrush" Value="#55F0A13A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MaterialChipTemplate">
            <Border Style="{StaticResource MaterialChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontFamily="Cascadia Code, Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding QuantityText}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding StateText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialChipOutputTemplate">
            <Border Style="{StaticResource MaterialChip}">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="Cascadia Code, Consolas"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding QuantityText}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StateText}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="SlotCardStyle" TargetType="Button">
            <Setter Property="Width" Value="186" />
            <Setter Property="Height" Value="104" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="0.18" />
                            <Border
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="Opacity" Value="0.78" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityKey}" Value="invention">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActivityKey}" Value="reaction">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FirstJob.IsSelected}" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GraphNodeStyle" TargetType="Button">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Opacity="0.18" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="invention">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="reaction">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GraphEdgeStyle" TargetType="Line">
            <Setter Property="Stroke" Value="#66A0A0A0" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                    <Setter Property="Stroke" Value="#CCF0A13A" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScheduleDataGrid" BasedOn="{StaticResource {x:Type ui:DataGrid}}" TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  有调度结果时显示  -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSchedule}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--  顶部指标 / 优化目标  -->
            <Border
                Grid.Row="0"
                Padding="10,7"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="120" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_AllComplete}" />
                            <TextBlock Style="{StaticResource ScheduleValue}" Text="{Binding Schedule.MakespanText}" />
                        </StackPanel>
                        <StackPanel Width="145" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_ManufacturingLines}" />
                            <TextBlock Style="{StaticResource ScheduleValue}" Text="{Binding Schedule.ManufacturingUsageText}" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_DedicatedSlots}" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Schedule.SpecialUsageText}" />
                        </StackPanel>
                        <StackPanel Width="175" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_Bottleneck}" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{Binding Schedule.BottleneckText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Width="125" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_JobCostTotal}" />
                            <TextBlock Style="{StaticResource ScheduleValue}" Text="{Binding Schedule.TotalJobCostText}" />
                        </StackPanel>
                        <StackPanel Width="100">
                            <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_CriticalJobs}" />
                            <TextBlock Style="{StaticResource ScheduleValue}" Text="{Binding Schedule.CriticalCountText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ScheduleLabel}"
                            Text="{DynamicResource IndustrySchedule_Objective}" />
                        <ComboBox
                            Width="112"
                            IsEnabled="{Binding CanReassignSchedule}"
                            SelectedIndex="{Binding ScheduleObjectiveIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource IndustrySchedule_ObjectiveMakespan}" />
                            <ComboBoxItem Content="{DynamicResource IndustrySchedule_ObjectiveCost}" />
                            <ComboBoxItem Content="{DynamicResource IndustrySchedule_ObjectiveBalanced}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TaskDetailColumn" Width="330" />
                </Grid.ColumnDefinitions>

                <TabControl
                    x:Name="ScheduleTabs"
                    Grid.Column="0"
                    Margin="8,6,0,8"
                    Background="Transparent"
                    SelectedIndex="{Binding DetailTabIndex, Mode=TwoWay}"
                    SelectionChanged="OnScheduleTabChanged">
                    <TabItem Header="{DynamicResource IndustrySchedule_TabSchedule}">
                        <ScrollViewer
                            x:Name="ScheduleScroll"
                            Cursor="SizeAll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            LostMouseCapture="OnPanLostCapture"
                            PreviewMouseLeftButtonDown="OnPanStart"
                            PreviewMouseLeftButtonUp="OnPanEnd"
                            PreviewMouseMove="OnPanMove">
                            <StackPanel Margin="4,6,8,8" Background="Transparent">
                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                    <ui:Button
                                        Padding="8,2"
                                        Appearance="Secondary"
                                        Click="OnGanttZoomOutClick"
                                        Content="−"
                                        FontSize="10"
                                        ToolTip="{DynamicResource IndustrySchedule_ZoomOut}" />
                                    <TextBlock
                                        Width="48"
                                        Margin="6,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Schedule.GanttZoomText}" />
                                    <ui:Button
                                        Padding="8,2"
                                        Appearance="Secondary"
                                        Click="OnGanttZoomInClick"
                                        Content="+"
                                        FontSize="10"
                                        ToolTip="{DynamicResource IndustrySchedule_ZoomIn}" />
                                    <ui:Button
                                        Margin="6,0,0,0"
                                        Padding="8,2"
                                        Appearance="Secondary"
                                        Click="OnGanttZoomResetClick"
                                        Content="100%"
                                        FontSize="10" />
                                    <ui:Button
                                        Margin="6,0,0,0"
                                        Padding="8,2"
                                        Appearance="Secondary"
                                        Click="OnGanttFitClick"
                                        Content="{DynamicResource IndustrySchedule_FitWidth}"
                                        FontSize="10" />
                                    <ui:Button
                                        Margin="6,0,0,0"
                                        Padding="8,2"
                                        Appearance="Secondary"
                                        Click="OnExportScheduleClick"
                                        Content="{DynamicResource IndustrySchedule_ExportCsv}"
                                        FontSize="10" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Schedule.TimelineStartText}" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Schedule.GanttZoom}" ScaleY="1" />
                                    </StackPanel.LayoutTransform>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Schedule.TimelineHint}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding Schedule.HasTimelineCompression, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ScheduleLabel}"
                                        Text="{DynamicResource IndustrySchedule_CharacterSlot}" />
                                    <ItemsControl
                                        Grid.Column="1"
                                        Width="{Binding Schedule.TimelineWidth}"
                                        Height="28"
                                        ItemsSource="{Binding Schedule.TimelineTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="2,0,0,0"
                                                    FontFamily="Cascadia Code, Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Schedule.ActiveCharacters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Border
                                                    Padding="6,4"
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding Name}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding CapabilitiesText}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding SourceText}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding UtilizationText}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding UsedSlotText}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding ActiveLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="26">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Width="38"
                                                                        FontFamily="Cascadia Code, Consolas"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding Id}" />
                                                                    <TextBlock
                                                                        x:Name="LineKind"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                        Text="{Binding Kind}" />
                                                                    <TextBlock
                                                                        Margin="5,0,0,0"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding BusyText}" />
                                                                </StackPanel>
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Width="{Binding DataContext.Schedule.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Height="26"
                                                                    Background="Transparent"
                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="0,0,0,1">
                                                                    <ItemsControl ItemsSource="{Binding Jobs}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="Canvas.Left" Value="{Binding DisplayLeft}" />
                                                                                <Setter Property="Canvas.Top" Value="2" />
                                                                                <Setter Property="Width" Value="{Binding Width}" />
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button
                                                                                    Width="{Binding Width}"
                                                                                    HorizontalAlignment="Left"
                                                                                    Click="OnJobClick"
                                                                                    Style="{StaticResource ScheduleBarStyle}"
                                                                                    Tag="{Binding}"
                                                                                    ToolTip="{Binding ToolTip}">
                                                                                    <TextBlock
                                                                                        FontSize="12"
                                                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                                        Text="{Binding BarText}"
                                                                                        TextTrimming="CharacterEllipsis" />
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ActivityKey}" Value="invention">
                                                                    <Setter TargetName="LineKind" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActivityKey}" Value="reaction">
                                                                    <Setter TargetName="LineKind" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActivityKey}" Value="planetary">
                                                                    <Setter TargetName="LineKind" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource IndustrySchedule_TabSteps}">
                        <ui:DataGrid
                            Margin="6"
                            ItemsSource="{Binding Schedule.StepsView}"
                            SelectedItem="{Binding Schedule.SelectedStep, Mode=TwoWay}"
                            Style="{StaticResource ScheduleDataGrid}">
                            <ui:DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,5,0,2"
                                                Padding="8,4"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        x:Name="StepGroupTitle"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Text="{Binding Name, Converter={StaticResource IndustryStageName}}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                        <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                                        <Run Text="{DynamicResource IndustrySchedule_StepsSuffix}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="invention">
                                                    <Setter TargetName="StepGroupTitle" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="reaction">
                                                    <Setter TargetName="StepGroupTitle" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ui:DataGrid.GroupStyle>
                            <ui:DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" Header="{DynamicResource IndustrySchedule_TabSteps}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <Border
                                                    Width="6"
                                                    Height="6"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="invention">
                                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="reaction">
                                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Job.TypeName}"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding Job.RunsText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="220" Header="{DynamicResource IndustrySchedule_Produced}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="4,3"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Job.OutputText}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="280" Header="{DynamicResource IndustrySchedule_Input}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemTemplate="{StaticResource MaterialChipTemplate}" ItemsSource="{Binding Job.Inputs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="150" Header="{DynamicResource IndustrySchedule_ColLineTime}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Job.LineText}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Code, Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Job.TimeText}"
                                                ToolTip="{Binding Job.TimeRangeToolTip}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="76" Header="{DynamicResource IndustrySchedule_JobCost}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="4,3"
                                                FontFamily="Cascadia Code, Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Job.JobCostText}"
                                                TextAlignment="Right" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="86" Header="{DynamicResource IndustryPage_BomCost}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                Appearance="Secondary"
                                                Click="OnViewBomCostClick"
                                                Content="{DynamicResource IndustrySchedule_View}"
                                                FontSize="10"
                                                Tag="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </TabItem>

                    <TabItem Header="{DynamicResource IndustrySchedule_TabStations}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="8" ItemsSource="{Binding Schedule.ActiveCharacters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="8"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding CapabilitiesText}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding UtilizationText}" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding UsedSlotText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding LineGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                            <StackPanel Margin="0,6,0,0">
                                                                <Border
                                                                    x:Name="GroupAccent"
                                                                    Margin="0,0,0,2"
                                                                    Padding="6,1,0,1"
                                                                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    BorderThickness="3,0,0,0">
                                                                    <TextBlock
                                                                        x:Name="GroupTitle"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                        Text="{Binding Title}" />
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button
                                                                Click="OnLineClick"
                                                                Style="{StaticResource SlotCardStyle}"
                                                                Tag="{Binding}">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            FontFamily="Cascadia Code, Consolas"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding LineLabel}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding QueueText}"
                                                                            ToolTip="{Binding QueueToolTip}" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding FirstJob.TypeName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            FontFamily="Cascadia Code, Consolas"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding FirstJob.TimeText}"
                                                                            ToolTip="{Binding FirstJob.TimeRangeToolTip}" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding FirstJob.RunsText}" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Row="1"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        Text="{DynamicResource IndustrySchedule_Idle}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Grid.Row="2"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        Text="{Binding BusyText}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding KindKey}" Value="invention">
                                                                    <Setter TargetName="GroupAccent" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                    <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindKey}" Value="reaction">
                                                                    <Setter TargetName="GroupAccent" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource IndustrySchedule_TabRelations}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,4,0,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="18"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Fill="#66A0A0A0" />
                                <TextBlock
                                    Margin="6,0,14,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource IndustrySchedule_Dependency}" />
                                <Rectangle
                                    Width="18"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Fill="#CCF0A13A" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource IndustrySchedule_CriticalPath}" />
                            </StackPanel>
                            <ScrollViewer
                                Grid.Row="1"
                                x:Name="RelationScroll"
                            Cursor="SizeAll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            LostMouseCapture="OnPanLostCapture"
                            PreviewMouseLeftButtonDown="OnPanStart"
                            PreviewMouseLeftButtonUp="OnPanEnd"
                            PreviewMouseMove="OnPanMove">
                            <Canvas
                                Width="{Binding Schedule.GraphWidth}"
                                Height="{Binding Schedule.GraphHeight}"
                                Margin="8"
                                Background="Transparent">
                                <ItemsControl
                                    Width="{Binding Schedule.GraphWidth}"
                                    Height="{Binding Schedule.GraphHeight}"
                                    ItemsSource="{Binding Schedule.GraphEdges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line
                                                X1="{Binding X1}"
                                                Y1="{Binding Y1}"
                                                X2="{Binding X2}"
                                                Y2="{Binding Y2}"
                                                Style="{StaticResource GraphEdgeStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl
                                    Width="{Binding Schedule.GraphWidth}"
                                    Height="{Binding Schedule.GraphHeight}"
                                    ItemsSource="{Binding Schedule.GraphNodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Click="OnGraphNodeClick"
                                                Style="{StaticResource GraphNodeStyle}"
                                                Tag="{Binding}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            x:Name="ActivityTitle"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                            Text="{Binding Job.ActivityText}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Job.Stage}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Job.TypeName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Job.LineText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Cascadia Code, Consolas"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Job.TimeText}"
                                                            ToolTip="{Binding Job.TimeRangeToolTip}" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="invention">
                                                    <Setter TargetName="ActivityTitle" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Job.ActivityKey}" Value="reaction">
                                                    <Setter TargetName="ActivityTitle" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{DynamicResource IndustryPage_BomCost}">
                        <uc:IndustryProductionChainView />
                    </TabItem>
                </TabControl>

                <!--  右侧详情  -->
                <Border
                    x:Name="TaskDetailPanel"
                    Grid.Column="1"
                    Margin="0,54,8,8"
                    Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{DynamicResource IndustrySchedule_JobDetails}" />
                            <ContentControl Margin="0,6,0,0" Content="{Binding Schedule.SelectedJob}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding TypeName}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RunsText}" />
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_Line}" />
                                                    <TextBlock FontSize="12" Text="{Binding LineText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_Time}" />
                                                    <TextBlock
                                                        FontFamily="Cascadia Code, Consolas"
                                                        FontSize="12"
                                                        Text="{Binding TimeText}"
                                                        ToolTip="{Binding TimeRangeToolTip}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_ActivityDuration}" />
                                                    <TextBlock
                                                        x:Name="DetailActivityTitle"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Text="{Binding ActivityText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_SkillModifier}" />
                                                    <TextBlock FontSize="12" Text="{Binding TimeMultiplierText}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource ScheduleSectionTitle}" Text="{DynamicResource IndustrySchedule_Input}" />
                                            <ItemsControl ItemTemplate="{StaticResource MaterialChipTemplate}" ItemsSource="{Binding Inputs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource ScheduleSectionTitle}" Text="{DynamicResource IndustrySchedule_Produced}" />
                                            <ItemsControl ItemTemplate="{StaticResource MaterialChipOutputTemplate}" ItemsSource="{Binding Outputs}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ScheduleLabel}" Text="{DynamicResource IndustrySchedule_JobCost}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontFamily="Cascadia Code, Consolas"
                                                    FontSize="12"
                                                    Text="{Binding JobCostText}" />
                                            </Grid>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ActivityKey}" Value="invention">
                                                <Setter TargetName="DetailActivityTitle" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActivityKey}" Value="reaction">
                                                <Setter TargetName="DetailActivityTitle" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <TextBlock Style="{StaticResource ScheduleSectionTitle}" Text="{DynamicResource IndustrySchedule_CandidateCharacters}" />
                            <ItemsControl ItemsSource="{Binding Schedule.Candidates}" IsEnabled="{Binding CanReassignSchedule}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,3"
                                            Padding="5,4"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding CapacityText}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding TimeText}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Cascadia Code, Consolas"
                                                        FontSize="12"
                                                        Text="{Binding DurationText}" />
                                                    <Border
                                                        Padding="4,0"
                                                        VerticalAlignment="Center"
                                                        Background="#22F0A13A"
                                                        CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{DynamicResource IndustrySchedule_Current}" />
                                                    </Border>
                                                    <Button
                                                        Margin="5,0,0,0"
                                                        Padding="6,1"
                                                        Click="OnReassignClick"
                                                        Content="{DynamicResource IndustrySchedule_Reassign}"
                                                        FontSize="12"
                                                        IsEnabled="{Binding CanReassign}"
                                                        Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Margin="0,5,0,0"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Click="OnAutoAssignClick"
                                Content="{DynamicResource IndustrySchedule_AutoSchedule}"
                                FontSize="12"
                                IsEnabled="{Binding CanReassignSchedule}" />
                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource IndustrySchedule_OptimizerTip}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!--  无结果  -->
        <Border
            Padding="24"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSchedule}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="CalendarLtr24" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{DynamicResource IndustrySchedule_NoResult}" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource IndustrySchedule_Empty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
