<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.AiAssistantChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  气泡文字用只读富文本（RichTextPresenter = RichTextBox）：可任意拖选复制  -->
        <Style x:Key="ChatRichText" TargetType="{x:Type controls:RichTextPresenter}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ChatRichTextSecondary" TargetType="{x:Type controls:RichTextPresenter}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--
            助手的回答是 Markdown（表格/加粗/列表），用 Controls/MarkdownPresenter 渲染（阶段 79 自写的渲染器，
            无新增依赖）；折叠靠控件的 MaxHeight 视觉裁剪，不做文本截断（截断会切坏表格）。
        -->
        <Style x:Key="ChatMarkdown" TargetType="{x:Type controls:MarkdownPresenter}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ChatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ChatSessionItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  ============ 已配置：左对话列表 + 右对话记录 ============  -->
        <Grid Margin="12" Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：对话列表 ============  -->
            <controls:CardControl
                Grid.Column="0"
                Margin="0,0,6,0"
                Header="{DynamicResource Assistant_Chat_Sessions}">
                <Grid>
                    <ListBox
                        x:Name="SessionList"
                        HorizontalContentAlignment="Stretch"
                        ItemContainerStyle="{StaticResource ChatSessionItem}"
                        ItemsSource="{Binding Sessions}"
                        PreviewMouseRightButtonDown="OnSessionPreviewMouseRightButtonDown"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="OnRenameSessionClick" Header="{DynamicResource Assistant_Chat_Rename}" />
                                <MenuItem Click="OnDeleteSessionClick" Header="{DynamicResource Assistant_Chat_Delete}" />
                                <MenuItem Click="OnClearSessionClick" Header="{DynamicResource Assistant_Chat_Clear}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Preview}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding UpdatedText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource Assistant_Chat_NoSessions}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>

                <controls:CardControl.Footer>
                    <ui:Button
                        HorizontalAlignment="Center"
                        Appearance="Primary"
                        Click="OnNewSessionClick"
                        Content="{DynamicResource Assistant_Chat_New}"
                        Icon="{ui:SymbolIcon Add24}" />
                </controls:CardControl.Footer>
            </controls:CardControl>

            <!--  ============ 右：对话记录 ============  -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:CardControl Grid.Row="0">
                    <controls:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    MouseLeftButtonDown="OnTitleMouseLeftButtonDown"
                                    Text="{Binding SessionTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{DynamicResource Assistant_Chat_Rename_Tip}"
                                    Visibility="{Binding SelectedSession.IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBox
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    KeyDown="OnTitleKeyDown"
                                    LostFocus="OnTitleLostFocus"
                                    Text="{Binding SelectedSession.TitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding SelectedSession.IsRenaming, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Transparent"
                                AutomationProperties.Name="{DynamicResource Assistant_Chat_Rename}"
                                Click="OnRenameClick"
                                Icon="{ui:SymbolIcon Edit24}"
                                ToolTip="{DynamicResource Assistant_Chat_Rename}"
                                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}" />

                            <TextBlock
                                Grid.Column="2"
                                MaxWidth="320"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding PendingText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </controls:CardControl.Header>

                    <Grid>
                        <ScrollViewer
                            x:Name="TranscriptScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <!--  不用 ListBox：列表项的选中语义会跟"在气泡里拖选文字"打架  -->
                            <ItemsControl x:Name="Transcript" ItemsSource="{Binding SelectedSession.Turns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <!--  请求气泡：靠右  -->
                                            <Border
                                                MaxWidth="560"
                                                Padding="10,8"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource ChatLabel}" Text="{DynamicResource Assistant_Chat_Request}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ChatLabel}"
                                                            Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                    <controls:RichTextPresenter
                                                        Margin="0,4,0,0"
                                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                        Text="{Binding UserDisplay, Mode=OneWay}">
                                                        <controls:RichTextPresenter.Style>
                                                            <Style BasedOn="{StaticResource ChatRichText}" TargetType="{x:Type controls:RichTextPresenter}">
                                                                <Setter Property="MaxHeight" Value="58" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUserExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="100000" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:RichTextPresenter.Style>
                                                    </controls:RichTextPresenter>
                                                    <ui:Button
                                                        Margin="0,4,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        Appearance="Transparent"
                                                        Click="OnToggleUserClick"
                                                        Content="{Binding UserExpandLabel}"
                                                        FontSize="12"
                                                        Visibility="{Binding CanExpandUser, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  回答气泡：靠左；工具步骤区 → 回答 → 确认卡片 → meta  -->
                                            <Border
                                                Margin="0,6,0,0"
                                                Padding="10,8"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource ChatLabel}" Text="{DynamicResource Assistant_Chat_Answer}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource ChatLabel}"
                                                            Text="{Binding TimeText}" />
                                                        <controls:SpinnerIcon
                                                            Width="14"
                                                            Height="14"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                            IsActive="{Binding ShowPendingBadge}" />
                                                    </StackPanel>

                                                    <!--  工具步骤区：每一步一行（图标 + 工具名 + 参数 + 耗时）  -->
                                                    <ItemsControl
                                                        Margin="0,6,0,0"
                                                        ItemsSource="{Binding Steps}"
                                                        Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <ui:SymbolIcon
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                        Symbol="Checkmark24"
                                                                        Visibility="{Binding Success, Converter={StaticResource BoolToVis}}" />
                                                                    <ui:SymbolIcon
                                                                        Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                        Symbol="Dismiss24"
                                                                        Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibility}}" />

                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Margin="5,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding DisplayName}" />
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding ParamSummary}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip="{Binding ResultSummary}" />
                                                                    <TextBlock
                                                                        Grid.Column="3"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding StatusText}" />
                                                                    <TextBlock
                                                                        Grid.Column="4"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                        Text="{Binding ElapsedText}"
                                                                        Visibility="{Binding HasElapsed, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!--  重型工具实时进度  -->
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Text="{Binding ProgressText}"
                                                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />

                                                    <!--  确认卡片：写操作（如跳桥增删）需要用户确认  -->
                                                    <Border
                                                        Margin="0,6,0,0"
                                                        Padding="10,8"
                                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasPendingConfirmation, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{DynamicResource Assistant_Chat_Confirm_Title}" />
                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{DynamicResource Assistant_Chat_Confirm_Hint}"
                                                                TextWrapping="Wrap" />
                                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding PendingLines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                            Text="{Binding}"
                                                                            TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                                <ui:Button
                                                                    Margin="4,0"
                                                                    Appearance="Primary"
                                                                    Click="OnConfirmApplyClick"
                                                                    Content="{DynamicResource Assistant_Chat_Confirm_Apply}"
                                                                    Icon="{ui:SymbolIcon Checkmark24}" />
                                                                <ui:Button
                                                                    Margin="4,0"
                                                                    Click="OnConfirmRejectClick"
                                                                    Content="{DynamicResource Assistant_Chat_Confirm_Reject}"
                                                                    Icon="{ui:SymbolIcon Dismiss24}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!--  回答正文（Markdown 渲染；流式增量按节流批量长进来）  -->
                                                    <controls:MarkdownPresenter
                                                        Margin="0,4,0,0"
                                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                        Markdown="{Binding AnswerDisplay, Mode=OneWay}"
                                                        Visibility="{Binding ShowAnswerBubble, Converter={StaticResource BoolToVis}}">
                                                        <controls:MarkdownPresenter.Style>
                                                            <Style BasedOn="{StaticResource ChatMarkdown}" TargetType="{x:Type controls:MarkdownPresenter}">
                                                                <!--  折叠：约五行高度；展开：不限高  -->
                                                                <Setter Property="MaxHeight" Value="96" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnswerExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="100000" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:MarkdownPresenter.Style>
                                                    </controls:MarkdownPresenter>

                                                    <ui:Button
                                                        Margin="0,4,0,0"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        Appearance="Transparent"
                                                        Click="OnToggleAnswerClick"
                                                        Content="{Binding AnswerExpandLabel}"
                                                        FontSize="12"
                                                        Visibility="{Binding CanExpandAnswer, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{DynamicResource Assistant_Chat_Generating}"
                                                        Visibility="{Binding ShowPendingHint, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                        Text="{DynamicResource Assistant_Chat_Stopped}"
                                                        Visibility="{Binding ShowStopped, Converter={StaticResource BoolToVis}}" />

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                        Text="{Binding Error}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}" />

                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding Meta}"
                                                            Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />

                                                        <ui:Button
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Appearance="Transparent"
                                                            AutomationProperties.Name="{DynamicResource Assistant_Chat_CopyAnswer}"
                                                            Click="OnCopyAnswerClick"
                                                            Icon="{ui:SymbolIcon Copy24}"
                                                            ToolTip="{DynamicResource Assistant_Chat_CopyAnswer}"
                                                            Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource Assistant_Chat_EmptyTip}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ShowSessionEmptyTip, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <controls:CardControl.Footer>
                        <Grid>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="{DynamicResource Assistant_Chat_UseContext}"
                                IsChecked="{Binding SelectedSession.UseContext, Mode=TwoWay}"
                                IsEnabled="{Binding HasSession}"
                                ToolTip="{DynamicResource Assistant_Chat_UseContext_Tip}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ContextInfoText}" />
                        </Grid>
                    </controls:CardControl.Footer>
                </controls:CardControl>

                <!--  ============ 输入 ============  -->
                <controls:CardControl
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Header="{DynamicResource Assistant_Chat_Input}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding EndpointSummary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding EndpointSummary}" />

                        <ui:TextBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            MinHeight="70"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            PlaceholderText="{DynamicResource Assistant_Chat_Input_Tip}"
                            PreviewKeyDown="OnInputPreviewKeyDown"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <controls:CardControl.Footer>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource Assistant_Chat_Input_Hint}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Margin="4,0"
                                    Appearance="Primary"
                                    Click="OnSendClick"
                                    Content="{DynamicResource Assistant_Chat_Send}"
                                    Icon="{ui:SymbolIcon Send24}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnStopClick"
                                    Content="{DynamicResource Assistant_Chat_Stop}"
                                    Icon="{ui:SymbolIcon Stop24}"
                                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnClearInputClick"
                                    Content="{DynamicResource Assistant_Chat_Clear}"
                                    Icon="{ui:SymbolIcon Eraser24}" />
                                <ui:Button
                                    Margin="4,0"
                                    Click="OnPopWindowClick"
                                    Content="{DynamicResource Assistant_Chat_PopWindow}"
                                    Icon="{ui:SymbolIcon WindowNew24}" />
                            </StackPanel>
                        </Grid>
                    </controls:CardControl.Footer>
                </controls:CardControl>
            </Grid>
        </Grid>

        <!--  ============ 未配置：整页引导 ============  -->
        <Border
            Margin="12"
            Padding="24"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="6"
            Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVis}}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Settings24" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource Assistant_NotConfigured_Title}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding NotConfiguredText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{DynamicResource Assistant_NotConfigured_Support}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="4,0"
                        Appearance="Primary"
                        Click="OnConfigureClick"
                        Content="{DynamicResource Assistant_GoConfigure}"
                        Icon="{ui:SymbolIcon Settings24}" />
                    <ui:Button
                        Margin="4,0"
                        Click="OnRecheckClick"
                        Content="{DynamicResource Assistant_Recheck}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
