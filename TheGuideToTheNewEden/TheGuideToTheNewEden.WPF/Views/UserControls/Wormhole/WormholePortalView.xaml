<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Wormhole.WormholePortalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12,16,16">

            <!--  标题  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Text="{Binding Name}" />
                <Border
                    Margin="10,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorNeutralBrush}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{Binding RespawnText}" />
                </Border>
            </StackPanel>

            <!--  基本信息  -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_Destination}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource InfoValue}"
                    Text="{Binding DestinationsText}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_AppearsIn}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource InfoValue}"
                    Text="{Binding AppearsInText}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_Lifetime}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource InfoValue}"
                    Text="{Binding LifetimeText}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_MassRegen}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource InfoValue}"
                    Text="{Binding MassRegenText}" />
            </Grid>

            <!--  质量数据  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource WormholePage_Portal_MassSection}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_MaxMassPerJump}" />
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Style="{StaticResource InfoValue}" Text="{Binding MaxMassPerJumpFullText}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding MaxMassNoteText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding MaxMassNoteText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Portal_TotalJumpMass}" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Style="{StaticResource InfoValue}" Text="{Binding TotalJumpMassFullText}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding TotalMassNoteText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding TotalMassNoteText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Grid>

            <!--  过洞计算器  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource WormholePage_Calculator_Title}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{DynamicResource WormholePage_Calculator_Note}"
                TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Calculator_Ship}" />
                <!--
                    选择舰船一行 = 代表舰船下拉（左半） + 具体舰船搜索框（右半，直接输入即搜）。
                    搜索结果在 Flyout 里弹出；WPF-UI 4.x 的 Flyout 锚点 = Flyout 元素自身矩形：
                    这里锚点 = 搜索框所在的半宽 Grid，Placement=Bottom 向下展开，
                    弹出宽度在展开时对齐搜索框宽度（见 OnShipSearchTextChanged）。见 ZKBPage 的同款用法。
                -->
                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="ShipCombo"
                        DisplayMemberPath="Display"
                        SelectionChanged="OnShipSelectionChanged" />
                    <Grid x:Name="ShipSearchHost" Grid.Column="2">
                        <ui:TextBox
                            x:Name="ShipSearchBox"
                            PlaceholderText="{DynamicResource WormholePage_Calculator_ShipSearchHint}"
                            TextChanged="OnShipSearchTextChanged" />
                        <ui:Flyout x:Name="ShipSearchFlyout" Placement="Bottom">
                            <!--  宽度自适应：下限 = 搜索框宽度（展开时由代码同步），上限 360 防长船名无限拉宽；横向不出滚动条  -->
                            <StackPanel x:Name="ShipSearchPanel" MinWidth="200" MaxWidth="360">
                                <ListBox
                                    x:Name="ShipSearchList"
                                    MaxHeight="240"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource StretchListItem}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectionChanged="OnShipSearchSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding MassText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ui:Flyout>
                    </Grid>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Calculator_ShipMass}" />
                <ui:NumberBox
                    x:Name="ShipMassBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    Minimum="0"
                    PlaceholderText="{DynamicResource WormholePage_Calculator_MassHint}"
                    TextChanged="OnMassValueChanged" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource InfoLabel}"
                    Text="{DynamicResource WormholePage_Calculator_UsedMass}" />
                <ui:NumberBox
                    x:Name="UsedMassBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    Minimum="0"
                    TextChanged="OnMassValueChanged"
                    Value="0" />
            </Grid>

            <!--  计算结果  -->
            <Border
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        x:Name="JumpResultText"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="PassesResultText"
                        Margin="0,6,0,0"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  外链  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource WormholePage_Links}" />
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="OnAnoikClick"
                    Content="Anoik" />
                <ui:Button Click="OnEllathaClick" Content="Ellatha" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
