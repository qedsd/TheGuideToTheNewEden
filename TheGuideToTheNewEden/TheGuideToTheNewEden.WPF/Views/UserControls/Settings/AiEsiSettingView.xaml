<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Settings.AiEsiSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  设置 → AI → 「ESI 全量访问」：网关开关 / 写操作 / ID 富化 / 页数 / 结果上限 / 错误配额 / 黑名单  -->
    <StackPanel Margin="0,0,0,40">
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel Margin="16,12">
                <TextBlock
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Esi}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Esi_Desc}"
                    TextWrapping="Wrap" />

                <ui:ToggleSwitch
                    x:Name="EsiToggle"
                    Margin="0,12,0,0"
                    Content="{DynamicResource AssistantSettingPage_EsiEnabled}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiEnabled_Desc}"
                    TextWrapping="Wrap" />

                <ui:ToggleSwitch
                    x:Name="EsiWriteToggle"
                    Margin="0,12,0,0"
                    Content="{DynamicResource AssistantSettingPage_EsiWrites}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiWrites_Desc}"
                    TextWrapping="Wrap" />

                <!--  把响应里的 ID 富化成「名称 (id)」  -->
                <ui:ToggleSwitch
                    x:Name="EsiEnrichToggle"
                    Margin="0,12,0,0"
                    Content="{DynamicResource AssistantSettingPage_EsiEnrich}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiEnrich_Desc}"
                    TextWrapping="Wrap" />

                <!--  一次最多取的页数  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_EsiMaxPages}" />
                <ui:NumberBox
                    x:Name="EsiPagesBox"
                    Width="160"
                    HorizontalAlignment="Left"
                    Maximum="10"
                    Minimum="1"
                    SmallChange="1" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiMaxPages_Desc}"
                    TextWrapping="Wrap" />

                <!--  单条结果字符上限  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_EsiMaxResultChars}" />
                <ui:NumberBox
                    x:Name="EsiCharsBox"
                    Width="160"
                    HorizontalAlignment="Left"
                    Maximum="12000"
                    Minimum="500"
                    SmallChange="500" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiMaxResultChars_Desc}"
                    TextWrapping="Wrap" />

                <!--  错误配额阈值  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_EsiErrorLimitFloor}" />
                <ui:NumberBox
                    x:Name="EsiErrorBox"
                    Width="160"
                    HorizontalAlignment="Left"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiErrorLimitFloor_Desc}"
                    TextWrapping="Wrap" />

                <!--  禁止调用的路径  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_EsiDeniedPaths}" />
                <ui:TextBox
                    x:Name="EsiDenyBox"
                    Width="420"
                    MinHeight="74"
                    HorizontalAlignment="Left"
                    AcceptsReturn="True"
                    MaxHeight="160"
                    PlaceholderText="{DynamicResource AssistantSettingPage_EsiDeniedPaths_Tip}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_EsiDeniedPaths_Desc}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="OnSaveClick"
                Content="{DynamicResource AssistantSettingPage_Save}"
                Icon="{ui:SymbolIcon Save24}" />
        </StackPanel>
    </StackPanel>
</UserControl>
