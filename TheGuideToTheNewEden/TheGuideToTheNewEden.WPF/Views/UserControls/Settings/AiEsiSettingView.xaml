<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Settings.AiEsiSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置 → AI → 「ESI 全量访问」：逐项 SettingCard + SettingsDivider（阶段 129 统一观感）。
        网关的整体说明放在第一行（开关）的说明里，避免再堆一段长文字。
    -->
    <StackPanel Margin="0,0,0,40">
        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource AssistantSettingPage_Esi}" />
        <TextBlock
            Margin="0,0,0,8"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource AssistantSettingPage_Esi_Desc}"
            TextWrapping="Wrap" />

        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiEnabled_Desc}"
                    Icon="Shield24"
                    Title="{DynamicResource AssistantSettingPage_EsiEnabled}">
                    <ui:ToggleSwitch x:Name="EsiToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiWrites_Desc}"
                    Icon="Document24"
                    Title="{DynamicResource AssistantSettingPage_EsiWrites}">
                    <ui:ToggleSwitch x:Name="EsiWriteToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiEnrich_Desc}"
                    Icon="LocalLanguage24"
                    Title="{DynamicResource AssistantSettingPage_EsiEnrich}">
                    <ui:ToggleSwitch x:Name="EsiEnrichToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiMaxPages_Desc}"
                    Icon="ArrowClockwise24"
                    Title="{DynamicResource AssistantSettingPage_EsiMaxPages}">
                    <ui:NumberBox
                        x:Name="EsiPagesBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="10"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiMaxResultChars_Desc}"
                    Icon="Cut24"
                    Title="{DynamicResource AssistantSettingPage_EsiMaxResultChars}">
                    <ui:NumberBox
                        x:Name="EsiCharsBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="12000"
                        Minimum="500"
                        SmallChange="500"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiErrorLimitFloor_Desc}"
                    Icon="DataTrending24"
                    Title="{DynamicResource AssistantSettingPage_EsiErrorLimitFloor}">
                    <ui:NumberBox
                        x:Name="EsiErrorBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_EsiDeniedPaths_Desc}"
                    Icon="Eraser24"
                    Title="{DynamicResource AssistantSettingPage_EsiDeniedPaths}">
                    <ui:TextBox
                        x:Name="EsiDenyBox"
                        Width="420"
                        MinHeight="74"
                        MaxHeight="160"
                        AcceptsReturn="True"
                        PlaceholderText="{DynamicResource AssistantSettingPage_EsiDeniedPaths_Tip}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap" />
                </controls:SettingCard>
            </StackPanel>
        </Border>

        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="OnSaveClick"
                Content="{DynamicResource AssistantSettingPage_Save}"
                Icon="{ui:SymbolIcon Save24}" />
        </StackPanel>
    </StackPanel>
</UserControl>
