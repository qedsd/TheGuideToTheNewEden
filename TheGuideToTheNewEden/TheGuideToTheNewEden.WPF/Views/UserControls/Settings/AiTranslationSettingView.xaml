<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Settings.AiTranslationSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置 → AI → 「翻译」：**翻译专属**设置（阶段 125 从原来的「模型与翻译」里拆出来）。
        模型端点与生成参数在隔壁的「模型」节（助手与翻译共用）。
    -->
    <StackPanel Margin="0,0,0,40">
        <!--  节标题：与其它设置子页一致（三级详情顶部由它提供 24px 间距）  -->
        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource AssistantSettingPage_Translate}" />

        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_UseGlossary_Desc}"
                    Icon="Database24"
                    Title="{DynamicResource AiSettingPage_UseGlossary}">
                    <ui:ToggleSwitch x:Name="UseGlossaryToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_GlossaryLimit_Desc}"
                    Icon="TextGrammarWand24"
                    Title="{DynamicResource AiSettingPage_GlossaryLimit}">
                    <ui:NumberBox
                        x:Name="GlossaryLimitBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="200"
                        Minimum="0"
                        SmallChange="5"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_GlossaryStatus_Desc}"
                    Icon="LocalLanguage24"
                    Title="{DynamicResource AiSettingPage_GlossaryStatus}">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            x:Name="GlossaryStatusText"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button
                            x:Name="ReloadGlossaryButton"
                            Click="OnReloadGlossaryClick"
                            Content="{DynamicResource AiSettingPage_ReloadGlossary}" />
                    </StackPanel>
                </controls:SettingCard>
            </StackPanel>
        </Border>

        <!--  ============ 翻译行为 ============  -->
        <TextBlock
            Margin="0,24,0,0"
            Style="{StaticResource SettingsSectionHeader}"
            Text="{DynamicResource AiSettingPage_TranslationBehavior}" />
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_ChunkSize_Desc}"
                    Icon="Cut24"
                    Title="{DynamicResource AiSettingPage_ChunkSize}">
                    <ui:NumberBox
                        x:Name="ChunkSizeBox"
                        Width="180"
                        HorizontalAlignment="Right"
                        Maximum="200000"
                        Minimum="0"
                        SmallChange="1000"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_ContextTokens_Desc}"
                    Icon="DocumentText24"
                    Title="{DynamicResource AiSettingPage_ContextTokens}">
                    <!--  token；0 = 不限制。此前记录按"最近优先"装进预算，装不下的更早记录省略  -->
                    <ui:NumberBox
                        x:Name="ContextTokensBox"
                        Width="180"
                        HorizontalAlignment="Right"
                        Maximum="200000"
                        Minimum="0"
                        SmallChange="500"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_Cache_Desc}"
                    Icon="Scan24"
                    Title="{DynamicResource AiSettingPage_Cache}">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock
                            x:Name="CacheStatusText"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:ToggleSwitch x:Name="CacheToggle" />
                        <ui:Button
                            Margin="10,0,0,0"
                            Click="OnClearCacheClick"
                            Content="{DynamicResource AiSettingPage_ClearCache}" />
                    </StackPanel>
                </controls:SettingCard>
            </StackPanel>
        </Border>

        <!--  ============ 翻译提示词 ============  -->
        <TextBlock
            Margin="0,24,0,0"
            Style="{StaticResource SettingsSectionHeader}"
            Text="{DynamicResource AiSettingPage_SystemPrompt}" />
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
                <controls:SettingCard
                    Description="{DynamicResource AiSettingPage_SystemPrompt_Desc}"
                    Icon="BookOpen24"
                    Title="{DynamicResource AiSettingPage_CustomPrompt}">
                    <StackPanel Width="420" HorizontalAlignment="Right">
                        <ui:TextBox
                            x:Name="SystemPromptBox"
                            AcceptsReturn="True"
                            MinHeight="120"
                            TextWrapping="Wrap" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Click="OnRestorePromptClick"
                            Content="{DynamicResource AiSettingPage_RestorePrompt}" />
                    </StackPanel>
                </controls:SettingCard>
            </StackPanel>
        </Border>

        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="OnSaveClick"
                Content="{DynamicResource AssistantSettingPage_Save}"
                Icon="{ui:SymbolIcon Save24}" />
        </StackPanel>
    </StackPanel>
</UserControl>
