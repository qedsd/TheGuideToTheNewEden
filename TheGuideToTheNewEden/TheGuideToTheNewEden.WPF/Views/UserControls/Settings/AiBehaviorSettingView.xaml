<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Settings.AiBehaviorSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  设置 → AI → 「行为」：工具轮数 / 默认角色 / 写操作确认 / 全局快捷键 / 助手系统提示词  -->
    <StackPanel Margin="0,0,0,40">
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel Margin="16,12">
                <TextBlock
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Behavior}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Behavior_Desc}"
                    TextWrapping="Wrap" />

                <!--  最大工具轮数  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_MaxToolRounds}" />
                <ui:NumberBox
                    x:Name="RoundsBox"
                    Width="160"
                    HorizontalAlignment="Left"
                    Maximum="30"
                    Minimum="1"
                    SmallChange="1" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_MaxToolRounds_Desc}"
                    TextWrapping="Wrap" />

                <!--  默认角色  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_DefaultCharacter}" />
                <ui:TextBox
                    x:Name="CharacterBox"
                    Width="320"
                    HorizontalAlignment="Left"
                    PlaceholderText="{DynamicResource AssistantSettingPage_DefaultCharacter_Tip}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_DefaultCharacter_Desc}"
                    TextWrapping="Wrap" />

                <!--  确认写操作  -->
                <ui:ToggleSwitch
                    x:Name="ConfirmToggle"
                    Margin="0,12,0,0"
                    Content="{DynamicResource AssistantSettingPage_Confirm}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Confirm_Desc}"
                    TextWrapping="Wrap" />

                <!--  全局快捷键  -->
                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource TranslationFieldLabel}"
                    Text="{DynamicResource AssistantSettingPage_Hotkey}" />
                <ui:TextBox
                    x:Name="HotkeyBox"
                    Width="200"
                    HorizontalAlignment="Left"
                    PlaceholderText="Alt+Q" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Hotkey_Desc}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  系统提示词  -->
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel Margin="16,12">
                <TextBlock
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Prompt}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AssistantSettingPage_Prompt_Desc}"
                    TextWrapping="Wrap" />
                <ui:TextBox
                    x:Name="PromptBox"
                    MinHeight="120"
                    Margin="0,8,0,0"
                    AcceptsReturn="True"
                    MaxHeight="260"
                    PlaceholderText="{DynamicResource AssistantSettingPage_Prompt_Tip}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="OnSaveClick"
                Content="{DynamicResource AssistantSettingPage_Save}"
                Icon="{ui:SymbolIcon Save24}" />
        </StackPanel>
    </StackPanel>
</UserControl>
