<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.Settings.AiBehaviorSettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置 → AI → 「行为」：逐项用 controls:SettingCard（图标 + 标题 + 说明 + 右侧控件）+ SettingsDivider 分隔，
        与其它设置页（如「通用设置」）保持同一套观感（阶段 129：之前是标签 + 控件堆叠，挤在一起）。
    -->
    <StackPanel Margin="0,0,0,0">
        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource AssistantSettingPage_Behavior}" />
        <Border Style="{StaticResource SettingsGroupBorder}">
            <StackPanel>
                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_MaxToolRounds_Desc}"
                    Icon="ArrowSync24"
                    Title="{DynamicResource AssistantSettingPage_MaxToolRounds}">
                    <ui:NumberBox
                        x:Name="RoundsBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="30"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_DefaultCharacter_Desc}"
                    Icon="Person24"
                    Title="{DynamicResource AssistantSettingPage_DefaultCharacter}">
                    <ui:TextBox
                        x:Name="CharacterBox"
                        Width="320"
                        HorizontalAlignment="Right"
                        PlaceholderText="{DynamicResource AssistantSettingPage_DefaultCharacter_Tip}" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_Confirm_Desc}"
                    Icon="Shield24"
                    Title="{DynamicResource AssistantSettingPage_Confirm}">
                    <ui:ToggleSwitch x:Name="ConfirmToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_ShowInMainWindow_Desc}"
                    Icon="WindowNew24"
                    Title="{DynamicResource AssistantSettingPage_ShowInMainWindow}">
                    <ui:ToggleSwitch x:Name="ShowInMainWindowToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_ContextWindow_Desc}"
                    Icon="WindowNew24"
                    Title="{DynamicResource AssistantSettingPage_ContextWindow}">
                    <!--  token；0 = 不限制。预算会从这里扣掉提示词/工具声明/输出预留/余量/本轮预留。
                          上面那个下拉是"按常用模型自动填入"（阶段 149）：选一个模型就把它的窗口写进下面的输入框，
                          可以再手改。  -->
                    <StackPanel HorizontalAlignment="Right">
                        <ComboBox
                            x:Name="KnownModelBox"
                            Width="260"
                            DisplayMemberPath="Label"
                            SelectionChanged="OnKnownModelSelectionChanged"
                            ToolTip="{DynamicResource AssistantSettingPage_ContextWindow_Desc}" />
                        <ui:NumberBox
                            x:Name="ContextWindowBox"
                            Width="180"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            Maximum="4000000"
                            Minimum="0"
                            SmallChange="10000"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_Summarize_Desc}"
                    Icon="DocumentText24"
                    Title="{DynamicResource AssistantSettingPage_Summarize}">
                    <ui:ToggleSwitch x:Name="SummarizeToggle" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_OutputReserve_Desc}"
                    Icon="Timer24"
                    Title="{DynamicResource AssistantSettingPage_OutputReserve}">
                    <ui:NumberBox
                        x:Name="OutputReserveBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="200000"
                        Minimum="0"
                        SmallChange="512"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_MaxCalls_Desc}"
                    Icon="Settings24"
                    Title="{DynamicResource AssistantSettingPage_MaxCalls}">
                    <ui:NumberBox
                        x:Name="MaxCallsBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="16"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_TurnToolTokens_Desc}"
                    Icon="DataTrending24"
                    Title="{DynamicResource AssistantSettingPage_TurnToolTokens}">
                    <ui:NumberBox
                        x:Name="TurnToolTokensBox"
                        Width="160"
                        HorizontalAlignment="Right"
                        Maximum="200000"
                        Minimum="0"
                        SmallChange="1000"
                        SpinButtonPlacementMode="Inline" />
                </controls:SettingCard>

                <Border Style="{StaticResource SettingsDivider}" />

                <controls:SettingCard
                    Description="{DynamicResource AssistantSettingPage_Hotkey_Desc}"
                    Icon="Keyboard24"
                    Title="{DynamicResource AssistantSettingPage_Hotkey}">
                    <!--  占位提示由代码设成 AiAssistantSettingService.HotkeyHint（默认值是"空 = 不启用"，提示不跟着空）  -->
                    <ui:TextBox
                        x:Name="HotkeyBox"
                        Width="200"
                        HorizontalAlignment="Right" />
                </controls:SettingCard>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource AssistantSettingPage_Prompt}" />
        <Border Style="{StaticResource SettingsGroupBorder}">
            <controls:SettingCard
                Description="{DynamicResource AssistantSettingPage_Prompt_Desc}"
                Icon="BookOpen24"
                Title="{DynamicResource AssistantSettingPage_Prompt}">
                <ui:TextBox
                    x:Name="PromptBox"
                    Width="420"
                    MinHeight="120"
                    MaxHeight="260"
                    AcceptsReturn="True"
                    PlaceholderText="{DynamicResource AssistantSettingPage_Prompt_Tip}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
            </controls:SettingCard>
        </Border>

        <StackPanel
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Primary"
                Click="OnSaveClick"
                Content="{DynamicResource AssistantSettingPage_Save}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</UserControl>
