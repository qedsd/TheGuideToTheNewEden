<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.ItemDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="640"
    d:DesignWidth="760"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ItemDetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ItemDetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  头部：物品图标 + 名称 + 分类  -->
        <Grid
            Grid.Row="0"
            Margin="20,8,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="56"
                Height="56"
                Margin="0,0,14,0"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6">
                <Image
                    Width="48"
                    Height="48"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding IconImage}"
                    Stretch="Uniform" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding CategoryText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <TabControl
            Grid.Row="1"
            Margin="12,0,12,0">

            <!--  概览  -->
            <TabItem Header="{DynamicResource ItemDetail_TabOverview}">
                <ScrollViewer
                    Padding="8,4,8,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />

                        <Border
                            Height="1"
                            Margin="0,10"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_MetaLevel}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding MetaLevelText}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_Volume}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding VolumeText}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_PackagedVolume}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding PackagedVolumeText}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_Mass}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding MassText}" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_Capacity}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding CapacityText}" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_Radius}" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding RadiusText}" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_PortionSize}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding PortionSizeText}" />

                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_BasePrice}" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding BasePriceText}" />

                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_MarketGroup}" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding MarketGroupText}" />

                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="0"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailLabel}"
                                Text="{DynamicResource ItemDetail_TypeId}" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="1"
                                Margin="0,3"
                                Style="{StaticResource ItemDetailValue}"
                                Text="{Binding TypeIdText}"
                                ToolTip="{Binding PublishedText}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  属性（只显示已发布属性）  -->
            <TabItem Header="{DynamicResource ItemDetail_TabAttributes}">
                <Grid Margin="8,4,8,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AttributeGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock
                                            Margin="2,0,0,3"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            FontSize="12.5"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding ToolTip}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            FontSize="12.5"
                                                            Text="{Binding ValueLine}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource ItemDetail_NoAttributes}"
                        Visibility="{Binding HasAttributes, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!--  技能要求（技能名可点击继续查看详情）  -->
            <TabItem Header="{DynamicResource ItemDetail_TabSkills}">
                <Grid Margin="8,4,8,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="12.5"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            controls:ItemLink.TypeId="{Binding TypeId}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            FontSize="12.5"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding LevelText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource ItemDetail_NoSkills}"
                        Visibility="{Binding HasSkills, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!--  底部：居中的「查看市场详情」  -->
        <Border
            x:Name="MarketBar"
            Grid.Row="2"
            Padding="20,10"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <ui:Button
                MinWidth="160"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Click="OnGoMarketClick"
                Content="{DynamicResource ItemDetail_GoMarket}" />
        </Border>
    </Grid>
</UserControl>
