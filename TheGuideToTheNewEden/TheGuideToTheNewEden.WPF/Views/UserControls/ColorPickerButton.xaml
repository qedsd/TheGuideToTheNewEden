<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.ColorPickerButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:pickers="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        通用"颜色按钮"：一排显示 色块 + #AARRGGBB，点开弹层复用已有的 ColorPickerView
        （ARGB 滑杆 / 数值 + HEX 输入，见阶段 135）。

        为什么做成控件而不是每行各写一遍：多开页有 4 个颜色设置，别的页面以后也会有；
        颜色值是 Core 的 System.Drawing.Color，与 PreviewItem 的属性同类型，可直接 TwoWay 绑定。
    -->
    <UserControl.Resources>
        <conv:ColorToBrushConverter x:Key="ColorBrush" />
        <conv:ColorHexConverter x:Key="ColorHex" />

        <!--  透明度棋盘底：半透明颜色压在深色主题上也能看出"有色但透"  -->
        <DrawingBrush
            x:Key="CheckerBrush"
            TileMode="Tile"
            Viewport="0,0,8,8"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF6E6E6E" Geometry="M0,0 H8 V8 H0 Z" />
                    <GeometryDrawing Brush="#FFA8A8A8" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <ui:Button
            x:Name="OpenButton"
            MinWidth="132"
            MinHeight="30"
            Padding="8,3"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Stretch"
            Appearance="Secondary"
            AutomationProperties.Name="{DynamicResource GamePreviewPage_PickColor}"
            Click="OnOpenClick"
            ToolTip="{DynamicResource GamePreviewPage_PickColor}">
            <StackPanel Orientation="Horizontal">
                <Grid
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center">
                    <Border Background="{StaticResource CheckerBrush}" CornerRadius="3" />
                    <Border
                        Background="{Binding Color, ElementName=Root, Converter={StaticResource ColorBrush}}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3" />
                </Grid>
                <TextBlock
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Color, ElementName=Root, Converter={StaticResource ColorHex}}" />
                <ui:SymbolIcon
                    Margin="7,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="Color24" />
            </StackPanel>
        </ui:Button>

        <Popup
            x:Name="PickerPopup"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=OpenButton}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                Margin="0,6,0,0"
                Padding="12"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Direction="270"
                        Opacity="0.18"
                        ShadowDepth="3"
                        Color="#000000" />
                </Border.Effect>
                <StackPanel Width="286">
                    <pickers:ColorPickerView x:Name="Picker" ColorChanged="OnPickerColorChanged" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource GamePreviewPage_PickColorTip}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            Appearance="Primary"
                            Click="OnCloseClick"
                            Content="{DynamicResource General_Close}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
