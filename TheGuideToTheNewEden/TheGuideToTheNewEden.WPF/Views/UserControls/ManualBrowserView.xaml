<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.ManualBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：搜索 + 手册列表  -->
        <Grid Grid.Column="0" Margin="12,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox
                x:Name="SearchBox"
                Grid.Row="0"
                PlaceholderText="{DynamicResource Manual.Search.Placeholder}"
                TextChanged="OnSearchTextChanged" />

            <ListBox
                x:Name="ManualList"
                Grid.Row="1"
                Margin="0,8,0,0"
                BorderThickness="0"
                SelectionChanged="OnManualSelectionChanged"
                VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3" MinWidth="240">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Id}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="4"
            Margin="8,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Transparent" />

        <!--  右：正文（自写渲染器；manual: 内链会打开对应手册）  -->
        <Grid Grid.Column="2" Margin="4,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        x:Name="ManualTitle"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ManualSubTitle"
                        FontSize="11.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <!--  界面语言没有对应手册、正在显示回退语言（zh-CN）时的提示；不静默  -->
                    <TextBlock
                        x:Name="FallbackHint"
                        Margin="0,4,0,0"
                        FontSize="11.5"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{DynamicResource Manual.FallbackToZh}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  工具条：问助手 / 复制正文 / 打开 md 文件；「返回全文」只在看单节时出现  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="12,2,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <ui:Button
                        Click="OnAskAssistantClick"
                        Content="{DynamicResource Manual.AskAssistant}"
                        Icon="{ui:SymbolIcon Sparkle24}"
                        ToolTip="{DynamicResource Manual.AskAssistant}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="OnCopyClick"
                        Content="{DynamicResource Manual.Copy}"
                        Icon="{ui:SymbolIcon Copy24}"
                        ToolTip="{DynamicResource Manual.Copy}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="OnOpenFileClick"
                        Content="{DynamicResource Manual.OpenFile}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        ToolTip="{DynamicResource Manual.OpenFile}" />
                    <ui:Button
                        x:Name="BackToFullButton"
                        Margin="8,0,0,0"
                        Click="OnBackToFullClick"
                        Content="{DynamicResource Manual.ShowAll}"
                        Icon="{ui:SymbolIcon DocumentText24}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <controls:MarkdownPresenter
                    x:Name="BodyPresenter"
                    Margin="4,0,0,0"
                    IsReadOnly="True"
                    IsDocumentEnabled="True" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
