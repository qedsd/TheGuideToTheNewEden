<UserControl
    x:Class="TheGuideToTheNewEden.WPF.Views.UserControls.CompareMarketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="RootView"
    Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="CompareCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="CompareNumberCellStyle"
            BasedOn="{StaticResource CompareCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="CompareFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="CompareSummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompareSummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CompareTipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="CompareWarningText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：市场 / 卖出物品 / 买入物品 / 价格口径 ============  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">
                <!--  市场（可多个：星域 / 星系 / 建筑）  -->
                <TabItem Header="{DynamicResource CompareMarketPage_Markets}">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MarketSlots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <uc:MarketLocationSelectorView SelectedItem="{Binding Location, Mode=TwoWay}" />
                                            <ui:Button
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Appearance="Transparent"
                                                Click="OnRemoveMarketClick"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                ToolTip="{DynamicResource CompareMarketPage_RemoveMarket}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ui:Button
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Click="OnAddMarketClick"
                            Content="{DynamicResource CompareMarketPage_AddMarket}"
                            Icon="{ui:SymbolIcon Add24}" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CompareTipText}"
                            Text="{DynamicResource CompareMarketPage_MarketLimitTip}" />
                    </Grid>
                </TabItem>

                <!--  卖出物品：编辑清单（数量可改），添加/导入走弹出层  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource CompareMarketPage_SellGroup}" />
                            <TextBlock Margin="6,0,0,0" Text="{Binding SellCount, StringFormat={}({0})}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Click="OnSellAddClick"
                                Content="{DynamicResource CompareMarketPage_AddItem}"
                                Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="OnSellImportClick"
                                Content="{DynamicResource CompareMarketPage_PasteImport}"
                                Icon="{ui:SymbolIcon ClipboardPaste24}" />
                        </Grid>
                        <ui:DataGrid
                            x:Name="SellItemsGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="False"
                            ItemsSource="{Binding SellItems}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnSellItemsRemoveClick" Header="{DynamicResource CompareMarketPage_RemoveFromList}" />
                                    <MenuItem Click="OnSellItemsMoveToBuyClick" Header="{DynamicResource CompareMarketPage_MoveToBuy}" />
                                </ContextMenu>
                            </ui:DataGrid.ContextMenu>
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    ElementStyle="{StaticResource CompareCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColItem}"
                                    IsReadOnly="True" />
                                <!--  数量列是清单里唯一可编辑的列；绑定不要加 StringFormat（TwoWay 下写回解析不可靠）  -->
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Amount}"
                                    ElementStyle="{StaticResource CompareNumberCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColAmount}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Volume, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource CompareNumberCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColVolume}"
                                    IsReadOnly="True" />
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserResize="False"
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Margin="2"
                                                Padding="4"
                                                Appearance="Transparent"
                                                Click="OnRemoveSellItemClick"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                ToolTip="{DynamicResource CompareMarketPage_RemoveFromList}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </Grid>
                </TabItem>

                <!--  买入物品：同上  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource CompareMarketPage_BuyGroup}" />
                            <TextBlock Margin="6,0,0,0" Text="{Binding BuyCount, StringFormat={}({0})}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Click="OnBuyAddClick"
                                Content="{DynamicResource CompareMarketPage_AddItem}"
                                Icon="{ui:SymbolIcon Add24}" />
                            <ui:Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="OnBuyImportClick"
                                Content="{DynamicResource CompareMarketPage_PasteImport}"
                                Icon="{ui:SymbolIcon ClipboardPaste24}" />
                        </Grid>
                        <ui:DataGrid
                            x:Name="BuyItemsGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="False"
                            ItemsSource="{Binding BuyItems}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnBuyItemsRemoveClick" Header="{DynamicResource CompareMarketPage_RemoveFromList}" />
                                    <MenuItem Click="OnBuyItemsMoveToSellClick" Header="{DynamicResource CompareMarketPage_MoveToSell}" />
                                </ContextMenu>
                            </ui:DataGrid.ContextMenu>
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    ElementStyle="{StaticResource CompareCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColItem}"
                                    IsReadOnly="True" />
                                <!--  数量列是清单里唯一可编辑的列；绑定不要加 StringFormat（TwoWay 下写回解析不可靠）  -->
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Amount}"
                                    ElementStyle="{StaticResource CompareNumberCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColAmount}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Volume, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource CompareNumberCellStyle}"
                                    Header="{DynamicResource CompareMarketPage_ColVolume}"
                                    IsReadOnly="True" />
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserResize="False"
                                    IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Margin="2"
                                                Padding="4"
                                                Appearance="Transparent"
                                                Click="OnRemoveBuyItemClick"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                ToolTip="{DynamicResource CompareMarketPage_RemoveFromList}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </Grid>
                </TabItem>

                <!--  价格口径与成交方式  -->
                <TabItem Header="{DynamicResource CompareMarketPage_PriceSetting}">
                    <ScrollViewer
                        Margin="0,6,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{DynamicResource CompareMarketPage_SellPriceBasis}" />
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding SellPriceBasisIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop5}" />
                                <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop}" />
                                <ComboBoxItem Content="{DynamicResource BusinessPage_SellAvailable}" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{DynamicResource CompareMarketPage_BuyPriceBasis}" />
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding BuyPriceBasisIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop5}" />
                                <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop}" />
                                <ComboBoxItem Content="{DynamicResource BusinessPage_BuyAvailable}" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{DynamicResource CompareMarketPage_SellMethod}" />
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding SellModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource CompareMarketPage_SellByOrder}" />
                                <ComboBoxItem Content="{DynamicResource CompareMarketPage_SellToBuyOrder}" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{DynamicResource CompareMarketPage_BuyMethod}" />
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding BuyModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource CompareMarketPage_BuyFromSellOrder}" />
                                <ComboBoxItem Content="{DynamicResource CompareMarketPage_BuyByOrder}" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{DynamicResource CompareMarketPage_SellTax}" />
                            <ui:NumberBox
                                Maximum="100"
                                Minimum="0"
                                SmallChange="0.5"
                                Value="{Binding SellTaxPercent, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CompareTipText}" Text="{DynamicResource CompareMarketPage_SellTaxTip}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ui:Button
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Click="OnCalculateClick"
                Content="{DynamicResource CompareMarketPage_Start}"
                IsEnabled="{Binding IsNotBusy}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!--  ============ 右：汇总 / 建议 / 警告 / 结果 ============  -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  汇总条（两行 3 列：18 位长数字五个挤一行会被截断）  -->
            <controls:CardControl Grid.Row="0" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4,0">
                        <TextBlock Style="{StaticResource CompareSummaryLabel}" Text="{DynamicResource CompareMarketPage_TotalIncome}" />
                        <TextBlock Style="{StaticResource CompareSummaryValue}" Text="{Binding TotalIncome, StringFormat={}{0:N2}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0">
                        <TextBlock Style="{StaticResource CompareSummaryLabel}" Text="{DynamicResource CompareMarketPage_TotalExpense}" />
                        <TextBlock Style="{StaticResource CompareSummaryValue}" Text="{Binding TotalExpense, StringFormat={}{0:N2}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4,0">
                        <TextBlock Style="{StaticResource CompareSummaryLabel}" Text="{DynamicResource CompareMarketPage_NetAmount}" />
                        <TextBlock Style="{StaticResource CompareSummaryValue}" Text="{Binding NetAmount, StringFormat={}{0:N2}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4,8,4,0">
                        <TextBlock Style="{StaticResource CompareSummaryLabel}" Text="{DynamicResource CompareMarketPage_TotalVolume}" />
                        <TextBlock Style="{StaticResource CompareSummaryValue}" Text="{Binding TotalVolume, StringFormat={}{0:N2}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,8,4,0">
                        <TextBlock Style="{StaticResource CompareSummaryLabel}" Text="{DynamicResource CompareMarketPage_NoQuoteCount}" />
                        <TextBlock Style="{StaticResource CompareSummaryValue}" Text="{Binding NoQuoteCount}" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <!--  警告条  -->
            <controls:CardControl
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10,8"
                Visibility="{Binding IsWarningVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Row="0"
                        Grid.Column="0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Symbol="Warning24"
                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CompareWarningText}"
                        Text="{Binding FailureText}"
                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}" />

                    <!--  原「无报价物品」一行已按用户要求移除（Row 1 保留为空行，故后续元素的行号不连续，属有意为之）  -->

                    <ui:SymbolIcon
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24"
                        Visibility="{Binding HasUnresolved, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="6,4,0,0"
                        Style="{StaticResource CompareWarningText}"
                        Text="{Binding UnresolvedText}"
                        Visibility="{Binding HasUnresolved, Converter={StaticResource BoolToVis}}" />

                    <ui:SymbolIcon
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="ArrowSync24"
                        Visibility="{Binding IsResultStale, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="6,4,0,0"
                        Style="{StaticResource CompareWarningText}"
                        Text="{DynamicResource CompareMarketPage_StaleResult}"
                        Visibility="{Binding IsResultStale, Converter={StaticResource BoolToVis}}" />

                    <ui:SymbolIcon
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Info24"
                        Visibility="{Binding IsSingleMarketHint, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="6,4,0,0"
                        Style="{StaticResource CompareWarningText}"
                        Text="{DynamicResource CompareMarketPage_SingleMarketHint}"
                        Visibility="{Binding IsSingleMarketHint, Converter={StaticResource BoolToVis}}" />
                    <!--  关闭按钮放右端：关掉后重新点「开始计算」会再次显示  -->
                    <ui:Button
                        Grid.Row="0"
                        Grid.RowSpan="5"
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="4"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        Click="OnDismissWarningClick"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{DynamicResource CompareMarketPage_Dismiss}" />
                </Grid>
            </controls:CardControl>

            <!--  结果：外层 卖出 / 买入，内层 全部 / 各市场（列在结果控件里构造）  -->
            <TabControl Grid.Row="4" Margin="0,8,0,0">
                <TabItem Header="{Binding SellResultHeader}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <uc:CompareMarketResultView
                            x:Name="SellResultView"
                            IsSellSide="True"
                            MarketNames="{Binding MarketNames}"
                            Tabs="{Binding SellResultTabs}" />
                        <!--  底部：分散 vs 集中在最优单一市场的差额（数值 + 百分比，不用自然语言建议）  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="10,6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasSellGain, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SellGainLabel}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding SellGain, StringFormat={}{0:N0}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Text="{Binding SellGainPercent, StringFormat={}{0:N2}%}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding BuyResultHeader}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <uc:CompareMarketResultView
                            x:Name="BuyResultView"
                            IsSellSide="False"
                            MarketNames="{Binding MarketNames}"
                            Tabs="{Binding BuyResultTabs}" />
                        <!--  底部：分散 vs 集中在最优单一市场的差额（数值 + 百分比）  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="10,6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasBuyGain, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding BuyGainLabel}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding BuyGain, StringFormat={}{0:N0}}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Text="{Binding BuyGainPercent, StringFormat={}{0:N2}%}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!--  ============ 添加物品（两个清单页签共用，目标组由打开它的按钮决定）  ============  -->
        <Popup
            x:Name="AddItemPopup"
            AllowsTransparency="True"
            Placement="Bottom"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                Width="460"
                Height="460"
                Margin="0,4,0,0"
                Style="{StaticResource AccentFlyoutBorder}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--
                        弹出层不在可视树里：绑定一律显式指向根控件的 DataContext，不要依赖继承。
                        "加入清单"按钮放在标题行（不是底部）：弹层贴屏幕边缘时底部会被裁，按钮放顶部永远可见。
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{Binding DataContext.AddTargetTitle, ElementName=RootView}" />
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Primary"
                            Click="OnAddSelectedClick"
                            Content="{Binding DataContext.AddToListText, ElementName=RootView}" />
                    </Grid>
                    <uc:MarketSelecteTreeView
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        SelectedItems="{Binding DataContext.TreeSelected, ElementName=RootView, Mode=TwoWay}" />
                </Grid>
            </Border>
        </Popup>

        <!--  ============ 粘贴导入（两个清单页签共用）  ============  -->
        <Popup
            x:Name="PastePopup"
            AllowsTransparency="True"
            Placement="Bottom"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                Width="440"
                Height="320"
                Margin="0,4,0,0"
                Style="{StaticResource AccentFlyoutBorder}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  同上：按钮放标题行，避免弹层贴屏幕边缘时底部被裁  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CompareFieldLabel}" Text="{Binding DataContext.PasteTargetTitle, ElementName=RootView}" />
                        <ui:Button
                            Grid.Column="1"
                            Appearance="Primary"
                            Click="OnImportPasteClick"
                            Content="{DynamicResource CompareMarketPage_Import}" />
                    </Grid>
                    <ui:TextBox
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AcceptsReturn="True"
                        PlaceholderText="{DynamicResource CompareMarketPage_PasteHint}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{Binding DataContext.PasteText, ElementName=RootView, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Popup>

        <!--
            ============ 页内等待遮罩 ============
            比价取数只用**本功能内部**的等待（§9 第 39 条）：只盖住本功能页并拦截点击，
            不会像全局 WaitingOverlay 那样遮住整个应用；完成/失败仍走右下角非阻塞通知。
        -->
        <Border
            Grid.ColumnSpan="2"
            Background="{DynamicResource SmokeFillColorDefaultBrush}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border
                Width="300"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <controls:SpinnerIcon
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        IsActive="{Binding IsBusy}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding BusyText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Click="OnCancelClick"
                        Content="{DynamicResource General_Cancel}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
