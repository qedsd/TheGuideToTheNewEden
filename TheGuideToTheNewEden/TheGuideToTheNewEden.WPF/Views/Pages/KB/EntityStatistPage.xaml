<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.KB.EntityStatistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:kbControls="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.KB"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:UrlToImageConverter x:Key="UrlImage" />
        <converters:IskConverter x:Key="Isk" />
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="StatCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="StatNumberCell"
            BasedOn="{StaticResource StatCell}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!--  概况统计块的标签/数值（同 WinUI：12px 细体标签居中、18px 数值居中）  -->
        <Style x:Key="StatName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Thin" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style
            x:Key="StatGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource FluentDataGridRowStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <DataTemplate x:Key="RankCardTemplate">
            <kbControls:KillRankCard
                Margin="0,0,8,8"
                Clicked="OnRankCardClicked"
                Item="{Binding}" />
        </DataTemplate>

        <!--  最高击杀：一个分组  -->
        <DataTemplate x:Key="TopAllTimeGroupTemplate">
            <Expander
                Margin="0,2"
                Background="Transparent"
                Header="{Binding Title}"
                IsExpanded="True">
                <ItemsControl
                    Margin="4"
                    ItemTemplate="{StaticResource RankCardTemplate}"
                    ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <!--  实体信息行：标签（宽 80 细体）+ 值；值带 Link 时渲染成链接样式、点击打开该实体（同 WinUI）  -->
        <DataTemplate x:Key="EntityRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Light"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />
                <ui:Button
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInfoLinkClick"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Padding="0"
                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                </ui:Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Value}"
                    Visibility="{Binding HasLink, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：实体概况（布局与 WinUI 实体统计页一致：信息卡 + 统计卡） ============  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  卡 1：实体信息（圆形头像 + 名称 + 浏览器打开 + 可点击信息行）  -->
                <controls:CardControl>
                    <StackPanel>
                        <Border
                            Width="100"
                            Height="100"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            CornerRadius="999"
                            Visibility="{Binding AvatarUrl, Converter={StaticResource StringToVis}}">
                            <Image Source="{Binding AvatarUrl, Converter={StaticResource UrlImage}}" Stretch="Fill" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource KBListControl_OpenBrowser}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnOpenInBrowserClick"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Icon="{ui:SymbolIcon Open24}"
                                Padding="0"
                                ToolTip="{DynamicResource KBListControl_OpenBrowser}" />
                        </Grid>

                        <ItemsControl
                            Margin="0,8,0,0"
                            ItemTemplate="{StaticResource EntityRowTemplate}"
                            ItemsSource="{Binding InfoRows}" />
                    </StackPanel>
                </controls:CardControl>

                <!--  卡 2：统计概览（危险/抱团细条 + 击杀/损失/点数 + 单杀，同 WinUI）  -->
                <controls:CardControl Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  危险系数  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Thin"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource EntityStatistPage_DangerRatio}" />
                            <controls:RatioBar
                                Grid.Column="1"
                                Height="2"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"
                                BarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                Ratio="{Binding DangerRatio}"
                                TrackBrush="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding DangerRatio}" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="1,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="%" />

                            <!--  抱团概率  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center"
                                FontWeight="Thin"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource EntityStatistPage_GangRatio}" />
                            <controls:RatioBar
                                Grid.Row="1"
                                Grid.Column="1"
                                Height="2"
                                Margin="12,10,8,0"
                                VerticalAlignment="Center"
                                BarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                Ratio="{Binding GangRatio}"
                                TrackBrush="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,10,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding GangRatio}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="1,10,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="%" />
                        </Grid>

                        <!--  击杀 / 损失 / 点数 + 单杀（3 列，绿=击杀 红=损失，同 WinUI）  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource StatName}" Text="{DynamicResource StatistMonthPage_ItemDestroyed}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource StatName}"
                                Text="{DynamicResource StatistMonthPage_IskDestroyed}" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource StatName}"
                                Text="{DynamicResource StatistMonthPage_PointsDestroyed}" />

                            <TextBlock
                                Grid.Row="1"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding ItemDestroyed}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding IskDestroyedText}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding PointsDestroyed}" />

                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource StatName}"
                                Text="{DynamicResource StatistMonthPage_ItemLost}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource StatName}"
                                Text="{DynamicResource StatistMonthPage_IskLost}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource StatName}"
                                Text="{DynamicResource StatistMonthPage_PointsLost}" />

                            <TextBlock
                                Grid.Row="4"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding ItemLost}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding IskLostText}" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource StatValue}"
                                Text="{Binding PointsLost}" />

                            <Grid Grid.Row="6" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StatName}" Text="{DynamicResource StatistMonthPage_SoloDestroyed}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource StatName}"
                                    Text="{DynamicResource StatistMonthPage_SoloLost}" />
                            </Grid>

                            <Grid Grid.Row="7" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding SoloKills}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding SoloLosses}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </controls:CardControl>
            </StackPanel>
        </ScrollViewer>

        <!--  ============ 右：统计子页签 ============  -->
        <TabControl
            x:Name="StatTabs"
            Grid.Column="1"
            Background="Transparent"
            SelectionChanged="OnTabSelectionChanged">

            <!--  KB 列表  -->
            <TabItem Header="{DynamicResource EntityStatistPage_KBList}" Tag="kb">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource StatistKBListPage_KBModifier}" />
                        <ComboBox
                            Width="140"
                            DisplayMemberPath="Label"
                            ItemsSource="{Binding ModifierOptions}"
                            SelectedIndex="{Binding ModifierIndex, Mode=TwoWay}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{DynamicResource General_Refresh}"
                            Click="OnRefreshKillListClick"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="{DynamicResource General_Refresh}" />
                    </StackPanel>

                    <kbControls:KillListControl
                        x:Name="KillList"
                        Grid.Row="1"
                        EntityClicked="OnListEntityClicked"
                        ItemsSource="{Binding Killmails}"
                        OpenKillmail="OnListOpenKillmail" />

                    <controls:PagerControl
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        HasNext="{Binding HasNext}"
                        Page="{Binding Page}"
                        PageChanged="OnKillListPageChanged" />
                </Grid>
            </TabItem>

            <!--  最贵击杀  -->
            <TabItem Header="{DynamicResource EntityStatistPage_TopValue}" Tag="topvalue">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource StatistTopValuePage_TopAllTime}" />
                        <ItemsControl ItemTemplate="{StaticResource RankCardTemplate}" ItemsSource="{Binding TopValueAllTime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,12,0,6"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource StatistTopValuePage_Top7dDays}" />
                        <ItemsControl ItemTemplate="{StaticResource RankCardTemplate}" ItemsSource="{Binding TopValue7Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  最高击杀  -->
            <TabItem Header="{DynamicResource EntityStatistPage_TopStatist}" Tag="topalltime">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="0,6,0,0"
                        ItemTemplate="{StaticResource TopAllTimeGroupTemplate}"
                        ItemsSource="{Binding TopAllTime}" />
                </ScrollViewer>
            </TabItem>

            <!--  分类统计  -->
            <TabItem Header="{DynamicResource EntityStatistPage_GroupSummary}" Tag="group">
                <ScrollViewer
                    Margin="0,6,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <ui:DataGrid
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        ItemsSource="{Binding Groups}"
                        Style="{StaticResource StatGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding No}"
                                ElementStyle="{StaticResource StatCell}"
                                Header="{DynamicResource StatistGroupPage_No}" />
                            <DataGridTextColumn
                                Width="240"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource StatCell}"
                                Header="{DynamicResource EntityStatistPage_Class}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ItemDestroyed}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistGroupPage_Kills}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding IskDestroyed, Converter={StaticResource Isk}}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_IskDestroyed}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ItemLost}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistGroupPage_Losses}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding IskLost, Converter={StaticResource Isk}}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_IskLost}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </ScrollViewer>
            </TabItem>

            <!--  月份统计  -->
            <TabItem Header="{DynamicResource EntityStatistPage_MonthSummary}" Tag="month">
                <ScrollViewer
                    Margin="0,6,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <ui:DataGrid
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        ItemsSource="{Binding Months}"
                        Style="{StaticResource StatGridStyle}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Year}"
                                ElementStyle="{StaticResource StatCell}"
                                Header="{DynamicResource StatistMonthPage_Year}" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Month}"
                                ElementStyle="{StaticResource StatCell}"
                                Header="{DynamicResource StatistMonthPage_Month}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ItemDestroyed}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_ItemDestroyed}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding PointsDestroyed}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_PointsDestroyed}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding IskDestroyed, Converter={StaticResource Isk}}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_IskDestroyed}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ItemLost}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_ItemLost}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding PointsLost}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_PointsLost}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding IskLost, Converter={StaticResource Isk}}"
                                ElementStyle="{StaticResource StatNumberCell}"
                                Header="{DynamicResource StatistMonthPage_IskLost}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </ScrollViewer>
            </TabItem>

            <!--  超期击杀  -->
            <TabItem
                Header="{DynamicResource EntityStatistPage_SupperSummary}"
                Tag="super"
                Visibility="{Binding HasSupers, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">
                        <Expander
                            Margin="0,2"
                            Background="Transparent"
                            Header="{DynamicResource StatistSuperPage_Titan}"
                            IsExpanded="True">
                            <ItemsControl ItemTemplate="{StaticResource RankCardTemplate}" ItemsSource="{Binding Titans}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                        <Expander
                            Margin="0,2"
                            Background="Transparent"
                            Header="{DynamicResource StatistSuperPage_Supercarrier}"
                            IsExpanded="True">
                            <ItemsControl ItemTemplate="{StaticResource RankCardTemplate}" ItemsSource="{Binding Supercarriers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  ============ 页面局部等待遮罩：每个实体标签独立显示 ============
              实体页支持多开并发加载，不走全局 WaitingOverlay（否则会误遮其他实体标签）；
              遮罩只盖住本页并拦截点击，视觉与全局等待一致（半透明 + 卡片 + 自绘旋转图标）。  -->
        <Border
            Grid.ColumnSpan="2"
            Background="{DynamicResource SmokeFillColorDefaultBrush}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border
                Width="280"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <controls:SpinnerIcon
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        IsActive="{Binding IsBusy}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding BusyText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
