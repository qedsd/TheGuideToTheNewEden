<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.KB.KillStreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:kbControls="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.KB"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <!--  整页一张卡：Header=标题 + 连接状态点 + 过滤计数；Footer=连接/断开/清空/设置；设置经弹窗打开  -->
    <controls:CardControl>
        <!--  ============ 内容区 ============  -->
        <Grid>
            <!--  未连接  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource ZKBHomePage_DisconnectTip}"
                Visibility="{Binding ShowDisconnectedHint, Converter={StaticResource BoolToVis}}" />

            <!--  连接中：页内局部等待（IsConnecting 驱动，不走全局遮罩）  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                <controls:SpinnerIcon
                    HorizontalAlignment="Center"
                    FontSize="34"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    IsActive="{Binding IsConnecting}" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource ZKBHomePage_ConnectingToWSS}" />
            </StackPanel>

            <!--  已连接：筛选 KB / 已过滤 KB  -->
            <TabControl Background="Transparent" Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <TabItem Header="{DynamicResource ZKBHomePage_MatchedKB}">
                    <kbControls:KillListControl
                        x:Name="MatchedList"
                        EntityClicked="OnListEntityClicked"
                        ItemsSource="{Binding KBItemInfos}"
                        OpenKillmail="OnListOpenKillmail" />
                </TabItem>
                <TabItem Header="{DynamicResource ZKBHomePage_FilteredOutKB}">
                    <kbControls:KillListControl
                        x:Name="FilteredList"
                        EntityClicked="OnListEntityClicked"
                        ItemsSource="{Binding FilteredOutKBItemInfos}"
                        OpenKillmail="OnListOpenKillmail" />
                </TabItem>
            </TabControl>
            <!--  匹配数 / 总数  -->
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,6,0"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Filter24" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding PassedCount}"
                    ToolTip="{DynamicResource ZKBHomePage_MatchedCount}" />
                <TextBlock
                    Margin="4,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="/" />
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TotalReceivedCount}"
                    ToolTip="{DynamicResource ZKBHomePage_TotalReceivedCount}" />
            </StackPanel>
        </Grid>

        <!--  ============ Footer：操作按钮 ============  -->
        <controls:CardControl.Footer>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    AutomationProperties.Name="{DynamicResource ZKBHomePage_Connect}"
                    Click="OnConnectClick"
                    FontSize="16"
                    Icon="{ui:SymbolIcon Play24}"
                    ToolTip="{DynamicResource ZKBHomePage_Connect}"
                    Visibility="{Binding ShowDisconnectedHint, Converter={StaticResource BoolToVis}}" />
                <ui:Button
                    Margin="0,0,6,0"
                    AutomationProperties.Name="{DynamicResource ZKBHomePage_Disconnect}"
                    Click="OnDisconnectClick"
                    FontSize="16"
                    ToolTip="{DynamicResource ZKBHomePage_Disconnect}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="0,0,6,0"
                    AutomationProperties.Name="{DynamicResource General_Clear}"
                    Click="OnClearClick"
                    FontSize="16"
                    Icon="{ui:SymbolIcon DismissCircle24}"
                    ToolTip="{DynamicResource General_Clear}" />
                <ui:Button
                    AutomationProperties.Name="{DynamicResource General_Setting}"
                    Click="OnSettingClick"
                    FontSize="16"
                    Icon="{ui:SymbolIcon Settings24}"
                    ToolTip="{DynamicResource General_Setting}" />
            </StackPanel>
        </controls:CardControl.Footer>
    </controls:CardControl>
</Page>
