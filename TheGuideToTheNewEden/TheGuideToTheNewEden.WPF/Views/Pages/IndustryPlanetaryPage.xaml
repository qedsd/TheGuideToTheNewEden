<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryPlanetaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TheGuideToTheNewEden.WPF.ViewModels.Industry"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PlanetaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="PlanetaryMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PlanetaryMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style
            x:Key="PlanetaryDataGrid"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style
            x:Key="PlanetaryListItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style
            x:Key="PlanetaryNodeListItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <DataTemplate x:Key="PlanetaryFacilityNodeTemplate" DataType="{x:Type vm:PlanetaryFacilityNode}">
            <Border
                Margin="0,2,4,2"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6"
                ToolTip="{Binding MetaText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="FacilityAccent"
                        Grid.Column="0"
                        CornerRadius="3,0,0,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFactory}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExtractor}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStorage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid
                        Grid.Column="1"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <ui:SymbolIcon
                            x:Name="FacilityIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="Settings24" />
                    </Grid>

                    <StackPanel Grid.Column="2" Margin="0,6,8,6">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Role, Converter={StaticResource IndustryRoleName}}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="3"
                        Margin="0,6,10,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding MetaText}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFactory}" Value="True">
                    <Setter TargetName="FacilityIcon" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="FacilityIcon" Property="Symbol" Value="Wrench24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExtractor}" Value="True">
                    <Setter TargetName="FacilityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="FacilityIcon" Property="Symbol" Value="ArrowDownload24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStorage}" Value="True">
                    <Setter TargetName="FacilityIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="FacilityIcon" Property="Symbol" Value="Database24" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryProductNodeTemplate" DataType="{x:Type vm:PlanetaryProductNodeViewModel}">
            <Grid Margin="{Binding IndentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="OnToggleProductNodeClick"
                    Tag="{Binding}"
                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronDown24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronRight24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </ui:Button>

                <Border
                    Grid.Column="1"
                    Margin="0,2,4,2"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTip="{Binding TooltipText}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="ProductAccent"
                            Grid.Column="0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            CornerRadius="3,0,0,3" />

                        <Grid
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <ui:SymbolIcon
                                x:Name="ProductIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Symbol="Target24" />
                        </Grid>

                        <StackPanel Grid.Column="2" Margin="0,5,8,5">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    MinWidth="26"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding TierText}" />
                                </Border>
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    x:Name="DecisionChip"
                                    Margin="7,0,0,0"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        x:Name="DecisionLabel"
                                        FontSize="9.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DecisionText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding MetaText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasMetaText, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding InputsText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasInputsText, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="3"
                            Margin="0,5,10,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding RequiredText}" />
                    </Grid>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBuild}" Value="True">
                    <Setter TargetName="ProductAccent" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="ProductIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="ProductIcon" Property="Symbol" Value="Wrench24" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImport}" Value="True">
                    <Setter TargetName="ProductAccent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="ProductIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="ProductIcon" Property="Symbol" Value="Database24" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRaw}" Value="True">
                    <Setter TargetName="ProductAccent" Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="ProductIcon" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="ProductIcon" Property="Symbol" Value="ArrowDownload24" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryProductTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="28"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="3">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TierText}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryBlueprintTemplate">
            <StackPanel Margin="2,2">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ProductName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding BlueprintName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryTargetTemplate">
            <Border
                Margin="0,2"
                Padding="8,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:NumberBox
                        Grid.Column="1"
                        Margin="6,0"
                        MaxDecimalPlaces="0"
                        Maximum="1000000"
                        Minimum="1"
                        SmallChange="1"
                        Value="{Binding Quantity, Mode=TwoWay}" />
                    <ui:Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Appearance="Transparent"
                        Click="OnRemoveTargetClick"
                        Icon="{ui:SymbolIcon Delete24}"
                        Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryLiveExtractorTemplate">
            <Border
                Margin="0,2"
                Padding="8,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ProductName}" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding QuantityText}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding CycleText}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding HeadsText}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding RemainingText}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Text="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryLiveFactoryTemplate">
            <Border
                Margin="0,2"
                Padding="8,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ProductName}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding CycleText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding InputsLabel}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Count, StringFormat=×{0}}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="10"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{Binding OutputText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryLivePlanetTemplate">
            <controls:CardControl
                Margin="0,0,0,10"
                Padding="14,8"
                CornerRadius="8">
                <controls:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Header}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding SubHeader}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding LastUpdateText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{Binding AlertText}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </controls:CardControl.Header>
                <StackPanel>
                    <TextBlock
                        Margin="0,3,0,1"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IndustryPlanetary_RoleExtractor}"
                        Visibility="{Binding HasExtractors, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl
                        ItemTemplate="{StaticResource PlanetaryLiveExtractorTemplate}"
                        ItemsSource="{Binding Extractors}"
                        Visibility="{Binding HasExtractors, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,6,0,1"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IndustryPlanetary_RoleFactory}"
                        Visibility="{Binding HasFactories, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl
                        ItemTemplate="{StaticResource PlanetaryLiveFactoryTemplate}"
                        ItemsSource="{Binding Factories}"
                        Visibility="{Binding HasFactories, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPlanetary_Stock}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StorageText}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPlanetary_Import}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding ImportsText}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPlanetary_Export}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                            Text="{Binding ExportsText}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </controls:CardControl>
        </DataTemplate>

        <DataTemplate x:Key="PlanetaryCharacterTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    VerticalAlignment="Center"
                    Content="{Binding DisplayName}"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                <ui:NumberBox
                    Grid.Column="1"
                    Margin="4,0"
                    ClearButtonEnabled="False"
                    Maximum="5"
                    Minimum="0"
                    SmallChange="1"
                    ToolTip="{DynamicResource IndustryPlanetary_CcuTip}"
                    Value="{Binding CcuLevel, Mode=TwoWay}" />
                <ui:NumberBox
                    Grid.Column="2"
                    Margin="4,0"
                    ClearButtonEnabled="False"
                    Maximum="6"
                    Minimum="1"
                    SmallChange="1"
                    ToolTip="{DynamicResource IndustryPlanetary_PlanetSlotsTip}"
                    Value="{Binding MaxPlanets, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <TabControl
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            SelectedIndex="{Binding SectionTabIndex, Mode=TwoWay}"
            SelectionChanged="OnSectionTabChanged">

            <!--  ================= 我的殖民地 =================  -->
            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Colonies}">
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:CardControl
                            Grid.Column="0"
                            Padding="10,8"
                            CornerRadius="8">
                            <controls:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="People16" />
                                    <TextBlock
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource IndustryPlanetary_Col_Character}" />
                                </StackPanel>
                            </controls:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox
                                    Grid.Row="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                    ItemsSource="{Binding LiveCharacters}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectedItem="{Binding SelectedLiveCharacter, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding CharacterName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding ColonyCountText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="2,8,2,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding LiveCharacterSummaryText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </controls:CardControl>

                        <controls:CardControl
                            Grid.Column="2"
                            Padding="10,8"
                            CornerRadius="8">
                            <controls:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="AppsList24" />
                                    <TextBlock
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource IndustryPlanetary_Colonies}" />
                                </StackPanel>
                            </controls:CardControl.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox
                                    Grid.Row="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                    ItemsSource="{Binding SelectedLiveCharacter.Colonies}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectedItem="{Binding SelectedLiveColony, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding PlanetName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="9.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding SubHeader}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Summary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="2,8,2,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding SelectedCharacterSummaryText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </controls:CardControl>

                        <Grid Grid.Column="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource IndustryPlanetary_SelectColonyHint}"
                                Visibility="{Binding HasNoSelectedLiveColony, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Visibility="{Binding HasSelectedLiveColony, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!--
                                        头部保持页面 VM 的 DataContext（刷新/停止按钮要按 VM 的忙碌状态互斥），
                                        殖民地数据一律走 SelectedLiveColony.*；下方页签整体切到殖民地对象。
                                    -->
                                    <controls:CardControl
                                        Grid.Row="0"
                                        Padding="14,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="15"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding SelectedLiveColony.Header}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            FontSize="15"
                                                            Text="{Binding SelectedLiveColony.SubHeader}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding SelectedLiveColony.LastUpdateLabel}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                                    <!--  刷新与停止互斥：不在读殖民地时只显示刷新，读取中只显示停止  -->
                                                    <ui:Button
                                                        Appearance="Secondary"
                                                        Click="OnRefreshLiveClick"
                                                        Icon="{ui:SymbolIcon ArrowSync24}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_RefreshColonies}"
                                                        Visibility="{Binding IsLiveNotBusy, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button
                                                        Click="OnCancelLiveClick"
                                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                        Icon="{ui:SymbolIcon RecordStop24}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_StopRefresh}"
                                                        Visibility="{Binding IsLiveBusy, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </controls:CardControl.Header>
                                        <StackPanel>
                                            <Border
                                                Padding="7,2"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Visibility="{Binding SelectedLiveColony.HasAlert, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                    Text="{Binding SelectedLiveColony.AlertText}" />
                                            </Border>
                                            <UniformGrid Margin="0,6,0,0" Columns="4">
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource PlanetaryMetricLabel}"
                                                        Text="{DynamicResource IndustryPlanetary_Ccu}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_CcuTip}" />
                                                    <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding SelectedLiveColony.UpgradeLevel}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_Pins}" />
                                                    <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding SelectedLiveColony.NumPins}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_RoleExtractor}" />
                                                    <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding SelectedLiveColony.Extractors.Count}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_RoleFactory}" />
                                                    <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding SelectedLiveColony.FactoryPinCount}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </controls:CardControl>

                                    <!--  详情页签放到卡片里，与其它 Tab 的卡片背景一致  -->
                                    <controls:CardControl
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Padding="8,6"
                                        CornerRadius="8">
                                        <TabControl
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            DataContext="{Binding SelectedLiveColony}">
                                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Capacity}">
                                                <StackPanel Margin="0,10,0,0">
                                                    <controls:CardControl
                                                        Padding="14,8"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasExtractorCapacity, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                    Symbol="ArrowDownload24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_ExtractionCapacity}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="9.5"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding ExtractorCapacityHint}"
                                                                ToolTip="{DynamicResource IndustryPlanetary_ExtractionCapacityTip}" />
                                                            <uc:PlanetaryCapacityChart
                                                                Height="150"
                                                                Margin="0,4,0,0"
                                                                Series="{Binding ExtractorCapacitySeries}" />
                                                        </StackPanel>
                                                    </controls:CardControl>
                                                    <controls:CardControl
                                                        Margin="0,8,0,0"
                                                        Padding="14,8"
                                                        CornerRadius="8"
                                                        ToolTip="{Binding FactoryCapacityHint}"
                                                        Visibility="{Binding HasFactoryCapacity, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    Symbol="Settings24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_FactoryTheoreticalOutput}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <uc:PlanetaryCapacityChart Height="150" Series="{Binding FactoryCapacitySeries}" />
                                                    </controls:CardControl>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Facilities}">
                                                <Grid Margin="0,10,0,0">
                                                    <controls:CardControl Padding="14,8" CornerRadius="8">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    Symbol="Settings24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_Tab_Facilities}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <Grid>
                                                            <ListBox
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                                ItemTemplate="{StaticResource PlanetaryFacilityNodeTemplate}"
                                                                ItemsSource="{Binding Facilities}"
                                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                                            <TextBlock
                                                                Margin="10"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPlanetary_NoFacilities}"
                                                                Visibility="{Binding HasNoFacilities, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </controls:CardControl>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Production}">
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <controls:CardControl
                                                        Grid.Row="0"
                                                        Padding="14,8"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasExtractors, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                    Symbol="ArrowDownload24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_RoleExtractor}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <ListBox
                                                            MaxHeight="240"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                            ItemTemplate="{StaticResource PlanetaryLiveExtractorTemplate}"
                                                            ItemsSource="{Binding Extractors}" />
                                                    </controls:CardControl>

                                                    <controls:CardControl
                                                        Grid.Row="1"
                                                        Margin="0,8,0,0"
                                                        Padding="14,8"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasFactories, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    Symbol="Settings24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_FactoryGroups}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <ListBox
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                            ItemTemplate="{StaticResource PlanetaryLiveFactoryTemplate}"
                                                            ItemsSource="{Binding Factories}" />
                                                    </controls:CardControl>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_StockLogistics}">
                                                <Grid Margin="0,10,0,0">
                                                    <controls:CardControl Padding="14,8" CornerRadius="8">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    Symbol="Database24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_Tab_StockLogistics}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPlanetary_Stock}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="10.5"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding StorageText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Margin="0,4,0,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPlanetary_Import}" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Margin="0,4,0,0"
                                                                FontSize="10.5"
                                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                Text="{Binding ImportsText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Margin="0,4,0,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPlanetary_Export}" />
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Grid.Column="1"
                                                                Margin="0,4,0,0"
                                                                FontSize="10.5"
                                                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                Text="{Binding ExportsText}"
                                                                TextWrapping="Wrap" />
                                                        </Grid>
                                                    </controls:CardControl>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_PinDetail}">
                                                <Grid Margin="0,10,0,0">
                                                    <controls:CardControl
                                                        Padding="14,8"
                                                        CornerRadius="8"
                                                        Visibility="{Binding HasPins, Converter={StaticResource BoolToVisibility}}">
                                                        <controls:CardControl.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                    Symbol="AppsList24" />
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{DynamicResource IndustryPlanetary_Tab_PinDetail}" />
                                                            </StackPanel>
                                                        </controls:CardControl.Header>
                                                        <ListBox
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                            ItemsSource="{Binding Pins}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="52" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                            Text="{Binding Role, Converter={StaticResource IndustryRoleName}}" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            FontSize="10.5"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding TypeName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Grid.Column="2"
                                                                            FontSize="9.5"
                                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                            Text="{Binding PinId}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </controls:CardControl>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </controls:CardControl>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  ================= 计划设置 =================  -->
            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Settings}">
                <Grid>
                    <controls:CardControl>
                        <TabControl
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectedIndex="{Binding SettingsTabIndex, Mode=TwoWay}">

                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Demand}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TabControl>
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Apps16" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPlanetary_SelectProduct}" />
                                                </StackPanel>
                                            </TabItem.Header>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBox
                                                    Grid.Row="0"
                                                    PlaceholderText="{DynamicResource IndustryPlanetary_SearchProduct}"
                                                    Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <ListBox
                                                    Grid.Row="1"
                                                    Margin="0,6,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                    ItemTemplate="{StaticResource PlanetaryProductTemplate}"
                                                    ItemsSource="{Binding FilteredProducts}"
                                                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" />
                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{DynamicResource General_Quantity}" />
                                                    <ui:NumberBox
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        MaxDecimalPlaces="0"
                                                        Maximum="1000000"
                                                        Minimum="1"
                                                        SmallChange="10"
                                                        Value="{Binding TargetQuantity, Mode=TwoWay}" />
                                                    <ui:Button
                                                        Grid.Column="2"
                                                        Click="OnAddProductClick"
                                                        Content="{DynamicResource General_Add}"
                                                        Icon="{ui:SymbolIcon Add24}" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Document24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPlanetary_ImportFromBlueprint}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_ImportFromBlueprintTip}" />
                                                </StackPanel>
                                            </TabItem.Header>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBox PlaceholderText="{DynamicResource IndustryPlanetary_SearchBlueprint}" Text="{Binding BlueprintSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                <ListBox
                                                    Grid.Row="1"
                                                    Margin="0,6,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                    ItemTemplate="{StaticResource PlanetaryBlueprintTemplate}"
                                                    ItemsSource="{Binding BlueprintResults}"
                                                    SelectedItem="{Binding SelectedBlueprint, Mode=TwoWay}" />
                                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding SelectedBlueprintText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <ui:NumberBox
                                                        Grid.Column="1"
                                                        Margin="6,0"
                                                        MaxDecimalPlaces="0"
                                                        Maximum="1000000"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        Value="{Binding BlueprintQuantity, Mode=TwoWay}" />
                                                    <ui:Button
                                                        Grid.Column="2"
                                                        Click="OnImportBlueprintClick"
                                                        Content="{DynamicResource IndustryPlanetary_ImportButton}"
                                                        Icon="{ui:SymbolIcon ArrowDownload24}" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                    <controls:CardControl
                                        Grid.Column="2"
                                        Padding="14,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="AppsList24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding TargetsCountText}" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ListBox
                                                Grid.Row="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                ItemTemplate="{StaticResource PlanetaryTargetTemplate}"
                                                ItemsSource="{Binding Targets}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                            <ui:Button
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Right"
                                                Appearance="Secondary"
                                                Click="OnClearTargetsClick"
                                                Content="{DynamicResource IndustryPlanetary_Clear}"
                                                Icon="{ui:SymbolIcon Delete24}" />
                                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPlanetary_PeriodDays}" />
                                                <ui:NumberBox
                                                    MaxDecimalPlaces="0"
                                                    Maximum="365"
                                                    Minimum="1"
                                                    SmallChange="1"
                                                    Value="{Binding PeriodDays, Mode=TwoWay}" />
                                                <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPlanetary_Mode}" />
                                                <ComboBox SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" ToolTip="{DynamicResource IndustryPlanetary_ModeTip}">
                                                    <ComboBoxItem Content="{DynamicResource IndustryPlanetary_ModeSelfSufficient}" />
                                                    <ComboBoxItem Content="{DynamicResource IndustryPlanetary_Import}" />
                                                    <ComboBoxItem Content="{DynamicResource IndustryPlanetary_ModeHybrid}" />
                                                </ComboBox>
                                                <CheckBox
                                                    Margin="0,8,0,0"
                                                    Content="{DynamicResource IndustryPlanetary_DeductColonyOutput}"
                                                    IsChecked="{Binding UseCurrentSupply, Mode=TwoWay}"
                                                    ToolTip="{DynamicResource IndustryPlanetary_DeductColonyOutputTip}" />
                                            </StackPanel>
                                        </Grid>
                                    </controls:CardControl>
                                </Grid>
                            </TabItem>

                            <!--  ================= 行星选择 =================  -->
                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Planets}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  左：已选星系（由候选行星聚合；某星系的行星被删空时整项自动消失）  -->
                                    <controls:CardControl Padding="12,8" CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource IndustryPlanetary_SelectSystemTip}">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Planet24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource General_SolarSystem}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding SystemsHeaderText}" />
                                            </Grid>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <uc:SolarSystemPickerView
                                                x:Name="SystemPicker"
                                                IncludeSpecialSystems="True"
                                                PopupHeight="420"
                                                PopupWidth="320" />
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding PlanetSummaryText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding PlanetSourceTooltip}" />
                                                <ui:Button
                                                    Grid.Column="1"
                                                    Appearance="Secondary"
                                                    Click="OnClearPlanetsClick"
                                                    Content="{DynamicResource IndustryPlanetary_Clear}"
                                                    Icon="{ui:SymbolIcon Delete24}"
                                                    IsEnabled="{Binding HasSelectedPlanets}" />
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                                <ListBox
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                    ItemsSource="{Binding SelectedSystems}"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                    SelectedItem="{Binding SelectedSystemItem, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4">
                                                                <TextBlock
                                                                    FontSize="12.5"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    FontSize="10"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding CountText}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock
                                                    Margin="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_AddSystemHint}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding HasNoSelectedSystems, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Grid>
                                    </controls:CardControl>

                                    <!--  右：选中星系的行星（逐颗移除；删空后左栏星系消失）  -->
                                    <controls:CardControl
                                        Grid.Column="2"
                                        Padding="12,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="AppsList24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding PlanetListHeaderText}" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <ListBox
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                ItemsSource="{Binding VisiblePlanets}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock
                                                                    FontSize="12.5"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    FontSize="10"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding DetailText}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <ui:Button
                                                                Grid.Column="1"
                                                                Width="26"
                                                                Height="26"
                                                                Padding="0"
                                                                VerticalAlignment="Center"
                                                                Appearance="Transparent"
                                                                Click="OnRemovePlanetClick"
                                                                Icon="{ui:SymbolIcon Delete24}"
                                                                Tag="{Binding}"
                                                                ToolTip="{DynamicResource IndustryPlanetary_Remove}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock
                                                Margin="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource IndustryPlanetary_SelectSystemFirst}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasNoVisiblePlanets, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </controls:CardControl>
                                </Grid>
                            </TabItem>

                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Characters}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:CardControl
                                        Grid.Column="0"
                                        Padding="16,10"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="People16" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{DynamicResource IndustryPage_ParticipatingCharacters}"
                                                    ToolTip="{DynamicResource IndustryPlanetary_AutoCharacterTip}" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,2,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_Col_Character}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_Ccu}"
                                                    ToolTip="{DynamicResource IndustryPlanetary_CcuTip}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Left"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_PlanetSlots}"
                                                    ToolTip="{DynamicResource IndustryPlanetary_PlanetSlotsTip}" />
                                            </Grid>
                                            <ListBox
                                                Grid.Row="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                                ItemTemplate="{StaticResource PlanetaryCharacterTemplate}"
                                                ItemsSource="{Binding Characters}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                        </Grid>
                                    </controls:CardControl>

                                    <controls:CardControl
                                        Grid.Column="2"
                                        Padding="16,10"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="Settings24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_CapacityParameters}"
                                                    ToolTip="{DynamicResource IndustryPlanetary_CapacityParametersTip}" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource PlanetaryLabel}"
                                                        Text="{DynamicResource IndustryPlanetary_DefaultCcu}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_CcuTip}" />
                                                    <ui:NumberBox
                                                        Maximum="5"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPlanetary_CcuTip}"
                                                        Value="{Binding CcuLevel, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock
                                                        Style="{StaticResource PlanetaryLabel}"
                                                        Text="{DynamicResource IndustryPlanetary_DefaultPlanetSlots}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_PlanetSlotsTip}" />
                                                    <ui:NumberBox
                                                        Maximum="6"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPlanetary_PlanetSlotsTip}"
                                                        Value="{Binding MaxPlanets, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource PlanetaryLabel}"
                                                        Text="{DynamicResource IndustryPlanetary_PlanetRadius}"
                                                        ToolTip="{DynamicResource IndustryPlanetary_PlanetRadiusTip}" />
                                                    <ui:NumberBox
                                                        IsEnabled="{Binding IsRadiusEditable}"
                                                        MaxDecimalPlaces="0"
                                                        Maximum="100000"
                                                        Minimum="0"
                                                        SmallChange="100"
                                                        Value="{Binding RadiusKm, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPlanetary_ExtractionCycle}" />
                                                    <ui:NumberBox
                                                        MaxDecimalPlaces="1"
                                                        Maximum="30"
                                                        Minimum="0.1"
                                                        SmallChange="0.5"
                                                        Value="{Binding CycleDays, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox
                                                Margin="0,12,0,0"
                                                Content="{DynamicResource IndustryPlanetary_CountSetupCost}"
                                                IsChecked="{Binding UseSetupCost, Mode=TwoWay}" />
                                        </StackPanel>
                                    </controls:CardControl>
                                </Grid>
                            </TabItem>

                            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_PriceTax}">
                                <Grid Margin="0,10,0,0">

                                    <controls:CardControl
                                        Grid.Column="0"
                                        Padding="16,10"
                                        VerticalAlignment="Top"
                                        CornerRadius="8"
                                        ToolTip="{DynamicResource IndustryPlanetary_PriceTaxTip}">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="Database24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{DynamicResource IndustryPlanetary_MarketTax}" />
                                            </StackPanel>
                                        </controls:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPlanetary_PriceMarket}" />
                                            <uc:MarketLocationSelectorView SelectedItem="{Binding SelectedPriceLocation, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="2,4,0,0"
                                                FontSize="10.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding PriceLocationText}"
                                                TextWrapping="Wrap" />
                                            <CheckBox
                                                Margin="0,8,0,0"
                                                Content="{DynamicResource IndustryPlanetary_UseMarketPrice}"
                                                IsChecked="{Binding UseMarketPrices, Mode=TwoWay}"
                                                ToolTip="{DynamicResource IndustryPlanetary_UseMarketPriceTip}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource PlanetaryLabel}"
                                                        Text="{DynamicResource IndustryPlanetary_PocoTax}"
                                                        ToolTip="{DynamicResource IndustryPage_PlanetTaxTip}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="0.5"
                                                        Value="{Binding PlanetTaxPercent, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPage_SalesTax}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="0.1"
                                                        Value="{Binding SalesTaxPercent, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource PlanetaryLabel}" Text="{DynamicResource IndustryPage_BrokerFee}" />
                                            <ui:NumberBox
                                                Maximum="100"
                                                Minimum="0"
                                                SmallChange="0.1"
                                                Value="{Binding BrokerFeePercent, Mode=TwoWay}" />
                                            <ui:Button
                                                Margin="0,10,0,0"
                                                Click="OnRefreshPricesClick"
                                                Content="{DynamicResource IndustryPlanetary_RefreshPrices}"
                                                Icon="{ui:SymbolIcon ArrowSync24}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="10.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding MarketStatusText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </controls:CardControl>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </controls:CardControl>

                    <StackPanel
                        Margin="0,12,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <!--  执行与停止互斥：计算中隐藏「执行行星计划」，只留「停止」  -->
                        <ui:Button
                            Height="34"
                            Appearance="Primary"
                            Click="OnCalculateClick"
                            Content="{DynamicResource IndustryPlanetary_RunPlan}"
                            Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                            Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Height="34"
                            Appearance="Secondary"
                            Click="OnCancelClick"
                            Content="{DynamicResource General_Stop}"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  ================= 计划详细 =================  -->
            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Result}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource IndustryPlanetary_RunFirst}"
                        Visibility="{Binding HasNoResult, Converter={StaticResource BoolToVisibility}}" />
                    <!--  结果内容放到卡片里，与计划设置/已保存计划的卡片背景一致；保存按钮在子页签 header 最右侧  -->
                    <controls:CardControl
                        Padding="8,6"
                        CornerRadius="8"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TabControl
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0">
                                <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Overview}">
                                    <StackPanel Margin="0,10,0,0">
                                        <controls:CardControl Padding="16,10" CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="DataUsage24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPlanetary_Overview}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <StackPanel>
                                                <UniformGrid Margin="0,8,0,0" Columns="5">
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_TargetCompletion}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding TargetDaysText}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_Colonies}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.TotalColonies}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_Characters}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.CharacterCount}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_TargetPerDay}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.OutputPerDay, StringFormat={}{0:N1}}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_ProfitPerDay}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.ProfitPerDay, StringFormat={}{0:N0} ISK}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_P1Colonies}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.ExtractionColonies}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_P234Colonies}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.P234FactoryColonies}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_SetupCost}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.SetupCost, StringFormat={}{0:N0} ISK}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_RevenuePerDay}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding CurrentPlan.Summary.RevenuePerDay, StringFormat={}{0:N0} ISK}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,12,10">
                                                        <TextBlock Style="{StaticResource PlanetaryMetricLabel}" Text="{DynamicResource IndustryPlanetary_PaybackDays}" />
                                                        <TextBlock Style="{StaticResource PlanetaryMetricValue}" Text="{Binding PaybackDaysText}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding CurrentPlan.Summary.TargetText}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding PlanetSourceText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding PlanetSourceTooltip}" />
                                            </StackPanel>
                                        </controls:CardControl>

                                        <controls:CardControl
                                            Margin="0,10,0,0"
                                            Padding="14,8"
                                            CornerRadius="8"
                                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                        Symbol="Warning24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPlanetary_PlanHints}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <ItemsControl ItemsSource="{Binding PlanWarnings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,1"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </controls:CardControl>

                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Chain}">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="2,0,2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="10.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource IndustryPlanetary_ChainSubtitle}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{DynamicResource IndustryPlanetary_ChainTip}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding ProductNodeCountText}" />
                                                <ui:Button
                                                    Height="24"
                                                    Padding="8,0"
                                                    Appearance="Transparent"
                                                    Click="OnExpandAllNodesClick"
                                                    Content="{DynamicResource IndustryPlanetary_ExpandAll}"
                                                    FontSize="10.5" />
                                                <ui:Button
                                                    Height="24"
                                                    Margin="4,0,0,0"
                                                    Padding="8,0"
                                                    Appearance="Transparent"
                                                    Click="OnCollapseAllNodesClick"
                                                    Content="{DynamicResource IndustryPlanetary_CollapseAll}"
                                                    FontSize="10.5" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <ListBox
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource PlanetaryNodeListItem}"
                                                ItemTemplate="{StaticResource PlanetaryProductNodeTemplate}"
                                                ItemsSource="{Binding FlatProductNodes}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                SelectedItem="{Binding SelectedProductNode, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource IndustryPlanetary_ChainEmpty}"
                                                Visibility="{Binding HasNoProductNodes, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource IndustryPlanetary_Tab_ColonyAllocation}">
                                    <Grid Margin="0,10,0,0">
                                        <ui:DataGrid ItemsSource="{Binding CurrentPlan.Colonies}" Style="{StaticResource PlanetaryDataGrid}">
                                            <ui:DataGrid.RowStyle>
                                                <Style BasedOn="{StaticResource FluentDataGridRowStyle}" TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <!--  候选行星里没有匹配类型：行星名留空、整行标红提示  -->
                                                        <DataTrigger Binding="{Binding MissingPlanet}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:DataGrid.RowStyle>
                                            <ui:DataGrid.CellStyle>
                                                <Style BasedOn="{StaticResource FluentDataGridCellStyle}" TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MissingPlanet}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:DataGrid.CellStyle>
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding CharacterName, Converter={StaticResource IndustryCharacterName}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Character}" />
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding PlanetName}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Planet}" />
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding RadiusKm, StringFormat={}{0:N0}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Radius}" />
                                                <DataGridTextColumn
                                                    Width="92"
                                                    Binding="{Binding PlanetType}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_PlanetType}" />
                                                <DataGridTextColumn
                                                    Width="52"
                                                    Binding="{Binding Role, Converter={StaticResource IndustryRoleName}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Role}" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding ProductName}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Product}" />
                                                <DataGridTextColumn
                                                    Width="56"
                                                    Binding="{Binding Factories}"
                                                    Header="{DynamicResource IndustryPlanetary_RoleFactory}" />
                                                <DataGridTextColumn
                                                    Width="56"
                                                    Binding="{Binding ExtractorHeads}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_ExtractorHeads}" />
                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding OutputPerDay, StringFormat={}{0:N1}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_OutputPerDay}" />
                                                <DataGridTextColumn
                                                    Width="82"
                                                    Binding="{Binding InputsPerDay, StringFormat={}{0:N0}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_InputPerDay}" />
                                                <DataGridTextColumn
                                                    Width="96"
                                                    Binding="{Binding SetupCost, StringFormat={}{0:N0}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_SetupIsk}" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource IndustryPlanetary_Tab_Imports}">
                                    <Grid Margin="0,10,0,0">
                                        <ui:DataGrid ItemsSource="{Binding CurrentPlan.Imports}" Style="{StaticResource PlanetaryDataGrid}">
                                            <ui:DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="Auto"
                                                    Binding="{Binding Tier}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Tier}" />
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding Name}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_Item}" />
                                                <DataGridTextColumn
                                                    Width="90"
                                                    Binding="{Binding QuantityPerDay, StringFormat={}{0:N1}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_QtyPerDay}" />
                                                <DataGridTextColumn
                                                    Width="100"
                                                    Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_UnitPrice}" />
                                                <DataGridTextColumn
                                                    Width="110"
                                                    Binding="{Binding CostPerDay, StringFormat={}{0:N0}}"
                                                    Header="{DynamicResource IndustryPlanetary_Col_CostPerDay}" />
                                            </ui:DataGrid.Columns>
                                        </ui:DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            <!--  保存按钮：贴在「概况/产物链/殖民地分配/外购」子页签 header 的最右侧  -->
                            <ui:Button
                                Margin="0,0,6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10"
                                Appearance="Secondary"
                                Click="OnSavePlanHeaderClick"
                                Content="{DynamicResource IndustryPlanetary_SavePlan}"
                                Icon="{ui:SymbolIcon Save24}"
                                Visibility="{Binding ShowPlanSaveButton, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </controls:CardControl>
                </Grid>
            </TabItem>

            <!--  ================= 已保存计划 =================  -->
            <TabItem Header="{DynamicResource IndustryPlanetary_Tab_SavedPlans}">
                <Grid>
                    <controls:CardControl Padding="14,8" CornerRadius="8">
                        <controls:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="Folder24" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource IndustryPlanetary_Tab_SavedPlans}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding SavedPlanCountText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Secondary"
                                        Click="OnLoadPlanClick"
                                        Content="{DynamicResource IndustryPlanetary_Load}"
                                        Icon="{ui:SymbolIcon FolderOpen24}"
                                        IsEnabled="{Binding HasSavedPlans}" />
                                    <ui:Button
                                        Margin="6,0,0,0"
                                        Appearance="Secondary"
                                        Click="OnDeletePlanClick"
                                        Content="{DynamicResource General_Remove}"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        IsEnabled="{Binding HasSavedPlans}" />
                                </StackPanel>
                            </Grid>
                        </controls:CardControl.Header>
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource IndustryPlanetary_NoSavedPlans}"
                                Visibility="{Binding HasNoSavedPlans, Converter={StaticResource BoolToVisibility}}" />
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource PlanetaryListItem}"
                                ItemsSource="{Binding SavedPlans}"
                                MouseDoubleClick="OnSavedPlanDoubleClick"
                                SelectedItem="{Binding SelectedSavedPlan, Mode=TwoWay}"
                                ToolTip="{DynamicResource IndustryPlanetary_RenameTip}"
                                Visibility="{Binding HasSavedPlans, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Summary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding UpdatedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </controls:CardControl>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  页面内非阻塞加载提示：计划计算 / 我的殖民地刷新共用，放在右下角  -->
        <Border
            Width="320"
            Margin="0,0,18,18"
            Padding="14,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="{Binding IsAnyBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Symbol="ArrowSync24" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding BusyNoticeText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
