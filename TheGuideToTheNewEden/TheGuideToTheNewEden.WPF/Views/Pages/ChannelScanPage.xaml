<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ChannelScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="ScanCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="ScanNumberCellStyle"
            BasedOn="{StaticResource ScanCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!--  统计项：徽标 + 名称 + 数量  -->
        <DataTemplate x:Key="StatisticsItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Source="{Binding Logo}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Count}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12,12,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：名单输入 ============  -->
        <controls:CardControl Grid.Column="0" Header="{DynamicResource ChannelScanPage_NameList}">
            <ui:TextBox
                AcceptsReturn="True"
                MinHeight="220"
                PlaceholderText="{DynamicResource ChannelScanPage_NamesTip}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{Binding NamesStr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                TextWrapping="Wrap" />
            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        Appearance="Primary"
                        Click="OnStartClick"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource ChannelScanPage_Start}"
                        AutomationProperties.Name="{DynamicResource ChannelScanPage_Start}" />
                    <ui:Button
                        Click="OnSettingClick"
                        Icon="{ui:SymbolIcon Settings24}"
                        ToolTip="{DynamicResource General_Setting}"
                        AutomationProperties.Name="{DynamicResource General_Setting}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 中：设置面板 ============  -->
        <controls:CardControl
            Grid.Column="1"
            Width="300"
            Margin="8,0"
            Header="{DynamicResource General_Setting}"
            Visibility="{Binding IsSetting, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Expander
                        Margin="0,2"
                        Background="Transparent"
                        Header="{DynamicResource ChannelScanPage_Setting_ZKB}"
                        IsExpanded="True">
                        <Grid Margin="12,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource ScanCellStyle}"
                                Text="{DynamicResource ChannelScanPage_Setting_GetZKB}" />
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Config.GetZKB, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource ScanCellStyle}"
                                Text="{DynamicResource ChannelScanPage_Setting_MaxZKB}" />
                            <ui:NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                MaxHeight="32"
                                Minimum="1"
                                SmallChange="10"
                                Value="{Binding Config.MaxZKB, Mode=TwoWay}" />
                        </Grid>
                    </Expander>

                    <Expander
                        Margin="0,2"
                        Background="Transparent"
                        Header="{DynamicResource ChannelScanPage_Setting_IgnoredEntities}"
                        IsExpanded="True">
                        <StackPanel Margin="12,4,0,4">
                            <CheckBox
                                Content="{DynamicResource ChannelScanPage_Setting_ActiveIgnoreList}"
                                IsChecked="{Binding Config.ActiveIgnoreList, Mode=TwoWay}" />
                            <CheckBox
                                Content="{DynamicResource ChannelScanPage_Setting_ShowIgnoredInResultDetail}"
                                IsChecked="{Binding Config.ShowIgnoredInResultDetail, Mode=TwoWay}" />
                            <CheckBox
                                Content="{DynamicResource ChannelScanPage_Setting_ShowIgnoredInResultStatistics}"
                                IsChecked="{Binding Config.ShowIgnoredInResultStatistics, Mode=TwoWay}" />

                            <ListBox
                                MinHeight="120"
                                MaxHeight="180"
                                Margin="0,8,0,0"
                                ItemsSource="{Binding Config.Ignoreds}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="4,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Id}" />
                                            <ui:Button
                                                Grid.Column="2"
                                                Appearance="Danger"
                                                Click="OnIgnoreDeleteClick"
                                                Icon="{ui:SymbolIcon Dismiss24}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  添加忽略名单  -->
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsAddingIgnore, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource ScanCellStyle}"
                                    Text="{DynamicResource ChannelScanPage_Setting_AddIgnored_IDTip}" />
                                <ui:TextBox
                                    Grid.Column="1"
                                    Text="{Binding AddingIgnoreId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource ScanCellStyle}"
                                    Text="{DynamicResource ChannelScanPage_Result_Character}" />
                                <ui:TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding AddingIgnoreName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource ScanCellStyle}"
                                    Text="{DynamicResource ChannelScanPage_Setting_IgnoredEntities}" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    SelectedIndex="{Binding AddingIgnoreCategory, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource ChannelScanPage_Result_Character}" />
                                    <ComboBoxItem Content="{DynamicResource ChannelScanPage_Result_Corporation}" />
                                    <ComboBoxItem Content="{DynamicResource ChannelScanPage_Result_Alliance}" />
                                </ComboBox>
                                <StackPanel
                                    Grid.Row="3"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,6,0"
                                        Appearance="Primary"
                                        Click="OnConfirmAddIgnoreClick"
                                        Content="{DynamicResource General_OK}" />
                                    <ui:Button Click="OnCancelAddIgnoreClick" Content="{DynamicResource General_Cancel}" />
                                </StackPanel>
                            </Grid>

                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Click="OnAddIgnoreClick"
                                Content="{DynamicResource General_Add}"
                                Icon="{ui:SymbolIcon Add24}"
                                Visibility="{Binding IsAddingIgnore, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--  关闭设置（底栏）  -->
            <controls:CardControl.Footer>
                <ui:Button
                    HorizontalAlignment="Center"
                    Click="OnHideSettingClick"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{DynamicResource ChannelScanPage_Hide}"
                    AutomationProperties.Name="{DynamicResource ChannelScanPage_Hide}" />
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 右：统计 / 详细 ============  -->
        <controls:CardControl Grid.Column="2">
            <TabControl>
                <!--  统计  -->
                <TabItem Header="{DynamicResource ChannelScanPage_Result_Statistics}">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:CardControl Header="{DynamicResource ChannelScanPage_Result_Statistics_Corporation}">
                            <ListBox
                                ItemTemplate="{StaticResource StatisticsItemTemplate}"
                                ItemsSource="{Binding StatisticsCorporation}"
                                ScrollViewer.CanContentScroll="True" />
                        </controls:CardControl>
                        <controls:CardControl
                            Grid.Column="2"
                            Header="{DynamicResource ChannelScanPage_Result_Statistics_Alliance}">
                            <ListBox
                                ItemTemplate="{StaticResource StatisticsItemTemplate}"
                                ItemsSource="{Binding StatisticsAlliance}"
                                ScrollViewer.CanContentScroll="True" />
                        </controls:CardControl>
                    </Grid>
                </TabItem>

                    <!--  详细  -->
                    <TabItem Header="{DynamicResource ChannelScanPage_Result_Detail}">
                        <ScrollViewer
                            Margin="0,6,0,0"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <ui:DataGrid
                                x:Name="ResultDataGrid"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding ScanInfos}"
                                MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionMode="Extended"
                                SelectionUnit="FullRow">
                                <ui:DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="OnAddIgnoreCharacterClick" Header="{DynamicResource ChannelScanPage_AddIgnored_Character}" />
                                        <MenuItem Click="OnAddIgnoreCorporationClick" Header="{DynamicResource ChannelScanPage_AddIgnored_Corporation}" />
                                        <MenuItem Click="OnAddIgnoreAllianceClick" Header="{DynamicResource ChannelScanPage_AddIgnored_Alliance}" />
                                        <MenuItem Click="OnReloadZKBClick" Header="{DynamicResource ChannelScanPage_ReloadResultZKB}" />
                                    </ContextMenu>
                                </ui:DataGrid.ContextMenu>
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="140"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_Character}" />
                                    <DataGridTextColumn
                                        Width="160"
                                        Binding="{Binding Corporation.Name}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_Corporation}" />
                                    <DataGridTextColumn
                                        Width="160"
                                        Binding="{Binding Alliance.Name}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_Alliance}" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding DangerRatio}"
                                        ElementStyle="{StaticResource ScanNumberCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_DangerRatio}" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding SoloStr}"
                                        ElementStyle="{StaticResource ScanNumberCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_SoloKills}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding ItemDestroyed}"
                                        ElementStyle="{StaticResource ScanNumberCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_Kills}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding ItemLost}"
                                        ElementStyle="{StaticResource ScanNumberCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_Losses}" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding GangRatio}"
                                        ElementStyle="{StaticResource ScanNumberCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_GangRatio}" />
                                    <DataGridCheckBoxColumn
                                        Width="80"
                                        Binding="{Binding HasSupers}"
                                        Header="{DynamicResource ChannelScanPage_Result_HasSupers}" />
                                    <DataGridCheckBoxColumn
                                        Width="100"
                                        Binding="{Binding CovertCyno}"
                                        Header="{DynamicResource ChannelScanPage_Result_CanCovertCyno}" />
                                    <DataGridTextColumn
                                        Width="180"
                                        Binding="{Binding TopShipsStr}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_TopShips}" />
                                    <DataGridTextColumn
                                        Width="160"
                                        Binding="{Binding TopGroupsStr}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_TopGroups}" />
                                    <DataGridTextColumn
                                        Width="180"
                                        Binding="{Binding TopSystemsStr}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_TopSystems}" />
                                    <DataGridTextColumn
                                        Width="180"
                                        Binding="{Binding TopRegionsStr}"
                                        ElementStyle="{StaticResource ScanCellStyle}"
                                        Header="{DynamicResource ChannelScanPage_Result_TopRegions}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </ScrollViewer>
                    </TabItem>
            </TabControl>

            <!--  结果条数（底栏）  -->
            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ResultCount}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource ChannelScanPage_Result_Character}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>
    </Grid>
</Page>
