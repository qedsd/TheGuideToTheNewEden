<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.GameLogMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:EqualsToVisibilityConverter x:Key="EqualsToVis" />

        <Style x:Key="LogFieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!--  角色项：名称 + 开始时间 + 监控中指示条  -->
        <DataTemplate x:Key="CharacterItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Width="3"
                    Height="26"
                    Margin="0,0,6,0"
                    Fill="{DynamicResource SystemFillColorCautionBrush}"
                    RadiusX="2"
                    RadiusY="2"
                    ToolTip="{DynamicResource GameLogMonitorPage_Running}"
                    Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1">
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding ListenerName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StartTime}"
                        ToolTip="{DynamicResource GameLogMonitorPage_StartTime}" />
                </StackPanel>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnOpenLogFileClick" Header="{DynamicResource GameLogMonitorPage_OpenLogFile}" />
                        <MenuItem Click="OnOpenLogFolderClick" Header="{DynamicResource GameLogMonitorPage_OpenLogFolder}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <!--  配置页签标题：名称 + 关闭  -->
        <DataTemplate x:Key="ConfigHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ConfigName}" />
                <ui:Button
                    Width="22"
                    Height="22"
                    Margin="6,0,0,0"
                    Padding="0"
                    Appearance="Transparent"
                    Click="OnCloseConfigClick"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{DynamicResource GameLogMonitorPage_RemoveConfig}" />
            </StackPanel>
        </DataTemplate>

        <!--  关键词行：正则 + 删除  -->
        <DataTemplate x:Key="KeyRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox PlaceholderText="{DynamicResource GameLogMonitorPage_Regex}" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Click="OnDeleteKeyClick">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="Dismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12,12,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：角色列表 ============  -->
        <controls:CardControl Grid.Column="0" Header="{DynamicResource GameLogMonitorPage_CharacterList}">
            <ListBox
                x:Name="CharacterList"
                ItemContainerStyle="{StaticResource StretchListItem}"
                ItemTemplate="{StaticResource CharacterItemTemplate}"
                ItemsSource="{Binding GameLogInfos}"
                ScrollViewer.CanContentScroll="True"
                SelectedItem="{Binding SelectedGameLogInfo, Mode=TwoWay}" />
            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource General_StartAll}"
                        Click="OnStartAllClick"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource General_StartAll}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource General_StopAll}"
                        Click="OnStopAllClick"
                        ToolTip="{DynamicResource General_StopAll}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        AutomationProperties.Name="{DynamicResource General_RefreshList}"
                        Click="OnRefreshClick"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{DynamicResource General_RefreshList}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 中：监控设置 ============  -->
        <controls:CardControl
            Grid.Column="1"
            Width="440"
            Margin="8,0"
            Header="{DynamicResource GameLogMonitorPage_Setting}"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <TabControl
                ItemTemplate="{StaticResource ConfigHeaderTemplate}"
                ItemsSource="{Binding ItemConfigs}"
                SelectedItem="{Binding SelectedItemConfig, Mode=TwoWay}">
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer
                            Margin="0,6,0,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  配置信息  -->
                                <Expander
                                    Margin="0,2"
                                    Background="Transparent"
                                    Header="{DynamicResource GameLogMonitorPage_Config}"
                                    IsExpanded="True">
                                    <Grid Margin="12,4,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LogFieldLabel}" Text="{DynamicResource GameLogMonitorPage_Config_Type}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource GameLogMonitorPage_Type_GameLog}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogType}" Value="1">
                                                            <Setter Property="Text" Value="{DynamicResource GameLogMonitorPage_Type_ErrorLog}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource LogFieldLabel}"
                                            Text="{DynamicResource GameLogMonitorPage_Config_Name}" />
                                        <ui:TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            LostFocus="OnConfigFieldLostFocus"
                                            Text="{Binding ConfigName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </Expander>

                                <!--  监控模式  -->
                                <Expander
                                    Margin="0,2"
                                    Background="Transparent"
                                    Header="{DynamicResource GameLogMonitorPage_MonitorMode}"
                                    IsExpanded="True">
                                    <Grid Margin="12,4,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LogFieldLabel}" Text="{DynamicResource GameLogMonitorPage_MonitorMode}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="{Binding MonitorMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource GameLogMonitorPage_MonitorMode_0}" />
                                            <ComboBoxItem Content="{DynamicResource GameLogMonitorPage_MonitorMode_1}" />
                                        </ComboBox>
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource LogFieldLabel}"
                                            Text="{DynamicResource GameLogMonitorPage_DisappearDelay}"
                                            Visibility="{Binding MonitorMode, Converter={StaticResource EqualsToVis}, ConverterParameter=1}" />
                                        <ui:NumberBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            MaxHeight="32"
                                            Minimum="1"
                                            SmallChange="5"
                                            Visibility="{Binding MonitorMode, Converter={StaticResource EqualsToVis}, ConverterParameter=1}"
                                            Value="{Binding DisappearDelay, Mode=TwoWay}" />
                                    </Grid>
                                </Expander>

                                <!--  通知方式  -->
                                <Expander
                                    Margin="0,2"
                                    Background="Transparent"
                                    Header="{DynamicResource GameLogMonitorPage_NotifyMode}"
                                    IsExpanded="True">
                                    <StackPanel Margin="12,4,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox
                                                MinWidth="110"
                                                Content="{DynamicResource GameLogMonitorPage_SystemNotify}"
                                                IsChecked="{Binding SystemNotify, Mode=TwoWay}" />
                                            <CheckBox
                                                MinWidth="110"
                                                Content="{DynamicResource GameLogMonitorPage_WindowNotify}"
                                                IsChecked="{Binding WindowNotify, Mode=TwoWay}" />
                                            <CheckBox Content="{DynamicResource GameLogMonitorPage_SoundNotify}" IsChecked="{Binding SoundNotify, Mode=TwoWay}" />
                                        </StackPanel>
                                        <CheckBox
                                            Margin="0,6,0,0"
                                            Content="{DynamicResource GameLogMonitorPage_RepeatSound}"
                                            IsChecked="{Binding RepeatSound, Mode=TwoWay}"
                                            Visibility="{Binding SoundNotify, Converter={StaticResource BoolToVis}}" />
                                        <Grid Margin="0,8,0,0" Visibility="{Binding SoundNotify, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource LogFieldLabel}" Text="{DynamicResource GameLogMonitorPage_SoundFile}" />
                                            <ui:TextBox
                                                Grid.Column="1"
                                                Margin="0,0,4,0"
                                                LostFocus="OnConfigFieldLostFocus"
                                                PlaceholderText="{DynamicResource GameLogMonitorPage_Default}"
                                                Text="{Binding SoundFile, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            <ui:Button
                                                Grid.Column="2"
                                                Click="OnPickSoundFileClick"
                                                Content="{DynamicResource EarlyWarningItemPage_Pick}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!--  监控关键词  -->
                                <Expander
                                    Margin="0,2"
                                    Background="Transparent"
                                    Header="{DynamicResource GameLogMonitorPage_NotifyKey}"
                                    IsExpanded="True">
                                    <StackPanel Margin="12,4,0,4">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{DynamicResource GameLogMonitorPage_NotifyKey_Tip}"
                                            TextWrapping="Wrap" />
                                        <ui:Button
                                            Margin="0,6,0,6"
                                            HorizontalAlignment="Left"
                                            Click="OnAddKeyClick"
                                            Content="{DynamicResource GameLogMonitorPage_AddKey}"
                                            Icon="{ui:SymbolIcon Add24}" />
                                        <ItemsControl ItemTemplate="{StaticResource KeyRowTemplate}" ItemsSource="{Binding Keys}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource GameLogMonitorPage_AddConfig}"
                        Click="OnAddConfigClick"
                        Icon="{ui:SymbolIcon Add24}"
                        ToolTip="{DynamicResource GameLogMonitorPage_AddConfig}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource GameLogMonitorPage_Start}"
                        Click="OnStartClick"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource GameLogMonitorPage_Start}"
                        Visibility="{Binding SelectedRunning, Converter={StaticResource InverseBoolToVis}}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource GameLogMonitorPage_Stop}"
                        Click="OnStopClick"
                        ToolTip="{DynamicResource GameLogMonitorPage_Stop}"
                        Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        AutomationProperties.Name="{DynamicResource GameLogMonitorPage_StopNotify}"
                        Click="OnStopNotifyClick"
                        Icon="{ui:SymbolIcon SpeakerMute24}"
                        ToolTip="{DynamicResource GameLogMonitorPage_StopNotify}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 右：实时日志 ============  -->
        <controls:CardControl Grid.Column="2" Header="{DynamicResource GameLogMonitorPage_Logs}">
            <RichTextBox
                x:Name="LogContentsBox"
                Background="Transparent"
                BorderThickness="0"
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto">
                <FlowDocument />
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnClearContentsClick" Header="{DynamicResource GameLogMonitorPage_ClearContents}" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
            </RichTextBox>
        </controls:CardControl>
    </Grid>
</Page>
