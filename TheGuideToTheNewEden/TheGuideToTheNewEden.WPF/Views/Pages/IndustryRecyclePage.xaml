<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryRecyclePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="RecycleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:CardControl Grid.Row="0" Padding="16,10" CornerRadius="8">
            <controls:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Symbol="ArrowSync24" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource IndustryRecycle_Title}" />
                </StackPanel>
            </controls:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="{DynamicResource IndustryRecycle_SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="2"
                    Click="OnSearchClick"
                    Content="{DynamicResource IndustryPage_Search}"
                    Icon="{ui:SymbolIcon Search24}" />
            </Grid>
        </controls:CardControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:CardControl Grid.Column="0" Padding="12,10" CornerRadius="8">
                <controls:CardControl.Header>
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{DynamicResource IndustryRecycle_SearchResults}" />
                </controls:CardControl.Header>
                <ListBox
                    MinHeight="260"
                    DisplayMemberPath="TypeName"
                    ItemsSource="{Binding SearchResults}"
                    SelectedItem="{Binding SelectedType, Mode=TwoWay}" />
            </controls:CardControl>

            <controls:CardControl Grid.Column="2" Padding="16,10" CornerRadius="8">
                <controls:CardControl.Header>
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding SelectedTypeName}" />
                </controls:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource RecycleLabel}" Text="{DynamicResource General_Quantity}" />
                            <ui:NumberBox
                                Maximum="1000000000"
                                Minimum="1"
                                SmallChange="100"
                                Value="{Binding Quantity, Mode=TwoWay}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            Margin="0,21,0,0"
                            Click="OnAddToBatchClick"
                            Content="{DynamicResource IndustryRecycle_AddToBatch}"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource RecycleLabel}" Text="{DynamicResource IndustryRecycle_BatchImport}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                Height="64"
                                AcceptsReturn="True"
                                PlaceholderText="{DynamicResource IndustryRecycle_BatchPlaceholder}"
                                Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                VerticalAlignment="Bottom"
                                Click="OnImportClick"
                                Content="{DynamicResource IndustryRecycle_Import}"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,8,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding BatchSummary}" />
                        <ui:Button
                            Grid.Column="1"
                            Click="OnClearBatchClick"
                            Content="{DynamicResource IndustryRecycle_ClearBatch}"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </Grid>

                    <DataGrid
                        Grid.Row="3"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="False"
                        ItemsSource="{Binding Batch}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource IndustryRecycle_Include}" Width="60" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="{DynamicResource IndustryPage_Col_Item}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Binding="{Binding Quantity, StringFormat=N0}" Header="{DynamicResource General_Quantity}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Click="OnReprocessClick"
                            Content="{DynamicResource IndustryRecycle_Reprocess}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:Button
                            Grid.Column="2"
                            Click="OnCompressClick"
                            Content="{DynamicResource IndustryRecycle_Compress}"
                            Icon="{ui:SymbolIcon ArrowMinimize24}" />
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource RecycleLabel}" Text="{DynamicResource IndustryRecycle_Yield}" />
                            <ui:NumberBox
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding YieldPercent, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="5" Margin="0,8,0,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding StatusText}"
                            TextWrapping="Wrap" />
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Outputs}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Name}" Header="{DynamicResource IndustryPage_Col_Item}" Width="*" />
                                <DataGridTextColumn Binding="{Binding Quantity, StringFormat=N0}" Header="{DynamicResource General_Quantity}" Width="140" />
                                <DataGridTextColumn Binding="{Binding UnitVolume, StringFormat=0.####}" Header="{DynamicResource IndustryRecycle_UnitVolume}" Width="130" />
                                <DataGridTextColumn Binding="{Binding TotalVolume, StringFormat=N2}" Header="{DynamicResource IndustryRecycle_TotalVolume}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </controls:CardControl>
        </Grid>
    </Grid>
</Page>
