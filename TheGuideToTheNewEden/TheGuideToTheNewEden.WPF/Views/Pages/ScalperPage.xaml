<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ScalperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <TabControl>
        <TabItem Header="{DynamicResource BusinessPage_Scalper}">
            <uc:ScalperAnalyseView x:Name="AnalyseView" />
        </TabItem>
        <TabItem Header="{DynamicResource BusinessPage_ShoppingCart}">
            <uc:ScalperShoppingCartView x:Name="CartView" />
        </TabItem>
        <TabItem Header="{DynamicResource BusinessPage_HistoryShopping}">
            <uc:ScalperShoppingRecordView x:Name="RecordView" />
        </TabItem>
    </TabControl>
</Page>
