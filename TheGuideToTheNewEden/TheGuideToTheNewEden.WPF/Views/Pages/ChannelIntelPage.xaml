<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ChannelIntelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="IntelFieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!--  每跳声音行：两行卡片，避免跳数/滑条/循环/文件/按钮挤在一行  -->
        <DataTemplate x:Key="SoundRowTemplate">
            <Border
                Margin="0,0,8,6"
                Padding="9,7"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Id}" />
                        <TextBlock
                            Margin="2,0,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource EarlyWarningItemPage_Jump}" />
                    </StackPanel>

                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Volume, StringFormat={}{0}%}"
                        TextAlignment="Right" />

                    <CheckBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource EarlyWarningItemPage_Loop}"
                        IsChecked="{Binding Loop, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,7,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource ChannelIntelPage_SoundFile}" />

                    <ui:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,6,8,0"
                        PlaceholderText="{DynamicResource EarlyWarningItemPage_DefaultFile}"
                        Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <ui:Button
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,6,0,0"
                        Click="OnPickSoundFileClick"
                        Content="{DynamicResource EarlyWarningItemPage_Pick}" />
                </Grid>
            </Border>
        </DataTemplate>
        <!--  角色项：名称 + 预警中指示条  -->
        <DataTemplate x:Key="CharacterItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Width="3"
                    Height="16"
                    Margin="0,0,6,0"
                    Fill="{DynamicResource SystemFillColorCautionBrush}"
                    RadiusX="2"
                    RadiusY="2"
                    ToolTip="{DynamicResource ChannelIntelPage_Running}"
                    Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：角色列表 ============  -->
        <controls:CardControl Grid.Column="0" Header="{DynamicResource ChannelIntelPage_Characters}">
            <ListBox
                x:Name="CharacterList"
                IsSynchronizedWithCurrentItem="False"
                ItemTemplate="{StaticResource CharacterItemTemplate}"
                ItemsSource="{Binding Characters}"
                ScrollViewer.CanContentScroll="True"
                SelectionChanged="OnCharacterSelectionChanged" />
            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource General_StartAll}"
                        Click="OnStartAllClick"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource General_StartAll}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource General_StopAll}"
                        Click="OnStopAllClick"
                        ToolTip="{DynamicResource General_StopAll}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_RefreshChannels}"
                        Click="OnRefreshCharactersClick"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{DynamicResource ChannelIntelPage_RefreshChannels}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 中：频道列表 ============  -->
        <controls:CardControl
            Grid.Column="1"
            Width="290"
            Margin="8,0"
            Header="{DynamicResource ChannelIntelPage_Channels}"
            Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <ListBox
                x:Name="ChannelList"
                IsEnabled="{Binding SelectedNotRunning}"
                ItemContainerStyle="{StaticResource StretchListItem}"
                ItemsSource="{Binding Session.ChatChanelInfos}"
                ScrollViewer.CanContentScroll="True"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                MinWidth="32"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ChannelName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{DynamicResource ChannelIntelPage_ChannelName}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SessionStarted}"
                                    ToolTip="{DynamicResource ChannelIntelPage_LastUpdateTime}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <controls:CardControl.Footer>
                <ui:Button
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource ChannelIntelPage_RefreshChannels}"
                    Click="OnRefreshChannelsClick"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    IsEnabled="{Binding SelectedNotRunning}"
                    ToolTip="{DynamicResource ChannelIntelPage_RefreshChannels}" />
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  ============ 右：预警设置 / 频道内容 ============  -->
        <controls:CardControl Grid.Column="2" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <TabControl>
                <!--  预警设置  -->
                <TabItem Header="{DynamicResource ChannelIntelPage_Setting}">
                    <ScrollViewer
                        Margin="0,6,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel IsEnabled="{Binding SelectedNotRunning}">
                            <!--  预警范围  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_RangeSetting}"
                                IsExpanded="True">
                                <Grid Margin="12,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_LocalSystem}" />
                                    <ToggleButton
                                        x:Name="LocalSystemToggle"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinHeight="32"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Content="{Binding Session.LocalSolarSystem.SolarSystemName}" />
                                    <Popup
                                        AllowsTransparency="True"
                                        IsOpen="{Binding IsChecked, ElementName=LocalSystemToggle, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=LocalSystemToggle}"
                                        PopupAnimation="Fade"
                                        StaysOpen="False">
                                        <Border
                                            Width="300"
                                            Height="420"
                                            Style="{StaticResource AccentFlyoutBorder}">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <ui:TextBox
                                                    x:Name="SystemSearchBox"
                                                    Grid.Row="0"
                                                    PlaceholderText="{DynamicResource MarketPage_SearchSolarSystem}"
                                                    TextChanged="OnSystemSearchChanged" />
                                                <ListBox
                                                    x:Name="SystemList"
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    DisplayMemberPath="SolarSystemName"
                                                    IsSynchronizedWithCurrentItem="False"
                                                    ScrollViewer.CanContentScroll="True"
                                                    SelectionChanged="OnSystemSelectionChanged"
                                                    VirtualizingStackPanel.IsVirtualizing="True"
                                                    VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_Jumps}" />
                                    <ui:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="160"
                                        MaxHeight="32"
                                        Margin="0,0,40,0"
                                        HorizontalAlignment="Left"
                                        ClearButtonEnabled="False"
                                        Maximum="8"
                                        Minimum="0"
                                        SmallChange="1"
                                        ValueChanged="OnIntelJumpsChanged"
                                        Value="{Binding Session.Setting.IntelJumpsValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_AutoUpdateLocation}" />
                                    <CheckBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource General_Yes}"
                                        IsChecked="{Binding Session.Setting.AutoUpdateLocaltion, Mode=TwoWay}" />
                                </Grid>
                            </Expander>

                            <!--  通知方式  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_NotifySetting}"
                                IsExpanded="True">
                                <StackPanel Margin="12,4,0,4" Orientation="Horizontal">
                                    <CheckBox
                                        MinWidth="90"
                                        Content="{DynamicResource ChannelIntelPage_Notify_Overlap}"
                                        IsChecked="{Binding Session.Setting.OverlapNotify, Mode=TwoWay}" />
                                    <CheckBox
                                        MinWidth="90"
                                        Content="{DynamicResource ChannelIntelPage_Notify_Sound}"
                                        IsChecked="{Binding Session.Setting.MakeSound, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource ChannelIntelPage_Notify_System}" IsChecked="{Binding Session.Setting.SystemNotify, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>

                            <!--  预警弹窗  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_OverlapSetting}"
                                IsExpanded="True"
                                Visibility="{Binding Session.Setting.OverlapNotify, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="12,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_OverlapShowType}" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="{Binding Session.Setting.OverlapType, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource ChannelIntelPage_OverlapType_Alwasys}" />
                                        <ComboBoxItem Content="{DynamicResource ChannelIntelPage_OverlapType_WhenNeed}" />
                                    </ComboBox>

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_OverlapStyle}" />
                                    <ComboBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="{Binding Session.Setting.OverlapStyle, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource ChannelIntelPage_OverlapStyle_Default}" />
                                        <ComboBoxItem Content="{DynamicResource ChannelIntelPage_OverlapStyle_SMT}" />
                                        <ComboBoxItem Content="{DynamicResource ChannelIntelPage_OverlapStyle_Near2}" />
                                    </ComboBox>

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_OverlapOpacity}" />
                                    <Slider
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="8,0,40,0"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Minimum="1"
                                        Value="{Binding Session.Setting.OverlapOpacity, Mode=TwoWay}" />
                                </Grid>
                            </Expander>

                            <!--  预警声音  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_SoundSetting}"
                                IsExpanded="True"
                                Visibility="{Binding Session.Setting.MakeSound, Converter={StaticResource BoolToVis}}">
                                <ItemsControl
                                    Margin="12,4,8,4"
                                    ItemTemplate="{StaticResource SoundRowTemplate}"
                                    ItemsSource="{Binding Session.Setting.Sounds}" />
                            </Expander>

                            <!--  关键词  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_KeywordSetting}"
                                IsExpanded="True">
                                <Grid Margin="12,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_IgnoreWords}" />
                                    <ui:TextBox
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        PlaceholderText="{DynamicResource ChannelIntelPage_IgnoreWords_Tips}"
                                        Text="{Binding Session.Setting.IgnoreWords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_ClearWords}" />
                                    <ui:TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        PlaceholderText="{DynamicResource ChannelIntelPage_ClearWords_Tips}"
                                        Text="{Binding Session.Setting.ClearWords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource IntelFieldLabel}"
                                        Text="{DynamicResource ChannelIntelPage_SystemNameDbs}" />
                                    <ListBox
                                        x:Name="NameDbsList"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        MaxHeight="120"
                                        Margin="0,8,40,0"
                                        DisplayMemberPath="Name"
                                        SelectionChanged="OnNameDbsSelectionChanged"
                                        SelectionMode="Multiple" />
                                </Grid>
                            </Expander>

                            <!--  其他  -->
                            <Expander
                                Margin="0,2"
                                Background="Transparent"
                                Header="{DynamicResource ChannelIntelPage_OtherSetting}"
                                IsExpanded="True">
                                <Grid Margin="12,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource ChannelIntelPage_AutoClear}"
                                        IsChecked="{Binding Session.Setting.AutoClear, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:NumberBox
                                            Width="160"
                                            MaxHeight="32"
                                            ClearButtonEnabled="False"
                                            Minimum="1"
                                            SmallChange="0.5"
                                            ToolTip="{DynamicResource ChannelIntelPage_AutoClear_Tip}"
                                            Visibility="{Binding Session.Setting.AutoClear, Converter={StaticResource BoolToVis}}"
                                            Value="{Binding Session.Setting.AutoClearMinute, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="min"
                                            Visibility="{Binding Session.Setting.AutoClear, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource ChannelIntelPage_AutoDowngrade}"
                                        IsChecked="{Binding Session.Setting.AutoDowngrade, Mode=TwoWay}" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                        <ui:NumberBox
                                            Width="160"
                                            MaxHeight="32"
                                            ClearButtonEnabled="False"
                                            Minimum="0.5"
                                            SmallChange="0.5"
                                            ToolTip="{DynamicResource ChannelIntelPage_AutoDowngrade_Tip}"
                                            Visibility="{Binding Session.Setting.AutoDowngrade, Converter={StaticResource BoolToVis}}"
                                            Value="{Binding Session.Setting.AutoDowngradeMinute, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="min"
                                            Visibility="{Binding Session.Setting.AutoDowngrade, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource ChannelIntelPage_SubZKB}"
                                        IsChecked="{Binding Session.Setting.SubZKB, Mode=TwoWay}" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                        <ui:NumberBox
                                            Width="160"
                                            MaxHeight="32"
                                            ClearButtonEnabled="False"
                                            Minimum="1"
                                            SmallChange="1"
                                            ToolTip="{DynamicResource ChannelIntelPage_SubZKB_Tip}"
                                            Visibility="{Binding Session.Setting.SubZKB, Converter={StaticResource BoolToVis}}"
                                            Value="{Binding Session.Setting.KBTime, Mode=TwoWay}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="sec"
                                            Visibility="{Binding Session.Setting.SubZKB, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  频道内容  -->
                <TabItem Header="{DynamicResource ChannelIntelPage_Contents}">
                    <RichTextBox
                        x:Name="ChatContentsBox"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto">
                        <FlowDocument />
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="OnClearContentsClick" Header="{DynamicResource General_Clear}" />
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                </TabItem>
            </TabControl>

            <!--  操作按钮（底栏）  -->
            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_Start}"
                        Click="OnStartClick"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="{DynamicResource ChannelIntelPage_Start}"
                        Visibility="{Binding SelectedNotRunning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_Stop}"
                        Click="OnStopClick"
                        ToolTip="{DynamicResource ChannelIntelPage_Stop}"
                        Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_StopSound}"
                        Click="OnStopSoundClick"
                        Icon="{ui:SymbolIcon SpeakerMute24}"
                        ToolTip="{DynamicResource ChannelIntelPage_StopSound}"
                        Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_RestorePos}"
                        Click="OnRestorePosClick"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        ToolTip="{DynamicResource ChannelIntelPage_RestorePos}"
                        Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        AutomationProperties.Name="{DynamicResource ChannelIntelPage_ApplySettingToAll}"
                        Click="OnApplySettingToAllClick"
                        Icon="{ui:SymbolIcon Copy24}"
                        IsEnabled="{Binding SelectedNotRunning}"
                        ToolTip="{DynamicResource ChannelIntelPage_ApplySettingToAll}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>
    </Grid>
</Page>
