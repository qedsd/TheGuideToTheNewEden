<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ChannelTranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  角色行：预警中（翻译中）左侧橙条  -->
        <DataTemplate x:Key="CharacterItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Width="3"
                    Height="16"
                    Margin="0,0,6,0"
                    Fill="{DynamicResource SystemFillColorCautionBrush}"
                    RadiusX="2"
                    RadiusY="2"
                    ToolTip="{DynamicResource ChannelTranslationPage_Running}"
                    Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  AI 未配置提示  -->
        <Border
            Grid.Row="0"
            Margin="12,12,12,0"
            Padding="8,6"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="4"
            Visibility="{Binding IsAiUnavailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding AiUnavailableText}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12" Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：角色列表 ============  -->
            <controls:CardControl Grid.Column="0" Header="{DynamicResource ChannelTranslationPage_TargetCharacter}">
                <ListBox
                    ItemTemplate="{StaticResource CharacterItemTemplate}"
                    ItemsSource="{Binding Characters}"
                    IsSynchronizedWithCurrentItem="False"
                    ScrollViewer.CanContentScroll="True"
                    SelectionChanged="OnCharacterSelectionChanged" />
                <controls:CardControl.Footer>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource General_StartAll}"
                            Click="OnStartAllClick"
                            Icon="{ui:SymbolIcon Play24}"
                            ToolTip="{DynamicResource General_StartAll}" />
                        <ui:Button
                            Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource General_StopAll}"
                            Click="OnStopAllClick"
                            ToolTip="{DynamicResource General_StopAll}"
                            Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            AutomationProperties.Name="{DynamicResource General_RefreshList}"
                            Click="OnRefreshClick"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="{DynamicResource General_RefreshList}" />
                    </StackPanel>
                </controls:CardControl.Footer>
            </controls:CardControl>

            <!--  ============ 中：频道与参数 ============  -->
            <controls:CardControl
                Grid.Column="1"
                Margin="8,0"
                Header="{DynamicResource ChannelTranslationPage_ChannelsAndSettings}"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox
                        Grid.Row="0"
                        IsEnabled="{Binding SelectedNotRunning}"
                        ItemContainerStyle="{StaticResource StretchListItem}"
                        ItemsSource="{Binding ChatChanelInfos}"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingStackPanel.IsVirtualizing="True"
                        VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        MinWidth="32"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding ChannelName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding SessionStarted, StringFormat={}{0:MM-dd HH:mm}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" IsEnabled="{Binding SelectedNotRunning}">
                        <Border Style="{StaticResource SettingsDivider}" />
                        <CheckBox
                            Margin="0,8,0,0"
                            Content="{DynamicResource ChannelTranslationPage_SkipMyself}"
                            IsChecked="{Binding SkipMyself, Mode=TwoWay}" />
                        <CheckBox
                            Margin="0,6,0,0"
                            Content="{DynamicResource ChannelTranslationPage_OnlyNonChinese}"
                            IsChecked="{Binding OnlyNonChinese, Mode=TwoWay}" />

                        <!--  上下文：跟 AI 翻译页同一个思路，频道场景默认开（一句话经常依赖前文）  -->
                        <CheckBox
                            Margin="0,6,0,0"
                            Content="{DynamicResource ChannelTranslationPage_UseContext}"
                            IsChecked="{Binding UseContext, Mode=TwoWay}"
                            ToolTip="{DynamicResource ChannelTranslationPage_UseContext_Tip}" />
                        <TextBlock
                            Margin="0,8,0,2"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource ChannelTranslationPage_ContextLimit}"
                            ToolTip="{DynamicResource ChannelTranslationPage_UseContext_Tip}" />
                        <ui:NumberBox
                            Maximum="20"
                            Minimum="1"
                            SmallChange="1"
                            ToolTip="{DynamicResource ChannelTranslationPage_UseContext_Tip}"
                            Value="{Binding ContextLimit, Mode=TwoWay}" />

                        <TextBlock
                            Margin="0,8,0,2"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource ChannelTranslationPage_MinLength}" />
                        <ui:NumberBox
                            Maximum="200"
                            Minimum="1"
                            SmallChange="1"
                            Value="{Binding MinLength, Mode=TwoWay}" />
                        <TextBlock
                            Margin="0,8,0,2"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource ChannelTranslationPage_Keyword}" />
                        <ui:TextBox
                            PlaceholderText="{DynamicResource ChannelTranslationPage_Keyword_Tip}"
                            Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <!--  翻译方向只读展示：跟着「AI 翻译」页的源/目标语言设置走  -->
                        <TextBlock
                            Margin="0,10,0,2"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource ChannelTranslationPage_Direction}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding DirectionText}"
                            TextWrapping="Wrap"
                            ToolTip="{DynamicResource ChannelTranslationPage_Direction_Tip}" />
                    </StackPanel>
                </Grid>

                <controls:CardControl.Footer>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            Appearance="Primary"
                            AutomationProperties.Name="{DynamicResource General_Start}"
                            Click="OnStartClick"
                            Icon="{ui:SymbolIcon Play24}"
                            ToolTip="{DynamicResource General_Start}"
                            Visibility="{Binding SelectedNotRunning, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            AutomationProperties.Name="{DynamicResource General_Stop}"
                            Click="OnStopClick"
                            ToolTip="{DynamicResource General_Stop}"
                            Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </controls:CardControl.Footer>
            </controls:CardControl>

            <!--  ============ 右：实时译文 ============  -->
            <controls:CardControl
                Grid.Column="2"
                Header="{DynamicResource ChannelTranslationPage_Result}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <uc:ChannelTranslationResultView Grid.Row="0" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />
                </Grid>
                <controls:CardControl.Footer>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource General_Clear}"
                            Click="OnClearClick"
                            Icon="{ui:SymbolIcon Eraser24}"
                            ToolTip="{DynamicResource General_Clear}" />
                        <ui:Button
                            AutomationProperties.Name="{DynamicResource TranslationPage_PopWindow}"
                            Click="OnPopWindowClick"
                            Icon="{ui:SymbolIcon WindowNew24}"
                            ToolTip="{DynamicResource TranslationPage_PopWindow}" />
                    </StackPanel>
                </controls:CardControl.Footer>
            </controls:CardControl>
        </Grid>

        <!--  AI 未配置：整页引导（与「AI 翻译」页同一套说法与按钮）  -->
        <Border
            Grid.Row="1"
            Margin="12"
            Padding="24"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="6"
            Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVis}}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Settings24" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource TranslationPage_Ai_NotConfigured_Title}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding AiUnavailableText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{DynamicResource TranslationPage_Ai_NotConfigured_Support}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="4,0"
                        Appearance="Primary"
                        Click="OnGoConfigureClick"
                        Content="{DynamicResource TranslationPage_Ai_GoConfigure}"
                        Icon="{ui:SymbolIcon Settings24}" />
                    <ui:Button
                        Margin="4,0"
                        Click="OnRecheckClick"
                        Content="{DynamicResource TranslationPage_Ai_Recheck}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
