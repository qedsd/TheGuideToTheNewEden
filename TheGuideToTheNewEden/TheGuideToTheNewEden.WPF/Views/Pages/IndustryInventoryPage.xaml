<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryInventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="InvLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="InvCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="InvNumberCell"
            BasedOn="{StaticResource InvCell}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style
            x:Key="InvDataGrid"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：仓库列表与管理  -->
        <controls:CardControl Grid.Column="0" Header="仓库">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    Grid.Row="0"
                    ItemContainerStyle="{StaticResource StretchListItem}"
                    ItemsSource="{Binding Warehouses}"
                    SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Summary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource InvLabel}" Text="仓库名称" />
                    <ui:TextBox
                        PlaceholderText="新仓库名称"
                        Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        Click="OnCreateWarehouseClick"
                        Content="新建仓库"
                        Icon="{ui:SymbolIcon Add24}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Click="OnRenameWarehouseClick"
                            Content="重命名"
                            Icon="{ui:SymbolIcon Edit24}" />
                        <ui:Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Appearance="Danger"
                            Click="OnDeleteWarehouseClick"
                            Content="删除"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </controls:CardControl>

        <!--  右：添加 / 导入 + 明细  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CardControl Grid.Row="0" Header="添加 / 导入">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource InvLabel}" Text="搜索物品（中英文名称均可）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                KeyDown="OnSearchKeyDown"
                                PlaceholderText="输入物品名称"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="2"
                                Click="OnSearchClick"
                                Content="搜索" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox
                                Grid.Column="0"
                                MaxHeight="150"
                                ItemsSource="{Binding SearchResults}"
                                SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding ID}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ui:NumberBox
                                Grid.Column="2"
                                Maximum="1000000000"
                                Minimum="1"
                                SmallChange="1"
                                Value="{Binding AddQuantity, Mode=TwoWay}" />
                            <ui:Button
                                Grid.Column="4"
                                Appearance="Primary"
                                Click="OnAddItemClick"
                                Content="添加到仓库" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource InvLabel}" Text="从角色导入资产" />
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,1"
                                            Content="{Binding DisplayName}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="OnMergeImportClick"
                                Content="合并导入" />
                            <ui:Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="OnReplaceImportClick"
                                Content="覆盖导入" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Click="OnImportCsvClick"
                                Content="导入 CSV" />
                            <ui:Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Click="OnExportCsvClick"
                                Content="导出 CSV" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding StatusText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <controls:CardControl Grid.Row="2" Header="库存明细">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:DataGrid
                        Grid.Row="0"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        Style="{StaticResource InvDataGrid}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource InvCell}"
                                Header="物品" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding QuantityText}"
                                ElementStyle="{StaticResource InvNumberCell}"
                                Header="数量" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding VolumeText}"
                                ElementStyle="{StaticResource InvNumberCell}"
                                Header="体积" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding TotalText}" />
                        <ui:NumberBox
                            Width="120"
                            Margin="0,0,8,0"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding EditQuantity, Mode=TwoWay}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Click="OnSetQuantityClick"
                            Content="设置数量" />
                        <ui:Button
                            Appearance="Danger"
                            Click="OnRemoveItemClick"
                            Content="移除选中物品"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>
        </Grid>
    </Grid>
</Page>
