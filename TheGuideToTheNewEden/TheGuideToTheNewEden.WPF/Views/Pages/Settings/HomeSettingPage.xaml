<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.HomeSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        主页设置（阶段 99 新建、阶段 100 扩充）：
        ① 卡片显示——钱包 / 行情 / 最近使用三张卡片的显示开关；
        ② 快捷方式——拖动排序、移除、添加（与主页编辑模式共用 HomeShortcutService 一份数据）。
        注意与阶段 97 物理删除的旧 HomeSettingPage（上下移按钮的快捷方式管理页）不同——
        本页的排序用与主页编辑模式一致的拖动方式。
    -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="36,20,36,40">

                <!--  卡片显示  -->
                <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource Home.Setting.CardsSection}" />
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel>
                        <controls:SettingCard
                            Description="{DynamicResource Home.Setting.ShowWallet_Desc}"
                            Icon="Wallet24"
                            Title="{DynamicResource Home.Setting.ShowWallet}">
                            <ui:ToggleSwitch x:Name="WalletToggle" />
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <controls:SettingCard
                            Description="{DynamicResource Home.Setting.ShowMarket_Desc}"
                            Icon="DataTrending24"
                            Title="{DynamicResource Home.Setting.ShowMarket}">
                            <ui:ToggleSwitch x:Name="MarketToggle" />
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <controls:SettingCard
                            Description="{DynamicResource Home.Setting.ShowRecent_Desc}"
                            Icon="History24"
                            Title="{DynamicResource Home.Setting.ShowRecent}">
                            <ui:ToggleSwitch x:Name="RecentToggle" />
                        </controls:SettingCard>
                    </StackPanel>
                </Border>

                <!--  快捷方式（阶段 100 加入；阶段 101 起是全局唯一的编辑入口）  -->
                <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource Home.Setting.ShortcutsSection}" />
                <TextBlock
                    Margin="0,2,0,8"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{DynamicResource Home.Setting.ShortcutsHint}"
                    TextWrapping="Wrap" />
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel>
                        <Grid Margin="12,10,12,8">
                            <TextBlock
                                x:Name="CountText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,6,0"
                                    Appearance="Secondary"
                                    Click="OnRestoreDefaultsClick"
                                    Content="{DynamicResource Home.Quick.RestoreDefaults}"
                                    ToolTip="{DynamicResource Home.Quick.RestoreConfirm}" />
                                <ui:Button
                                    x:Name="AddButton"
                                    Appearance="Primary"
                                    Click="OnAddClick"
                                    Content="{DynamicResource Home.Quick.AddTile}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource SettingsDivider}" />
                        <ItemsControl
                            x:Name="RowList"
                            Margin="6,4,6,6"
                            AllowDrop="True"
                            Background="Transparent"
                            DragOver="OnListDragOver"
                            Drop="OnListDrop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,2"
                                        Padding="9,6"
                                        AllowDrop="True"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        DragLeave="OnRowDragLeave"
                                        DragOver="OnRowDragOver"
                                        Drop="OnRowDrop"
                                        MouseLeftButtonDown="OnRowMouseLeftButtonDown"
                                        MouseMove="OnRowMouseMove"
                                        ToolTip="{Binding DetailToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!--  拖动中：半透明（与主页磁贴同视觉）  -->
                                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                        <Setter Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                    <!--  落位目标：强调色描边（与主页磁贴同视觉）  -->
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Padding" Value="8,5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="30"
                                                Height="30"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <Image
                                                    Width="18"
                                                    Height="18"
                                                    Source="{Binding TileIcon}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <!--  行尾操作：宽窄切换 + 移除（Grid.Column="2" 不能省——漏了会挤到图标旁）  -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <!--  宽窄切换：图标随当前尺寸变化（小 → 扩为宽磁贴，宽 → 缩为小磁贴）  -->
                                                <ui:Button
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    Appearance="Transparent"
                                                    Click="OnSizeToggleClick">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="{Binding SizeToggleIcon}" />
                                                    </ui:Button.Icon>
                                                    <ui:Button.ToolTip>
                                                        <ToolTip Content="{Binding SizeToggleToolTip}" />
                                                    </ui:Button.ToolTip>
                                                </ui:Button>
                                                <ui:Button
                                                    Padding="4"
                                                    Margin="2,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Appearance="Transparent"
                                                    Click="OnRemoveClick"
                                                    Icon="{ui:SymbolIcon Dismiss24}"
                                                    ToolTip="{DynamicResource Home.Quick.Remove}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="EmptyHint"
                            Margin="12,4,12,10"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource Home.Quick.Empty}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
