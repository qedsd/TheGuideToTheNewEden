<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.GameLogSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="36,20,36,40">
                <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource SettingPage_GameLog}" />
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel>
                        <controls:SettingCard
                            Description="{DynamicResource Setting_GameLog_EVELogsPath_Description}"
                            Icon="Folder24"
                            Title="{DynamicResource Setting_GameLog_EVELogsPath_Title}">
                            <ui:TextBox
                                x:Name="LogsPathTextBox"
                                Width="280"
                                HorizontalAlignment="Right" />
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <controls:SettingCard
                            Description="{DynamicResource Setting_GameLog_ChannelDuration_Description}"
                            Icon="Calendar24"
                            Title="{DynamicResource Setting_GameLog_ChannelDuration_Title}">
                            <ui:NumberBox
                                x:Name="ChannelDurationBox"
                                Width="160"
                                HorizontalAlignment="Right"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline" />
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <controls:SettingCard
                            Description="{DynamicResource Setting_GameLog_MaxShowItems_Description}"
                            Icon="Document24"
                            Title="{DynamicResource Setting_GameLog_MaxShowItems_Title}">
                            <ui:NumberBox
                                x:Name="MaxShowItemsBox"
                                Width="160"
                                HorizontalAlignment="Right"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline" />
                        </controls:SettingCard>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>