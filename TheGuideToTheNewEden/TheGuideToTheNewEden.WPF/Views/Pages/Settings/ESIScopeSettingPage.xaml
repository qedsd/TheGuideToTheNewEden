<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.ESIScopeSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Grid Margin="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource SettingPage_ESIScope}" />

        <Border
            Grid.Row="1"
            Style="{StaticResource SettingsGroupBorder}">
            <DockPanel>
                <CheckBox
                    x:Name="SelectAllCheckBox"
                    DockPanel.Dock="Top"
                    Margin="16,14,16,10"
                    Content="{DynamicResource ESIScopeSettingPage_SelectAll}" />

                <Border DockPanel.Dock="Top" Style="{StaticResource SettingsDivider}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScopeList" Margin="8,6,8,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="8,4"
                                    Content="{Binding Scope}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>