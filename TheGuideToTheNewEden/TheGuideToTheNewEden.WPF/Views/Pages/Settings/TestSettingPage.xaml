<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.TestSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="36,20,36,40">
                <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource SettingPage_Test}" />
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel>
                        <!--  系统通知  -->
                        <controls:SettingCard
                            Description="{DynamicResource TestSettingPage_SystemNotify_Desc}"
                            Icon="Alert24"
                            Title="{DynamicResource TestSettingPage_SystemNotify}">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="SendToastButton"
                                    MinWidth="112"
                                    Content="{DynamicResource TestSettingPage_SystemNotify_SendToast}" />
                                <Button
                                    x:Name="CheckNotificationButton"
                                    MinWidth="112"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource TestSettingPage_SystemNotify_CheckSetting}" />
                            </StackPanel>
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <!--  声音播放  -->
                        <controls:SettingCard
                            Description="{DynamicResource TestSettingPage_MediaPlayer_Desc}"
                            Icon="SoundSource24"
                            Title="{DynamicResource TestSettingPage_MediaPlayer}">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="PlaySoundButton"
                                    MinWidth="72"
                                    Content="{DynamicResource TestSettingPage_MediaPlayer_Play}" />
                                <Button
                                    x:Name="PauseSoundButton"
                                    MinWidth="72"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource TestSettingPage_MediaPlayer_Pause}" />
                                <Button
                                    x:Name="PickSoundButton"
                                    MinWidth="112"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource TestSettingPage_MediaPlayer_PickFile}" />
                            </StackPanel>
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <!--  HKCR 协议  -->
                        <controls:SettingCard
                            Description="{DynamicResource TestSettingPage_HKCRProtocol_Desc}"
                            Icon="Link24"
                            Title="{DynamicResource TestSettingPage_HKCRProtocol}">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="ReadProtocolButton"
                                    MinWidth="80"
                                    Content="{DynamicResource TestSettingPage_ReadProtocol}" />
                                <Button
                                    x:Name="WriteProtocolButton"
                                    MinWidth="80"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource TestSettingPage_RegistyProtocol}" />
                                <Button
                                    x:Name="DeleteProtocolButton"
                                    MinWidth="80"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource TestSettingPage_DeleteProtocol}" />
                            </StackPanel>
                        </controls:SettingCard>

                        <Border Style="{StaticResource SettingsDivider}" />

                        <controls:SettingCard Icon="Info24" Title="{DynamicResource TestSettingPage_HKCRProtocol}">
                            <TextBlock
                                x:Name="ProtocolValueText"
                                Width="420"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </controls:SettingCard>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>