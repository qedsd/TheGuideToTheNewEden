<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.AiAssistantSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="36,20,36,40">
                <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="{DynamicResource SettingPage_AiAssistant}" />

                <!--  模型端点提示：助手复用「AI 翻译」的设置，这里只放行为参数  -->
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16,12">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Endpoint_Desc}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  ============ 行为 ============  -->
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16,12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Behavior}" />

                        <!--  最大工具轮数  -->
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource AssistantSettingPage_MaxToolRounds}" />
                        <ui:NumberBox
                            x:Name="RoundsBox"
                            Width="160"
                            HorizontalAlignment="Left"
                            Maximum="30"
                            Minimum="1"
                            SmallChange="1" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_MaxToolRounds_Desc}"
                            TextWrapping="Wrap" />

                        <!--  默认角色  -->
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource AssistantSettingPage_DefaultCharacter}" />
                        <ui:TextBox
                            x:Name="CharacterBox"
                            Width="320"
                            HorizontalAlignment="Left"
                            PlaceholderText="{DynamicResource AssistantSettingPage_DefaultCharacter_Tip}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_DefaultCharacter_Desc}"
                            TextWrapping="Wrap" />

                        <!--  确认写操作  -->
                        <ui:ToggleSwitch
                            x:Name="ConfirmToggle"
                            Margin="0,12,0,0"
                            Content="{DynamicResource AssistantSettingPage_Confirm}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Confirm_Desc}"
                            TextWrapping="Wrap" />

                        <!--  全局快捷键  -->
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource TranslationFieldLabel}"
                            Text="{DynamicResource AssistantSettingPage_Hotkey}" />
                        <ui:TextBox
                            x:Name="HotkeyBox"
                            Width="200"
                            HorizontalAlignment="Left"
                            PlaceholderText="Alt+Q" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Hotkey_Desc}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  ============ 系统提示词 ============  -->
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16,12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Prompt}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AssistantSettingPage_Prompt_Desc}"
                            TextWrapping="Wrap" />
                        <ui:TextBox
                            x:Name="PromptBox"
                            MinHeight="120"
                            Margin="0,8,0,0"
                            AcceptsReturn="True"
                            MaxHeight="260"
                            PlaceholderText="{DynamicResource AssistantSettingPage_Prompt_Tip}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Click="OnSaveClick"
                        Content="{DynamicResource AssistantSettingPage_Save}"
                        Icon="{ui:SymbolIcon Save24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="OnRestoreClick"
                        Content="{DynamicResource AssistantSettingPage_Restore}"
                        Icon="{ui:SymbolIcon ArrowReset24}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
