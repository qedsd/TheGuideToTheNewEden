<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Settings.AiAssistantSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        设置 → AI：与「设置首页」同一套钻取式导航。
        SectionView = 二级菜单（四节，占满整页）；点某一节 → DetailView = 三级（该节详情 + 面包屑返回）。
    -->
    <Grid>
        <!--  ============ 二级菜单（整页列表） ============  -->
        <ScrollViewer
            x:Name="SectionView"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="36,20,36,40">
                    <!--
                        不画页面标题：当前所在分类已经由设置壳页的面包屑显示（「设置 › AI › …」），
                        这里直接给菜单项，与其它设置子页保持一致（阶段 125）。
                    -->
                    <Border Style="{StaticResource SettingsGroupBorder}">
                        <ItemsControl x:Name="SectionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="Section_Click"
                                        Style="{StaticResource SettingsRowButton}"
                                        Tag="{Binding}">
                                        <Grid MinHeight="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                Symbol="{Binding Icon}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="16,12"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <ui:SymbolIcon
                                                Grid.Column="2"
                                                Margin="24,0,16,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="ChevronRight24" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ui:Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Click="OnRestoreAllClick"
                        Content="{DynamicResource AssistantSettingPage_Restore}"
                        Icon="{ui:SymbolIcon ArrowReset24}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource AssistantSettingPage_Restore_Desc}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  ============ 三级菜单（某一节的详情） ============  -->
        <!--  没有自己的标题栏：导航标题由外层设置页的面包屑显示成「设置 › AI › 节名」（阶段 124）  -->
        <Grid x:Name="DetailView" Background="Transparent" Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!--
                    顶部**不给**边距（阶段 129）：分节视图自己以 SettingsSectionHeader 开头（它自带 24px 上边距），
                    与其它设置子页（根 `Margin="36,0,36,40"` + 节标题）完全一致；
                    这里再给 24 就比别的页多出一段空白（用户实机反馈"与导航栏隔了一段高度"）。
                -->
                <ContentControl x:Name="SectionHost" Margin="36,0,36,32" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
