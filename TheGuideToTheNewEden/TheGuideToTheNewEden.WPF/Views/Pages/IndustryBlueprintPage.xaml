<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryBlueprintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="IndustryFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <Style x:Key="IndustryCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="IndustryNumberCellStyle"
            BasedOn="{StaticResource IndustryCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：搜索与结果  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryBp_SearchLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        KeyDown="OnSearchKeyDown"
                        PlaceholderText="{DynamicResource IndustryPage_SearchPlaceholder}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="2"
                        Click="OnSearchClick"
                        Content="{DynamicResource IndustryPage_Search}" />
                </Grid>
            </StackPanel>

            <ListBox
                Grid.Row="1"
                Margin="0,8,0,0"
                DisplayMemberPath="ProductName"
                ItemsSource="{Binding Results}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" />
        </Grid>

        <!--  右：蓝图详情  -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CardControl Grid.Row="0" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Subtitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:CardControl>

            <ui:DataGrid
                x:Name="DetailGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                ItemsSource="{Binding Details}"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Kind}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryBp_Col_Kind}" />
                    <DataGridTextColumn
                        Width="360"
                        Binding="{Binding Name}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryBp_Col_Name}" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Amount}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryBp_Col_Amount}" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Note}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryBp_Col_Note}" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
    </Grid>
</Page>
