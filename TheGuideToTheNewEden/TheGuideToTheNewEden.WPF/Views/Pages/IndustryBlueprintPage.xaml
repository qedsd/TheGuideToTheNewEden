<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryBlueprintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TheGuideToTheNewEden.WPF.ViewModels.Industry"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RecipeRow" TargetType="Border">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <DataTemplate x:Key="RecipeRowTemplate" DataType="{x:Type vm:IndustryRecipeRow}">
            <Border Style="{StaticResource RecipeRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="9.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding Note}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Text="{Binding Amount}" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ActivityTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="IndustryProductTreeItemStyle"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:IndustryProductTreeCategory}" ItemsSource="{Binding Groups}">
            <TextBlock
                Margin="0,2"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:IndustryProductTreeGroup}" ItemsSource="{Binding Items}">
            <TextBlock
                Margin="0,1"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:IndustryProductTreeItem}">
            <StackPanel Margin="0,1,4,1">
                <TextBlock
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding BlueprintName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTabTemplate" DataType="{x:Type vm:IndustryActivityItem}">
            <StackPanel>
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}" />
                <TextBlock
                    FontSize="9"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding TimeText}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：可制造物品树与搜索 =================  -->
        <controls:CardControl
            Grid.Column="0"
            Padding="14,8"
            CornerRadius="8">
            <controls:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Symbol="Search24" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="可制造物品" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding ProductCountText}" />
                </Grid>
            </controls:CardControl.Header>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        KeyDown="OnSearchKeyDown"
                        PlaceholderText="搜索可制造物品"
                        Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="2"
                        Click="OnSearchClick"
                        Icon="{ui:SymbolIcon Search24}" />
                </Grid>

                <TreeView
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource IndustryProductTreeItemStyle}"
                    ItemsSource="{Binding ProductTree}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItemChanged="OnProductTreeSelected" />
            </Grid>
        </controls:CardControl>

        <!--  ================= 右：配方可视化 =================  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题区  -->
            <Border
                Grid.Row="0"
                Padding="18,14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Subtitle}"
                        TextWrapping="Wrap" />

                    <ListBox
                        Margin="0,10,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ActivityTabItem}"
                        ItemTemplate="{StaticResource ActivityTabTemplate}"
                        ItemsSource="{Binding Activities}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedActivity, Mode=TwoWay}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>

            <!--  配方主体：输入 → 输出  -->
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:CardControl
                            Grid.Column="0"
                            Padding="14,8"
                            CornerRadius="8">
                            <controls:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="Wrench24" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="输入材料" />
                                </StackPanel>
                            </controls:CardControl.Header>
                            <ItemsControl ItemTemplate="{StaticResource RecipeRowTemplate}" ItemsSource="{Binding MaterialRows}" />
                        </controls:CardControl>

                        <Grid Grid.Column="1" Margin="8,0">
                            <Border
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Border
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="13">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Symbol="ChevronRight24" />
                            </Border>
                        </Grid>

                        <controls:CardControl
                            Grid.Column="2"
                            Padding="14,8"
                            CornerRadius="8">
                            <controls:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                        Symbol="Target24" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="输出产物" />
                                </StackPanel>
                            </controls:CardControl.Header>
                            <ItemsControl ItemTemplate="{StaticResource RecipeRowTemplate}" ItemsSource="{Binding ProductRows}" />
                        </controls:CardControl>
                    </Grid>

                    <controls:CardControl
                        Margin="0,12,0,0"
                        Padding="14,8"
                        CornerRadius="8">
                        <controls:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    Symbol="Settings24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="技能需求" />
                            </StackPanel>
                        </controls:CardControl.Header>
                        <ItemsControl ItemTemplate="{StaticResource RecipeRowTemplate}" ItemsSource="{Binding SkillRows}" />
                    </controls:CardControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
