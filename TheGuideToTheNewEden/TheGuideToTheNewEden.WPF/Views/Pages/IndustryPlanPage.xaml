<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TheGuideToTheNewEden.WPF.ViewModels.Industry"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="IndustryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style x:Key="IndustryMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="IndustryMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="IndustryMetricValueCompact"
            BasedOn="{StaticResource IndustryMetricValue}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style
            x:Key="IndustryProfitText"
            BasedOn="{StaticResource IndustryMetricValueCompact}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProfitIsPositive}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProfit}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="IndustryTargetProfitText"
            BasedOn="{StaticResource IndustryMetricValueCompact}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfitPositive}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTargetProfit}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="IndustryOverviewTargetItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <DataTemplate x:Key="IndustryCostSliceCompactTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Name}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding PercentText}" />
            </Grid>
        </DataTemplate>

        <Style
            x:Key="IndustryDataGrid"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AlternatingRowBackground" Value="Transparent" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="IndustrySmallChip" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style
            x:Key="IndustryFlatItem"
            BasedOn="{StaticResource StretchListItem}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style
            x:Key="IndustryProductTreeItemStyle"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:IndustryProductTreeCategory}" ItemsSource="{Binding Groups}">
            <TextBlock
                Margin="0,2"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:IndustryProductTreeGroup}" ItemsSource="{Binding Items}">
            <TextBlock
                Margin="0,1"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:IndustryProductTreeItem}">
            <Grid Margin="0,1,4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding BlueprintName}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Width="22"
                    Height="22"
                    Margin="0,0,8,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="OnAddProductClick"
                    Icon="{ui:SymbolIcon Add24}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource IndustryPage_AddToTarget}" />
            </Grid>
        </DataTemplate>

        <!--  生产链节点：扁平列表 + 缩进 + 展开/收起，避免 TreeView 把卡片挤窄  -->
        <DataTemplate x:Key="IndustryNodeTemplate" DataType="{x:Type vm:IndustryPlanNodeViewModel}">
            <Grid Margin="{Binding IndentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    Padding="0"
                    VerticalAlignment="Center"
                    Appearance="Transparent"
                    Click="OnToggleNodeClick"
                    Tag="{Binding}"
                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronDown24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:SymbolIcon
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronRight24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </ui:Button>

                <Border
                    x:Name="NodeCard"
                    Grid.Column="1"
                    Margin="0,1,4,1"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTip="{Binding QuantityText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Accent"
                            Grid.Column="0"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            CornerRadius="3,0,0,3" />

                        <Grid
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <ui:SymbolIcon
                                x:Name="BuildIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Symbol="Wrench24"
                                Visibility="{Binding IsBuild, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon
                                x:Name="BuyIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Database24"
                                Visibility="{Binding IsBuy, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon
                                x:Name="InventionIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Symbol="DataSunburst24"
                                Visibility="{Binding IsInvention, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Margin="0,7,8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid
                                    x:Name="DecisionChip"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                    <Border
                                        x:Name="DecisionBg"
                                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        CornerRadius="4"
                                        Opacity="0.18" />
                                    <TextBlock
                                        x:Name="DecisionLabel"
                                        Margin="7,1"
                                        FontSize="10"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Text="{Binding DecisionText}" />
                                </Grid>
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding ActivityText}" />
                            </StackPanel>

                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding QuantityText}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding RunsText}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding MeTeText}" />
                            </StackPanel>

                            <controls:RatioBar
                                Height="3"
                                Margin="0,5,0,0"
                                BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Ratio="{Binding CostSharePercent}"
                                ToolTip="{Binding CostShareText}"
                                TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="9.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding CostShareText}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            Margin="0,7,10,7"
                            HorizontalAlignment="Right">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding FullBuildCostText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding MarketText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DecisionKey}" Value="buy">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="invention">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="stock">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="surplus">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="jobs">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DecisionKey}" Value="mixed">
                    <Setter TargetName="Accent" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionBg" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter TargetName="DecisionLabel" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="IndustryTargetTemplate">
            <Border
                Margin="0,2"
                Padding="8,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:NumberBox
                        Grid.Column="1"
                        Margin="6,0"
                        MaxDecimalPlaces="0"
                        Maximum="1000000"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="{Binding Quantity, Mode=TwoWay}" />
                    <ui:Button
                        Grid.Column="2"
                        Appearance="Transparent"
                        Click="OnRemoveTargetClick"
                        Icon="{ui:SymbolIcon Delete24}"
                        Tag="{Binding}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Height="28"
                        Margin="0,4,6,0"
                        FontSize="11"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding DataContext.TargetDecryptors, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        SelectedItem="{Binding SelectedDecryptor, Mode=TwoWay}"
                        ToolTip="{DynamicResource IndustryPage_DecryptorTargetTip}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IndustryRigTemplate">
            <Border
                Margin="0,2"
                Padding="8,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis" />
                    <ui:Button
                        Grid.Column="1"
                        Width="24"
                        Height="24"
                        Appearance="Transparent"
                        Click="OnRemoveRigClick"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        Tag="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IndustryCostSliceTemplate">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Name}" />
                <controls:RatioBar
                    x:Name="SliceBar"
                    Grid.Column="1"
                    Height="4"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Ratio="{Binding Percent}"
                    TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding PercentText}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="job">
                    <Setter TargetName="SliceBar" Property="BarBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="stock">
                    <Setter TargetName="SliceBar" Property="BarBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="IndustryNodeDetailTemplate" DataType="{x:Type vm:IndustryPlanNodeViewModel}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,0,2,4">
                    <TextBlock
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource IndustrySmallChip}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DecisionText}" />
                        </Border>
                        <Border Style="{StaticResource IndustrySmallChip}" Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ActivityText}" />
                        </Border>
                        <Border Style="{StaticResource IndustrySmallChip}" Visibility="{Binding HasMeTe, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding MeTeText}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding QuantityText}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{Binding StockText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasStock, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding RunsText}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding BlueprintStockText}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasBlueprintStockText, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="{Binding FullCostLabel}"
                                ToolTip="{Binding FullCostHint}" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding FullBuildCostText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="{DynamicResource IndustryPage_CashOutlay}"
                                ToolTip="{DynamicResource IndustryPage_CashOutlayTip}" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding CashCostText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource IndustryMetricLabel}"
                                Text="{DynamicResource IndustryPage_JobCostIncluded}"
                                ToolTip="{DynamicResource IndustryPage_JobCostTip}" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding JobCostText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_JobDuration}" />
                            <TextBlock Style="{StaticResource IndustryMetricValue}" Text="{Binding JobTimeText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Style="{StaticResource IndustryLabel}"
                        Text="{DynamicResource IndustryPage_CostBreakdown}"
                        ToolTip="{DynamicResource IndustryPage_CostBreakdownTip}" />
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPage_PurchaseMaterials}"
                            ToolTip="{DynamicResource IndustryPage_PurchaseMaterialsTip}" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Ratio="{Binding MaterialShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding MaterialShare, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPage_JobCost}"
                            ToolTip="{DynamicResource IndustryPage_JobCostIncludedTip}" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemFillColorCautionBrush}"
                            Ratio="{Binding JobShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding JobShare, StringFormat={}{0:0}%}" />
                    </Grid>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource IndustryPage_StockOffset}"
                            ToolTip="{DynamicResource IndustryPage_StockOffsetTip}" />
                        <controls:RatioBar
                            Grid.Column="1"
                            Height="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center"
                            BarBrush="{DynamicResource SystemFillColorSuccessBrush}"
                            Ratio="{Binding StockShare}"
                            TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding StockShare, StringFormat={}{0:0}%}" />
                    </Grid>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource IndustryPage_CostFormula}"
                        TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding HasInventionData, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_InventionData}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding InventionText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding InventionCostHint}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding InventionWarning}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasInventionWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding DecryptorText}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_MarketReference}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding MarketText}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding ReferencePriceText}" />

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_NodeActions}" />
                    <WrapPanel>
                        <ui:Button
                            Margin="0,0,6,0"
                            Appearance="Secondary"
                            Click="OnForceBuildClick"
                            Content="{DynamicResource IndustryPage_ForceBuild}" />
                        <ui:Button
                            Margin="0,0,6,0"
                            Appearance="Secondary"
                            Click="OnForceBuyClick"
                            Content="{DynamicResource IndustryPage_ForceBuy}" />
                        <ui:Button
                            Appearance="Secondary"
                            Click="OnBlacklistClick"
                            Content="{DynamicResource IndustryPage_Blacklist}" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_DirectInput}" />
                    <ui:DataGrid
                        MaxHeight="220"
                        ItemsSource="{Binding Children}"
                        Style="{StaticResource IndustryDataGrid}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="{DynamicResource IndustryPage_Col_Item}" />
                            <DataGridTextColumn
                                Width="180"
                                Binding="{Binding QuantityText}"
                                Header="{DynamicResource IndustryPage_Col_NeedProduceBuy}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <!--  ================= 分区 Tab =================  -->
        <TabControl
            Grid.Row="2"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            SelectedIndex="{Binding SectionTabIndex, Mode=TwoWay}">
            <!--  ================= 计划设置（计算前） =================  -->
            <TabItem Header="{DynamicResource IndustryPage_Tab_Settings}">
                <Grid>
                    <controls:CardControl>
                        <TabControl
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectedIndex="{Binding SettingsTabIndex, Mode=TwoWay}">
                            <!--  目标：左侧常驻物品树 + 右侧目标列表  -->
                            <TabItem Header="{DynamicResource IndustryPage_Tab_Targets}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:CardControl
                                        Grid.Column="0"
                                        Padding="14,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Search24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPage_Manufacturable}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding ProductCountText}" />
                                            </Grid>
                                        </controls:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <ui:TextBox
                                                Grid.Row="0"
                                                PlaceholderText="{DynamicResource IndustryBp_SearchLabel}"
                                                Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TreeView
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource IndustryProductTreeItemStyle}"
                                                ItemsSource="{Binding ProductTree}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                        </Grid>
                                    </controls:CardControl>

                                    <controls:CardControl
                                        Grid.Column="2"
                                        Padding="14,8"
                                        CornerRadius="8">
                                        <controls:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Symbol="AppsList24" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding TargetsCountText}" />
                                            </StackPanel>

                                        </controls:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="2,0,2,4">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPage_Col_Item}" />
                                                <TextBlock
                                                    Margin="0,0,100,0"
                                                    HorizontalAlignment="Right"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource General_Quantity}" />
                                            </Grid>
                                            <ScrollViewer
                                                Grid.Row="1"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemTemplate="{StaticResource IndustryTargetTemplate}" ItemsSource="{Binding Targets}" />
                                            </ScrollViewer>
                                            <ui:Button
                                                Grid.Row="2"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Click="OnClearTargetsClick"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                ToolTip="{DynamicResource IndustryPage_ClearTargets}" />
                                        </Grid>
                                    </controls:CardControl>
                                </Grid>
                            </TabItem>

                            <!--  工艺  -->
                            <TabItem Header="{DynamicResource IndustryPage_Tab_Process}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <controls:CardControl
                                            Grid.Column="0"
                                            Padding="16,10"
                                            CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Calculator24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPage_BasicParameters}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_Me}" />
                                                        <ui:NumberBox
                                                            Maximum="10"
                                                            Minimum="0"
                                                            SmallChange="1"
                                                            Value="{Binding MeLevel, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_Te}" />
                                                        <ui:NumberBox
                                                            Maximum="20"
                                                            Minimum="0"
                                                            SmallChange="1"
                                                            Value="{Binding TeLevel, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_CostIndexLocation}" />
                                                <uc:MarketLocationSelectorView SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" />
                                            </StackPanel>
                                        </controls:CardControl>

                                        <controls:CardControl
                                            Grid.Column="2"
                                            Padding="16,10"
                                            CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                        Symbol="DataSunburst24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPage_InventionReaction}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_Decryptor}" />
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="Name"
                                                    ItemsSource="{Binding Decryptors}"
                                                    SelectedItem="{Binding SelectedDecryptor, Mode=TwoWay}" />
                                                <TextBlock
                                                    Margin="2,4,2,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPage_DecryptorTip}"
                                                    TextWrapping="Wrap" />

                                                <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_InventionCost}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_Attempts}" />
                                                        <ui:NumberBox
                                                            Maximum="1000"
                                                            Minimum="0"
                                                            SmallChange="1"
                                                            Value="{Binding InventionAttemptsOverride, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_SuccessRateOverride}" />
                                                        <ui:NumberBox
                                                            Maximum="100"
                                                            Minimum="0"
                                                            SmallChange="1"
                                                            Value="{Binding InventionProbabilityOverridePercent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_BpcRunsPerCopy}" />
                                                        <ui:NumberBox
                                                            Maximum="1000"
                                                            Minimum="0"
                                                            SmallChange="1"
                                                            Value="{Binding InventionBpcRunsOverride, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock
                                                    Margin="2,4,2,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPage_InventionAutoTip}"
                                                    TextWrapping="Wrap" />

                                                <CheckBox
                                                    Margin="0,12,0,0"
                                                    Content="{DynamicResource IndustryPage_ReactionApplyMe}"
                                                    IsChecked="{Binding ApplyMeToReactions, Mode=TwoWay}"
                                                    ToolTip="{DynamicResource IndustryPage_ReactionApplyMeTip}" />
                                                <CheckBox
                                                    Margin="0,4,0,0"
                                                    Content="{DynamicResource IndustryPage_ReactionApplyRigs}"
                                                    IsChecked="{Binding ApplyRigToReactions, Mode=TwoWay}"
                                                    ToolTip="{DynamicResource IndustryPage_ReactionApplyRigsTip}" />
                                                <TextBlock
                                                    Margin="2,4,2,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPage_ReactionDefaultTip}"
                                                    TextWrapping="Wrap" />
                                                <ui:Button
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    Click="OnClearDecisionsClick"
                                                    Content="{DynamicResource IndustryPage_ClearDecisions}" />
                                                <TextBlock
                                                    Margin="2,6,2,0"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource IndustryPage_ClearDecisionsTip}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </controls:CardControl>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!--  建筑  -->
                            <TabItem Header="{DynamicResource IndustryPage_Tab_Structure}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <controls:CardControl
                                            Grid.Column="0"
                                            Padding="12,10"
                                            CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="BookDatabase24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPage_BuildingProfiles}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <ListBox
                                                MinHeight="260"
                                                ItemContainerStyle="{StaticResource StretchListItem}"
                                                ItemsSource="{Binding BuildingProfiles}"
                                                MouseDoubleClick="OnBuildingProfileDoubleClick"
                                                SelectedItem="{Binding SelectedBuildingProfile, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,3">
                                                            <Grid>
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Name}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBox
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                    IsVisibleChanged="OnBuildingProfileEditBoxVisible"
                                                                    KeyDown="OnBuildingProfileNameKeyDown"
                                                                    LostFocus="OnBuildingProfileNameLostFocus"
                                                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                            <TextBlock
                                                                Margin="0,1,0,0"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Summary}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <controls:CardControl.Footer>
                                                <ui:Button
                                                    HorizontalAlignment="Center"
                                                    Click="OnNewBuildingProfileClick"
                                                    Content="{DynamicResource IndustryPage_NewProfile}"
                                                    Icon="{ui:SymbolIcon Add24}" />
                                            </controls:CardControl.Footer>
                                        </controls:CardControl>

                                        <controls:CardControl
                                            Grid.Column="2"
                                            Padding="16,10"
                                            CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="Settings24" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding SelectedBuildingProfileName}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <StackPanel>
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_MaterialBonus}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPage_MaterialBonusTip}"
                                                        Value="{Binding MaterialBonusPercent, Mode=TwoWay}" />

                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_TimeBonus}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPage_TimeBonusTip}"
                                                        Value="{Binding TimeBonusPercent, Mode=TwoWay}" />

                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_CostBonus}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPage_CostBonusTip}"
                                                        Value="{Binding CostBonusPercent, Mode=TwoWay}" />

                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_FacilityTax}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPage_FacilityTaxTip}"
                                                        Value="{Binding FacilityTaxPercent, Mode=TwoWay}" />

                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_SccSurcharge}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="0.5"
                                                        ToolTip="{DynamicResource IndustryPage_SccSurchargeTip}"
                                                        Value="{Binding SccSurchargePercent, Mode=TwoWay}" />

                                                    <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_PlanetTax}" />
                                                    <ui:NumberBox
                                                        Maximum="100"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        ToolTip="{DynamicResource IndustryPage_PlanetTaxTip}"
                                                        Value="{Binding PlanetTaxPercent, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <controls:CardControl.Footer>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <ui:Button
                                                        Margin="0,0,6,0"
                                                        Click="OnSaveBuildingProfileClick"
                                                        Content="{DynamicResource General_Save}"
                                                        Icon="{ui:SymbolIcon Save16}" />
                                                    <ui:Button
                                                        Click="OnDeleteBuildingProfileClick"
                                                        Content="{DynamicResource General_Remove}"
                                                        Icon="{ui:SymbolIcon Delete24}" />
                                                </StackPanel>
                                            </controls:CardControl.Footer>
                                        </controls:CardControl>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!--  角色与市场  -->
                            <TabItem Header="{DynamicResource IndustryPage_Tab_CharacterMarket}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <controls:CardControl
                                            Grid.Column="0"
                                            Padding="16,10"
                                            CornerRadius="8">
                                            <controls:CardControl.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                        Symbol="People16" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{DynamicResource IndustryPage_ParticipatingCharacters}" />
                                                </StackPanel>
                                            </controls:CardControl.Header>
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Characters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox
                                                                Margin="0,3"
                                                                Content="{Binding DisplayName}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator Margin="0,10,0,6" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{DynamicResource IndustryPage_CustomCharacters}" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{DynamicResource IndustryPage_CustomCharacterHint}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <ui:Button
                                                        Grid.Column="1"
                                                        Padding="10,4"
                                                        VerticalAlignment="Center"
                                                        Click="OnAddCustomCharacterClick"
                                                        Content="{DynamicResource General_Add}"
                                                        Icon="{ui:SymbolIcon Add24}" />
                                                </Grid>

                                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding CustomCharacters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                    <TextBlock
                                                                        Margin="28,0,0,0"
                                                                        FontSize="10"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        Text="{Binding Summary}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <ui:Button
                                                                        Padding="8,3"
