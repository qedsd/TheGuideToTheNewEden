<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.IndustryPlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="IndustryFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <Style x:Key="IndustrySummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="IndustryCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="IndustryNumberCellStyle"
            BasedOn="{StaticResource IndustryCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：目标与参数 ============  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Target}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            KeyDown="OnSearchKeyDown"
                            PlaceholderText="{DynamicResource IndustryPage_SearchPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="2"
                            Click="OnSearchClick"
                            Content="{DynamicResource IndustryPage_Search}" />
                    </Grid>
                    <ListBox
                        MaxHeight="200"
                        Margin="0,6,0,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding SearchResults}"
                        SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Quantity}" />
                    <ui:NumberBox
                        Maximum="1000000"
                        Minimum="1"
                        SmallChange="1"
                        Value="{Binding Quantity, Mode=TwoWay}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_ME}" />
                            <ui:NumberBox
                                Maximum="10"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding MeLevel, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_TE}" />
                            <ui:NumberBox
                                Maximum="20"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding TeLevel, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_SolarSystem}" />
                    <uc:MarketLocationSelectorView SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_FacilityTax}" />
                            <ui:NumberBox
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding FacilityTaxPercent, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_SpaceModifier}" />
                            <ui:NumberBox
                                Maximum="5"
                                Minimum="0"
                                SmallChange="0.1"
                                Value="{Binding SpaceModifier, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_RigMe}" />
                            <ui:NumberBox
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding RigMeBonusPercent, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_RigTe}" />
                            <ui:NumberBox
                                Maximum="100"
                                Minimum="0"
                                SmallChange="1"
                                Value="{Binding RigTeBonusPercent, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Character}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="CharacterName"
                        ItemsSource="{Binding Characters}"
                        SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" />

                    <CheckBox
                        Margin="0,10,0,0"
                        Content="{DynamicResource IndustryPage_UseAssets}"
                        IsChecked="{Binding UseAssets, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="{DynamicResource IndustryPage_UseJobs}"
                        IsChecked="{Binding UseInProgressJobs, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="{DynamicResource IndustryPage_UseBlueprints}"
                        IsChecked="{Binding UseOwnedBlueprints, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Click="OnCalculateClick"
                    Content="{DynamicResource IndustryPage_Calculate}" />
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Click="OnCopyClick"
                    Content="{DynamicResource IndustryPage_Copy}" />
            </StackPanel>
        </Grid>

        <!--  ============ 右：汇总 + BOM 结果 ============  -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CardControl
                Grid.Row="0"
                Margin="0,0,0,10"
                Header="{DynamicResource IndustryPage_Summary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Summary_Target}" />
                        <TextBlock Style="{StaticResource IndustrySummaryValue}" Text="{Binding TargetName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Summary_Runs}" />
                        <TextBlock Style="{StaticResource IndustrySummaryValue}" Text="{Binding SummaryRuns}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Summary_JobCost}" />
                        <TextBlock Style="{StaticResource IndustrySummaryValue}" Text="{Binding SummaryJobCost}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Summary_DirectBuy}" />
                        <TextBlock Style="{StaticResource IndustrySummaryValue}" Text="{Binding SummaryDirectBuy}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource IndustryFieldLabel}" Text="{DynamicResource IndustryPage_Summary_SelfBuild}" />
                        <TextBlock Style="{StaticResource IndustrySummaryValue}" Text="{Binding SummarySelfBuild}" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <ui:DataGrid
                x:Name="ResultGrid"
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                ItemsSource="{Binding Rows}"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="360"
                        Binding="{Binding DisplayName}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Item}" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding DecisionText}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Decision}" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Needed, StringFormat=N0}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Needed}" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding Produced, StringFormat=N0}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Produced}" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Runs, StringFormat=N0}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Runs}" />
                    <DataGridTextColumn
                        Width="90"
                        Binding="{Binding ToBuy, StringFormat=N0}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_Buy}" />
                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding JobCost, StringFormat=N2}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Col_JobCost}" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
    </Grid>
</Page>
