                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_TotalCost}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetCostText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_CashOutlayShort}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetCashText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_StockOffset}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetStockText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_NetRevenue}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetRevenueText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_ProfitMargin}" />
                                                                <TextBlock
                                                                    FontSize="15"
                                                                    Style="{StaticResource IndustryTargetProfitText}"
                                                                    Text="{Binding TargetProfitText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_JobCost}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetJobCostText}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,8">
                                                                <TextBlock Style="{StaticResource IndustryMetricLabel}" Text="{DynamicResource IndustryPage_Runs}" />
                                                                <TextBlock Style="{StaticResource IndustryMetricValueCompact}" Text="{Binding TargetRunsText}" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_CostBreakdown}" />
                                                        <Grid Height="20">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="40" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPage_PurchaseMaterials}" />
                                                            <controls:RatioBar
                                                                Grid.Column="1"
                                                                Height="4"
                                                                Margin="4,0,8,0"
                                                                VerticalAlignment="Center"
                                                                BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                                Ratio="{Binding MaterialShare}"
                                                                TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding MaterialShare, StringFormat={}{0:0}%}" />
                                                        </Grid>
                                                        <Grid Height="20">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="40" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPage_JobCost}" />
                                                            <controls:RatioBar
                                                                Grid.Column="1"
                                                                Height="4"
                                                                Margin="4,0,8,0"
                                                                VerticalAlignment="Center"
                                                                BarBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                                Ratio="{Binding JobShare}"
                                                                TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding JobShare, StringFormat={}{0:0}%}" />
                                                        </Grid>
                                                        <Grid Height="20">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="40" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{DynamicResource IndustryPage_StockOffset}" />
                                                            <controls:RatioBar
                                                                Grid.Column="1"
                                                                Height="4"
                                                                Margin="4,0,8,0"
                                                                VerticalAlignment="Center"
                                                                BarBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                                Ratio="{Binding StockShare}"
                                                                TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding StockShare, StringFormat={}{0:0}%}" />
                                                        </Grid>

                                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                            <ui:Button
                                                                Margin="0,0,8,0"
                                                                Click="OnCopySelectedTargetClick"
                                                                Content="{DynamicResource IndustryPage_CopyProductShopping}"
                                                                Icon="{ui:SymbolIcon DocumentSettings16}" />
                                                            <ui:Button
                                                                Click="OnExportSelectedTargetClick"
                                                                Content="{DynamicResource IndustryPage_ExportProductCsv}"
                                                                Icon="{ui:SymbolIcon ArrowDown24}" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Margin="0,14,0,0"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                            Text="{DynamicResource IndustryPage_ShoppingList}" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="10.5"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{DynamicResource IndustryPage_ShoppingListTip}"
                                                            TextWrapping="Wrap" />
                                                        <ui:DataGrid
                                                            MaxHeight="260"
                                                            ItemsSource="{Binding DataContext.OverviewBuyItems, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                            Style="{StaticResource IndustryDataGrid}">
                                                            <ui:DataGrid.Columns>
                                                                <DataGridTextColumn
                                                                    Width="*"
                                                                    Binding="{Binding Name}"
                                                                    Header="{DynamicResource IndustryPage_Col_Item}" />
                                                                <DataGridTextColumn
                                                                    Width="80"
                                                                    Binding="{Binding QuantityText}"
                                                                    Header="{DynamicResource General_Quantity}" />
                                                                <DataGridTextColumn
                                                                    Width="80"
                                                                    Binding="{Binding UnitPriceText}"
                                                                    Header="{DynamicResource IndustryPage_UnitPrice}" />
                                                                <DataGridTextColumn
                                                                    Width="100"
                                                                    Binding="{Binding TotalText}"
                                                                    Header="{DynamicResource IndustryPage_Amount}" />
                                                            </ui:DataGrid.Columns>
                                                        </ui:DataGrid>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </controls:CardControl>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!--  生产详情：排程 / 步骤 / 工位 / 关系 / 生产链  -->
                            <TabItem Header="{DynamicResource IndustryPage_Tab_Production}">
                                <uc:IndustryScheduleView />
                            </TabItem>
                        </TabControl>
                    </controls:CardControl>
                    <ui:Button
                        Height="34"
                        Margin="0,12,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Appearance="Primary"
                        Content="{DynamicResource IndustryPage_SavePlan}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Symbol="Save16" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </TabItem>

            <!--  ================= 已保存计划 =================  -->
            <TabItem Header="{DynamicResource IndustryPage_Tab_SavedPlans}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <controls:CardControl
                        Grid.Column="0"
                        Padding="10,8"
                        CornerRadius="8">
                        <controls:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Symbol="Folder24" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource IndustryPage_Tab_SavedPlans}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding SavedPlansCountText}" />
                            </Grid>
                        </controls:CardControl.Header>
                        <ListBox
                            ItemContainerStyle="{StaticResource StretchListItem}"
                            ItemsSource="{Binding SavedPlans}"
                            SelectedItem="{Binding SelectedSavedPlan, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding UpdatedText}" />
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TargetSummary}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </controls:CardControl>

                    <controls:CardControl
                        Grid.Column="2"
                        Padding="14,8"
                        CornerRadius="8"
                        Header="{DynamicResource IndustryPage_SaveLoad}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource IndustryLabel}" Text="{DynamicResource IndustryPage_PlanName}" />
                            <ui:TextBox PlaceholderText="{DynamicResource IndustryPage_PlanNamePlaceholder}" Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Click="OnSavePlanClick"
                                Content="{DynamicResource IndustryPage_SaveAsNew}"
                                Icon="{ui:SymbolIcon Save24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnOverwritePlanClick"
                                Content="{DynamicResource IndustryPage_OverwriteSelected}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnLoadPlanClick"
                                Content="{DynamicResource IndustryPage_LoadSelected}"
                                Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="OnRenamePlanClick"
                                Content="{DynamicResource IndustryPage_RenameSelected}"
                                Icon="{ui:SymbolIcon Edit24}" />
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Appearance="Danger"
                                Click="OnDeletePlanClick"
                                Content="{DynamicResource IndustryPage_DeleteSelected}"
                                Icon="{ui:SymbolIcon Delete24}" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource IndustryPage_SavedPlansTip}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:CardControl>
                </Grid>
            </TabItem>
        </TabControl>

        <!--  页面内非阻塞进度：详细订单分页/计算阶段，IsHitTestVisible=False 不挡住其他操作  -->
        <Border
            Width="320"
            Margin="0,0,18,18"
            Padding="14,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="100"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Symbol="ArrowSync24" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding BusyText}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <controls:RatioBar
                    Height="4"
                    Margin="0,8,0,0"
                    BarBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Ratio="{Binding BusyProgressPercent}"
                    TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding HasBusyProgress, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>