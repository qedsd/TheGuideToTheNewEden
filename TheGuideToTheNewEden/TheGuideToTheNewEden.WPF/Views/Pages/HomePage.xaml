<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        主页（见 HOME_DESIGN.md）：
        · 品牌 / 状态条（104 → 品牌重设计）：纯矢量主题感知版（DynamicResource 随深浅主题切换），替代 home.jpg 固定深色图；
        · 快捷方式（磁贴网格，可增删 / 拖动排序 / 小宽两档 / 分组分段 / 状态角标）；
        · 数据卡：我的钱包 + 我的行情（左右两栏，窄窗口下自动上下堆叠）。
        顶层导航页不写页面标题（§10「UI 约定」），第一行直接是品牌条。
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  磁贴：自带模板 + 显式 Foreground（显式样式会顶掉隐式样式，见 §9 第 18 条）  -->
        <Style x:Key="HomeTileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Border>
                            <!--  键盘焦点环  -->
                            <Border
                                x:Name="FocusFrame"
                                Margin="3"
                                BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusFrame" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!--  行情卡里的小卡（可点击 → 跳市场页选中该物品）  -->
        <Style x:Key="MarketMiniCard" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="MiniBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="MiniBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  最近使用的小胶囊  -->
        <Style x:Key="RecentChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ChipBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  磁贴模板（阶段 101 起只有主页磁贴一处使用；编辑在 设置 → 主页，不再有添加槽位）  -->
        <DataTemplate x:Key="HomeTileTemplate">
            <!--
                阶段 101：磁贴只剩"点开"一种交互——编辑（增删/排序/宽窄）全部收进 设置 → 主页，
                右键菜单 / 拖动 / ✕ / 添加槽位随之移除。
            -->
            <Button
                Width="{Binding TileWidth}"
                Height="112"
                Margin="0,0,12,12"
                Click="OnTileClick"
                Style="{StaticResource HomeTileButton}"
                Tag="{Binding}"
                ToolTip="{Binding DetailToolTip}">
                <Grid>
                    <!--  小磁贴：图标居中 + 名称（最多两行）  -->
                    <StackPanel
                        Margin="8,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSmall, Converter={StaticResource BoolToVisibility}}">
                        <!--  彩色矢量图标（NavIcons.xaml）；尺寸必须显式写死，见 REFACTORING §112 的说明  -->
                        <Image
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            Source="{Binding TileIcon}" />
                        <TextBlock
                            MaxHeight="38"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            LineHeight="18"
                            Text="{Binding Title}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  宽磁贴：左图标 + 名称 / 副标题  -->
                    <Grid
                        Margin="18,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsWide, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  彩色矢量图标（NavIcons.xaml）  -->
                        <Image
                            Grid.Column="0"
                            Width="26"
                            Height="26"
                            VerticalAlignment="Center"
                            Source="{Binding TileIcon}" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!--  状态角标（运行态：预警中 / 监控中 / 多开中 / 击杀流已连 / 有收藏）  -->
                    <Border
                        Width="12"
                        Height="12"
                        Margin="0,8,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SystemFillColorCautionBrush}"
                        CornerRadius="6"
                        ToolTip="{Binding BadgeToolTip}"
                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        x:Name="RootScroll"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!--
                品牌 / 状态条（纯矢量，主题感知）。
                SizeChanged → 圆角裁剪：ClipToBounds 只按**矩形**裁，装饰层的出血星门环会从圆角处溢出
                （表现为"只有右上角是方的"），故在 code-behind 里按实际尺寸重建圆角 Clip 几何。
            -->
            <Border
                x:Name="HeroBanner"
                Height="160"
                ClipToBounds="True"
                CornerRadius="8"
                SizeChanged="OnHeroBannerSizeChanged">
                <Grid ClipToBounds="True">
                    <Grid.Resources>
                        <!--  状态胶囊（主题感知）  -->
                        <Style x:Key="BannerPill" TargetType="Border">
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="CornerRadius" Value="13" />
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>

                        <!--  图标按钮（主题感知）  -->
                        <Style x:Key="BannerIconButton" TargetType="Button">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="BtnBorder"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!--  胶囊/按钮内图标统一前景  -->
                        <Style x:Key="BannerIcon" TargetType="ui:SymbolIcon">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </Grid.Resources>

                    <!--
                        背景层：底色 + 三层星云。
                        全部来自 Resources/BannerBackground.{Dark|Light}.xaml，
                        而那两个文件由 design/branding/_svg_to_wpf_banner.py 从 banner_*.svg **自动生成**
                        （不再手写 —— 手写曾漏掉第 3 层星云、且几何与设计稿不符）。
                        两套字典键名相同，由 ThemeService.ApplyBannerDictionary() 随主题整体换入。
                    -->
                    <Border
                        x:Name="BannerBase"
                        Background="{DynamicResource Banner.Bg.Base}"
                        CornerRadius="8" />
                    <Border
                        x:Name="BannerNebula1"
                        Background="{DynamicResource Banner.Bg.Nebula1}"
                        CornerRadius="8" />
                    <Border
                        x:Name="BannerNebula2"
                        Background="{DynamicResource Banner.Bg.Nebula2}"
                        CornerRadius="8" />
                    <Border
                        x:Name="BannerNebula3"
                        Background="{DynamicResource Banner.Bg.Nebula3}"
                        CornerRadius="8" />

                    <!--
                        背景层：星野 + 闪星。
                        画刷 Banner.Stars 由 design/branding/_svg_to_wpf_stars.py 从
                        banner_*.svg 忠实转出（33 个圆点 + 3 个四角星）；
                        坐标用 SVG 的 1200×200 空间 + Stretch="Fill"，随 Banner 尺寸自动缩放，
                        不再手工换算像素（那会导致星点被裁 / 位置偏移）。
                        星点颜色随主题：深色=亮星，浅色=暗点纹理（两套字典各一份）。
                    -->
                    <Border Background="{DynamicResource Banner.Stars}" IsHitTestVisible="False" />

                    <!--  BEGIN BannerSymbol: 由 design/branding/_svg_to_wpf_banner.py 生成，勿手改  -->
                    <!--
                        装饰层：右侧出血星门环 + 罗盘星。
                        几何与 design/branding/banner_*.svg 严格同构（等比 0.8）：
                        · 环心距右边缘 64px、纵向 y=80，
                        半径 136、描边 24；环身出血由圆角裁切；
                        · 罗盘星与环**同心**，尖半径 32px（故完整可见）。
                        颜色用 Banner.Symbol（两主题各一份）。改设计稿后重跑脚本即可。
                    -->
                    <Canvas
                        Width="216"
                        Height="160"
                        HorizontalAlignment="Right"
                        IsHitTestVisible="False">
                        <!--  大环：环心在画布右缘内侧，环身出血（同设计稿）  -->
                        <Ellipse
                            Canvas.Left="4"
                            Canvas.Top="-68"
                            Width="296"
                            Height="296"
                            Stroke="{DynamicResource Banner.Symbol}"
                            StrokeThickness="24" />
                        <!--  罗盘星：与环同心，不会戳出边界  -->
                        <Path Data="M 152 48 Q 152 80 184 80 Q 152 80 152 112 Q 152 80 120 80 Q 152 80 152 48 Z" Fill="{DynamicResource Banner.Symbol}" />
                    </Canvas>
                    <!--  END BannerSymbol  -->

                    <!--  ===== 内容层 =====  -->
                    <Grid Margin="22,16,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  第一行：Logo 标识 + 应用名 + 版本号  -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <!--  迷你「星门罗盘」（纯矢量，32px）  -->
                            <Canvas
                                Width="34"
                                Height="34"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Canvas.Left="4"
                                    Canvas.Top="4"
                                    Width="26"
                                    Height="26"
                                    Stroke="{DynamicResource Banner.Symbol}"
                                    StrokeThickness="3.2" />
                                <Path Data="M 17,7 Q 17,17 27,17 Q 17,17 17,27 Q 17,17 7,17 Q 17,17 17,7 Z" Fill="{DynamicResource Banner.Symbol}" />
                            </Canvas>
                            <!--
                                品牌双行标题（同设计稿 banner_*.svg 的构图）：
                                上行 = 当前语言的名称，下行 = **另一语言**的名称，
                                故中文界面下是「新伊甸漫游指南 / THE GUIDE TO THE NEW EDEN」，
                                英文界面下是「The Guide To The New Eden / 新伊甸漫游指南」。
                                两者都来自语言资源（AppDisplayName / AppDisplayNameAlt），随语言切换刷新；
                                英文那行的字间距在 ViewModel 里按设计稿补（见 AppSubtitle）。
                                
                                字体用 BrandFontFamily（与设计稿的 font-family 同一字栈，
                                含字体缺失时的回退链，定义见 Controls/GlobalControlStyles.xaml）。
                                若不设则继承 WPF-UI 默认字体，与设计稿不一致 —— 这正是原先的问题。
                            -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="{StaticResource BrandFontFamily}"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding AppName}" />
                                    <Border
                                        Margin="10,0,0,0"
                                        Padding="9,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontFamily="{StaticResource BrandFontFamily}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding VersionText}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Margin="1,3,0,0"
                                    FontFamily="{StaticResource BrandFontFamily}"
                                    FontSize="10"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding AppSubtitle}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  第二行：状态胶囊（左）+ 工具按钮（右）  -->
                        <Grid Grid.Row="1" VerticalAlignment="Bottom">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <Border Style="{StaticResource BannerPill}" ToolTip="{DynamicResource Home.Status.PlayersTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Style="{StaticResource BannerIcon}" Symbol="People16" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding PlayersText}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource BannerPill}" ToolTip="{DynamicResource Home.Status.GameTimeTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Style="{StaticResource BannerIcon}" Symbol="GlobeClock20" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding GameTimeText}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Background="#59FFB900"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnUpdatePillClick"
                                    Style="{StaticResource BannerPill}"
                                    ToolTip="{DynamicResource Home.Status.NewVersionTip}"
                                    Visibility="{Binding HasNewVersion, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Style="{StaticResource BannerIcon}" Symbol="CloudArrowDown24" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding NewVersionText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <!--  快捷输入（快速命令），主题感知配色  -->
                                <Border
                                    Width="330"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon
                                            Grid.Column="0"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="Search24" />

                                        <Grid Grid.Column="1" Margin="6,0,4,0">
                                            <TextBlock
                                                x:Name="QuickQueryPlaceholder"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                IsHitTestVisible="False"
                                                Text="{DynamicResource Home.Quick.Placeholder}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ui:TextBox
                                                x:Name="QuickQueryBox"
                                                Margin="-12,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                ClearButtonEnabled="False"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                KeyDown="OnQuickQueryKeyDown"
                                                TextChanged="OnQuickQueryTextChanged">
                                                <ui:TextBox.Resources>
                                                    <!--  ① 背景：静态 + 悬停 + 焦点 + 禁用，全部全透明  -->
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                                                    <!--  ② 边框：非焦点时的 1px 底线 + 焦点时的 2px 强调线，都透明  -->
                                                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                                                </ui:TextBox.Resources>
                                            </ui:TextBox>
                                        </Grid>

                                        <Button
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Click="OnQuickQueryGoClick"
                                            Style="{StaticResource BannerIconButton}"
                                            ToolTip="{DynamicResource Home.Quick.Go}">
                                            <ui:SymbolIcon
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Symbol="Send24" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Button
                                    Click="OnOpenManualClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="{DynamicResource Home.Action.Manual}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="BookQuestionMark24" />
                                </Button>
                                <Button
                                    Click="OnOpenAboutClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="{DynamicResource Home.Action.About}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Info24" />
                                </Button>
                                <Button
                                    Click="OnOpenLogClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="{DynamicResource Home.Action.OpenLog}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Bug16" />
                                </Button>
                                <Button
                                    Click="OnOpenConfigClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="{DynamicResource Home.Action.OpenConfigFolder}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="DocumentSettings16" />
                                </Button>
                                <Button
                                    Click="OnOpenGithubClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="GitHub">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Code24" />
                                </Button>
                                <Button
                                    Click="OnOpenQqGroupClick"
                                    Style="{StaticResource BannerIconButton}"
                                    ToolTip="{DynamicResource Home.Status.QqGroup}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="ContactCard16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>


            <!--  ============ 快捷方式 ============  -->
            <controls:CardControl
                x:Name="QuickCard"
                Margin="0,12,0,0"
                Padding="16,8"
                CornerRadius="8">
                <controls:CardControl.Header>
                    <!--
                        阶段 101：标题行不再有「⋯」「编辑」「＋ 添加」——快捷方式编辑全部在
                        设置 → 主页（拖动排序 / 移除 / 添加 / 宽窄 / 恢复默认）。
                    -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource Home.Quick.Title}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding CountText}" />
                    </StackPanel>
                </controls:CardControl.Header>

                <StackPanel>
                    <!--  「最近使用」（P2；开关打开时才有内容）  -->
                    <Grid Margin="0,0,0,10" Visibility="{Binding ShowRecent, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Home.Recent.Title}" />

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding RecentTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="OnRecentClick"
                                        Style="{StaticResource RecentChipButton}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Symbol="{Binding Icon}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Title}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            Click="OnClearRecentClick"
                            Icon="{ui:SymbolIcon Eraser24}"
                            ToolTip="{DynamicResource Home.Setting.ClearRecent}" />
                    </Grid>

                    <!--
                        阶段 101：磁贴只有一份平铺列表——「磁贴按分组分段显示」功能随用户要求移除
                        （连同 HomeShortcutService.ShowGrouped 与分组视图模型）。
                    -->
                    <ItemsControl
                        x:Name="TileList"
                        ItemTemplate="{StaticResource HomeTileTemplate}"
                        ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--  空态引导  -->
                    <TextBlock
                        Margin="2,10,2,4"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Home.Quick.Empty}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </controls:CardControl>

            <!--  ============ 数据卡：我的钱包 + 我的行情 ============  -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  我的钱包（P1）  -->
                <controls:CardControl
                    Grid.Column="0"
                    Padding="16,8"
                    CornerRadius="8"
                    Visibility="{Binding ShowWalletCard, Converter={StaticResource BoolToVisibility}}">
                    <controls:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Home.Wallet.Title}" />
                                <controls:SpinnerIcon
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    IsActive="{Binding Wallet.IsLoading}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ComboBox
                                    Width="112"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding Wallet.RangeLabels}"
                                    SelectedIndex="{Binding Wallet.RangeIndex, Mode=TwoWay}" />
                                <ui:Button
                                    Margin="6,0,0,0"
                                    Appearance="Transparent"
                                    Click="OnRefreshWalletClick"
                                    Icon="{ui:SymbolIcon ArrowSync24}"
                                    ToolTip="{DynamicResource General_Refresh}" />
                            </StackPanel>
                        </Grid>
                    </controls:CardControl.Header>

                    <StackPanel>
                        <!--  没有登录角色  -->
                        <StackPanel
                            Margin="0,6,0,6"
                            Orientation="Horizontal"
                            Visibility="{Binding Wallet.HasNoCharacter, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Person24" />
                            <TextBlock
                                MaxWidth="420"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Home.Wallet.NoCharacter}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Primary"
                                Click="OnGoCharactersClick"
                                Content="{DynamicResource Home.Wallet.GoCharacters}" />
                        </StackPanel>

                        <!--  有角色但全部失败  -->
                        <TextBlock
                            Margin="0,6,0,6"
                            FontSize="12.5"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{DynamicResource Home.Wallet.AllFailed}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Wallet.HasAllFailed, Converter={StaticResource BoolToVisibility}}" />

                        <!--  有数据  -->
                        <StackPanel Visibility="{Binding Wallet.ShowContent, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Wallet.TotalLabel}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="23"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Wallet.BalanceText}" />

                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,0,24,4" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Home.Wallet.IncomeLabel}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                        Text="{Binding Wallet.IncomeText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,24,4" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Home.Wallet.OutcomeLabel}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Text="{Binding Wallet.OutcomeText}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Text="{Binding Wallet.FailedText}"
                                    Visibility="{Binding Wallet.HasPartialFailure, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>

                            <Border
                                Height="1"
                                Margin="0,8,0,10"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <!--  有余额但区间/窗口内无流水（角色长期未登录，journal 保留窗口已过）→ 提示而非报错  -->
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource Home.Wallet.NoJournal}"
                                TextWrapping="Wrap"
                                Visibility="{Binding Wallet.HasNoSlices, Converter={StaticResource BoolToVisibility}}" />

                            <!--  收支构成：窄窗口下两列自动上下堆叠  -->
                            <WrapPanel>
                                <StackPanel
                                    Width="250"
                                    Margin="0,0,20,0"
                                    Visibility="{Binding Wallet.HasIncomeSlices, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Home.Wallet.IncomeBreakdown}" />
                                    <ItemsControl ItemsSource="{Binding Wallet.IncomeSlices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="56" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Width="56"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding PercentText}"
                                                        TextAlignment="Right" />
                                                    <controls:RatioBar
                                                        Grid.Column="2"
                                                        Height="3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        BarBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                        Ratio="{Binding Percent}"
                                                        TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel
                                    Width="250"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding Wallet.HasOutcomeSlices, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource Home.Wallet.OutcomeBreakdown}" />
                                    <ItemsControl ItemsSource="{Binding Wallet.OutcomeSlices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="56" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Width="56"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding PercentText}"
                                                        TextAlignment="Right" />
                                                    <controls:RatioBar
                                                        Grid.Column="2"
                                                        Height="3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        BarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                        Ratio="{Binding Percent}"
                                                        TrackBrush="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Wallet.NoteText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </controls:CardControl>

                <!--  我的行情（P1）  -->
                <controls:CardControl
                    Grid.Column="1"
                    Width="392"
                    Margin="12,0,0,0"
                    Padding="16,8"
                    CornerRadius="8"
                    Visibility="{Binding ShowMarketCard, Converter={StaticResource BoolToVisibility}}">
                    <controls:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource Home.Market.Title}" />
                                <controls:SpinnerIcon
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    IsActive="{Binding Market.IsLoading}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Market.FavoriteCountText}"
                                    Visibility="{Binding Market.HasMore, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Appearance="Transparent"
                                    Click="OnGoMarketClick"
                                    Content="{DynamicResource Home.Market.AllFavorites}" />
                            </StackPanel>
                        </Grid>
                    </controls:CardControl.Header>

                    <StackPanel>
                        <!--  收藏为空  -->
                        <StackPanel Margin="0,4,0,6" Visibility="{Binding Market.HasNoFavorite, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon
                                FontSize="20"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="Star24" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Home.Market.NoFavorite}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Appearance="Primary"
                                Click="OnGoMarketClick"
                                Content="{DynamicResource Home.Market.GoMarket}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Market.Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="OnMarketItemClick"
                                        Style="{StaticResource MarketMiniCard}"
                                        Tag="{Binding}">
                                        <Grid Margin="10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Name}" />
                                                <Image
                                                    Grid.Column="1"
                                                    Width="16"
                                                    Height="16"
                                                    controls:AsyncImage.TypeId="{Binding IconTypeId}" />
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding AverageText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    x:Name="ChangeText"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{Binding ChangeText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRising}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource Home.Market.Volume}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding VolumeText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    FontSize="11"
                                                    Text="{Binding VolumeChangeText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVolumeRising}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding Market.NoteText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:CardControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
