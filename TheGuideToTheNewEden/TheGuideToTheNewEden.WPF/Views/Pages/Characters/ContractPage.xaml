<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.ContractPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.HorizontalScrollBarVisibility="Visible">

    <Page.Resources>
        <!--  表格外观：只读、按行选中（列与 WinUI3 ContractPage 一致）  -->
        <Style x:Key="ContractGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource FluentDataGridRowStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible" />
            <!--  页面根节点的 ScrollViewer.CanContentScroll=False 会被继承进来，导致表格自身的横向滚动（含滚动条）失效；这里显式改回表格默认的按行滚动  -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <!--  文本单元格  -->
        <Style x:Key="ContractCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  数值单元格：右对齐  -->
        <Style
            x:Key="ContractNumberCellStyle"
            BasedOn="{StaticResource ContractCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <TabControl
        x:Name="Tabs"
        Margin="24,16,24,20"
        Padding="0"
        Background="Transparent">

        <!--  个人合同  -->
        <TabItem Header="{DynamicResource ContractPage_Character}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid
                    x:Name="CharacterContractsGrid"
                    ItemsSource="{Binding CharacterContracts.Items}"
                    Style="{StaticResource ContractGridStyle}"
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            MinWidth="160"
                            Binding="{Binding Title}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Title}"
                            Width="240" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding TypeText}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Type}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Price, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Price}" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding IssuerName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Issuer}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding DateIssued, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DateIssued}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding DateExpired, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DateExpired}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding AcceptorName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Acceptor}" />
                        <DataGridTextColumn
                            MinWidth="180"
                            Binding="{Binding StartLocationName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_StartLocation}"
                            Width="220" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Status}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Status}" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding ForCorporation}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_ForCorporation}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Buyout, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Buyout}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Volume, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Volume}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Reward, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Reward}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Collateral, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Collateral}" />
                        <DataGridTextColumn
                            MinWidth="180"
                            Binding="{Binding EndLocationName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_EndLocation}"
                            Width="220" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding DaysToComplete}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DaysToComplete}" />
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>

                <controls:PagerControl
                    x:Name="CharacterPager"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HasNext="{Binding CharacterContracts.HasNext}" />
            </Grid>
        </TabItem>

        <!--  军团合同  -->
        <TabItem Header="{DynamicResource ContractPage_Corp}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid
                    x:Name="CorpContractsGrid"
                    ItemsSource="{Binding CorpContracts.Items}"
                    Style="{StaticResource ContractGridStyle}"
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            MinWidth="160"
                            Binding="{Binding Title}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Title}"
                            Width="240" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding TypeText}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Type}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Price, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Price}" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding IssuerName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Issuer}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding DateIssued, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DateIssued}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding DateExpired, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DateExpired}" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding AcceptorName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Acceptor}" />
                        <DataGridTextColumn
                            MinWidth="180"
                            Binding="{Binding StartLocationName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_StartLocation}"
                            Width="220" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Status}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_Status}" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding ForCorporation}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_ForCorporation}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Buyout, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Buyout}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Volume, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Volume}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Reward, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Reward}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding Collateral, StringFormat=N2}"
                            ElementStyle="{StaticResource ContractNumberCellStyle}"
                            Header="{DynamicResource ContractPage_Collateral}" />
                        <DataGridTextColumn
                            MinWidth="180"
                            Binding="{Binding EndLocationName}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_EndLocation}"
                            Width="220" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding DaysToComplete}"
                            ElementStyle="{StaticResource ContractCellStyle}"
                            Header="{DynamicResource ContractPage_DaysToComplete}" />
                    </DataGrid.Columns>
                </DataGrid>
                </ScrollViewer>

                <controls:PagerControl
                    x:Name="CorpPager"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HasNext="{Binding CorpContracts.HasNext}" />
            </Grid>
        </TabItem>
    </TabControl>
</Page>
