<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <!--  军团 / 联盟  -->
            <Border Style="{StaticResource SettingsGroupBorder}">
                <StackPanel Margin="16">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.Corporation}" />
                    <TextBlock
                        x:Name="CorporationText"
                        Margin="0,4,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.Alliance}" />
                    <TextBlock
                        x:Name="AllianceText"
                        Margin="0,4,0,0"
                        FontSize="16"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!--  舰船 / 位置 / 在线  -->
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroupBorder}">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.Ship}" />
                    <TextBlock
                        x:Name="ShipText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,0" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.Location}" />
                    <TextBlock
                        x:Name="LocationText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,8,0,0" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.Online}" />
                    <TextBlock
                        x:Name="OnlineText"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="12,8,0,0" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.LastLogin}" />
                    <TextBlock
                        x:Name="LastLoginText"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="12,8,0,0" />
                </Grid>
            </Border>

            <!--  技能队列  -->
            <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroupBorder}">
                <StackPanel Margin="16">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Characters.SkillQueue}" />

                    <ItemsControl x:Name="QueueList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding SkillName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding FinishedLevel, StringFormat=Level {0}}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="16,0,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Finish, StringFormat={}{0:MM-dd HH:mm}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        x:Name="QueueEmptyText"
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Characters.NotTraining}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
