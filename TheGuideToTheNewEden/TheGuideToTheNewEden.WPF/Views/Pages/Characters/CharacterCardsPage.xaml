<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.CharacterCardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="36,20,36,40">

                <!--  标题 + 刷新  -->
                <Grid>
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="{DynamicResource Characters.Title}" />
                    <Button
                        x:Name="RefreshButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Characters.Refresh}" />
                </Grid>

                <!--  汇总  -->
                <Border
                    x:Name="SummaryCard"
                    Margin="0,20,0,0"
                    Style="{StaticResource SettingsGroupBorder}">
                    <UniformGrid Columns="4" Margin="0,16">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding CharacterCount}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Summary.Characters}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding TotalSkillPointsText}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Summary.SkillPoints}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding TotalWalletText}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Summary.Wallet}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding TotalLoyalty, StringFormat=N0}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Summary.Loyalty}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!--  空状态引导  -->
                <Border
                    x:Name="EmptyState"
                    Margin="0,20,0,0"
                    Padding="32"
                    Style="{StaticResource SettingsGroupBorder}"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Symbol="Person24" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Characters.Empty.Title}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Characters.Empty.Description}"
                            TextWrapping="Wrap" />
                        <ui:Button
                            x:Name="LoginButton"
                            Margin="0,20,0,0"
                            MinWidth="160"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            Content="{DynamicResource Characters.Login}" />
                    </StackPanel>
                </Border>

                <!--  角色卡片网格  -->
                <ItemsControl x:Name="CardList" Margin="0,20,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="330"
                                Height="164"
                                Margin="0,0,12,12"
                                Click="Card_Click"
                                Style="{StaticResource SettingsRowButton}"
                                Tag="{Binding}">
                                <Border Padding="16" Style="{StaticResource SettingsGroupBorder}">
                                    <Grid>
                                        <!--  头像（圆形），无图时露出下方首字母；仅真实角色显示  -->
                                        <Grid
                                            Width="64"
                                            Height="64"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding IsAdd, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Border
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="32" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="24"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Initial}" />
                                            <Border CornerRadius="32">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Ellipse
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,2,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Fill="MediumSeaGreen"
                                                Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <!--  角色信息（仅真实角色显示）  -->
                                        <StackPanel
                                            Margin="80,2,0,0"
                                            Visibility="{Binding IsAdd, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding StatusText}" />
                                            <TextBlock
                                                Margin="0,10,0,0"
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding WalletText}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SkillPointsText}" />
                                        </StackPanel>

                                        <!--  移除（仅真实角色显示）  -->
                                        <ui:Button
                                            x:Name="RemoveButton"
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Appearance="Transparent"
                                            Click="RemoveCharacter_Click"
                                            Tag="{Binding}"
                                            ToolTip="{DynamicResource Characters.Remove}"
                                            Visibility="{Binding IsAdd, Converter={StaticResource InverseBoolToVisibility}}">
                                            <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                        </ui:Button>

                                        <!--  添加卡片内容  -->
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAdd, Converter={StaticResource BoolToVisibility}}">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                FontSize="28"
                                                Symbol="Add24" />
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                Text="{DynamicResource Characters.Add}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
