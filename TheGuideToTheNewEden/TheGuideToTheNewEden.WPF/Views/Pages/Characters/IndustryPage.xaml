<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.IndustryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False"
    ScrollViewer.HorizontalScrollBarVisibility="Visible">

    <Page.Resources>
        <!--  表格外观：只读、按行选中；列与 WinUI3 工业页保持一致  -->
        <Style x:Key="IndustryGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource FluentDataGridRowStyle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible" />
            <!--  页面根节点的 ScrollViewer.CanContentScroll=False 会被继承进来，导致表格自身的横向滚动（含滚动条）失效；这里显式改回表格默认的按行滚动  -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <!--  文本单元格  -->
        <Style x:Key="IndustryCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  数值单元格：右对齐  -->
        <Style x:Key="IndustryNumberCellStyle" BasedOn="{StaticResource IndustryCellStyle}" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,20">
        <Border Padding="4" Style="{StaticResource SettingsGroupBorder}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid
                x:Name="JobGrid"
                ItemsSource="{Binding Jobs}"
                Style="{StaticResource IndustryGridStyle}"
                        MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="120"
                        Binding="{Binding BlueprintName}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Blueprint}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="120"
                        Binding="{Binding ProductName}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Product}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="75"
                        Binding="{Binding StatusText}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Status}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="60"
                        Binding="{Binding Runs, StringFormat=N0}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Runs}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="70"
                        Binding="{Binding Probability, StringFormat=N2}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Probability}" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding StartDate, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_StartDate}" 
                        MinWidth="130" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="85"
                        Binding="{Binding DurationText}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Duration}" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding EndDate, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_EndDate}" 
                        MinWidth="130" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="80"
                        Binding="{Binding Cost, StringFormat=N2}"
                        ElementStyle="{StaticResource IndustryNumberCellStyle}"
                        Header="{DynamicResource IndustryPage_Cost}" />
                    <DataGridTextColumn
                        Width="Auto"
                        MinWidth="110"
                        Binding="{Binding LocationName}"
                        ElementStyle="{StaticResource IndustryCellStyle}"
                        Header="{DynamicResource IndustryPage_Location}" />
                </DataGrid.Columns>
            </DataGrid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
