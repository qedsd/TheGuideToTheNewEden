<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.CharacterWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧信息栏  -->
        <ScrollViewer
            Grid.Column="0"
            Padding="20,16,10,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  身份  -->
                <Border Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="56" Height="56">
                                <Border
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="28" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Initial}" />
                                <Border CornerRadius="28">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Corporation}" />
                            <TextBlock
                                x:Name="CorporationText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Alliance}" />
                            <TextBlock
                                x:Name="AllianceText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,6,0,0"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Birthday}" />
                            <TextBlock
                                x:Name="BirthdayText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="8,6,0,0" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.SecurityStatus}" />
                            <TextBlock
                                x:Name="SecurityText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="8,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  资产  -->
                <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Characters.Assets}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.WalletBalance}" />
                            <TextBlock
                                x:Name="WalletText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,0,0,0" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Summary.Loyalty}" />
                            <TextBlock
                                x:Name="LoyaltyText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="8,6,0,0" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.SkillPoints}" />
                            <TextBlock
                                x:Name="SkillPointsText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="8,6,0,0" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Characters.Unallocated}" />
                            <TextBlock
                                x:Name="UnallocatedText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="8,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  技能队列  -->
                <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroupBorder}">
                    <StackPanel Margin="16">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Characters.SkillQueue}" />
                        <TextBlock
                            x:Name="QueueText"
                            Margin="0,10,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="QueueEndText"
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  右侧子页  -->
        <TabControl
            x:Name="SubTabs"
            Grid.Column="1"
            Margin="0,8,0,0"
            Padding="0"
            Background="Transparent" />

    </Grid>
</Page>
