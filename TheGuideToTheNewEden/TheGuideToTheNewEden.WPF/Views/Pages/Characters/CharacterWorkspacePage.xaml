<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.CharacterWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ZkbCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Thin" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ZkbValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧信息栏（身份/资产 → 技能队列 → ZKB）  -->
        <ScrollViewer
            Grid.Column="0"
            Padding="20,16,10,20"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel>

                    <!--  身份 + 资产  -->
                    <Border Style="{StaticResource SettingsGroupBorder}">
                        <StackPanel Margin="16">
                            <Grid
                                Width="100"
                                Height="100"
                                HorizontalAlignment="Center">
                                <Border
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="50" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Card.Initial}" />
                                <Border CornerRadius="50">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Card.Avatar}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Card.Name}"
                                TextTrimming="CharacterEllipsis" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <!--  出生日期  -->
                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="{DynamicResource CharacterPage_Birthday}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding BirthdayText}" />

                                <!--  SP（含未分配）  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="SP" />
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource InfoValueStyle}" Text="{Binding TotalSpText}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        Style="{StaticResource InfoValueStyle}"
                                        Text="(" />
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        Style="{StaticResource InfoValueStyle}"
                                        Text="{Binding UnallocatedSpText}"
                                        ToolTip="{DynamicResource CharacterPage_UnallocatedSp}" />
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        Style="{StaticResource InfoValueStyle}"
                                        Text=")" />
                                </StackPanel>

                                <!--  LP  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="LP" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding LpText}" />

                                <!--  安全等级  -->
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="{DynamicResource CharacterPage_SecurityStatus}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding SecurityText}" />

                                <!--  角色钱包  -->
                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="{DynamicResource CharacterPage_CharacterWallet}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding WalletText}" />

                                <!--  军团钱包（需要财务权限，无权限不显示）  -->
                                <TextBlock
                                    Grid.Row="5"
                                    Height="28"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="{DynamicResource CharacterPage_CorpWallet}"
                                    Visibility="{Binding HasCorpWallet, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="2"
                                    Height="28"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding CorpWalletText}"
                                    Visibility="{Binding HasCorpWallet, Converter={StaticResource BoolToVisibility}}" />

                                <!--  势力：军团名 + [联盟代号]  -->
                                <TextBlock
                                    Grid.Row="6"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="{DynamicResource CharacterPage_Faction}" />
                                <StackPanel
                                    Grid.Row="6"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource InfoValueStyle}" Text="{Binding CorporationText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource InfoValueStyle}"
                                        Text="["
                                        Visibility="{Binding HasAlliance, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Style="{StaticResource InfoValueStyle}"
                                        Text="{Binding AllianceTickerText}"
                                        Visibility="{Binding HasAlliance, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Style="{StaticResource InfoValueStyle}"
                                        Text="]"
                                        Visibility="{Binding HasAlliance, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  技能队列  -->
                    <Border Margin="0,12,0,0" Style="{StaticResource SettingsGroupBorder}">
                        <StackPanel Margin="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontWeight="Thin"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource CharacterPage_SkillQueue}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Card.QueuePercentText}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="%" />
                                </StackPanel>
                            </Grid>

                            <controls:RatioBar
                                Height="3"
                                Margin="0,8,0,0"
                                TrackBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BarBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                Ratio="{Binding Card.QueuePercent}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" ToolTip="{DynamicResource CharacterPage_RemainTime}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="&#xE2AD;" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Card.QueueRemainText}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Text="{DynamicResource CharacterPage_NotRunning}"
                                        Visibility="{Binding Card.QueueRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    ToolTip="{DynamicResource CharacterPage_RemainSkill}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="&#xF003;" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Card.QueueUndoneCount}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="/" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Card.QueueTotalCount}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  ZKB 战绩  -->
                    <Border
                        Margin="0,12,0,0"
                        Style="{StaticResource SettingsGroupBorder}"
                        Visibility="{Binding HasZkb, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="{DynamicResource EntityStatistPage_DangerRatio}" />
                                <controls:RatioBar
                                    Grid.Column="1"
                                    Height="3"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    TrackBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                    BarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                    Ratio="{Binding DangerRatio}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding DangerRatio}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="%" />

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource InfoLabelStyle}"
                                    Text="{DynamicResource EntityStatistPage_GangRatio}" />
                                <controls:RatioBar
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="3"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    TrackBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                    BarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                    Ratio="{Binding GangRatio}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="{Binding GangRatio}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource InfoValueStyle}"
                                    Text="%" />
                            </Grid>

                            <Grid Margin="-16,16,-16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource ZkbCaptionStyle}" Text="{DynamicResource StatistMonthPage_ItemDestroyed}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource ZkbCaptionStyle}"
                                    Text="{DynamicResource StatistMonthPage_IskDestroyed}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource ZkbCaptionStyle}"
                                    Text="{DynamicResource StatistMonthPage_ItemLost}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource ZkbCaptionStyle}"
                                    Text="{DynamicResource StatistMonthPage_IskLost}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource ZkbValueStyle}"
                                    Text="{Binding ItemDestroyed}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource ZkbValueStyle}"
                                    Text="{Binding IskDestroyedText}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource ZkbValueStyle}"
                                    Text="{Binding ItemLost}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource ZkbValueStyle}"
                                    Text="{Binding IskLostText}" />
                            </Grid>

                            <Button
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Click="ZkbButton_Click"
                                Content="ZKB" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!--  左栏刷新（覆盖在右上方，与 WinUI 一致）  -->
                <ui:Button
                    x:Name="RefreshLeftButton"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Click="RefreshLeftButton_Click"
                    ToolTip="{DynamicResource General_Refresh}">
                    <ui:SymbolIcon FontSize="12" Symbol="ArrowSync24" />
                </ui:Button>
            </Grid>
        </ScrollViewer>

        <!--  右侧子页  -->
        <Grid Grid.Column="1">
            <TabControl
                x:Name="SubTabs"
                Margin="0,8,0,0"
                Padding="0"
                Background="Transparent" />
            <ui:Button
                x:Name="RefreshPageButton"
                Margin="0,12,16,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Click="RefreshPageButton_Click"
                ToolTip="{DynamicResource General_Refresh}">
                <ui:SymbolIcon FontSize="12" Symbol="ArrowSync24" />
            </ui:Button>
        </Grid>

    </Grid>
</Page>
