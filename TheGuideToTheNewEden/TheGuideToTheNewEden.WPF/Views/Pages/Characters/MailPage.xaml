<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.Characters.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  列表项样式 StretchListItem 已提到全局（Controls/GlobalControlStyles.xaml），此处直接引用  -->
    </Page.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：标签列表（"全部邮件" + 各标签，右侧为未读数徽标）  -->
        <ListBox
            x:Name="LabelList"
            Grid.Column="0"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource StretchListItem}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="LabelList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorSuccessBrush}"
                            CornerRadius="8"
                            ToolTip="{DynamicResource MailPage_UnreadCount}"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{Binding UnreadBadgeText}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border
            Grid.Column="1"
            Width="1"
            Margin="8,0"
            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!--  右侧：邮件列表（未读圆点 / 主题 / 发件人 / 日期）  -->
        <Grid Grid.Column="2">
            <ListBox
                x:Name="MailList"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource StretchListItem}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="MailList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                        ToolTip="{DynamicResource MailPage_Unread}"
                                        Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Subject}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding FromName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{DynamicResource MailPage_From}" />
                            </Grid>

                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DateText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  加载提示（仅有邮件/无邮件时由列表本身表达）  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Characters.Loading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
