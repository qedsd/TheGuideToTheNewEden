<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:map="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls.Map"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--  HUD 深空配色（画布区域永远是深空，浮层用固定深色而非主题色）  -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <SolidColorBrush x:Key="HudBg" Color="#E0101626" />
        <SolidColorBrush x:Key="HudBorder" Color="#2E7DF9FF" />
        <SolidColorBrush x:Key="HudAccent" Color="#7DF9FF" />
        <SolidColorBrush x:Key="HudText" Color="#E6F0FF" />
        <SolidColorBrush x:Key="HudDim" Color="#8FA3C8" />
        <SolidColorBrush x:Key="HudIntel" Color="#FF5C74" />
        <!--  画布区底色与加载遮罩（随主题切换，值在 MapPage.ApplyTheme 里重设）  -->
        <SolidColorBrush x:Key="MapBg" Color="#05070E" />
        <SolidColorBrush x:Key="MapLoadingBg" Color="#AA05070E" />

        <Style x:Key="HudTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HudAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HudTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HudText}" />
        </Style>

        <!--
            Slider 左右分色样式已上移为全局隐式样式（Controls/GlobalControlStyles.xaml）：左侧主题色、右侧灰；
            图例"大小"滑条直接走全局样式，HUD 面板上同样可读（主题色画刷随主题、深浅均可辨识）
        -->

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  ============ 顶栏 ============  -->
        <Border
            Grid.Row="0"
            Padding="10,6"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <!--  常用入口：搜索、定位、筛选、工具、更多  -->
                    <ui:TextBox
                        x:Name="SearchBox"
                        Width="160"
                        MinWidth="120"
                        ClearButtonEnabled="True"
                        PlaceholderText="{DynamicResource MapPage_SearchPlaceholder}"
                        TextChanged="SearchBox_TextChanged" />
                    <!--  星域定位（自「更多」提到顶栏）  -->
                    <ComboBox
                        x:Name="RegionCombo"
                        Width="140"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Regions}"
                        SelectedItem="{Binding SelectedLocateRegion, Mode=TwoWay}"
                        SelectionChanged="RegionCombo_SelectionChanged"
                        ToolTip="{DynamicResource MapTool_Region}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RegionName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!--  着色模式（自「更多」提到顶栏）  -->
                    <ComboBox
                        x:Name="ColorModeCombo"
                        Width="130"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="ColorMode_SelectionChanged"
                        ToolTip="{DynamicResource MapPage_ColorMode}">
                        <ComboBoxItem Content="{DynamicResource MapPage_ColorSecurity}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ColorSov}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ColorPlanetResource}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ColorKills}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ColorJumps}" />
                    </ComboBox>
                    <!--  行星资源类型：仅在「着色模式 = 行星资源」时出现，跟随着色模式放在顶栏  -->
                    <ComboBox
                        x:Name="ResourceKindCombo"
                        Width="110"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        SelectionChanged="ResourceKind_SelectionChanged"
                        ToolTip="{DynamicResource MapPage_ColorPlanetResource}"
                        Visibility="Collapsed">
                        <ComboBoxItem Content="{DynamicResource MapPage_ResourcePower}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ResourceWorkforce}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ResourceMagmaticGas}" />
                        <ComboBoxItem Content="{DynamicResource MapPage_ResourceSuperionicIce}" />
                    </ComboBox>
                    <!--  工具（导航 / 情报等入口都在这个下拉里）  -->
                    <ui:Button
                        x:Name="ToolsButton"
                        Width="34"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="0"
                        Appearance="Secondary"
                        Click="ToolsButton_Click"
                        Icon="{ui:SymbolIcon Apps16}"
                        ToolTip="{DynamicResource MapPage_Tools}">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <ui:MenuItem Click="NavButton_Click" Header="{DynamicResource MapPage_Tool_Navigate}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Map24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Click="OneJumpCover_Click" Header="{DynamicResource MapPage_Tool_Cover}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Target24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Click="PlanetResourceList_Click" Header="{DynamicResource MapPage_Tool_Resource}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DataUsage24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Click="JumpBridgeSetting_Click" Header="{DynamicResource MapPage_Tool_Bridge}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Branch16" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Click="SovGroupSetting_Click" Header="{DynamicResource MapPage_Tool_Sov}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Globe24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                                <ui:MenuItem Click="IntelTool_Click" Header="{DynamicResource MapPage_Tool_Intel}">
                                    <ui:MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Info24" />
                                    </ui:MenuItem.Icon>
                                </ui:MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <!--  显示设置（独立窗口：筛选与图层 + 显示参数，不置顶）  -->
                    <ui:Button
                        Width="34"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="0"
                        Appearance="Secondary"
                        AutomationProperties.Name="{DynamicResource MapPage_DisplaySettings}"
                        Click="DisplaySettingsButton_Click"
                        Icon="{ui:SymbolIcon Settings24}"
                        ToolTip="{DynamicResource MapPage_DisplaySettings}" />
                </StackPanel>
                <!--  重置视图：固定在顶栏最右侧  -->
                <ui:Button
                    Width="34"
                    Height="30"
                    Padding="0"
                    Appearance="Secondary"
                    AutomationProperties.Name="{DynamicResource MapPage_ResetView}"
                    Click="ResetView_Click"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    ToolTip="{DynamicResource MapPage_ResetView}" />
            </DockPanel>
        </Border>

        <!--  ============ 画布区 ============  -->
        <Grid Grid.Row="1">
            <!--  深空底（保证画布外圈也是深色）  -->
            <Border Background="{DynamicResource MapBg}" />
            <map:StarMapCanvas x:Name="MapCanvas" />

            <!--  悬停提示（顶部居中 HUD）  -->
            <Border
                x:Name="HoverHud"
                Padding="12,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource HudBg}"
                BorderBrush="{DynamicResource HudBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="HoverHudText"
                    FontSize="13"
                    Foreground="{DynamicResource HudText}" />
            </Border>

            <!--  选中星系信息卡（右下）  -->
            <Border
                x:Name="InfoCard"
                Width="300"
                Margin="12"
                Padding="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource HudBg}"
                BorderBrush="{DynamicResource HudBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding SelectedSystem, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource HudText}"
                            Text="{Binding SelectedSystem.Name}" />
                        <Button
                            Margin="6,0,0,0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="#207DF9FF"
                            BorderBrush="{DynamicResource HudBorder}"
                            BorderThickness="1"
                            Click="SystemDetail_Click"
                            Content="{DynamicResource MapPage_Detail}"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="{DynamicResource HudAccent}" />
                        <Border
                            MinWidth="40"
                            Margin="8,0,0,0"
                            Padding="6,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#307DF9FF"
                            BorderBrush="{DynamicResource HudBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource HudAccent}"
                                Text="{Binding SelectedSecurityText}" />
                        </Border>
                    </DockPanel>
                    <TextBlock
                        Grid.Row="1"
                        FontSize="12"
                        Foreground="{DynamicResource HudDim}"
                        Text="{Binding SelectedInfoText}" />
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource HudDim}"
                                Text="{DynamicResource MapPage_Kills}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource HudText}"
                                Text="{Binding SelectedKillsText}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource HudDim}"
                                Text="{DynamicResource MapPage_Jumps}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource HudText}"
                                Text="{Binding SelectedJumpsText}" />
                        </StackPanel>
                    </Grid>
                    <!--  邻接星系  -->
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource HudDim}"
                            Text="{DynamicResource MapPage_Neighbors}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Neighbors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,6,6"
                                        Padding="8,2"
                                        Background="#207DF9FF"
                                        BorderBrush="{DynamicResource HudBorder}"
                                        Click="Neighbor_Click"
                                        Content="{Binding Name}"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="{DynamicResource HudText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  色阶图例（左下）：标题随着色模式，色条与两端标签解释颜色含义  -->
            <Border
                x:Name="LegendPanel"
                Margin="12"
                Padding="10,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource HudBg}"
                BorderBrush="{DynamicResource HudBorder}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel MaxWidth="256">
                    <TextBlock
                        x:Name="LegendTitle"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource HudText}" />
                    <StackPanel x:Name="LegendScale" Margin="0,6,0,0">
                        <!--  11 格色条：UniformGrid 等分整行宽度，随图例面板自适应占满  -->
                        <UniformGrid x:Name="LegendStrips" Rows="1" />
                        <Grid Margin="0,3,0,0">
                            <TextBlock
                                x:Name="LegendLow"
                                HorizontalAlignment="Left"
                                FontSize="11"
                                Foreground="{DynamicResource HudDim}" />
                            <TextBlock
                                x:Name="LegendHigh"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{DynamicResource HudDim}" />
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        x:Name="LegendNote"
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource HudDim}"
                        TextWrapping="Wrap" />
                    <!--  主权晕染开关：仅主权着色模式下显示（文案与热力模式统一叫「热力」；标签不受影响）  -->
                    <StackPanel
                        x:Name="LegendSovShadingRow"
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <CheckBox
                            x:Name="SovShadingToggle"
                            Margin="-12,0,0,0"
                            VerticalAlignment="Center"
                            Checked="SovShadingToggle_Changed"
                            Content="{DynamicResource MapPage_HeatBlocks}"
                            FontSize="12"
                            Foreground="{DynamicResource HudText}"
                            Unchecked="SovShadingToggle_Changed" />
                    </StackPanel>
                    <!--  热力开关行：色块显隐 + 聚合方式（主权联盟疆域 / 几何格子），只在行星资源 / 击杀 / 通行三模式下显示  -->
                    <StackPanel
                        x:Name="LegendHeatRow"
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <CheckBox
                            x:Name="HeatToggle"
                            Margin="-12,0,0,0"
                            VerticalAlignment="Center"
                            Checked="HeatToggle_Changed"
                            Content="{DynamicResource MapPage_HeatBlocks}"
                            FontSize="12"
                            Foreground="{DynamicResource HudText}"
                            Unchecked="HeatToggle_Changed" />
                        <CheckBox
                            x:Name="HeatSovToggle"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Checked="HeatSovToggle_Changed"
                            Content="{DynamicResource MapPage_HeatBySov}"
                            FontSize="12"
                            Foreground="{DynamicResource HudText}"
                            ToolTip="{DynamicResource MapPage_HeatBySov}"
                            Unchecked="HeatSovToggle_Changed" />
                    </StackPanel>
                    <!--  色块大小：滑条值越大块越大（1..100 档位线性映射画布格数范围），仅几何格子聚合时显示  -->
                    <StackPanel
                        x:Name="LegendHeatSizeRow"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="-12,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource HudDim}"
                            Text="{DynamicResource MapPage_HeatGridSize}" />
                        <Slider
                            x:Name="HeatSizeSlider"
                            Width="100"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            IsSnapToTickEnabled="True"
                            LargeChange="8"
                            Maximum="100"
                            Minimum="1"
                            SmallChange="1"
                            TickFrequency="1"
                            ValueChanged="HeatSizeSlider_ValueChanged" />
                        <TextBlock
                            x:Name="HeatSizeText"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource HudText}"
                            TextAlignment="Right" />
                    </StackPanel>
                    <!--  热力网格偏移：方向按钮按 1/4 格步进平移网格原点（默认贴数据包围盒左上角），复位回原点；随热力行同显隐  -->
                    <StackPanel
                        x:Name="LegendHeatOffsetRow"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource HudDim}"
                            Text="{DynamicResource MapPage_HeatOffset}" />
                        <Button
                            MinWidth="26"
                            MinHeight="22"
                            Padding="4,0"
                            Click="HeatOffset_Click"
                            Content="{ui:SymbolIcon ArrowLeft24}"
                            FontSize="11"
                            Tag="L"
                            ToolTip="{DynamicResource MapPage_HeatOffset}" />
                        <Button
                            MinWidth="26"
                            MinHeight="22"
                            Padding="4,0"
                            Click="HeatOffset_Click"
                            Content="{ui:SymbolIcon ArrowRight24}"
                            FontSize="11"
                            Tag="R"
                            ToolTip="{DynamicResource MapPage_HeatOffset}" />
                        <Button
                            MinWidth="26"
                            MinHeight="22"
                            Padding="4,0"
                            Click="HeatOffset_Click"
                            Content="{ui:SymbolIcon ArrowUp24}"
                            FontSize="11"
                            Tag="U"
                            ToolTip="{DynamicResource MapPage_HeatOffset}" />
                        <Button
                            MinWidth="26"
                            MinHeight="22"
                            Padding="4,0"
                            Click="HeatOffset_Click"
                            Content="{ui:SymbolIcon ArrowDown24}"
                            FontSize="11"
                            Tag="D"
                            ToolTip="{DynamicResource MapPage_HeatOffset}" />
                        <Button
                            MinHeight="22"
                            Margin="4,0,0,0"
                            Padding="6,0"
                            Click="HeatOffset_Click"
                            Content="{DynamicResource MapPage_HeatOffsetReset}"
                            FontSize="11"
                            Tag="C" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  加载遮罩  -->
            <Border Background="{DynamicResource MapLoadingBg}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing
                        Width="48"
                        Height="48"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource HudDim}"
                        Text="{DynamicResource MapPage_Loading}" />
                </StackPanel>
            </Border>

            <!--  主权装载中：页内轻量指示（不用全局遮罩——装载是后台增强，不挡缩放/平移/切换其他功能）  -->
            <Border
                Margin="0,64,0,0"
                Padding="14,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource HudBg}"
                BorderBrush="{DynamicResource HudBorder}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="{Binding IsSovLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <controls:SpinnerIcon
                        FontSize="16"
                        Foreground="{DynamicResource HudAccent}"
                        IsActive="{Binding IsSovLoading}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource HudDim}"
                        Text="{DynamicResource MapPage_LoadingSov}" />
                </StackPanel>
            </Border>

            <!--  搜索下拉  -->
            <Popup
                x:Name="SearchPopup"
                Width="260"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=SearchBox}"
                PopupAnimation="Fade"
                StaysOpen="False">
                <Border
                    Margin="0,4,8,8"
                    Background="{DynamicResource HudBg}"
                    BorderBrush="{DynamicResource HudBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ListBox
                        x:Name="SearchList"
                        MaxHeight="280"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{x:Null}"
                        ItemsSource="{Binding SearchResults}"
                        SelectionChanged="SearchList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource HudText}" Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="{DynamicResource HudDim}"
                                        Text="{Binding RegionName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>






        </Grid>
    </Grid>
</Page>
