<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:dbmodels="clr-namespace:TheGuideToTheNewEden.Core.DBModels;assembly=TheGuideToTheNewEden.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        「攻略 · 资源」页：与「死亡远征」同构的阅读器（左列表 + 筛选，右正文）。
        数据 = CombatSite 里的非战斗站点：战斗遗迹(5) / 数据站点(10) / 矿石站点(11) / 气云站点(12) / 冰带(13)。
        虫洞站点(14) 不在这里——它并进了「战斗异常」页的列表（分类显示"冬眠者"、出现空间"虫洞"）。
    -->
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="ResourceItemTemplate" DataType="{x:Type dbmodels:CombatSite}">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Text="{Binding TitleCN}"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding TitleEN}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Category}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：搜索 + 列表 + 分类筛选  -->
        <controls:CardControl>
            <controls:CardControl.Header>
                <ui:TextBox
                    Margin="0,6"
                    FontWeight="Normal"
                    PlaceholderText="{DynamicResource ResourcesPage_SearchTip}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </controls:CardControl.Header>

            <Grid>
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource StretchListItem}"
                    ItemTemplate="{StaticResource ResourceItemTemplate}"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource ResourcesPage_Empty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Stretch">
                    <ComboBox
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  右：标题 + 元信息 + 正文  -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <controls:CardControl Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <controls:CardControl.Header>
                    <StackPanel Margin="0,4">
                        <controls:RichTextPresenter
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{Binding Selected.TitleCN, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled" />
                        <controls:RichTextPresenter
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Selected.TitleEN, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled" />
                        <controls:RichTextPresenter
                            Margin="0,6,0,0"
                            VerticalAlignment="Top"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding MetaText, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled"
                            Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </controls:CardControl.Header>

                <Grid>
                    <controls:MarkdownPresenter
                        BaseFontSize="16"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Markdown="{Binding Selected.WikiContent, Mode=OneWay}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource DEDPage_NoContent}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </controls:CardControl>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource ResourcesPage_NoSelection}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>
    </Grid>
</Page>
