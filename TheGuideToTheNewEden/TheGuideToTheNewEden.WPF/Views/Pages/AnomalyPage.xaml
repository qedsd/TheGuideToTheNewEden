<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.AnomalyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        「攻略 · 战斗异常」页。
        · 第一个 Tab 固定是「所有异常」= 原来的异常对照表（列表 + 搜索 + 筛选），关不掉。
        · 点某一行的名字 / 「可升级为」列后，**不再跳转死亡远征页**，而是在后面新开一个 Tab
          显示该站点正文（Header = 异常名，可手动关闭），行为与 Zkillboard 页一致。
        · 列表里同时包含虫洞站点：分类显示"冬眠者"，出现空间显示"虫洞"。
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style
            x:Key="GuideTableGrid"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource FluentDataGridRowStyle}" />
            <!--  页面根节点的 CanContentScroll=False 会被继承进来，显式改回按行滚动（阶段 22）  -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="CellSecondary"
            BasedOn="{StaticResource CellText}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style
            x:Key="CellAccent"
            BasedOn="{StaticResource CellText}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  「可升级为」单元格：有目标 = 可点（跳「死亡远征」页看详细），没目标 = 灰色原文  -->
        <DataTemplate x:Key="TargetCellTemplate">
            <Grid>
                <ui:Button
                    Margin="4,2"
                    Padding="6,2"
                    HorizontalAlignment="Left"
                    Appearance="Transparent"
                    BorderThickness="0"
                    Click="OnTargetClick"
                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Text="{Binding TargetText}"
                        TextTrimming="CharacterEllipsis" />
                </ui:Button>

                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TargetText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding HasTarget, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="8">
        <TabControl
            x:Name="DetailTabs"
            Background="Transparent"
            BorderThickness="0">

            <!--  固定页：所有异常（列表 + 搜索 + 筛选）  -->
            <TabItem Header="{DynamicResource AnomalyPage_TabAll}">
                <controls:CardControl>
                    <controls:CardControl.Header>
                        <Grid Margin="0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding StatusText}" />

                            <ui:TextBox
                                Grid.Column="1"
                                Width="300"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Stretch"
                                FontWeight="Normal"
                                PlaceholderText="{DynamicResource AnomalyPage_SearchTip}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox
                                Grid.Column="2"
                                Width="140"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding FactionOptions}"
                                SelectedItem="{Binding SelectedFaction, Mode=TwoWay}" />

                            <ComboBox
                                Grid.Column="3"
                                Width="110"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding TierOptions}"
                                SelectedItem="{Binding SelectedTier, Mode=TwoWay}" />
                        </Grid>
                    </controls:CardControl.Header>

                    <Grid>
                        <ui:DataGrid
                            x:Name="AnomalyGrid"
                            Margin="0,6,0,0"
                            ItemsSource="{Binding Items}"
                            MouseDoubleClick="OnRowDoubleClick"
                            Style="{StaticResource GuideTableGrid}">
                            <ui:DataGrid.Columns>
                                <DataGridTemplateColumn Width="1.1*" Header="{DynamicResource AnomalyPage_ColTitleCN}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  单击中文名 → 本页开页签看正文；双击整行同样；只有「可升级为」列跳死亡远征  -->
                                            <ui:Button
                                                Margin="4,2"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Click="OnSelfClick">
                                                <TextBlock
                                                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                    Text="{Binding TitleCN}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </ui:Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Width="1.1*"
                                    Binding="{Binding TitleEN}"
                                    ElementStyle="{StaticResource CellSecondary}"
                                    Header="{DynamicResource AnomalyPage_ColTitleEN}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Level}"
                                    ElementStyle="{StaticResource CellAccent}"
                                    Header="{DynamicResource AnomalyPage_ColLevel}" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Faction}"
                                    ElementStyle="{StaticResource CellSecondary}"
                                    Header="{DynamicResource AnomalyPage_ColFaction}" />
                                <DataGridTemplateColumn
                                    Width="1.6*"
                                    CellTemplate="{StaticResource TargetCellTemplate}"
                                    Header="{DynamicResource AnomalyPage_ColTarget}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Location}"
                                    ElementStyle="{StaticResource CellSecondary}"
                                    Header="{DynamicResource AnomalyPage_ColSpace}" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource AnomalyPage_Empty}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </controls:CardControl>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
