<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.MissionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:dbmodels="clr-namespace:TheGuideToTheNewEden.Core.DBModels.Static;assembly=TheGuideToTheNewEden.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        「攻略 · 任务」页（2026-11 重做）。
        · 数据：Core/MissionService → Resources/Database/static.db 的 Mission 表（1313 条，来自 EVE University Wiki 的 Missions 体系）。
        · 左卡 = 搜索 + 列表 + 三个筛选（分类 / 等级 / 势力）；
          右卡 = 中英标题 + 元信息 + 正文（任务目标 / 属性 / 攻略正文 / NPC 表，全部 Markdown）。
        · 与「死亡远征」页同构，用户切功能不用换脑子（见 REFACTORING.md 阶段 354）。
    -->
    <Page.Resources>
        <converters:MissionLevelConverter x:Key="MissionLevel" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="MissionItemTemplate" DataType="{x:Type dbmodels:Mission}">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Text="{Binding TitleEN}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding TitleCN}"
                    TextWrapping="Wrap" />

                <Grid Grid.Row="2" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding MissionType}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Text="{Binding Level, Converter={StaticResource MissionLevel}}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：搜索 + 列表 + 筛选  -->
        <controls:CardControl>
            <controls:CardControl.Header>
                <ui:TextBox
                    Margin="0,6"
                    FontWeight="Normal"
                    PlaceholderText="{DynamicResource MissionPage_SearchTip}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </controls:CardControl.Header>

            <Grid>
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource StretchListItem}"
                    ItemTemplate="{StaticResource MissionItemTemplate}"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource MissionPage_Empty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Stretch">
                    <ComboBox
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                    <ComboBox
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding LevelOptions}"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />

                    <ComboBox
                        Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding FactionOptions}"
                        SelectedItem="{Binding SelectedFaction, Mode=TwoWay}" />

                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  右：标题 + 元信息 + 正文  -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <controls:CardControl Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <controls:CardControl.Header>
                    <StackPanel Margin="0,4">
                        <controls:RichTextPresenter
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Text="{Binding Selected.TitleEN, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled" />
                        <controls:RichTextPresenter
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Selected.TitleCN, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled" />
                        <controls:RichTextPresenter
                            Margin="0,6,0,0"
                            VerticalAlignment="Top"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding MetaText, Mode=OneWay}"
                            VerticalScrollBarVisibility="Disabled"
                            Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </controls:CardControl.Header>

                <Grid>
                    <controls:MarkdownPresenter
                        BaseFontSize="16"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Markdown="{Binding Selected.WikiContent, Mode=OneWay}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource MissionPage_NoSelection}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </controls:CardControl>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource MissionPage_NoSelection}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>
    </Grid>
</Page>
