<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.MissionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:dbmodels="clr-namespace:TheGuideToTheNewEden.Core.DBModels;assembly=TheGuideToTheNewEden.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <!--
        任务页（对应 WinUI 版 Views/MissionPage.xaml）：左卡 = 搜索 + 列表 + 等级筛选，右卡 = 选中任务的攻略正文。
        · 数据来自 Core 的 MissionService（Resources/Database/static.db）：列表按等级/名称查，正文按 Id 查 MissionContent。
        · 正文是 Markdown（上古 EVEWiki 导出），渲染走自写的 Controls/MarkdownPresenter（无新增依赖）。
        · 与 WinUI 的差异：AutoSuggestBox → 搜索框 + 就地结果列表；正文加载期间右卡显示页内局部等待；
          页面内不显示大标题（见 REFACTORING.md §10「UI 约定」）。
    -->
    <Page.Resources>
        <converters:MissionLevelConverter x:Key="MissionLevel" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="MissionItemTemplate" DataType="{x:Type dbmodels:Mission}">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Text="{Binding Title_Zh}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Level, Converter={StaticResource MissionLevel}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：搜索 + 列表 + 等级筛选  -->
        <controls:CardControl>
            <controls:CardControl.Header>
                <ui:TextBox
                    Margin="0,6"
                    FontWeight="Normal"
                    PlaceholderText="{DynamicResource MissionPage_SearchTip}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </controls:CardControl.Header>

            <Grid>
                <ListBox
                    x:Name="MissionList"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource StretchListItem}"
                    ItemTemplate="{StaticResource MissionItemTemplate}"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding Selected, Mode=TwoWay}"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource MissionPage_Empty}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <controls:CardControl.Footer>
                <StackPanel HorizontalAlignment="Stretch">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding LevelIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource Mission_Level_1}" />
                        <ComboBoxItem Content="{DynamicResource Mission_Level_2}" />
                        <ComboBoxItem Content="{DynamicResource Mission_Level_3}" />
                        <ComboBoxItem Content="{DynamicResource Mission_Level_4}" />
                        <ComboBoxItem Content="{DynamicResource Mission_Level_5}" />
                    </ComboBox>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}" />
                </StackPanel>
            </controls:CardControl.Footer>
        </controls:CardControl>

        <!--  右：正文（未选中时给引导文案）  -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <controls:CardControl Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <controls:CardControl.Header>
                    <TextBlock
                        Margin="0,4"
                        FontSize="18"
                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                        Text="{Binding Selected.Title_Zh, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </controls:CardControl.Header>

                <Grid>
                    <controls:MarkdownPresenter
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Markdown="{Binding ContentText, Mode=OneWay}" />

                    <!--  正文加载中：页内局部指示（不用全局遮罩，§9 第 39 条）  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsContentLoading, Converter={StaticResource BoolToVis}}">
                        <controls:SpinnerIcon
                            HorizontalAlignment="Center"
                            FontSize="30"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            IsActive="{Binding IsContentLoading}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource MissionPage_ContentLoading}" />
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource MissionPage_NoContent}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding ShowNoContent, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </controls:CardControl>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource MissionPage_NoSelection}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>
    </Grid>
</Page>
