<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.AppraisalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="AppraisalFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <Style x:Key="AppraisalCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style x:Key="AppraisalSummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AppraisalCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="AppraisalNumberCellStyle"
            BasedOn="{StaticResource AppraisalCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：输入与估价设置 ============  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  输入 + 设置（可滚动）  -->
            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ui:TextBox
                    AcceptsReturn="True"
                    PlaceholderText="{DynamicResource AppraisalPage_PasteData}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,10">
                <!--  价格来源（星域 / 星系 / 建筑）  -->
                <TextBlock
                    Margin="0,14,0,2"
                    Style="{StaticResource AppraisalFieldLabel}"
                    Text="{DynamicResource AppraisalPage_Market}" />
                <uc:MarketLocationSelectorView SelectedItem="{Binding SelectedMarketLocation, Mode=TwoWay}" />

                <!--  卖出估价  -->
                <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_SellValuation}" />
                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding SellPriceTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop5}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellAvailable}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop5}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyAvailable}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryHighest}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryAverage}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryLowest}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryMedian}" />
                </ComboBox>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_SellPercent}" />
                        <ui:NumberBox
                            Maximum="10000"
                            Minimum="0"
                            SmallChange="5"
                            Value="{Binding SellPercent, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource BusinessPage_HistoryDay}" />
                        <ui:NumberBox
                            Maximum="365"
                            Minimum="1"
                            SmallChange="1"
                            Value="{Binding HistoryDay, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <!--  买入估价  -->
                <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_BuyValuation}" />
                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding BuyPriceTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop5}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellAvailable}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_SellTop}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop5}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyAvailable}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_BuyTop}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryHighest}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryAverage}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryLowest}" />
                    <ComboBoxItem Content="{DynamicResource BusinessPage_HistoryMedian}" />
                </ComboBox>
                <TextBlock
                    Margin="0,10,0,2"
                    Style="{StaticResource AppraisalFieldLabel}"
                    Text="{DynamicResource AppraisalPage_BuyPercent}" />
                <ui:NumberBox
                    Maximum="10000"
                    Minimum="0"
                    SmallChange="5"
                    Value="{Binding BuyPercent, Mode=TwoWay}" />

                <CheckBox
                    Margin="0,10,0,0"
                    Content="{DynamicResource BusinessPage_RemoveExtremum}"
                    IsChecked="{Binding RemoveExtremum, Mode=TwoWay}" />
            </StackPanel>
            <!--  操作按钮  -->
            <StackPanel Grid.Row="2">
                <ui:Button
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Click="OnEstimateClick"
                    Content="{DynamicResource AppraisalPage_Estimate}" />
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Click="OnCopyClick"
                    Content="{DynamicResource AppraisalPage_CopyResult}" />
            </StackPanel>
        </Grid>

        <!--  ============ 右：估价结果 ============  -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  汇总条  -->
            <Border Grid.Row="0" Style="{StaticResource AppraisalCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="8,0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_Market}" />
                        <TextBlock Style="{StaticResource AppraisalSummaryValue}" Text="{Binding ResultMarket}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_Volume}" />
                        <TextBlock Style="{StaticResource AppraisalSummaryValue}" Text="{Binding ResultVolume}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_Buy}" />
                        <TextBlock Style="{StaticResource AppraisalSummaryValue}" Text="{Binding ResultBuy}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="4,0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_Split}" />
                        <TextBlock Style="{StaticResource AppraisalSummaryValue}" Text="{Binding ResultSplit}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="4,0">
                        <TextBlock Style="{StaticResource AppraisalFieldLabel}" Text="{DynamicResource AppraisalPage_Sell}" />
                        <TextBlock Style="{StaticResource AppraisalSummaryValue}" Text="{Binding ResultSell}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  警告提示（未识别 / 无报价）  -->
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="10,6"
                Style="{StaticResource AppraisalCardBorder}"
                Visibility="{Binding HasUnresolved, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding UnresolvedText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border
                Grid.Row="2"
                Margin="0,6,0,0"
                Padding="10,6"
                Style="{StaticResource AppraisalCardBorder}"
                Visibility="{Binding HasNoPrice, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding NoPriceText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  明细表  -->
            <ScrollViewer
                Grid.Row="4"
                Margin="0,8,0,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <ui:DataGrid
                    MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.CanContentScroll="True"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow">
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Margin="4,2"
                                        Source="{Binding Icon}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="220"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource AppraisalCellStyle}"
                            Header="{DynamicResource AppraisalPage_Item}" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding Amount, StringFormat={}{0:N0}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_Amount}" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Volume, StringFormat={}{0:N2}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_Volume}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding UnitBuyPrice, StringFormat={}{0:N2}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_UnitBuy}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding BuyPrice, StringFormat={}{0:N2}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_Buy}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding UnitSellPrice, StringFormat={}{0:N2}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_UnitSell}" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding SellPrice, StringFormat={}{0:N2}}"
                            ElementStyle="{StaticResource AppraisalNumberCellStyle}"
                            Header="{DynamicResource AppraisalPage_Sell}" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
