<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.GamePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:pickers="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <!--
        阶段 134 的布局说明（历史）：多开页按「AI 助手 / 主页」的观感重排（左侧客户端 + 中间预览 + 右侧设置 300）。
        三条取向（与阶段 133 的 AI 助手、阶段 92 的主页一致）：
        ① 少包裹：左侧客户端栏是**一层** 8px 圆角卡片（主页的卡片语言），右侧设置区完全去卡片化
        （Win11 设置页那套「分组卡 + 分隔线 + 12px 内边距」），中间只在页面上放一块"屏幕"；
        ② 层次清楚：左 = 有哪些客户端（含运行态）/ 中 = 选中客户端的实时画面与关键参数 / 右 = 该项设置，
        阅读顺序与"选中 → 看画面 → 调设置"一致；操作按钮跟着作用对象走（开始/停止在预览标题行，
        激活/恢复位置/应用到其余在设置里的「操作」组），不再堆在底栏；
        ③ 只留必要信息：去掉标题栏式卡片头与 6 个纯图标底栏按钮；设置项收成按需分组，
        长说明压成 11px 提示行；「名称条颜色」两项已无任何窗口读取（阶段 44 删掉彩色名称条后成了死设置），
        一并从界面移除。
        阶段 135 的现行布局（覆盖上面的历史描述）：「客户端列表 220 + 设置（*）+ 画面侧栏 260（可折叠为 40）」。
        设置是主区域；页面内画面只作确认用，宽视口默认展开、窄视口默认收起。颜色设置接入 ColorPickerButton，
        选中项 / 列表项 / 页脚的停止按钮统一改为醒目的红色（Danger）样式，左侧列表支持搜索。
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:ColorToBrushConverter x:Key="ColorBrush" />
        <conv:ProcessDisplayNameConverter x:Key="ProcessName" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!--  一级面板：顶部客户端条（8px 圆角 + 1px 描边，与主页卡片一致）  -->
        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            条件显示用的容器样式（目标类型 StackPanel）：把"只在某条件下才有意义"的几行包进一个 StackPanel，
            默认 Collapsed、条件满足时 Visible。全部走绑定（条件一变立即生效，不写 code-behind）：
            · 没显示预览窗口            → 外观/不透明度/隐藏/高亮/角色名叠加/恢复位置 全部不显示；
            · 游戏窗口活动时隐藏 已开启  → 高亮（以及高亮边框组）没有意义，一并隐藏；
            · 高亮 未开启               → 高亮边框颜色/宽度 不显示；
            · 带标题栏（样式 0）        → 角色名叠加不显示（名字已在标题栏），并提示"上边距不生效"；
            · 跟随窗口缩放 关闭         → 缩放倍率不显示。
            没选中客户端时 SelectedSetting 为 null → 不满足任何条件 → 整块隐藏（此时页签本身也隐藏）。
        -->
        <Style x:Key="WhenWindow" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenWindowNoHide" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.HideOnForeground}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenHighlight" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.HideOnForeground}" Value="False" />
                        <Condition Binding="{Binding SelectedSetting.Highlight}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenOverlay" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="1" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenFollowScale" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.NameOverlayFollowScale}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenTitleBar" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  说明 / 提示：统一 11px 三级色  -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!--  设置区分组：分组标题 + 圆角分组卡（Win11 设置页语言）  -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="2,10,0,6" />
        </Style>

        <Style
            x:Key="GroupCard"
            BasedOn="{StaticResource SettingsGroupBorder}"
            TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!--  设置行：左标签 + 右控件，40px 行高  -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!--  长标签换行而不是截断：设置区变宽后仍有个别长句（如"开始全部时包含…"），截断会丢信息  -->
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style
            x:Key="RowDivider"
            BasedOn="{StaticResource SettingsDivider}"
            TargetType="Border">
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <!--
            客户端列表项：圆角 + 悬停/选中反馈。
            选中态用主题色 1px 描边（与 TabItem 的选中口径一致），运行态由前面的绿点表示。
        -->
        <Style x:Key="ProcessItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            客户端项：运行态圆点 + 角色名 + 窗口标题（第二行）+ 快捷键胶囊。
            名字用 MultiBinding 把两个"会变"的输入都绑上（窗口标题 + 配置里的角色名）；
            单值绑定绑的是整个对象，改具体属性时不会重新求值（详见 ProcessDisplayNameConverter 注释）。
        -->
        <DataTemplate x:Key="ProcessItemTemplate">
            <Grid ToolTip="{Binding WindowTitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="8"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    ToolTip="{DynamicResource GamePreviewPage_Running}">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Fill="{DynamicResource SystemFillColorSuccessBrush}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ProcessName}">
                                <Binding Path="WindowTitle" />
                                <Binding Path="Setting.Name" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WindowTitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  运行中：直接给一个红色停止钮（不必先选中再找停止按钮）；快捷键胶囊紧随其后  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="{DynamicResource GamePreviewPage_Stop}"
                        BorderThickness="0"
                        Click="OnStopProcessClick"
                        ToolTip="{DynamicResource GamePreviewPage_Stop}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon
                            FontSize="13"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Symbol="RecordStop24" />
                    </ui:Button>
                    <Border
                        VerticalAlignment="Center"
                        Style="{StaticResource Pill}"
                        ToolTip="{DynamicResource GamePreviewPage_ItemHotKey}"
                        Visibility="{Binding Setting.HotKey, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Setting.HotKey}" />
                    </Border>
                </StackPanel>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnStartProcessClick" Header="{DynamicResource GamePreviewPage_Start}" />
                        <MenuItem Click="OnStopProcessClick" Header="{DynamicResource GamePreviewPage_Stop}" />
                        <Separator />
                        <MenuItem Click="OnMoveUpClick" Header="{DynamicResource GamePreviewPage_MoveUp}" />
                        <MenuItem Click="OnMoveDownClick" Header="{DynamicResource GamePreviewPage_MoveDown}" />
                        <MenuItem Click="OnRestorePositionClick" Header="{DynamicResource GamePreviewPage_RestorePosition}" />
                        <Separator />
                        <MenuItem Click="OnActivateSourceClick" Header="{DynamicResource GamePreviewPage_OpenSourceWindow}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <!--  分组里的"角色"点选胶囊：选中 = 主题色描边 + 浅底；绿点 = 该角色正在预览  -->
        <Style x:Key="CharacterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CharacterChipContent">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="5"
                    Height="5"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource SystemFillColorSuccessBrush}"
                    Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    MaxWidth="120"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--
            分组列表项（阶段 136）：一行显示分组名 + 已设置的两个分组快捷键。
            成员数 / 成员编辑只在右侧"编辑分组"区显示，列表保持紧凑，十几个分组也能一屏扫完。
        -->
        <DataTemplate x:Key="HotKeyGroupItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding GroupName}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Style="{StaticResource Pill}"
                        ToolTip="{DynamicResource GamePreviewPage_Forward}"
                        Visibility="{Binding SwitchHotkey_Forward, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding SwitchHotkey_Forward}" />
                    </Border>
                    <Border
                        Margin="4,0,0,0"
                        Style="{StaticResource Pill}"
                        ToolTip="{DynamicResource GamePreviewPage_Backward}"
                        Visibility="{Binding SwitchHotkey_Backward, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding SwitchHotkey_Backward}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
            切换顺序列表项（阶段 137）：序号 + 角色名/窗口标题 + 运行态 + 上/下移；
            已关闭客户端的旧标题显示"未发现"，并且可以单独移除。
        -->
        <DataTemplate x:Key="SwitchOrderItemTemplate">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Index}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource SystemFillColorSuccessBrush}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding CharacterName}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Pill}"
                            ToolTip="{DynamicResource GamePreviewPage_Order_Missing}"
                            Visibility="{Binding IsPresent, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{DynamicResource GamePreviewPage_Order_Missing}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WindowTitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="OnOrderMoveUpClick"
                        IsEnabled="{Binding CanMoveUp}"
                        ToolTip="{DynamicResource GamePreviewPage_MoveUp}">
                        <ui:SymbolIcon FontSize="12" Symbol="ArrowUp24" />
                    </ui:Button>
                    <ui:Button
                        Width="24"
                        Height="24"
                        Margin="2,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="OnOrderMoveDownClick"
                        IsEnabled="{Binding CanMoveDown}"
                        ToolTip="{DynamicResource GamePreviewPage_MoveDown}">
                        <ui:SymbolIcon FontSize="12" Symbol="ArrowDown24" />
                    </ui:Button>
                    <ui:Button
                        Width="24"
                        Height="24"
                        Margin="2,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="OnOrderRemoveClick"
                        ToolTip="{DynamicResource GamePreviewPage_Order_Remove}"
                        Visibility="{Binding IsPresent, Converter={StaticResource InverseBoolToVis}}">
                        <ui:SymbolIcon
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Symbol="Delete24" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--
            分组单独排序列表项（阶段 138）：角色名 + 运行态 + 上/下移。
            顺序按角色名保存，窗口标题变化（切换角色）不会让分组顺序失效。
        -->
        <DataTemplate x:Key="GroupOrderItemTemplate">
            <Grid Margin="2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Index}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{DynamicResource SystemFillColorSuccessBrush}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="OnGroupOrderMoveUpClick"
                        IsEnabled="{Binding CanMoveUp}"
                        ToolTip="{DynamicResource GamePreviewPage_MoveUp}">
                        <ui:SymbolIcon FontSize="12" Symbol="ArrowUp24" />
                    </ui:Button>
                    <ui:Button
                        Width="24"
                        Height="24"
                        Margin="2,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="OnGroupOrderMoveDownClick"
                        IsEnabled="{Binding CanMoveDown}"
                        ToolTip="{DynamicResource GamePreviewPage_MoveDown}">
                        <ui:SymbolIcon FontSize="12" Symbol="ArrowDown24" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        外层 Grid 只做一件事：把页面夹在承载页面的 ScrollViewer 视口内
        （ConverterParameter = 上下/左右外边距之和；ViewportMaxHeightConverter 就是"视口值 − 内边距"）。
        不夹住的话，页面会被内容撑高/撑宽，滚轮与横向溢出都会落到整个页面上。
    -->
    <Grid x:Name="PageRoot" Margin="14,6,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：客户端列表 ============  -->
        <Border Grid.Column="0" Style="{StaticResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Height="40"
                    Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource GamePreviewPage_Clients}" />

                    <!--  运行计数胶囊：2 / 12 = 12 个客户端里 2 个正在预览  -->
                    <Border
                        Grid.Column="1"
                        Margin="6,0,2,0"
                        Style="{StaticResource Pill}"
                        ToolTip="{DynamicResource GamePreviewPage_Running}"
                        Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="5"
                                Height="5"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding ProcessCountText}" />
                        </StackPanel>
                    </Border>

                    <ui:Button
                        Grid.Column="2"
                        Padding="5"
                        Appearance="Transparent"
                        AutomationProperties.Name="{DynamicResource General_RefreshList}"
                        BorderThickness="0"
                        Click="OnRefreshClick"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{DynamicResource General_RefreshList}" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!--  客户端搜索：十几个以上时不用在长列表里翻找（匹配角色名或窗口标题）  -->
                <Grid Grid.Row="2" Margin="8,6,8,2">
                    <ui:TextBox
                        PlaceholderText="{DynamicResource GamePreviewPage_ClientFilterPlaceholder}"
                        Text="{Binding ClientFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource GamePreviewPage_ClientFilterPlaceholder}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </Grid>

                <Grid Grid.Row="3">
                    <!--  竖向列表：两行一项（角色名 + 窗口标题），十几个客户端一屏基本放得下  -->
                    <ListBox
                        x:Name="ProcessList"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ProcessItem}"
                        ItemTemplate="{StaticResource ProcessItemTemplate}"
                        ItemsSource="{Binding ProcessesView}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" />

                    <!--  空态：没发现客户端（游戏未启动 / 关键词不匹配）  -->
                    <StackPanel
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasProcesses, Converter={StaticResource InverseBoolToVis}}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ScreenSearch24" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource GamePreviewPage_NoClientTip}"
                            TextAlignment="Center" />
                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Click="OnRefreshClick"
                            Content="{DynamicResource General_RefreshList}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>

                    <!--  有客户端，但被搜索条件全部挡掉  -->
                    <StackPanel
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasNoMatch, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="Search24" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource GamePreviewPage_NoMatch}"
                            TextAlignment="Center" />
                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Click="OnClearFilterClick"
                            Content="{DynamicResource GamePreviewPage_ClearFilter}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="4"
                    Padding="10,9"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Width="80"
                            Appearance="Primary"
                            AutomationProperties.Name="{DynamicResource General_StartAll}"
                            Click="OnStartAllClick">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Grid.Column="1"
                            Width="80"
                            Margin="6,0,0,0"
                            Padding="10,6"
                            Appearance="Danger"
                            AutomationProperties.Name="{DynamicResource General_StopAll}"
                            Click="OnStopAllClick"
                            ToolTip="{DynamicResource General_StopAll}"
                            Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="RecordStop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ============ 右：设置（主区域）+ 画面（可折叠侧栏） ============  -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                ========== 画面（辅助视图，可折叠） ==========
                这个功能的"画面"由桌面上的预览小窗承担；页面内这块只用于确认选中的客户端，
                因此固定 260 DIP、纵向紧凑排列；窄视口首次进入自动收起，收起后只留 40 DIP 导轨。
            -->
            <Border
                x:Name="PreviewPane"
                Grid.Column="2"
                Width="300"
                Margin="0,6,0,0"
                Style="{StaticResource Surface}"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Height="40"
                        Margin="12,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Symbol="VideoMultiple24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource GamePreviewPage_Preview}" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="1"
                            Padding="5"
                            Appearance="Transparent"
                            AutomationProperties.Name="{DynamicResource GamePreviewPage_HidePreview}"
                            BorderThickness="0"
                            Click="OnTogglePreviewClick"
                            Icon="{ui:SymbolIcon PanelRightContract24}"
                            ToolTip="{DynamicResource GamePreviewPage_HidePreview}" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ScrollViewer
                        Grid.Row="2"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,6">
                            <!--  选中项名称 + 运行态  -->
                            <Grid Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                    Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource GamePreviewPage_NoSelection}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ProcessName}">
                                            <Binding Path="SelectedProcess.WindowTitle" />
                                            <Binding Path="SelectedProcess.Setting.Name" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!--
                                选中项的启停：整行按钮。
                                "停止预览"用 Danger（红底白字）并加粗——用户反馈原来的 Secondary 图标按钮不够醒目，
                                而多开时最常用的操作恰恰是"停掉某一个"。
                            -->
                            <Grid Margin="12,10,12,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    AutomationProperties.Name="{DynamicResource GamePreviewPage_Start}"
                                    Click="OnStartClick"
                                    Content="{DynamicResource GamePreviewPage_Start}"
                                    Visibility="{Binding SelectedRunning, Converter={StaticResource InverseBoolToVis}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Danger"
                                    AutomationProperties.Name="{DynamicResource GamePreviewPage_Stop}"
                                    Click="OnStopClick"
                                    Content="{DynamicResource GamePreviewPage_Stop}"
                                    FontWeight="SemiBold"
                                    Icon="{ui:SymbolIcon RecordStop24}"
                                    Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!--  实时画面：宽度占满侧栏，高度由 code-behind 按源比例计算（上限 220）  -->
                            <Grid x:Name="PreviewArea" Margin="12,10,12,0">
                                <Border
                                    x:Name="PreviewFrame"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Border
                                        x:Name="PreviewHost"
                                        Margin="1"
                                        Background="Transparent"
                                        ClipToBounds="True">
                                        <StackPanel
                                            Margin="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <ui:SymbolIcon
                                                HorizontalAlignment="Center"
                                                FontSize="26"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Symbol="VideoOff24" />
                                            <TextBlock
                                                x:Name="PreviewHint"
                                                MaxWidth="200"
                                                Margin="0,10,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{DynamicResource GamePreviewPage_PreviewTip}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>

                            <!--
                                当前生效的参数（紧凑纵排）：显示样式 / 不透明度 / 高亮 / 快捷键。
                                块自身随条件隐藏（WhenWindow / WhenHighlight），与设置面板同一套触发条件。
                            -->
                            <StackPanel
                                x:Name="PreviewInfo"
                                Margin="12,10,12,14"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{DynamicResource GamePreviewPage_PreviewMode}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="Text" Value="{DynamicResource GamePreviewPage_PreviewMode_1}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="0">
                                                        <Setter Property="Text" Value="{DynamicResource GamePreviewPage_PreviewMode_0}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="False">
                                                        <Setter Property="Text" Value="{DynamicResource GamePreviewPage_NoPreviewWindow}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Style="{StaticResource WhenWindow}">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource GamePreviewPage_Opacity}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding SelectedSetting.OverlapOpacity}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Style="{StaticResource WhenHighlight}">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{DynamicResource GamePreviewPage_GroupHighlight}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border
                                                Width="9"
                                                Height="9"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding SelectedSetting.HighlightColor, Converter={StaticResource ColorBrush}}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2" />
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Setter Property="Text" Value="{DynamicResource GamePreviewPage_On}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedSetting.Highlight}" Value="False">
                                                                <Setter Property="Text" Value="{DynamicResource GamePreviewPage_Off}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{DynamicResource GamePreviewPage_ItemHotKey}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="Text" Value="{Binding SelectedSetting.HotKey}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSetting.HotKey}" Value="">
                                                        <Setter Property="Text" Value="{DynamicResource GamePreviewPage_NotSet}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  收起后的窄导轨：一键展开画面侧栏  -->
            <Border
                x:Name="PreviewRail"
                Grid.Column="2"
                Width="40"
                Margin="0,6,0,0"
                Style="{StaticResource Surface}"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <ui:Button
                        Margin="0,6,0,0"
                        Padding="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        AutomationProperties.Name="{DynamicResource GamePreviewPage_ShowPreview}"
                        BorderThickness="0"
                        Click="OnTogglePreviewClick"
                        Icon="{ui:SymbolIcon PanelLeftExpand24}"
                        ToolTip="{DynamicResource GamePreviewPage_ShowPreview}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource GamePreviewPage_Preview}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Border>

            <!--  ========== 设置（主区域） ==========  -->
            <TabControl
                x:Name="SettingsTabs"
                Grid.Column="0"
                Margin="0,6,0,0"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding SettingsTabIndex, Mode=TwoWay}">
                <!--
                    索引由 VM 的 SettingsTabIndex 给出：0 = 选中项设置、1 = 全局设置、2 = 分组设置、3 = 切换顺序。
                    未选中进程时 0 归一化为 1（此时"选中项设置"页签已隐藏）。
                    双向绑定：点页签即回写 SettingsTabIndex。不能只绑"是否全局"：WPF 允许选中一个已隐藏的
                    TabItem，启动时索引 0 而该项隐藏，就会停在隐藏页上、全局设置点不到。
                -->
                <TabItem Header="{DynamicResource GamePreviewPage_ItemSetting}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer
                        Padding="0,2,6,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource GamePreviewPage_ItemSettingTip}" />

                            <!--  操作：对这个客户端的一次性动作（原来是底栏一排纯图标按钮）  -->
                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupActions}" />
                            <Border Style="{StaticResource GroupCard}">
                                <!--
                                    操作按钮按内容宽度横向排布，一行放不下再自动换行（WrapPanel）。
                                    设置区现在比原来宽很多，4 个操作在常见宽度下可同排；窄窗口才折行，
                                    不再像之前那样每个按钮各占一整行。
                                    启停按钮保留红/主题色与加粗，仍然是这组里最醒目的一项。
                                -->
                                <WrapPanel Margin="12,10,4,2">
                                    <ui:Button
                                        MinHeight="34"
                                        Margin="0,0,8,8"
                                        Padding="12,6"
                                        Appearance="Primary"
                                        AutomationProperties.Name="{DynamicResource GamePreviewPage_Start}"
                                        Click="OnStartClick"
                                        Content="{DynamicResource GamePreviewPage_Start}"
                                        Visibility="{Binding SelectedRunning, Converter={StaticResource InverseBoolToVis}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button
                                        MinHeight="34"
                                        Margin="0,0,8,8"
                                        Padding="12,6"
                                        Appearance="Danger"
                                        AutomationProperties.Name="{DynamicResource GamePreviewPage_Stop}"
                                        Click="OnStopClick"
                                        Content="{DynamicResource GamePreviewPage_Stop}"
                                        FontWeight="SemiBold"
                                        Icon="{ui:SymbolIcon RecordStop24}"
                                        Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        MinHeight="34"
                                        Margin="0,0,8,8"
                                        Padding="12,6"
                                        Click="OnActivateSourceClick"
                                        Content="{DynamicResource GamePreviewPage_OpenSourceWindow}"
                                        Icon="{ui:SymbolIcon ArrowStepIn24}" />
                                    <!--  恢复位置只对"显示预览窗口"有意义：无窗口时 SetPosition 是空实现  -->
                                    <ui:Button
                                        MinHeight="34"
                                        Margin="0,0,8,8"
                                        Padding="12,6"
                                        Click="OnRestorePositionClick"
                                        Content="{DynamicResource GamePreviewPage_RestorePosition}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Visibility="{Binding SelectedSetting.ShowPreviewWindow, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button
                                        MinHeight="34"
                                        Margin="0,0,8,8"
                                        Padding="12,6"
                                        Click="OnApplyToAllClick"
                                        Content="{DynamicResource GamePreviewPage_ApplyToAll}"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </WrapPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupWindow}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_ShowPreviewWindow}"
                                            ToolTip="{DynamicResource GamePreviewPage_ShowPreviewWindowTip}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_ShowPreviewWindow}"
                                            IsChecked="{Binding SelectedSetting.ShowPreviewWindow, Mode=TwoWay}"
                                            ToolTip="{DynamicResource GamePreviewPage_ShowPreviewWindowTip}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <!--  只在"显示预览窗口"打开时才有意义的外观 / 前景联动  -->
                                    <StackPanel Style="{StaticResource WhenWindow}">
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_PreviewMode}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Width="200"
                                                SelectedIndex="{Binding SelectedSetting.ShowPreviewWindowMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="{DynamicResource GamePreviewPage_PreviewMode_0}" />
                                                <ComboBoxItem Content="{DynamicResource GamePreviewPage_PreviewMode_1}" />
                                            </ComboBox>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource RowLabel}"
                                                Text="{DynamicResource GamePreviewPage_LockAspectRatio}"
                                                ToolTip="{DynamicResource GamePreviewPage_LockAspectRatioTip}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_LockAspectRatio}"
                                                IsChecked="{Binding SelectedSetting.LockAspectRatio, Mode=TwoWay}"
                                                ToolTip="{DynamicResource GamePreviewPage_LockAspectRatioTip}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Opacity}" />
                                            <Slider
                                                Grid.Column="1"
                                                Width="160"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100"
                                                Minimum="0"
                                                TickFrequency="1"
                                                Value="{Binding SelectedSetting.OverlapOpacity, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding SelectedSetting.OverlapOpacity}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource RowLabel}"
                                                Text="{DynamicResource GamePreviewPage_HideOnForeground}"
                                                ToolTip="{DynamicResource GamePreviewPage_HideOnForegroundTip}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_HideOnForeground}"
                                                IsChecked="{Binding SelectedSetting.HideOnForeground, Mode=TwoWay}"
                                                ToolTip="{DynamicResource GamePreviewPage_HideOnForegroundTip}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <!--  "活动时隐藏"打开时，高亮永远不会生效（先隐藏了就没有边框可高亮）  -->
                                    <StackPanel Style="{StaticResource WhenWindowNoHide}">
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Highlight}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_Highlight}"
                                                IsChecked="{Binding SelectedSetting.Highlight, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_RespondGlobalHotKey}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_RespondGlobalHotKey}"
                                            IsChecked="{Binding SelectedSetting.RespondGlobalHotKey, Mode=TwoWay}" />
