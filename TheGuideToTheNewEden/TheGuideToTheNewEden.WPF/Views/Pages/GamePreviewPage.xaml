<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.GamePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent">

    <!--
        阶段 134：多开页按「AI 助手 / 主页」的新观感重排。
        三条取向（与阶段 133 的 AI 助手、阶段 92 的主页一致）：
          ① 少包裹：左侧客户端栏是**一层** 8px 圆角卡片（主页的卡片语言），右侧设置区完全去卡片化
             （Win11 设置页那套「分组卡 + 分隔线 + 12px 内边距」），中间只在页面上放一块"屏幕"；
          ② 层次清楚：左 = 有哪些客户端（含运行态）/ 中 = 选中客户端的实时画面与关键参数 / 右 = 该项设置，
             阅读顺序与"选中 → 看画面 → 调设置"一致；操作按钮跟着作用对象走（开始/停止在预览标题行，
             激活/恢复位置/应用到其余在设置里的「操作」组），不再堆在底栏；
          ③ 只留必要信息：去掉标题栏式卡片头与 6 个纯图标底栏按钮；设置项收成按需分组，
             长说明压成 11px 提示行；「名称条颜色」两项已无任何窗口读取（阶段 44 删掉彩色名称条后成了死设置），
             一并从界面移除。
        布局是「左侧竖向客户端列表（220）+ 预览（*）+ 设置（300）」：客户端常见十几个，竖向列表
        一屏能扫完（两行一项约 40 DIP，12 个约 480 DIP）；三列宽度按"窗口内容区约 908 DIP"配平
        （220 + 8 + 300 + 8 固定后预览仍有约 370）。
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:ColorHexConverter x:Key="ColorHex" />
        <conv:ColorToBrushConverter x:Key="ColorBrush" />
        <conv:ProcessDisplayNameConverter x:Key="ProcessName" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!--  一级面板：顶部客户端条（8px 圆角 + 1px 描边，与主页卡片一致）  -->
        <Style x:Key="Surface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            条件显示用的容器样式（目标类型 StackPanel）：把"只在某条件下才有意义"的几行包进一个 StackPanel，
            默认 Collapsed、条件满足时 Visible。全部走绑定（条件一变立即生效，不写 code-behind）：
              · 没显示预览窗口            → 外观/不透明度/隐藏/高亮/角色名叠加/恢复位置 全部不显示；
              · 游戏窗口活动时隐藏 已开启  → 高亮（以及高亮边框组）没有意义，一并隐藏；
              · 高亮 未开启               → 高亮边框颜色/宽度 不显示；
              · 带标题栏（样式 0）        → 角色名叠加不显示（名字已在标题栏），并提示"上边距不生效"；
              · 跟随窗口缩放 关闭         → 缩放倍率不显示。
            没选中客户端时 SelectedSetting 为 null → 不满足任何条件 → 整块隐藏（此时页签本身也隐藏）。
        -->
        <Style x:Key="WhenWindow" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenWindowNoHide" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.HideOnForeground}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenHighlight" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.HideOnForeground}" Value="False" />
                        <Condition Binding="{Binding SelectedSetting.Highlight}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenOverlay" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="True" />
                        <Condition Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="1" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenFollowScale" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.NameOverlayFollowScale}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenTitleBar" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  说明 / 提示：统一 11px 三级色  -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <!--  设置区分组：分组标题 + 圆角分组卡（Win11 设置页语言）  -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="2,10,0,6" />
        </Style>

        <Style
            x:Key="GroupCard"
            BasedOn="{StaticResource SettingsGroupBorder}"
            TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!--  设置行：左标签 + 右控件，40px 行高  -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style
            x:Key="RowDivider"
            BasedOn="{StaticResource SettingsDivider}"
            TargetType="Border">
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <!--  颜色色块（颜色值输入框左边的预览）  -->
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            客户端列表项：圆角 + 悬停/选中反馈。
            选中态用主题色 1px 描边（与 TabItem 的选中口径一致），运行态由前面的绿点表示。
        -->
        <Style x:Key="ProcessItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            客户端项：运行态圆点 + 角色名 + 窗口标题（第二行）+ 快捷键胶囊。
            名字用 MultiBinding 把两个"会变"的输入都绑上（窗口标题 + 配置里的角色名）；
            单值绑定绑的是整个对象，改具体属性时不会重新求值（详见 ProcessDisplayNameConverter 注释）。
        -->
        <DataTemplate x:Key="ProcessItemTemplate">
            <Grid ToolTip="{Binding WindowTitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="8"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    ToolTip="{DynamicResource GamePreviewPage_Running}">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Fill="{DynamicResource SystemFillColorSuccessBrush}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ProcessName}">
                                <Binding Path="WindowTitle" />
                                <Binding Path="Setting.Name" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding WindowTitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Pill}"
                    ToolTip="{DynamicResource GamePreviewPage_ItemHotKey}"
                    Visibility="{Binding Setting.HotKey, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Style="{StaticResource PillText}" Text="{Binding Setting.HotKey}" />
                </Border>

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="OnStartProcessClick" Header="{DynamicResource GamePreviewPage_Start}" />
                        <MenuItem Click="OnStopProcessClick" Header="{DynamicResource GamePreviewPage_Stop}" />
                        <Separator />
                        <MenuItem Click="OnMoveUpClick" Header="{DynamicResource GamePreviewPage_MoveUp}" />
                        <MenuItem Click="OnMoveDownClick" Header="{DynamicResource GamePreviewPage_MoveDown}" />
                        <MenuItem Click="OnRestorePositionClick" Header="{DynamicResource GamePreviewPage_RestorePosition}" />
                        <Separator />
                        <MenuItem Click="OnActivateSourceClick" Header="{DynamicResource GamePreviewPage_OpenSourceWindow}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <!--  分组里的"角色"点选胶囊：选中 = 主题色描边 + 浅底；绿点 = 该角色正在预览  -->
        <Style x:Key="CharacterChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CharacterChipContent">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="5"
                    Height="5"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource SystemFillColorSuccessBrush}"
                    Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    MaxWidth="120"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  分组快捷键编辑行  -->
        <DataTemplate x:Key="HotKeyGroupTemplate">
            <Border
                Padding="12,10"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="{DynamicResource GamePreviewPage_GroupHotkey_Name}" Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="5"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Click="OnRemoveGroupClick"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="{DynamicResource GamePreviewPage_GroupHotkey_Remove}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Margin="0,0,3,0"
                            PlaceholderText="{DynamicResource GamePreviewPage_Forward}"
                            Text="{Binding SwitchHotkey_Forward, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <ui:TextBox
                            Grid.Column="1"
                            Margin="3,0,0,0"
                            PlaceholderText="{DynamicResource GamePreviewPage_Backward}"
                            Text="{Binding SwitchHotkey_Backward, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <!--
                        角色成员：点选胶囊（不再手输"逗号分隔的角色名"）。
                        候选来自页面 VM 的 CharacterCandidates（发现中的客户端 + 已保存配置 + 其他分组里手工加的名字），
                        成员关系仍写回 PreviewHotKeyGroup.GameNames；选中态与计数在 code-behind 里同步（HashSet 没有变更通知）。
                    -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="GroupSelectedCount"
                            VerticalAlignment="Center"
                            Style="{StaticResource Hint}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button
                                Padding="7,2"
                                Appearance="Transparent"
                                BorderThickness="0"
                                Click="OnSelectAllGroupCharactersClick"
                                Content="{DynamicResource GamePreviewPage_GroupHotkey_SelectAll}"
                                FontSize="11" />
                            <ui:Button
                                Padding="7,2"
                                Appearance="Transparent"
                                BorderThickness="0"
                                Click="OnClearGroupCharactersClick"
                                Content="{DynamicResource GamePreviewPage_GroupHotkey_Clear}"
                                FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl
                        x:Name="GroupCharacterList"
                        Margin="0,4,0,0"
                        Loaded="OnGroupCharacterListLoaded"
                        ItemsSource="{Binding DataContext.CharacterCandidates, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton
                                    Click="OnGroupCharacterChipClick"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource CharacterChipContent}"
                                    Loaded="OnGroupCharacterChipLoaded"
                                    Style="{StaticResource CharacterChip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  不在候选列表里的角色（未登录 / 未保存配置）也能手工加进分组  -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="GroupNewCharacter" PlaceholderText="{DynamicResource GamePreviewPage_GroupHotkey_AddPlaceholder}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="OnAddGroupCharacterClick"
                            Content="{DynamicResource GamePreviewPage_GroupHotkey_AddCharacter}"
                            Icon="{ui:SymbolIcon PersonAdd24}" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{DynamicResource GamePreviewPage_GroupHotkey_Restart}"
                            IsChecked="{Binding Restart, Mode=TwoWay}" />
                        <ui:Button
                            HorizontalAlignment="Right"
                            Click="OnApplyGroupClick"
                            Content="{DynamicResource GamePreviewPage_Apply}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        外层 Grid 只做一件事：把页面夹在承载页面的 ScrollViewer 视口内
        （ConverterParameter = 上下/左右外边距之和；ViewportMaxHeightConverter 就是"视口值 − 内边距"）。
        不夹住的话，页面会被内容撑高/撑宽，滚轮与横向溢出都会落到整个页面上。
    -->
    <Grid
        x:Name="PageRoot"
        Margin="14,6,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：客户端列表 ============  -->
        <Border Grid.Column="0" Style="{StaticResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Height="40"
                    Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource GamePreviewPage_Clients}" />

                    <!--  运行计数胶囊：2 / 12 = 12 个客户端里 2 个正在预览  -->
                    <Border
                        Grid.Column="1"
                        Margin="6,0,2,0"
                        Style="{StaticResource Pill}"
                        ToolTip="{DynamicResource GamePreviewPage_Running}"
                        Visibility="{Binding HasProcesses, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="5"
                                Height="5"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding ProcessCountText}" />
                        </StackPanel>
                    </Border>

                    <ui:Button
                        Grid.Column="2"
                        Padding="5"
                        Appearance="Transparent"
                        AutomationProperties.Name="{DynamicResource General_RefreshList}"
                        BorderThickness="0"
                        Click="OnRefreshClick"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{DynamicResource General_RefreshList}" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Row="2">
                    <!--  竖向列表：两行一项（角色名 + 窗口标题），十几个客户端一屏基本放得下  -->
                    <ListBox
                        x:Name="ProcessList"
                        Padding="6,4"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ProcessItem}"
                        ItemTemplate="{StaticResource ProcessItemTemplate}"
                        ItemsSource="{Binding Processes}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedProcess, Mode=TwoWay}" />

                    <!--  空态：没发现客户端（游戏未启动 / 关键词不匹配）  -->
                    <StackPanel
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasProcesses, Converter={StaticResource InverseBoolToVis}}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ScreenSearch24" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource GamePreviewPage_NoClientTip}"
                            TextAlignment="Center" />
                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Click="OnRefreshClick"
                            Content="{DynamicResource General_RefreshList}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="3"
                    Padding="10,9"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            AutomationProperties.Name="{DynamicResource General_StartAll}"
                            Click="OnStartAllClick"
                            Content="{DynamicResource General_StartAll}"
                            Icon="{ui:SymbolIcon Play24}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="7"
                            AutomationProperties.Name="{DynamicResource General_StopAll}"
                            BorderThickness="0"
                            Click="OnStopAllClick"
                            ToolTip="{DynamicResource General_StopAll}"
                            Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  ============ 右：预览 + 设置 ============  -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  ========== 预览 ==========  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题行：预览 · 角色名 ·（预览中） | 右侧只留"开始/停止"  -->
                <Grid
                    Grid.Row="0"
                    Height="40"
                    Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="VideoMultiple24" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource GamePreviewPage_Preview}" />
                        <Border
                            Grid.Column="2"
                            Width="1"
                            Height="12"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{DynamicResource GamePreviewPage_NoSelection}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ProcessName}">
                                    <Binding Path="SelectedProcess.WindowTitle" />
                                    <Binding Path="SelectedProcess.Setting.Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <Border
                            Grid.Column="4"
                            Margin="10,0,0,0"
                            Style="{StaticResource Pill}"
                            Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Style="{StaticResource PillText}" Text="{DynamicResource GamePreviewPage_Running}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <ui:Button
                            Margin="0,0,2,0"
                            Appearance="Primary"
                            AutomationProperties.Name="{DynamicResource GamePreviewPage_Start}"
                            Click="OnStartClick"
                            Content="{DynamicResource GamePreviewPage_Start}"
                            Icon="{ui:SymbolIcon Play24}"
                            Visibility="{Binding SelectedRunning, Converter={StaticResource InverseBoolToVis}}" />
                        <ui:Button
                            Appearance="Secondary"
                            AutomationProperties.Name="{DynamicResource GamePreviewPage_Stop}"
                            Click="OnStopClick"
                            Content="{DynamicResource GamePreviewPage_Stop}"
                            Visibility="{Binding SelectedRunning, Converter={StaticResource BoolToVis}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="RecordStop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!--
                    预览区宽度占满、高度按源画面比例在 code-behind 里算（并夹在可用高度内），
                    所以画面与区域严丝合缝、不会留黑边；外框比宿主大 1px，有画面时也看得见描边。
                    画面 + 下方参数条作为一组垂直居中，窗口很高时不会变成"贴顶的一块小图"。
                -->
                <Grid
                    x:Name="PreviewArea"
                    Grid.Row="1"
                    Margin="0,6,0,2">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="PreviewFrame"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="22"
                                    Direction="270"
                                    Opacity="0.16"
                                    ShadowDepth="3"
                                    Color="#000000" />
                            </Border.Effect>
                            <Border
                                x:Name="PreviewHost"
                                Margin="1"
                                Background="Transparent"
                                ClipToBounds="True">
                                <StackPanel
                                    Margin="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        FontSize="26"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="VideoOff24" />
                                    <TextBlock
                                        x:Name="PreviewHint"
                                        MaxWidth="320"
                                        Margin="0,10,0,0"
                                        FontSize="12.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource GamePreviewPage_PreviewTip}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="0,10,0,0"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />

                        <!--
                            关键参数（只列"当前真的生效"的项）：显示样式 / 不透明度 / 高亮边框 / 激活快捷键。
                            块自身随条件隐藏（WhenWindow / WhenWindowNoHide），WrapPanel 保证窄窗口下换行而不是被裁。
                        -->
                        <WrapPanel
                            x:Name="PreviewInfo"
                            Grid.Row="2"
                            Margin="2,10,2,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource GamePreviewPage_PreviewMode}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12.5"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="Text" Value="{DynamicResource GamePreviewPage_PreviewMode_1}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindowMode}" Value="0">
                                                    <Setter Property="Text" Value="{DynamicResource GamePreviewPage_PreviewMode_0}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedSetting.ShowPreviewWindow}" Value="False">
                                                    <Setter Property="Text" Value="{DynamicResource GamePreviewPage_NoPreviewWindow}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Margin="0,0,26,0"
                                Style="{StaticResource WhenWindow}">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource GamePreviewPage_Opacity}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding SelectedSetting.OverlapOpacity}" />
                            </StackPanel>

                            <StackPanel
                                Margin="0,0,26,0"
                                Style="{StaticResource WhenHighlight}">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource GamePreviewPage_GroupHighlight}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <Border
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding SelectedSetting.HighlightColor, Converter={StaticResource ColorBrush}}" />
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSetting.Highlight}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="Text" Value="{DynamicResource GamePreviewPage_On}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSetting.Highlight}" Value="False">
                                                        <Setter Property="Text" Value="{DynamicResource GamePreviewPage_Off}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource GamePreviewPage_ItemHotKey}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12.5"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="Text" Value="{Binding SelectedSetting.HotKey}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSetting.HotKey}" Value="">
                                                    <Setter Property="Text" Value="{DynamicResource GamePreviewPage_NotSet}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!--  ========== 设置 ==========  -->
            <TabControl
                Grid.Column="2"
                Margin="0,6,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding SettingsTabIndex, Mode=TwoWay}">
                <!--
                    索引由 VM 的 SettingsTabIndex 给出（未选中进程时恒为 1 = 全局设置），双向绑定：
                    点页签即回写 IsGlobalSetting。不能反过来只绑"是否全局"：WPF 允许选中一个已隐藏的 TabItem，
                    启动时索引 0 而该项隐藏，就会停在隐藏页上、全局设置点不到。
                -->
                <TabItem Header="{DynamicResource GamePreviewPage_ItemSetting}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer
                        Padding="0,2,6,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource GamePreviewPage_ItemSettingTip}" />

                            <!--  操作：对这个客户端的一次性动作（原来是底栏一排纯图标按钮）  -->
                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupActions}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <ui:Button
                                        HorizontalAlignment="Stretch"
                                        Click="OnActivateSourceClick"
                                        Content="{DynamicResource GamePreviewPage_OpenSourceWindow}"
                                        Icon="{ui:SymbolIcon ArrowStepIn24}" />
                                    <!--  恢复位置只对"显示预览窗口"有意义：无窗口时 SetPosition 是空实现  -->
                                    <StackPanel Style="{StaticResource WhenWindow}">
                                        <ui:Button
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRestorePositionClick"
                                            Content="{DynamicResource GamePreviewPage_RestorePosition}"
                                            Icon="{ui:SymbolIcon ArrowReset24}" />
                                    </StackPanel>
                                    <ui:Button
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="OnApplyToAllClick"
                                        Content="{DynamicResource GamePreviewPage_ApplyToAll}"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupWindow}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_ShowPreviewWindow}"
                                            ToolTip="{DynamicResource GamePreviewPage_ShowPreviewWindowTip}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_ShowPreviewWindow}"
                                            IsChecked="{Binding SelectedSetting.ShowPreviewWindow, Mode=TwoWay}"
                                            ToolTip="{DynamicResource GamePreviewPage_ShowPreviewWindowTip}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <!--  只在"显示预览窗口"打开时才有意义的外观 / 前景联动  -->
                                    <StackPanel Style="{StaticResource WhenWindow}">
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_PreviewMode}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Width="132"
                                                SelectedIndex="{Binding SelectedSetting.ShowPreviewWindowMode, Mode=TwoWay}">
                                                <ComboBoxItem Content="{DynamicResource GamePreviewPage_PreviewMode_0}" />
                                                <ComboBoxItem Content="{DynamicResource GamePreviewPage_PreviewMode_1}" />
                                            </ComboBox>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Opacity}" />
                                            <Slider
                                                Grid.Column="1"
                                                Width="110"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                Maximum="100"
                                                Minimum="10"
                                                TickFrequency="5"
                                                Value="{Binding SelectedSetting.OverlapOpacity, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding SelectedSetting.OverlapOpacity}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource RowLabel}"
                                                Text="{DynamicResource GamePreviewPage_HideOnForeground}"
                                                ToolTip="{DynamicResource GamePreviewPage_HideOnForegroundTip}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_HideOnForeground}"
                                                IsChecked="{Binding SelectedSetting.HideOnForeground, Mode=TwoWay}"
                                                ToolTip="{DynamicResource GamePreviewPage_HideOnForegroundTip}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <!--  "活动时隐藏"打开时，高亮永远不会生效（先隐藏了就没有边框可高亮）  -->
                                    <StackPanel Style="{StaticResource WhenWindowNoHide}">
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Highlight}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_Highlight}"
                                                IsChecked="{Binding SelectedSetting.Highlight, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_RespondGlobalHotKey}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_RespondGlobalHotKey}"
                                            IsChecked="{Binding SelectedSetting.RespondGlobalHotKey, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  高亮边框：只有"显示窗口 + 活动时高亮"都成立时才有意义  -->
                            <StackPanel Style="{StaticResource WhenHighlight}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupHighlight}" />
                                <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_HighlightColor}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Background="{Binding SelectedSetting.HighlightColor, Converter={StaticResource ColorBrush}}"
                                            Style="{StaticResource Swatch}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            Width="96"
                                            Text="{Binding SelectedSetting.HighlightColor, Converter={StaticResource ColorHex}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <!--  高亮边框宽度：四边一排（左/上/右/下），省掉四行  -->
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_HighlightMargin}" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource GamePreviewPage_Margin_Left}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource GamePreviewPage_Margin_Top}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource GamePreviewPage_Margin_Right}" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{DynamicResource GamePreviewPage_Margin_Bottom}" />

                                            <ui:TextBox
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Width="42"
                                                MinHeight="28"
                                                Margin="0,3,3,0"
                                                Padding="4,2"
                                                TextAlignment="Center"
                                                Text="{Binding SelectedSetting.HighlightMarginLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            <ui:TextBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Width="42"
                                                MinHeight="28"
                                                Margin="0,3,3,0"
                                                Padding="4,2"
                                                TextAlignment="Center"
                                                Text="{Binding SelectedSetting.HighlightMarginTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            <ui:TextBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Width="42"
                                                MinHeight="28"
                                                Margin="0,3,3,0"
                                                Padding="4,2"
                                                TextAlignment="Center"
                                                Text="{Binding SelectedSetting.HighlightMarginRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            <ui:TextBox
                                                Grid.Row="1"
                                                Grid.Column="3"
                                                Width="42"
                                                MinHeight="28"
                                                Margin="0,3,0,0"
                                                Padding="4,2"
                                                TextAlignment="Center"
                                                Text="{Binding SelectedSetting.HighlightMarginBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                    </Grid>

                                    <!--  带标题栏（样式 0）不画上边框：只有左/右/下三边生效  -->
                                    <StackPanel Style="{StaticResource WhenTitleBar}">
                                        <Border Style="{StaticResource RowDivider}" />
                                        <TextBlock
                                            Margin="12,6,12,9"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource GamePreviewPage_MarginTopIgnored}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!--  角色名叠加：只在"显示窗口 + 无标题栏（样式 1）"时才有意义  -->
                            <StackPanel Style="{StaticResource WhenOverlay}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_NameOverlay}" />
                                <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFont}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="150"
                                            ItemsSource="{Binding FontFamilies}"
                                            SelectedItem="{Binding SelectedSetting.NameOverlayFontFamily, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFontSize}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="66"
                                            MinHeight="30"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            TextAlignment="Center"
                                            Text="{Binding SelectedSetting.NameOverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFollowScale}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_NameOverlayFollowScale}"
                                            IsChecked="{Binding SelectedSetting.NameOverlayFollowScale, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <!--  缩放倍率只在"跟随窗口缩放"打开时生效  -->
                                    <StackPanel Style="{StaticResource WhenFollowScale}">
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayScaleFactor}" />
                                            <ui:TextBox
                                                Grid.Column="1"
                                                Width="66"
                                                MinHeight="30"
                                                Padding="6,3"
                                                HorizontalAlignment="Right"
                                                IsEnabled="{Binding SelectedSetting.NameOverlayFollowScale}"
                                                TextAlignment="Center"
                                                Text="{Binding SelectedSetting.NameOverlayScaleFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />
                                    </StackPanel>

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayBackground}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Background="{Binding SelectedSetting.NameOverlayBackgroundColor, Converter={StaticResource ColorBrush}}"
                                            Style="{StaticResource Swatch}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            Width="96"
                                            Text="{Binding SelectedSetting.NameOverlayBackgroundColor, Converter={StaticResource ColorHex}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayBackgroundHighlight}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Background="{Binding SelectedSetting.NameOverlayBackgroundColorHighlight, Converter={StaticResource ColorBrush}}"
                                            Style="{StaticResource Swatch}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            Width="96"
                                            Text="{Binding SelectedSetting.NameOverlayBackgroundColorHighlight, Converter={StaticResource ColorHex}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayForeground}" />
                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Background="{Binding SelectedSetting.NameOverlayForegroundColor, Converter={StaticResource ColorBrush}}"
                                            Style="{StaticResource Swatch}" />
                                        <ui:TextBox
                                            Grid.Column="2"
                                            Width="96"
                                            Text="{Binding SelectedSetting.NameOverlayForegroundColor, Converter={StaticResource ColorHex}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <Border Style="{StaticResource RowDivider}" />
                                    <TextBlock
                                        Margin="12,8,12,10"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_NameOverlayTip}" />
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_ItemHotKey}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <ui:TextBox
                                        LostFocus="OnItemHotkeyLostFocus"
                                        PlaceholderText="{DynamicResource GamePreviewPage_HotkeyPlaceholder}"
                                        Text="{Binding SelectedSetting.HotKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_HotkeyTip}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource GamePreviewPage_GlobalSetting}">
                    <ScrollViewer
                        Padding="0,2,6,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock
                                Margin="2,0,0,6"
                                Style="{StaticResource GroupTitle}"
                                Text="{DynamicResource GamePreviewPage_GroupDiscovery}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_ProcessKeywords}" />
                                    <ui:TextBox
                                        Margin="0,6,0,0"
                                        PlaceholderText="{DynamicResource GamePreviewPage_ProcessKeywordsPlaceholder}"
                                        Text="{Binding ProcessKeywords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_ProcessKeywordsTip}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_SwitchHotkey}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Forward}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="120"
                                            Text="{Binding ForwardHotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Backward}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="120"
                                            Text="{Binding BackwardHotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <TextBlock
                                        Margin="12,8,12,10"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_SwitchHotkeyTip}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_ActivationMode}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <ComboBox SelectedIndex="{Binding Setting.SetForegroundWindowMode, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_0}" />
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_1}" />
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_2}" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_UniformSize}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_UniformWidth}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="66"
                                            MinHeight="30"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            TextAlignment="Center"
                                            Text="{Binding Setting.UniformWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_UniformHeight}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="66"
                                            MinHeight="30"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            TextAlignment="Center"
                                            Text="{Binding Setting.UniformHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <StackPanel
                                        Margin="12,8,12,10"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Click="OnApplyUniformSizeClick"
                                            Content="{DynamicResource GamePreviewPage_Apply}"
                                            Icon="{ui:SymbolIcon Resize24}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_AutoLayout}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <StackPanel Margin="12,10">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Mode}" />
                                        <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding Setting.AutoLayout, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_0}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_1}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_2}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_3}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Anchor}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="132"
                                            SelectedIndex="{Binding Setting.AutoLayoutAnchor, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_0}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_1}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_2}" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Span}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="66"
                                            MinHeight="30"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            TextAlignment="Center"
                                            Text="{Binding Setting.AutoLayoutSpan, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Count}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="66"
                                            MinHeight="30"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            TextAlignment="Center"
                                            Text="{Binding Setting.AutoLayoutCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <StackPanel
                                        Margin="12,8,12,10"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Click="OnApplyAutoLayoutClick"
                                            Content="{DynamicResource GamePreviewPage_Apply}"
                                            Icon="{ui:SymbolIcon Grid24}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_Order}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <ui:TextBox
                                        Height="72"
                                        AcceptsReturn="True"
                                        Text="{Binding OrderText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        TextWrapping="NoWrap"
                                        VerticalScrollBarVisibility="Auto" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button
                                            HorizontalAlignment="Left"
                                            Click="OnFillOrderClick"
                                            Content="{DynamicResource GamePreviewPage_Order_FromList}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Click="OnApplyOrderClick"
                                            Content="{DynamicResource GamePreviewPage_Apply}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_Behavior}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_StartAllWithNoneSetting}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_StartAllWithNoneSetting}"
                                            IsChecked="{Binding Setting.StartAllWithNoneSetting, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_AutoStartNewProcess}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_AutoStartNewProcess}"
                                            IsChecked="{Binding Setting.AutoStartNewProcess, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_SwitchCharacterKeepSetting}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_SwitchCharacterKeepSetting}"
                                            IsChecked="{Binding Setting.SwitchCharacterKeepSetting, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupHotkey}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource GamePreviewPage_GroupHotkeyTip}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="OnAddGroupClick"
                                            Content="{DynamicResource GamePreviewPage_GroupHotkey_Add}"
                                            Icon="{ui:SymbolIcon Add24}" />
                                    </Grid>
                                    <ItemsControl ItemTemplate="{StaticResource HotKeyGroupTemplate}" ItemsSource="{Binding HotKeyGroups}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
