                                <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_GroupHighlight}" />
                                <Border Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_HighlightColor}" />
                                            <pickers:ColorPickerButton Grid.Column="1" Color="{Binding SelectedSetting.HighlightColor, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <!--  高亮边框宽度：四边一排（左/上/右/下），省掉四行  -->
                                        <Grid Margin="12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_HighlightMargin}" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource GamePreviewPage_Margin_Left}" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource GamePreviewPage_Margin_Top}" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource GamePreviewPage_Margin_Right}" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{DynamicResource GamePreviewPage_Margin_Bottom}" />

                                                <ui:TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Width="60"
                                                    MinHeight="28"
                                                    Margin="0,3,3,0"
                                                    Padding="4,2"
                                                    ClearButtonEnabled="False"
                                                    Text="{Binding SelectedSetting.HighlightMarginLeft, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    TextAlignment="Center" />
                                                <ui:TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Width="60"
                                                    MinHeight="28"
                                                    Margin="0,3,3,0"
                                                    Padding="4,2"
                                                    ClearButtonEnabled="False"
                                                    Text="{Binding SelectedSetting.HighlightMarginTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    TextAlignment="Center" />
                                                <ui:TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Width="60"
                                                    MinHeight="28"
                                                    Margin="0,3,3,0"
                                                    Padding="4,2"
                                                    ClearButtonEnabled="False"
                                                    Text="{Binding SelectedSetting.HighlightMarginRight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    TextAlignment="Center" />
                                                <ui:TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="3"
                                                    Width="60"
                                                    MinHeight="28"
                                                    Margin="0,3,0,0"
                                                    Padding="4,2"
                                                    ClearButtonEnabled="False"
                                                    Text="{Binding SelectedSetting.HighlightMarginBottom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    TextAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <!--  带标题栏（样式 0）不画上边框：只有左/右/下三边生效  -->
                                        <StackPanel Style="{StaticResource WhenTitleBar}">
                                            <Border Style="{StaticResource RowDivider}" />
                                            <TextBlock
                                                Margin="12,6,12,9"
                                                Style="{StaticResource Hint}"
                                                Text="{DynamicResource GamePreviewPage_MarginTopIgnored}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  角色名叠加：只在"显示窗口 + 无标题栏（样式 1）"时才有意义  -->
                            <StackPanel Style="{StaticResource WhenOverlay}">
                                <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_NameOverlay}" />
                                <Border Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFont}" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Width="200"
                                                ItemsSource="{Binding FontFamilies}"
                                                SelectedItem="{Binding SelectedSetting.NameOverlayFontFamily, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFontSize}" />
                                            <ui:TextBox
                                                Grid.Column="1"
                                                Width="120"
                                                Height="32"
                                                Padding="6,3"
                                                HorizontalAlignment="Right"
                                                ClearButtonEnabled="False"
                                                Text="{Binding SelectedSetting.NameOverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayFollowScale}" />
                                            <ui:ToggleSwitch
                                                Grid.Column="1"
                                                AutomationProperties.Name="{DynamicResource GamePreviewPage_NameOverlayFollowScale}"
                                                IsChecked="{Binding SelectedSetting.NameOverlayFollowScale, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <!--  缩放倍率只在"跟随窗口缩放"打开时生效  -->
                                        <StackPanel Style="{StaticResource WhenFollowScale}">
                                            <Grid Style="{StaticResource Row}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayScaleFactor}" />
                                                <ui:TextBox
                                                    Grid.Column="1"
                                                    Width="120"
                                                    Height="32"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Right"
                                                    ClearButtonEnabled="False"
                                                    IsEnabled="{Binding SelectedSetting.NameOverlayFollowScale}"
                                                    Text="{Binding SelectedSetting.NameOverlayScaleFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </Grid>
                                            <Border Style="{StaticResource RowDivider}" />
                                        </StackPanel>

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayBackground}" />
                                            <pickers:ColorPickerButton Grid.Column="1" Color="{Binding SelectedSetting.NameOverlayBackgroundColor, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayBackgroundHighlight}" />
                                            <pickers:ColorPickerButton Grid.Column="1" Color="{Binding SelectedSetting.NameOverlayBackgroundColorHighlight, Mode=TwoWay}" />
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}" />

                                        <Grid Style="{StaticResource Row}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_NameOverlayForeground}" />
                                            <pickers:ColorPickerButton Grid.Column="1" Color="{Binding SelectedSetting.NameOverlayForegroundColor, Mode=TwoWay}" />
                                        </Grid>

                                        <Border Style="{StaticResource RowDivider}" />
                                        <TextBlock
                                            Margin="12,8,12,10"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource GamePreviewPage_NameOverlayTip}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_ItemHotKey}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <pickers:HotkeyInput
                                        Hotkey="{Binding SelectedSetting.HotKey, Mode=TwoWay}"
                                        HotkeyApplied="OnItemHotkeyApplied"
                                        PlaceholderText="{DynamicResource GamePreviewPage_HotkeyPlaceholder}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_HotkeyTip}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource GamePreviewPage_GlobalSetting}">
                    <ScrollViewer
                        Padding="0,2,6,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock
                                Margin="2,0,0,6"
                                Style="{StaticResource GroupTitle}"
                                Text="{DynamicResource GamePreviewPage_GroupDiscovery}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_ProcessKeywords}" />
                                    <ui:TextBox
                                        Margin="0,6,0,0"
                                        PlaceholderText="{DynamicResource GamePreviewPage_ProcessKeywordsPlaceholder}"
                                        Text="{Binding ProcessKeywords, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_ProcessKeywordsTip}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_SwitchHotkey}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Forward}" />
                                        <pickers:HotkeyInput
                                            Grid.Column="1"
                                            Width="200"
                                            Height="32"
                                            Hotkey="{Binding ForwardHotkey, Mode=TwoWay}"
                                            PlaceholderText="{DynamicResource GamePreviewPage_HotkeyPlaceholder}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_Backward}" />
                                        <pickers:HotkeyInput
                                            Grid.Column="1"
                                            Width="200"
                                            Height="32"
                                            Hotkey="{Binding BackwardHotkey, Mode=TwoWay}"
                                            PlaceholderText="{DynamicResource GamePreviewPage_HotkeyPlaceholder}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <TextBlock
                                        Margin="12,8,12,10"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_SwitchHotkeyTip}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_ActivationMode}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel Margin="12,10">
                                    <ComboBox SelectedIndex="{Binding Setting.SetForegroundWindowMode, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_0}" />
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_1}" />
                                        <ComboBoxItem Content="{DynamicResource GamePreviewPage_ActivationMode_2}" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_UniformSize}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_UniformWidth}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="140"
                                            Height="32"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            Text="{Binding Setting.UniformWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_UniformHeight}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="140"
                                            Height="32"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            Text="{Binding Setting.UniformHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <StackPanel
                                        Margin="12,8,12,10"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Click="OnApplyUniformSizeClick"
                                            Content="{DynamicResource GamePreviewPage_Apply}"
                                            Icon="{ui:SymbolIcon Resize24}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_AutoLayout}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <StackPanel Margin="12,10">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Mode}" />
                                        <ComboBox Margin="0,6,0,0" SelectedIndex="{Binding Setting.AutoLayout, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_0}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_1}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_2}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Mode_3}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Anchor}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="140"
                                            SelectedIndex="{Binding Setting.AutoLayoutAnchor, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_0}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_1}" />
                                            <ComboBoxItem Content="{DynamicResource GamePreviewPage_AutoLayout_Anchor_2}" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Span}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="140"
                                            Height="32"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            Text="{Binding Setting.AutoLayoutSpan, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{DynamicResource GamePreviewPage_AutoLayout_Count}" />
                                        <ui:TextBox
                                            Grid.Column="1"
                                            Width="140"
                                            Height="32"
                                            Padding="6,3"
                                            HorizontalAlignment="Right"
                                            Text="{Binding Setting.AutoLayoutCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <StackPanel
                                        Margin="12,8,12,10"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Click="OnApplyAutoLayoutClick"
                                            Content="{DynamicResource GamePreviewPage_Apply}"
                                            Icon="{ui:SymbolIcon Grid24}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_Snap}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_SnapEnabled}"
                                            ToolTip="{DynamicResource GamePreviewPage_SnapEnabledTip}" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_SnapEnabled}"
                                            IsChecked="{Binding Setting.SnapEnabled, Mode=TwoWay}"
                                            ToolTip="{DynamicResource GamePreviewPage_SnapEnabledTip}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_SnapDistance}"
                                            ToolTip="{DynamicResource GamePreviewPage_SnapDistanceTip}" />
                                        <ui:NumberBox
                                            Grid.Column="1"
                                            Width="140"
                                            ClearButtonEnabled="False"
                                            Maximum="64"
                                            Minimum="1"
                                            SmallChange="1"
                                            ToolTip="{DynamicResource GamePreviewPage_SnapDistanceTip}"
                                            Value="{Binding Setting.SnapDistance, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupTitle}" Text="{DynamicResource GamePreviewPage_Behavior}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_StartAllWithNoneSetting}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_StartAllWithNoneSetting}"
                                            IsChecked="{Binding Setting.StartAllWithNoneSetting, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_AutoStartNewProcess}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_AutoStartNewProcess}"
                                            IsChecked="{Binding Setting.AutoStartNewProcess, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource RowLabel}"
                                            Text="{DynamicResource GamePreviewPage_SwitchCharacterKeepSetting}"
                                            TextWrapping="Wrap" />
                                        <ui:ToggleSwitch
                                            Grid.Column="1"
                                            AutomationProperties.Name="{DynamicResource GamePreviewPage_SwitchCharacterKeepSetting}"
                                            IsChecked="{Binding Setting.SwitchCharacterKeepSetting, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ========== 分组设置（独立页签：列表 + 编辑当前分组） ==========  -->
                <TabItem Header="{DynamicResource GamePreviewPage_GroupSettingTab}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,2,0,0"
                            Style="{StaticResource Hint}"
                            Text="{DynamicResource GamePreviewPage_GroupHotkeyTip}" />

                        <!--
                            分组选择器（阶段 139）：搜索 + 下拉选择 + 添加/上移/下移/删除。
                            这一块固定在页签顶部、不随编辑区滚动；原来的 240 高分组列表改成下拉，
                            分组多时既不用先滚回顶部切组，也省掉约 200 DIP 垂直空间。
                        -->
                        <Border
                            Grid.Row="1"
                            Margin="0,8,0,2"
                            Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="12,10,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox
                                        PlaceholderText="{DynamicResource GamePreviewPage_GroupHotkey_FilterPlaceholder}"
                                        Text="{Binding GroupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{DynamicResource GamePreviewPage_GroupHotkey_FilterPlaceholder}">
                                        <ui:TextBox.Icon>
                                            <ui:SymbolIcon Symbol="Search24" />
                                        </ui:TextBox.Icon>
                                    </ui:TextBox>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Click="OnAddGroupClick"
                                        Content="{DynamicResource GamePreviewPage_GroupHotkey_Add}"
                                        Icon="{ui:SymbolIcon Add24}" />
                                </Grid>

                                <Grid Margin="12,8,12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Height="32"
                                        HorizontalContentAlignment="Stretch"
                                        IsTextSearchEnabled="True"
                                        ItemTemplate="{StaticResource HotKeyGroupItemTemplate}"
                                        ItemsSource="{Binding HotKeyGroupsView}"
                                        MaxDropDownHeight="320"
                                        SelectedItem="{Binding SelectedHotKeyGroup, Mode=TwoWay}"
                                        TextSearch.TextPath="GroupName" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <ui:Button
                                            Padding="5"
                                            Appearance="Transparent"
                                            BorderThickness="0"
                                            Click="OnRemoveSelectedGroupClick"
                                            IsEnabled="{Binding HasSelectedHotKeyGroup}"
                                            ToolTip="{DynamicResource GamePreviewPage_GroupHotkey_Remove}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Margin="12,0,12,10"
                                    Style="{StaticResource Hint}"
                                    Text="{DynamicResource GamePreviewPage_GroupHotkey_Empty}"
                                    Visibility="{Binding HasHotKeyGroups, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock
                                    Margin="12,0,12,10"
                                    Style="{StaticResource Hint}"
                                    Text="{DynamicResource GamePreviewPage_GroupHotkey_NoMatch}"
                                    Visibility="{Binding HasGroupNoMatch, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!--  编辑当前分组：只有这一块滚动，顶部选择器始终固定可见  -->
                        <ScrollViewer
                            Grid.Row="2"
                            Padding="0,2,6,0"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,4">
                                <Border Style="{StaticResource GroupCard}" Visibility="{Binding HasSelectedHotKeyGroup, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DataContext="{Binding SelectedHotKeyGroup}">
                                        <!--  名称（上/下移/删除已移到顶部选择器，这里只负责改名）  -->
                                        <ui:TextBox
                                            Margin="12,10,12,0"
                                            PlaceholderText="{DynamicResource GamePreviewPage_GroupHotkey_Name}"
                                            Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <Grid Margin="12,8,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <pickers:HotkeyInput
                                                Margin="0,0,3,0"
                                                Hotkey="{Binding SwitchHotkey_Forward, Mode=TwoWay}"
                                                PlaceholderText="{DynamicResource GamePreviewPage_Forward}" />
                                            <pickers:HotkeyInput
                                                Grid.Column="1"
                                                Margin="3,0,0,0"
                                                Hotkey="{Binding SwitchHotkey_Backward, Mode=TwoWay}"
                                                PlaceholderText="{DynamicResource GamePreviewPage_Backward}" />
                                        </Grid>

                                        <!--
                                            角色成员：点选胶囊。候选来自页面 VM 的 CharacterCandidates
                                            （发现中的客户端 + 已保存配置 + 其他分组里手工加的名字）；
                                            成员关系仍写回 PreviewHotKeyGroup.GameNames，选中态与计数在 code-behind 里同步。
                                        -->
                                        <Grid Margin="12,10,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="GroupSelectedCount"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Hint}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ui:Button
                                                    Padding="7,2"
                                                    Appearance="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnSelectAllGroupCharactersClick"
                                                    Content="{DynamicResource GamePreviewPage_GroupHotkey_SelectAll}"
                                                    FontSize="11" />
                                                <ui:Button
                                                    Padding="7,2"
                                                    Appearance="Transparent"
                                                    BorderThickness="0"
                                                    Click="OnClearGroupCharactersClick"
                                                    Content="{DynamicResource GamePreviewPage_GroupHotkey_Clear}"
                                                    FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  还没进入角色的客户端不会出现在候选里：明确提示原因，避免误以为没刷新  -->
                                        <TextBlock
                                            Margin="12,2,12,0"
                                            Style="{StaticResource Hint}"
                                            Text="{Binding DataContext.UnnamedClientHint, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            Visibility="{Binding DataContext.HasUnnamedClients, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock
                                            Margin="12,2,12,0"
                                            Style="{StaticResource Hint}"
                                            Text="{Binding DataContext.DuplicateCharacterNameHint, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            Visibility="{Binding DataContext.HasDuplicateCharacterNames, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />

                                        <!--  胶囊区最高 180 DIP：客户端多时内部滚动，不把整页撑长  -->
                                        <ScrollViewer
                                            MaxHeight="180"
                                            Margin="12,4,12,0"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl
                                                x:Name="GroupCharacterList"
                                                ItemsSource="{Binding DataContext.CharacterCandidates, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                Loaded="OnGroupCharacterListLoaded">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton
                                                            Click="OnGroupCharacterChipClick"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource CharacterChipContent}"
                                                            Loaded="OnGroupCharacterChipLoaded"
                                                            Style="{StaticResource CharacterChip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!--  不在候选列表里的角色（未登录 / 未保存配置）也能手工加进分组  -->
                                        <Grid Margin="12,4,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="GroupNewCharacter" PlaceholderText="{DynamicResource GamePreviewPage_GroupHotkey_AddPlaceholder}" />
                                            <ui:Button
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Click="OnAddGroupCharacterClick"
                                                Content="{DynamicResource GamePreviewPage_GroupHotkey_AddCharacter}"
                                                Icon="{ui:SymbolIcon PersonAdd24}" />
                                        </Grid>

                                        <!--
                                            分组顺序（阶段 138）：
                                            关闭"单独排序"时跟随「切换顺序」的全局排序；开启后按下面的列表循环。
                                            顺序按角色名保存，窗口标题变化（切换角色）不会让分组顺序失效。
                                        -->
                                        <Border Style="{StaticResource RowDivider}" />
                                        <Grid Margin="12,8,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Style="{StaticResource RowLabel}"
                                                Text="{DynamicResource GamePreviewPage_GroupOrder}"
                                                ToolTip="{DynamicResource GamePreviewPage_GroupOrder_Tip}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{DynamicResource GamePreviewPage_GroupOrder_Custom}" />
                                                <ui:ToggleSwitch
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="{DynamicResource GamePreviewPage_GroupOrder_Custom}"
                                                    Click="OnGroupOrderModeClick"
                                                    IsChecked="{Binding UseGlobalOrder, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                                    ToolTip="{DynamicResource GamePreviewPage_GroupOrder_Tip}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="12,2,12,0"
                                            Style="{StaticResource Hint}"
                                            Text="{DynamicResource GamePreviewPage_GroupOrder_Tip}" />

                                        <StackPanel Visibility="{Binding UseGlobalOrder, Converter={StaticResource InverseBoolToVis}}">
                                            <WrapPanel Margin="12,8,4,0">
                                                <ui:Button
                                                    MinHeight="30"
                                                    Margin="0,0,8,6"
                                                    Padding="10,4"
                                                    Click="OnGroupOrderFillGlobalClick"
                                                    Content="{DynamicResource GamePreviewPage_GroupOrder_FromGlobal}"
                                                    FontSize="12"
                                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                                <ui:Button
                                                    MinHeight="30"
                                                    Margin="0,0,8,6"
                                                    Padding="10,4"
                                                    Click="OnGroupOrderSortClick"
                                                    Content="{DynamicResource GamePreviewPage_Order_Sort}"
                                                    FontSize="12"
                                                    Icon="{ui:SymbolIcon ArrowSort24}" />
                                            </WrapPanel>

                                            <ListBox
                                                x:Name="GroupOrderList"
                                                MaxHeight="180"
                                                Padding="4,2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource StretchListItem}"
                                                ItemTemplate="{StaticResource GroupOrderItemTemplate}"
                                                ItemsSource="{Binding DataContext.GroupOrderEntries, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                            <TextBlock
                                                Margin="12,8,12,4"
                                                Style="{StaticResource Hint}"
                                                Text="{DynamicResource GamePreviewPage_GroupOrder_Empty}"
                                                Visibility="{Binding DataContext.HasGroupOrderEntries, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>

                                        <Grid Margin="12,8,12,10">
                                            <CheckBox
                                                VerticalAlignment="Center"
                                                Content="{DynamicResource GamePreviewPage_GroupHotkey_Restart}"
                                                IsChecked="{Binding Restart, Mode=TwoWay}" />
                                            <ui:Button
                                                HorizontalAlignment="Right"
                                                Click="OnApplyGroupClick"
                                                Content="{DynamicResource GamePreviewPage_Apply}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!--  ========== 切换顺序（独立页签：可上/下移的顺序列表） ==========  -->
                <TabItem Header="{DynamicResource GamePreviewPage_Order}">
                    <ScrollViewer
                        Padding="0,2,6,0"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource GamePreviewPage_OrderTip}" />

                            <Border Margin="0,8,0,2" Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <WrapPanel Margin="12,10,4,2">
                                        <ui:Button
                                            MinHeight="34"
                                            Margin="0,0,8,8"
                                            Padding="12,6"
                                            Click="OnOrderFillClick"
                                            Content="{DynamicResource GamePreviewPage_Order_FromList}"
                                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                                        <ui:Button
                                            MinHeight="34"
                                            Margin="0,0,8,8"
                                            Padding="12,6"
                                            Click="OnOrderSortByNameClick"
                                            Content="{DynamicResource GamePreviewPage_Order_Sort}"
                                            Icon="{ui:SymbolIcon ArrowSort24}" />
                                        <ui:Button
                                            MinHeight="34"
                                            Margin="0,0,8,8"
                                            Padding="12,6"
                                            Click="OnOrderRefreshClick"
                                            Content="{DynamicResource General_RefreshList}"
                                            Icon="{ui:SymbolIcon ArrowSync24}" />
                                    </WrapPanel>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <ListBox
                                        x:Name="SwitchOrderList"
                                        MaxHeight="460"
                                        Padding="4,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource StretchListItem}"
                                        ItemTemplate="{StaticResource SwitchOrderItemTemplate}"
                                        ItemsSource="{Binding SwitchOrderEntries}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                    <TextBlock
                                        Margin="12,8,12,10"
                                        Style="{StaticResource Hint}"
                                        Text="{DynamicResource GamePreviewPage_Order_Empty}"
                                        Visibility="{Binding HasSwitchOrderEntries, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
