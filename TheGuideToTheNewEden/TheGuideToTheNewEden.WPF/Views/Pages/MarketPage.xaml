<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.MarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="MarketCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="MarketNumberCellStyle"
            BasedOn="{StaticResource MarketCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="MarketFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MarketValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  物品头统计卡（卖单 / 买单各一张）：标题 / 标签 / 数值  -->
        <Style x:Key="MarketStatCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MarketStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MarketStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：市场与物品选择 ============  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  市场（星域 / 星系 / 建筑）选择  -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource MarketFieldLabel}" Text="{DynamicResource MarketPage_TargetMarket}" />
                <uc:MarketLocationSelectorView Margin="0,4,0,0" SelectedItem="{Binding SelectedMarketLocation, Mode=TwoWay}" />
            </StackPanel>

            <!--  列表（分组树 / 搜索）与收藏分开展示  -->
            <TabControl Grid.Row="1" Margin="0,10,0,0">
                <TabItem Header="{DynamicResource MarketPage_AllList}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:TextBox
                            Grid.Row="0"
                            Margin="0,6,0,0"
                            PlaceholderText="{DynamicResource MarketPage_SearchType}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <TreeView
                            x:Name="TypeTree"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ItemsSource="{Binding TreeRoots}"
                            SelectedItemChanged="OnTypeTreeSelectedItemChanged"
                            Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVis}}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock
                                        Margin="2,3"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <ListBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            DisplayMemberPath="Name"
                            IsSynchronizedWithCurrentItem="False"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelectionChanged"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_Star}">
                    <ListBox
                        Margin="0,6,0,0"
                        DisplayMemberPath="Name"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding StaredItems}"
                        SelectionChanged="OnStaredSelectionChanged" />
                </TabItem>
            </TabControl>
        </Grid>

        <!--  ============ 右：订单与历史 ============  -->
        <Grid
            Grid.Column="1"
            Margin="6,12,12,12"
            Visibility="{Binding HasSelectedInvType, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  物品头（阶段 90）：左 = 图标+名称+描述+元信息+按钮；右 = 卖/买两张统计卡（单行，无独立按钮行）  -->
            <controls:CardControl Grid.Row="0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  左：物品图标  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="64"
                        Height="64"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Image
                            Width="56"
                            Height="56"
                            Source="{Binding SelectedInvTypeIcon}" />
                    </Border>

                    <!--  中：名称 / 描述（最多两行） / 元信息（体积 · 市场 · 价差） / 操作按钮（图标，悬停提示）  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="14,0,18,0">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding SelectedInvTypeName}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxHeight="34"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedInvTypeDescription}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTip="{Binding SelectedInvTypeDescription}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedInvTypeMetaText}" />

                        <!--  操作按钮：不写死宽高（避免图标被模板内边距裁掉），图标 FontSize=20  -->
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="{DynamicResource MarketPage_AddStar}"
                                Click="OnStarClick"
                                ToolTip="{DynamicResource MarketPage_AddStar}"
                                Visibility="{Binding Stared, Converter={StaticResource InverseBoolToVis}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="Star24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="{DynamicResource MarketPage_CancelStar}"
                                Click="OnStarClick"
                                ToolTip="{DynamicResource MarketPage_CancelStar}"
                                Visibility="{Binding Stared, Converter={StaticResource BoolToVis}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="StarOff24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <!--  固定到主页（P3 参数化磁贴：市场 + 当前物品）  -->
                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="{DynamicResource Home.Quick.PinCurrent}"
                                Click="OnPinToHomeClick"
                                ToolTip="{DynamicResource Home.Quick.PinCurrent}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="Pin24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <!--  物品说明：独立窗口（后续在那里扩展 SDE 更详细属性）  -->
                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="{DynamicResource MarketPage_Description}"
                                Click="OnDescriptionClick"
                                ToolTip="{DynamicResource MarketPage_Description}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="Info24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <!--  买入：独立窗口，显示计算详细  -->
                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                Margin="0,0,6,0"
                                AutomationProperties.Name="{DynamicResource MarketPage_Cal_Buy}"
                                Click="OnCalculatorClick"
                                ToolTip="{DynamicResource MarketPage_Cal_Buy}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="Calculator24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button
                                MinWidth="34"
                                MinHeight="30"
                                AutomationProperties.Name="{DynamicResource MarketPage_Refresh}"
                                Click="OnRefreshClick"
                                ToolTip="{DynamicResource MarketPage_Refresh}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon FontSize="20" Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>

                    <!--  右：卖单 / 买单 两张统计卡（最低/最高价、5%、均价、数量）  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">

                        <!--  卖单卡  -->
                        <Border
                            Padding="14,10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource MarketStatCardTitle}"
                                    Text="{DynamicResource MarketPage_Sell}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Lowest}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding SellTop, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="5%" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding Sell5P, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Mean}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding SellMean, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Amount}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding SellAmount, StringFormat={}{0:N0}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  买单卡  -->
                        <Border
                            Margin="10,0,0,0"
                            Padding="14,10"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource MarketStatCardTitle}"
                                    Text="{DynamicResource MarketPage_Buy}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Highest}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding BuyTop, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="5%" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding Buy5P, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Mean}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding BuyMean, StringFormat={}{0:N0}}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource MarketStatLabel}"
                                        Text="{DynamicResource MarketPage_Amount}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource MarketStatValue}"
                                        Text="{Binding BuyAmount, StringFormat={}{0:N0}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <!--  卖单 / 买单 / 历史  -->
            <TabControl Grid.Row="1" Margin="0,8,0,0">
                <TabItem Header="{DynamicResource MarketPage_Sell}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ui:DataGrid
                            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding SellOrders}"
                            ScrollViewer.CanContentScroll="True"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding VolumeRemain, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Amount}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Price}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Security}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Security}" />
                                <DataGridTextColumn
                                    Width="240"
                                    Binding="{Binding LocationName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Location}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding SolarSystem.SolarSystemName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource General_SolarSystemName}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding RemainTime}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Duration}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding LocationId}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="LocationId" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_Buy}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ui:DataGrid
                            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding BuyOrders}"
                            ScrollViewer.CanContentScroll="True"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding VolumeRemain, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Amount}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Price}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Security}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Security}" />
                                <DataGridTextColumn
                                    Width="240"
                                    Binding="{Binding LocationName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Location}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding SolarSystem.SolarSystemName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource General_SolarSystemName}" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Range}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Range}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding MinVolume, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_MinVolume}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding RemainTime}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Duration}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding LocationId}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="LocationId" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_History}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Width="160"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                SelectedIndex="{Binding HistoryRangeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource MarketPage_History1}" />
                                <ComboBoxItem Content="{DynamicResource MarketPage_History3}" />
                                <ComboBoxItem Content="{DynamicResource MarketPage_History6}" />
                                <ComboBoxItem Content="{DynamicResource MarketPage_History12}" />
                                <ComboBoxItem Content="{DynamicResource MarketPage_HistoryAll}" />
                            </ComboBox>
                            <!--  区间统计信息行（参考行情软件：涨跌幅 / 最高 / 最低 / 均价 / 累计成交）  -->
                            <WrapPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MarketStatLabel}" Text="{DynamicResource MarketPage_PriceChange}" />
                                        <TextBlock Margin="8,0,0,0" Text="{Binding HistoryChangePercentText}">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource MarketStatValue}" TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryRising}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MarketStatLabel}" Text="{DynamicResource MarketPage_HistoryHigh}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource MarketStatValue}"
                                            Text="{Binding HistoryHigh, StringFormat={}{0:N0}}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MarketStatLabel}" Text="{DynamicResource MarketPage_HistoryLow}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource MarketStatValue}"
                                            Text="{Binding HistoryLow, StringFormat={}{0:N0}}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MarketStatLabel}" Text="{DynamicResource MarketPage_HistoryMean}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource MarketStatValue}"
                                            Text="{Binding HistoryMean, StringFormat={}{0:N0}}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource MarketStatLabel}" Text="{DynamicResource MarketPage_HistoryVolume}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource MarketStatValue}"
                                            Text="{Binding HistoryVolumeTotal, StringFormat={}{0:N0}}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>

                        <!--  价格 / 销量 两页签；时间范围下拉覆盖在页签条右侧同一行  -->
                        <TabControl Grid.Row="1">
                            <TabItem Header="{DynamicResource MarketPage_Price}">
                                <Grid>
                                    <lvc:CartesianChart
                                        MinHeight="240"
                                        Background="Transparent"
                                        LegendPosition="Top"
                                        Series="{Binding ActivePriceSeries}"
                                        TooltipPosition="Auto"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        ZoomMode="X" />
                                    <!--  显示模式：高低平均曲线 / 箱体（K线）  -->
                                    <ComboBox
                                        Grid.Row="0"
                                        Width="160"
                                        Margin="0,4,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        SelectedIndex="{Binding PriceChartModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{DynamicResource MarketPage_PriceModeLines}" />
                                        <ComboBoxItem Content="{DynamicResource MarketPage_Candle}" />
                                    </ComboBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{DynamicResource MarketPage_StatisticVolume}">
                                <lvc:CartesianChart
                                    MinHeight="240"
                                    Background="Transparent"
                                    LegendPosition="Top"
                                    Series="{Binding VolumeSeries}"
                                    TooltipPosition="Auto"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="X" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
