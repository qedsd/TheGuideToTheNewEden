<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.MarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="MarketCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="MarketNumberCellStyle"
            BasedOn="{StaticResource MarketCellStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="MarketFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MarketValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  统计小表：5% / 平均 / 数量 三列，卖单、买单各一行（与 WinUI 版同置）  -->
        <Style x:Key="MarketStatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左：市场与物品选择 ============  -->
        <Grid Grid.Column="0" Margin="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  市场（星域 / 星系 / 建筑）选择  -->
            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource MarketFieldLabel}" Text="{DynamicResource MarketPage_TargetMarket}" />
                <uc:MarketLocationSelectorView
                    Margin="0,4,0,0"
                    SelectedItem="{Binding SelectedMarketLocation, Mode=TwoWay}" />
            </StackPanel>

            <!--  列表（分组树 / 搜索）与收藏分开展示  -->
            <TabControl Grid.Row="1" Margin="0,10,0,0">
                <TabItem Header="{DynamicResource MarketPage_AllList}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:TextBox
                            Grid.Row="0"
                            Margin="0,6,0,0"
                            PlaceholderText="{DynamicResource MarketPage_SearchType}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <TreeView
                            x:Name="TypeTree"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ItemsSource="{Binding TreeRoots}"
                            SelectedItemChanged="OnTypeTreeSelectedItemChanged"
                            Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVis}}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock
                                        Margin="2,3"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <ListBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            DisplayMemberPath="Name"
                            IsSynchronizedWithCurrentItem="False"
                            ItemsSource="{Binding SearchResults}"
                            SelectionChanged="OnSearchResultSelectionChanged"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_Star}">
                    <ListBox
                        Margin="0,6,0,0"
                        DisplayMemberPath="Name"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding StaredItems}"
                        SelectionChanged="OnStaredSelectionChanged" />
                </TabItem>
            </TabControl>
        </Grid>

        <!--  ============ 右：订单与历史 ============  -->
        <Grid
            Grid.Column="1"
            Margin="6,12,12,12"
            Visibility="{Binding HasSelectedInvType, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  物品头：第一行 图标 | 名称 | 统计；第二行 操作按钮（右对齐）  -->
            <controls:CardControl Grid.Row="0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Width="56"
                        Height="56"
                        VerticalAlignment="Top"
                        Source="{Binding SelectedInvTypeIcon}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Top"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding SelectedInvTypeName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <!--  卖单/买单统计（与物品名称同一行）  -->
                    <Grid
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource MarketFieldLabel}"
                            Text="5%" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource MarketFieldLabel}"
                            Text="{DynamicResource MarketPage_Mean}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            Style="{StaticResource MarketFieldLabel}"
                            Text="{DynamicResource MarketPage_Amount}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource MarketFieldLabel}"
                            Text="{DynamicResource MarketPage_Sell}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding Sell5P, StringFormat={}{0:N2}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding SellMean, StringFormat={}{0:N2}}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding SellAmount, StringFormat={}{0:N0}}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource MarketFieldLabel}"
                            Text="{DynamicResource MarketPage_Buy}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding Buy5P, StringFormat={}{0:N2}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding BuyMean, StringFormat={}{0:N2}}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Style="{StaticResource MarketStatValue}"
                            Text="{Binding BuyAmount, StringFormat={}{0:N0}}" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="12,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                        <ui:Button
                            Margin="0,0,8,0"
                            Click="OnStarClick"
                            Content="{DynamicResource MarketPage_AddStar}"
                            Visibility="{Binding Stared, Converter={StaticResource InverseBoolToVis}}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Click="OnStarClick"
                            Content="{DynamicResource MarketPage_CancelStar}"
                            Visibility="{Binding Stared, Converter={StaticResource BoolToVis}}" />

                        <!--  物品说明：独立窗口（后续在那里扩展 SDE 更详细属性）  -->
                        <ui:Button
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Click="OnDescriptionClick"
                            Content="{DynamicResource MarketPage_Description}" />

                        <!--  买入：独立窗口，显示计算详细  -->
                        <ui:Button
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Click="OnCalculatorClick"
                            Content="{DynamicResource MarketPage_Cal_Buy}" />

                        <ui:Button Click="OnRefreshClick" Content="{DynamicResource MarketPage_Refresh}" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <!--  卖单 / 买单 / 历史  -->
            <TabControl Grid.Row="1" Margin="0,8,0,0">
                <TabItem Header="{DynamicResource MarketPage_Sell}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ui:DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding SellOrders}"
                            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            ScrollViewer.CanContentScroll="True"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding VolumeRemain, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Amount}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Price}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Security}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Security}" />
                                <DataGridTextColumn
                                    Width="240"
                                    Binding="{Binding LocationName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Location}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding SolarSystem.SolarSystemName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource General_SolarSystemName}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding RemainTime}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Duration}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding LocationId}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="LocationId" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_Buy}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ui:DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding BuyOrders}"
                            MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                            ScrollViewer.CanContentScroll="True"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding VolumeRemain, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Amount}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Price, StringFormat={}{0:N2}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Price}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Security}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_Security}" />
                                <DataGridTextColumn
                                    Width="240"
                                    Binding="{Binding LocationName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Location}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding SolarSystem.SolarSystemName}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource General_SolarSystemName}" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Range}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Range}" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding MinVolume, StringFormat={}{0:N0}}"
                                    ElementStyle="{StaticResource MarketNumberCellStyle}"
                                    Header="{DynamicResource MarketPage_MinVolume}" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding RemainTime}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="{DynamicResource MarketPage_Duration}" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding LocationId}"
                                    ElementStyle="{StaticResource MarketCellStyle}"
                                    Header="LocationId" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource MarketPage_History}">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ComboBox
                            Grid.Row="0"
                            Width="160"
                            HorizontalAlignment="Right"
                            SelectedIndex="{Binding HistoryRangeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource MarketPage_History1}" />
                            <ComboBoxItem Content="{DynamicResource MarketPage_History3}" />
                            <ComboBoxItem Content="{DynamicResource MarketPage_History6}" />
                            <ComboBoxItem Content="{DynamicResource MarketPage_History12}" />
                            <ComboBoxItem Content="{DynamicResource MarketPage_HistoryAll}" />
                        </ComboBox>

                        <TabControl Grid.Row="1" Margin="0,8,0,0">
                            <TabItem Header="{DynamicResource MarketPage_Price}">
                                <lvc:CartesianChart
                                    MinHeight="240"
                                    LegendPosition="Top"
                                    Series="{Binding PriceSeries}"
                                    TooltipPosition="Auto"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="X" />
                            </TabItem>
                            <TabItem Header="{DynamicResource MarketPage_StatisticVolume}">
                                <lvc:CartesianChart
                                    MinHeight="240"
                                    LegendPosition="Top"
                                    Series="{Binding VolumeSeries}"
                                    TooltipPosition="Auto"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    ZoomMode="X" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
