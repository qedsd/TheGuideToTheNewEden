<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.WormholePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:models="clr-namespace:TheGuideToTheNewEden.WPF.Models.Wormhole"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!--  洞系列表条目  -->
        <DataTemplate x:Key="WormholeListItemTemplate" DataType="{x:Type models:WormholeListItem}">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  徽章底色按等级取星图安全等级色板（c1 浅蓝 … c13 红），文字按底色亮度取黑/白  -->
                <Border
                    Grid.Column="1"
                    Width="Auto"
                    Margin="0,0,10,0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Background="{Binding ClassBadgeBrush}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding ClassBadgeTextBrush}"
                        Text="{Binding ClassNameShort}" />
                </Border>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding PhenomenaName}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  洞口按钮（代号 + 通往）  -->
        <DataTemplate x:Key="PortalButtonTemplate" DataType="{x:Type models:PortalButtonModel}">
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Padding="10,6"
                Click="OnPortalButtonClick"
                Style="{DynamicResource SettingsRowButton}">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}" />
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding DestinationsText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--  友链按钮  -->
        <DataTemplate x:Key="LinkButtonTemplate">
            <Button
                MinWidth="96"
                Margin="0,0,8,8"
                Padding="10,6"
                Click="OnLinkButtonClick"
                Content="{Binding}"
                Style="{DynamicResource SettingsRowButton}" />
        </DataTemplate>

        <!--  ZKB 活跃实体行（军团/联盟）  -->
        <!--
            整行铺满：WPF-UI 的隐式 Button 样式把 HorizontalAlignment 设成 Left（=内容宽度），
            裸写 <Button> 时内部 Grid 会被压成"头像+名称+计数"的内容宽度——名称不再裁剪、计数列
            紧贴名称、"N 天前"叠在名称上（实机截图实测）。这里改用键控样式 SettingsRowButton：
            它不带 BasedOn，不继承隐式样式的对齐设置，模板的 ContentPresenter 是 Stretch。
            另外显式写 HorizontalAlignment="Stretch"，避免以后有人给它加 BasedOn 时又退回内容宽度。
        -->
        <DataTemplate x:Key="ActiveEntityTemplate" DataType="{x:Type models:ActiveEntityItem}">
            <Button
                Margin="0,2"
                Padding="4,4"
                HorizontalAlignment="Stretch"
                Click="OnEntityButtonClick"
                Style="{DynamicResource SettingsRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        controls:AsyncImage.Source="{Binding ImageUrl}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Count}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding LastActiveText}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!--  ZKB 热门船型行  -->
        <DataTemplate x:Key="ShipStatTemplate" DataType="{x:Type models:ShipTypeStatItem}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="26"
                    Height="26"
                    Margin="0,0,10,0"
                    controls:AsyncImage.Source="{Binding ImageUrl}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Name}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Count}" />
            </Grid>
        </DataTemplate>

        <!--  天体行  -->
        <DataTemplate x:Key="StellarItemTemplate" DataType="{x:Type models:StellarItem}">
            <Grid Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ItemName}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding TypeName}" />
            </Grid>
        </DataTemplate>

        <!--  洞系详情小节标题  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style
            x:Key="WormholeGridStyle"
            BasedOn="{StaticResource {x:Type ui:DataGrid}}"
            TargetType="{x:Type ui:DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 顶栏：标题 + 模式切换 ============  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{DynamicResource Nav.Wormhole}" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <RadioButton
                    x:Name="ModeBrowserButton"
                    Margin="0,0,6,0"
                    Checked="OnModeChanged"
                    GroupName="WormholeMode"
                    IsChecked="True">
                    <TextBlock Text="{DynamicResource WormholePage_ModeBrowser}" />
                </RadioButton>
                <RadioButton
                    x:Name="ModePortalLibraryButton"
                    Checked="OnModeChanged"
                    GroupName="WormholeMode">
                    <TextBlock Text="{DynamicResource WormholePage_ModePortalLibrary}" />
                </RadioButton>
            </StackPanel>
        </Grid>

        <!--  ============ 模式一：洞系浏览 ============  -->
        <Grid x:Name="BrowserPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="0.85*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  左卡：搜索 + 列表 + 详情  -->
            <controls:CardControl Grid.Column="0">
                <controls:CardControl.Header>
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Margin="0,0,8,0"
                            PlaceholderText="{DynamicResource WormholePage_Search}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            SelectedIndex="{Binding ClassIndex}">
                            <ComboBoxItem Content="{DynamicResource WormholePage_ClassFilter_All}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_1}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_2}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_3}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_4}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_5}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_6}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_12}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_13}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_14}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_15}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_16}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_17}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Class_18}" />
                        </ComboBox>
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="104"
                            SelectedIndex="{Binding PhenomenaIndex}">
                            <ComboBoxItem Content="{DynamicResource WormholePage_PhenomenaFilter_All}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_0}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_1}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_2}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_3}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_4}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_Phenomena_5}" />
                        </ComboBox>
                    </Grid>
                </controls:CardControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  列表  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox
                            x:Name="WormholeList"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{DynamicResource StretchListItem}"
                            ItemTemplate="{StaticResource WormholeListItemTemplate}"
                            ItemsSource="{Binding FilteredWormholes}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedWormhole}" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="10,4"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding FilteredCount, Mode=OneWay}" />
                            <TextBlock
                                Margin="3,0,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource WormholePage_SystemsCount}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!--  详情  -->
                    <Grid Grid.Column="2">
                        <TextBlock
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource WormholePage_NoSelection}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Detail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />

                        <ScrollViewer
                            Margin="0,0,0,4"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding Detail, Converter={StaticResource NullToVis}}">
                            <StackPanel Margin="12,4,12,0">
                                <!--  标题行  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                        Text="{Binding Detail.Name}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button
                                            Margin="4,0,0,0"
                                            Padding="6"
                                            Click="OnCopyNameClick"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            ToolTip="{DynamicResource WormholePage_CopyName}" />
                                    </StackPanel>
                                </Grid>

                                <!--  等级 + 天象（徽章配色与列表一致）  -->
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Border
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding Detail.ClassBadgeBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Detail.ClassBadgeTextBrush}"
                                            Text="{Binding Detail.ClassName}" />
                                    </Border>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{DynamicResource WormholePage_Phenomena}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Detail.PhenomenaName}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail.ClassDescription}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail.PhenomenaDescription}"
                                    TextWrapping="Wrap" />

                                <!--  永联洞  -->
                                <TextBlock
                                    Margin="0,14,0,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource WormholePage_Static}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource PortalButtonTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{Binding Detail.StaticsPortals}"
                                    Visibility="{Binding Detail.HasStatics, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource WormholePage_NoStatics}"
                                    Visibility="{Binding Detail.HasStatics, Converter={StaticResource InverseBoolToVis}}" />

                                <!--  漫游洞  -->
                                <TextBlock
                                    Margin="0,14,0,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource WormholePage_Wandering}" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource PortalButtonTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{Binding Detail.WanderingPortals}"
                                    Visibility="{Binding Detail.HasWanderings, Converter={StaticResource BoolToVis}}" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{DynamicResource WormholePage_NoWanderings}"
                                    Visibility="{Binding Detail.HasWanderings, Converter={StaticResource InverseBoolToVis}}" />

                                <!--  天体  -->
                                <TabControl Margin="0,14,0,0">
                                    <TabItem Header="{DynamicResource WormholePage_Planet}">
                                        <ListBox
                                            ItemContainerStyle="{StaticResource StretchListItem}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemTemplate="{StaticResource StellarItemTemplate}"
                                            ItemsSource="{Binding Detail.Planets}" />
                                    </TabItem>
                                    <TabItem Header="{DynamicResource WormholePage_Moon}">
                                        <ListBox
                                            ItemContainerStyle="{StaticResource StretchListItem}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemTemplate="{StaticResource StellarItemTemplate}"
                                            ItemsSource="{Binding Detail.Moons}" />
                                    </TabItem>
                                    <TabItem Header="{DynamicResource WormholePage_Other}">
                                        <ListBox
                                            ItemContainerStyle="{StaticResource StretchListItem}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemTemplate="{StaticResource StellarItemTemplate}"
                                            ItemsSource="{Binding Detail.Others}" />
                                    </TabItem>
                                </TabControl>

                                <!--  友链  -->
                                <TextBlock
                                    Margin="0,14,0,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{DynamicResource WormholePage_Links}" />
                                <ItemsControl ItemTemplate="{StaticResource LinkButtonTemplate}" ItemsSource="{Binding LinkNames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </controls:CardControl>

            <!--  右卡：ZKB 分析  -->
            <controls:CardControl Grid.Column="2">
                <controls:CardControl.Header>
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{DynamicResource WormholePage_ZKB}" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="110"
                            Margin="8,0"
                            SelectedIndex="{Binding KbRangeIndex}">
                            <ComboBoxItem Content="{DynamicResource WormholePage_ZKB_Range200}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_ZKB_Range400}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_ZKB_Range600}" />
                            <ComboBoxItem Content="{DynamicResource WormholePage_ZKB_Range800}" />
                        </ComboBox>
                        <ui:Button
                            Grid.Column="2"
                            Padding="6"
                            Click="OnOpenKbClick"
                            Icon="{ui:SymbolIcon ScanObject24}"
                            ToolTip="{DynamicResource WormholePage_ZKB_Detail}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="4,0,0,0"
                            Padding="6"
                            Click="OnRefreshKbClick"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="{DynamicResource General_Refresh}" />
                    </Grid>
                </controls:CardControl.Header>
                <Grid>
                    <!--  未选择  -->
                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource WormholePage_ZKB_NoSelection}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Detail, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />

                    <!--  加载中  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Visibility="{Binding IsKbLoading, Converter={StaticResource BoolToVis}}">
                        <controls:SpinnerIcon Width="28" Height="28" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource WormholePage_ZKB_Loading}" />
                    </StackPanel>

                    <!--  空态：无数据 / 取数失败。成功出数据（HasKbData）后隐藏  -->
                    <!--
                        KbSummary 是 VM 里唯一的空态文案出口，此前没有任何绑定，
                        于是 zKB 返回空（或失败）时整张卡片只剩空白：既没数字也没提示。
                    -->
                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding KbSummary}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasKbData, Converter={StaticResource InverseBoolToVis}}" />

                    <!--  统计结果  -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasKbData, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="12,8,12,8">
                            <!--  概要三格  -->
                            <UniformGrid Columns="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource WormholePage_ZKB_Kills}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding KbKillsText}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource WormholePage_ZKB_Isk}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Text="{Binding KbIskText}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{DynamicResource WormholePage_ZKB_Span}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding KbSpanText}" />
                                </StackPanel>
                            </UniformGrid>

                            <!--  最活跃军团  -->
                            <TextBlock
                                Margin="0,14,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource WormholePage_ZKB_MostActiveCorporations}" />
                            <ItemsControl ItemTemplate="{StaticResource ActiveEntityTemplate}" ItemsSource="{Binding TopCorporations}" />

                            <!--  最活跃联盟  -->
                            <TextBlock
                                Margin="0,10,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource WormholePage_ZKB_MostActiveAlliances}" />
                            <ItemsControl ItemTemplate="{StaticResource ActiveEntityTemplate}" ItemsSource="{Binding TopAlliances}" />

                            <!--  热门船型（新增）  -->
                            <TextBlock
                                Margin="0,10,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource WormholePage_ZKB_TopShips}" />
                            <ItemsControl ItemTemplate="{StaticResource ShipStatTemplate}" ItemsSource="{Binding TopShips}" />

                            <!--  活跃时段（新增：堆叠柱状图，本地时间）  -->
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource WormholePage_ZKB_ActivityChart}" />
                            <TextBlock
                                Margin="0,2,0,4"
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{DynamicResource WormholePage_ZKB_ActivityChartNote}" />
                            <lvc:CartesianChart
                                Height="240"
                                LegendPosition="Bottom"
                                Series="{Binding ActivitySeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </controls:CardControl>
        </Grid>

        <!--  ============ 模式二：洞口库 ============  -->
        <controls:CardControl
            x:Name="PortalLibraryPanel"
            Grid.Row="1"
            Visibility="Collapsed">
            <controls:CardControl.Header>
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Margin="0,0,8,0"
                        PlaceholderText="{DynamicResource WormholePage_PortalSearch}"
                        Text="{Binding PortalSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        SelectedIndex="{Binding PortalDestIndex}">
                        <ComboBoxItem Content="{DynamicResource WormholePage_PortalDest_All}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_100}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_101}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_102}" />
                        <!--  c1-c6 复用 WormholePage_Class_1..6：ClassFilter_C* 这组键在语言文件里不存在（下拉会显示键名）  -->
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_1}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_2}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_3}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_4}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_5}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_6}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_12}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Class_13}" />
                    </ComboBox>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="90"
                        SelectedIndex="{Binding PortalRespawnIndex}">
                        <ComboBoxItem Content="{DynamicResource WormholePage_RespawnFilter_All}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Portal_Respawn_Static}" />
                        <ComboBoxItem Content="{DynamicResource WormholePage_Portal_Respawn_Wandering}" />
                    </ComboBox>
                </Grid>
            </controls:CardControl.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:DataGrid
                    x:Name="PortalGrid"
                    Margin="4"
                    ItemsSource="{Binding FilteredPortals}"
                    MouseDoubleClick="OnPortalGridDoubleClick"
                    RowHeight="34"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    Style="{StaticResource WormholeGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="88"
                            Binding="{Binding Name}"
                            Header="{DynamicResource WormholePage_Portal}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding DestinationsText}"
                            Header="{DynamicResource WormholePage_Portal_Destination}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding AppearsInText}"
                            Header="{DynamicResource WormholePage_Portal_AppearsIn}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding LifetimeText}"
                            Header="{DynamicResource WormholePage_Portal_Lifetime}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding MaxMassPerJumpText}"
                            Header="{DynamicResource WormholePage_Portal_MaxMassPerJump}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding TotalJumpMassText}"
                            Header="{DynamicResource WormholePage_Portal_TotalJumpMass}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding MassRegenText}"
                            Header="{DynamicResource WormholePage_Portal_MassRegen}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding RespawnText}"
                            Header="{DynamicResource WormholePage_Portal_Respawn}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding NoteText}"
                            Header="{DynamicResource WormholePage_Portal_Note}"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </ui:DataGrid>
                <StackPanel
                    Grid.Row="1"
                    Margin="10,4"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding PortalCount, Mode=OneWay}" />
                    <TextBlock
                        Margin="3,0,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource WormholePage_PortalsCount}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource WormholePage_PortalLibraryTip}" />
                </StackPanel>
            </Grid>
        </controls:CardControl>
    </Grid>
</Page>
