<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ZKBPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:pages="clr-namespace:TheGuideToTheNewEden.WPF.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <!--
            TabControl 模板：骨架镜像 WPF-UI 4.3.0 默认模板（内容 Border / PART_SelectedContentHost 原样），
            头行改为「单行标签区（宽度 = 全宽 - 40）+ 右侧 40px 预留列」——末尾一段宽度留给页面级搜索按钮；
            标签区为 WinUI3 TabView 式单行滚动（横向 StackPanel 不换行，溢出经左右卷动钮/滚轮横滚，无溢出自动折叠）
        -->
        <ControlTemplate x:Key="KbTabsTemplate" TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    头行：单行标签区（WinUI3 TabView 式——横向 StackPanel 不换行，溢出经左右卷动钮/滚轮横滚，
                    无溢出时卷动钮折叠；ZIndex=1 仍压住内容区顶边线）+ 右侧 240px 预留位给**常驻搜索框**
                    （框本体 200，多留 40 是为了下方结果弹出层不越出窗口右缘）
                -->
                <Grid
                    Grid.Row="0"
                    Height="36"
                    Panel.ZIndex="1"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <!--  标签容器：左外边距由代码设为"钉住头部"的实际宽度，使标签始终在它右侧滚动  -->
                    <DockPanel
                        x:Name="HeaderTabsPanel"
                        Background="Transparent"
                        LastChildFill="True">
                        <RepeatButton
                            Command="{x:Static pages:ZKBPage.HeaderScrollLeftCommand}"
                            DockPanel.Dock="Left"
                            Focusable="False">
                            <RepeatButton.Style>
                                <Style TargetType="RepeatButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <!--  无溢出（ScrollableWidth=0）时整体折叠，对齐 WinUI3 TabView"溢出才出按钮"  -->
                                        <DataTrigger Binding="{Binding ElementName=HeaderScroll, Path=ScrollableWidth}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RepeatButton.Style>
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="0,5"
                                        VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <!--  Filled=True 走 Fluent 的"实心"字形（_filled 变体），比描边版明显更粗  -->
                                        <ui:SymbolIcon
                                            Filled="True"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Symbol="ChevronLeft24" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <RepeatButton
                            Command="{x:Static pages:ZKBPage.HeaderScrollRightCommand}"
                            DockPanel.Dock="Right"
                            Focusable="False">
                            <RepeatButton.Style>
                                <Style TargetType="RepeatButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=HeaderScroll, Path=ScrollableWidth}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RepeatButton.Style>
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border
                                        Width="26"
                                        Height="26"
                                        Margin="0,5"
                                        VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                        <ui:SymbolIcon
                                            Filled="True"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Symbol="ChevronRight24" />
                                    </Border>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <ScrollViewer
                            x:Name="HeaderScroll"
                            HorizontalScrollBarVisibility="Hidden"
                            PreviewMouseWheel="OnHeaderScrollPreviewMouseWheel"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel
                                Margin="0"
                                Background="Transparent"
                                IsItemsHost="True"
                                KeyboardNavigation.TabIndex="1"
                                Orientation="Horizontal" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!--  内容区：与 WPF-UI 默认模板一致  -->
                <Border
                    x:Name="Border"
                    Grid.Row="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,4,4,4"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local">
                    <ContentPresenter
                        x:Name="PART_SelectedContentHost"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ContentSource="SelectedContent"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ControlTemplate>
    </Page.Resources>

    <Grid>
        <!--  ============ 标签宿主（击杀流固定首个 + 实体统计 / KB 详情），自定义头行模板  ============  -->
        <TabControl
            x:Name="Tabs"
            Background="Transparent"
            Template="{StaticResource KbTabsTemplate}" />

        <!--  ============ 钉住的"击杀流"标签头：固定在头行最左端，实体/详情标签在它右侧滚动  ============
              首个 TabItem 的头部已在代码里收敛为零宽，这里用页面级覆盖层重绘一个"标签头"：
              点击选中第一个标签；宽度随标题（语言）自适应，代码把标签容器让开同样的宽度  -->
        <Grid
            x:Name="PinnedStreamHeaderHost"
            Height="36"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Button
                x:Name="PinnedStreamHeader"
                Padding="12,0"
                Click="OnPinnedStreamHeaderClick"
                Content="{DynamicResource ZKBHomePage_KillStream}"
                Cursor="Hand"
                ToolTip="{DynamicResource ZKBHomePage_KillStream}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!--  选中它就是当前标签时，文字与下划线对齐 WPF-UI 的选中态  -->
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="0">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Border
                Height="2"
                Margin="8,0"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                CornerRadius="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>

        <!--
            ============ 常驻搜索框 + 结果下拉：覆盖在头行右侧（与 TabItem Header 同行）  ============
            搜索框**固定**在原来搜索按钮的位置（右对齐、宽 200），不再藏进 Flyout；只有结果列表用 Flyout 弹出。
            WPF-UI 4.x 的 Flyout 模板 Popup 不设 PlacementTarget，锚点 = Flyout 元素自身矩形：
            这里锚点 = 整个 240 宽覆盖层，`Placement=Bottom` 的弹出层与锚点左缘对齐向下展开
            （240 宽正好容纳"内容 200 + 弹出层内边距"，右缘不会越出窗口）。
        -->
        <Grid
            Width="240"
            Height="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <ui:TextBox
                x:Name="SearchBox"
                Width="200"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                PlaceholderText="{DynamicResource ZKBPage_SearchTip}"
                TextChanged="OnSearchTextChanged" />
            <ui:Flyout
                x:Name="SearchFlyout"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Placement="Bottom">
                <StackPanel Width="200">
                    <TextBlock
                        Margin="0,0,0,6"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding SearchStatus}"
                        Visibility="{Binding SearchStatus, Converter={StaticResource StringToVis}}" />
                    <ListBox
                        x:Name="SearchResultList"
                        MaxHeight="360"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource StretchListItem}"
                        ItemsSource="{Binding SearchResults}"
                        SelectionChanged="OnSearchResultSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Id}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Converter={StaticResource CategoryEnum}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Flyout>
        </Grid>
    </Grid>
</Page>
