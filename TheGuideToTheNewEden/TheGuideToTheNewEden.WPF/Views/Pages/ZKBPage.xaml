<Page
    x:Class="TheGuideToTheNewEden.WPF.Views.Pages.ZKBPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:converters="clr-namespace:TheGuideToTheNewEden.WPF.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="Transparent"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:CategoryEnumToStringConverter x:Key="CategoryEnum" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  ============ 顶部：实体搜索 ============  -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <ui:TextBox
                x:Name="SearchBox"
                Width="380"
                HorizontalAlignment="Left"
                PlaceholderText="{DynamicResource ZKBPage_SearchTip}"
                TextChanged="OnSearchTextChanged" />
            <TextBlock
                Margin="392,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SearchStatus}"
                Visibility="{Binding SearchStatus, Converter={StaticResource StringToVis}}" />
        </Grid>

        <!--  ============ 主体：搜索结果 + 标签宿主 ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <controls:CardControl
                Grid.Column="0"
                Width="300"
                Margin="0,0,8,0"
                Header="{DynamicResource ZKBPage_OpenEntity}"
                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                <ListBox
                    x:Name="SearchResultList"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource StretchListItem}"
                    ItemsSource="{Binding SearchResults}"
                    SelectionChanged="OnSearchResultSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Id}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Converter={StaticResource CategoryEnum}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </controls:CardControl>

            <!--  击杀流（固定首个标签）+ 实体统计 / KB 详情标签  -->
            <TabControl
                x:Name="Tabs"
                Grid.Column="1"
                Background="Transparent" />
        </Grid>
    </Grid>
</Page>
