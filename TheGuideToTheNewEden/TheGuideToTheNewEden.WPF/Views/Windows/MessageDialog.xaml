<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="440"
    MaxWidth="560"
    MinWidth="360"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid Margin="16,48,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <ui:SymbolIcon x:Name="IconSymbol" FontSize="24" Margin="0,0,10,0" />
                <TextBlock
                    x:Name="TitleText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                x:Name="MessageText"
                Grid.Row="1"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="YesButton"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Click="OnYesClick"
                    Content="{DynamicResource General_Yes}"
                    IsDefault="True"
                    Visibility="Collapsed" />
                <ui:Button
                    x:Name="OkButton"
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Click="OnOkClick"
                    Content="{DynamicResource General_OK}"
                    IsDefault="True"
                    Visibility="Collapsed" />
                <ui:Button
                    x:Name="NoButton"
                    Click="OnNoClick"
                    Content="{DynamicResource General_No}"
                    IsCancel="True"
                    Visibility="Collapsed" />
                <ui:Button
                    x:Name="CancelButton"
                    Click="OnCancelClick"
                    Content="{DynamicResource General_Cancel}"
                    IsCancel="True"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <ui:TitleBar x:Name="TitleBar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
