<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Home.Action.About}"
    Width="460"
    Height="440"
    MinWidth="380"
    MinHeight="320"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="34"
            Title="{DynamicResource Home.Action.About}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,10,24,20">
                <Image
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Left"
                    Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_128.png" />

                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource AppDisplayName}" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="0,4,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource AppDescription}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Home.About.Runtime}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="RuntimeText"
                    Margin="0,4,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Click="OnGithubClick"
                        Content="{DynamicResource Home.About.Github}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Code24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="OnQqGroupClick"
                        Content="{DynamicResource Home.Status.QqGroup}"
                        Icon="{ui:SymbolIcon Chat24}" />
                    <!--  内置说明书（Markdown）：原来这里是"打开 PDF"，阶段 131 起改指手册窗口  -->
                    <ui:Button
                        Margin="8,0,0,0"
                        Click="OnManualClick"
                        Content="{DynamicResource Home.Action.Manual}"
                        Icon="{ui:SymbolIcon BookQuestionMark24}"
                        ToolTip="{DynamicResource Nav.Manual}" />
                </StackPanel>

                <TextBlock
                    Margin="0,18,0,0"
                    FontSize="12.5"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource Home.About.ThirdParty}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="WPF-UI · H.NotifyIcon · HtmlRenderer.WPF · LiveCharts2 / SkiaSharp · Newtonsoft.Json · EVEStandard · ZKB.NET · Octokit"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
