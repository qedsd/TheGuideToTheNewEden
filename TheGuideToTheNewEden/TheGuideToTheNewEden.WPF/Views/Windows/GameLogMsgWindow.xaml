<Window
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.GameLogMsgWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GameLogMsgWindow"
    Width="440"
    Height="380"
    MinWidth="0"
    MinHeight="0"
    AllowsTransparency="True"
    Background="Transparent"
    Closing="OnWindowClosing"
    Loaded="OnWindowLoaded"
    LocationChanged="OnWindowGeometryChanged"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeChanged="OnWindowGeometryChanged"
    SnapsToDevicePixels="True"
    StateChanged="OnWindowGeometryStateChanged"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!--  背板：不透明度只作用于这一层（颜色与透明度在代码里按设置生成），文字/卡片始终实色  -->
    <Border
        x:Name="BackdropPlate"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏（CaptionHeight=0，拖动在代码里 DragMove；按钮同时负责最小化 / 隐藏）  -->
            <Grid
                x:Name="TitleBarGrid"
                Grid.Row="0"
                Margin="10,0,2,0"
                Background="Transparent"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  阶段 364：清除战斗状态 / 前置游戏 都收到标题栏，底部不再占用一整条  -->
                    <ui:Button
                        x:Name="CombatClearButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        Click="OnCombatClearClick"
                        Icon="{ui:SymbolIcon Eraser24}"
                        ToolTip="{DynamicResource GameLogMsgWindow_ClearCombatTip}"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="ShowGameButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        Click="OnShowGameClick"
                        Icon="{ui:SymbolIcon Desktop24}"
                        ToolTip="{DynamicResource GameLogMsgWindow_ShowGame}" />
                    <ui:Button
                        x:Name="MinimizeButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        Click="OnMinimizeClick"
                        Icon="{ui:SymbolIcon Subtract12}"
                        ToolTip="{DynamicResource ToolWindow.Minimize}" />
                    <ui:Button
                        x:Name="CloseButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        Appearance="Transparent"
                        Click="OnCloseClick"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{DynamicResource General_Close}" />
                </StackPanel>
            </Grid>

            <!--  战斗 / 监控 两块：战斗区固定高度（卡片不再按剩余空间撑满），监控区占剩余高度  -->
            <Grid Grid.Row="1" Margin="13,2,13,0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CombatRow" Height="Auto" />
                    <RowDefinition x:Name="MonitorRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CombatArea" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  阶段 378：所有非伤害分类统一成胶囊（分组名 + 数值），伤害单独一张卡片  -->
                    <ScrollViewer
                        x:Name="ChipsScroll"
                        MaxHeight="150"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PillsList" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="8,2"
                                    Background="{Binding Background}"
                                    CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Expired}" Value="True">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="360">
                                            <TextBlock
                                                FontSize="11"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Arrow}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Amount}" />
                                        <TextBlock
                                            Margin="3,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{Binding Brush}"
                                            Text="{Binding Rest}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!--  阶段 379：伤害只有一张卡片，样式与上一版卡片一致（左侧红条 + 标签 + 两栏）  -->
                    <Border
                        x:Name="DamageCard"
                        Grid.Row="1"
                        Margin="0,2,0,4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                            <StackPanel Grid.Column="1" Margin="9,5,8,6">
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource CombatLog_Damage}" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0" DataContext="{Binding Incoming}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Text="{DynamicResource CombatLog_DamageReceived}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            Text="{Binding LastText}" />
                                        <TextBlock
                                            Margin="6,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding AgoText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DpsText}" />
                                </StackPanel>
                                <Rectangle Grid.Column="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" DataContext="{Binding Outgoing}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                        Text="{DynamicResource CombatLog_DamageDealt}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Text="{Binding LastText}" />
                                        <TextBlock
                                            Margin="6,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding AgoText}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DpsText}" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock
                        x:Name="CombatEmpty"
                        Grid.Row="1"
                        Margin="2,6,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource CombatLog_NoCombat}"
                        Visibility="Collapsed" />
                </Grid>

                <!--  下半部：关键词命中消息流  -->
                <Grid x:Name="MonitorArea" Grid.Row="1">
                    <ScrollViewer
                        x:Name="FeedScroll"
                        Padding="0,1,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FeedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,1">
                                        <Border
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="5"
                                            Opacity="0.10"
                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                        <!--  阶段 370：关键词命中只显示日志原文（不再显示时间 / 配置名）  -->
                                        <TextBlock
                                            Margin="6,3"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock
                        x:Name="FeedEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource GameLogMsgWindow_NoHits}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
