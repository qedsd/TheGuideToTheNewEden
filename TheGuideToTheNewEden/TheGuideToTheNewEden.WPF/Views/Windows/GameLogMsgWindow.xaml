<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.GameLogMsgWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="400"
    Height="300"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowBackdropType="None"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  战斗日志状态条（阶段 357）：由日志监控"战斗日志"开关驱动，与多开叠加层同源  -->
        <Border
            x:Name="CombatPanel"
            Grid.Row="1"
            Margin="8,0,8,4"
            Padding="8,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4"
            Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource CombatLog_PanelTitle}" />
                    <ui:Button
                        x:Name="CombatClearButton"
                        Grid.Column="1"
                        Padding="6,1"
                        Click="OnCombatClearClick"
                        Content="{DynamicResource CombatLog_Clear}"
                        FontSize="11"
                        ToolTip="{DynamicResource CombatLog_Clear}"
                        Visibility="Collapsed" />
                </Grid>
                <ItemsControl x:Name="CombatList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ColorKey}" Value="warning">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColorKey}" Value="success">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColorKey}" Value="info">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColorKey}" Value="purple">
                                                <Setter Property="Foreground" Value="#C084FC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ColorKey}" Value="normal">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="460" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="CombatEmpty"
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{DynamicResource CombatLog_NoCombat}" />
            </StackPanel>
        </Border>

        <RichTextBox
            x:Name="MsgBox"
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0"
            Focusable="False"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto">
            <FlowDocument />
            <RichTextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="OnClearClick" Header="{DynamicResource General_Clear}" />
                </ContextMenu>
            </RichTextBox.ContextMenu>
        </RichTextBox>

        <ui:Button
            Grid.Row="3"
            Margin="8"
            HorizontalAlignment="Stretch"
            Appearance="Primary"
            Click="OnShowGameClick"
            Content="{DynamicResource GameLogMonitorPage_ShowGame}" />
    </Grid>
</ui:FluentWindow>
