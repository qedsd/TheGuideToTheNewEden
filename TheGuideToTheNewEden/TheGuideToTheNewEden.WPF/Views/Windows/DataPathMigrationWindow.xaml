<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.DataPathMigrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource DataPathMigration_Title}"
    Width="720"
    Height="600"
    MinWidth="640"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="MigrationPathBox" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="MigrationPathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MigrationOption" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="MigrationOptionDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="24,2,0,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid Margin="20,52,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{DynamicResource DataPathMigration_Heading}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="IntroText"
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,12,0,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource MigrationPathBox}">
                        <TextBlock x:Name="LegacyPathText" Style="{StaticResource MigrationPathText}" />
                    </Border>

                    <Border
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24" />
                            <TextBlock
                                x:Name="WarningText"
                                Margin="10,0,0,0"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <RadioButton
                        x:Name="UseNewFolderRadio"
                        Margin="0,18,0,4"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        GroupName="DataPathChoice"
                        IsChecked="True">
                        <TextBlock Text="{DynamicResource DataPathMigration_UseNew}" TextWrapping="Wrap" />
                    </RadioButton>
                    <TextBlock x:Name="NewFolderDescription" Style="{StaticResource MigrationOptionDescription}" />
                    <Border
                        Margin="24,0,0,0"
                        Padding="0"
                        Style="{StaticResource MigrationPathBox}">
                        <TextBlock x:Name="NewPathText" Style="{StaticResource MigrationPathText}" />
                    </Border>
                    <CheckBox
                        x:Name="CopyLegacyCheckBox"
                        Margin="24,10,0,0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Content="{DynamicResource DataPathMigration_Copy}"
                        IsChecked="True" />

                    <RadioButton
                        x:Name="UseLegacyFolderRadio"
                        Margin="0,18,0,4"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        GroupName="DataPathChoice">
                        <TextBlock Text="{DynamicResource DataPathMigration_UseLegacy}" TextWrapping="Wrap" />
                    </RadioButton>
                    <TextBlock x:Name="LegacyFolderDescription" Style="{StaticResource MigrationOptionDescription}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="ContinueButton"
                    MinWidth="120"
                    Appearance="Primary"
                    Click="OnContinueClick"
                    Content="{DynamicResource DataPathMigration_Continue}" />
            </StackPanel>
        </Grid>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{DynamicResource DataPathMigration_Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
