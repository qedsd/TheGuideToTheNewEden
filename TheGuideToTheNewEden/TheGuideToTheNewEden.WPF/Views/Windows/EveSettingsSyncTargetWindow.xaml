<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.EveSettingsSyncTargetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="480"
    Height="540"
    MinWidth="420"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid Margin="16,48,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  源文件  -->
            <TextBlock
                x:Name="SourceText"
                Grid.Row="0"
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource EveSettingsSyncPage_SyncDialogTip}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" Margin="0,0,0,6">
                <CheckBox
                    x:Name="SelectAllCheck"
                    VerticalAlignment="Center"
                    Checked="OnSelectAllChecked"
                    Content="{DynamicResource EveSettingsSyncPage_SelectAll}"
                    IsThreeState="True"
                    Unchecked="OnSelectAllUnchecked" />
                <TextBlock
                    x:Name="CountText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Border
                Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ListBox
                    x:Name="TargetList"
                    Padding="8,6"
                    Background="Transparent"
                    BorderThickness="0"
                    IsSynchronizedWithCurrentItem="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox
                                Margin="0,3"
                                Checked="OnItemChecked"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                Unchecked="OnItemChecked">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding SubText}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel
                Grid.Row="4"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="OnOkClick"
                    Content="{DynamicResource EveSettingsSyncPage_Sync}"
                    IsDefault="True" />
                <ui:Button
                    Click="OnCancelClick"
                    Content="{DynamicResource General_Cancel}"
                    IsCancel="True" />
            </StackPanel>
        </Grid>

        <ui:TitleBar x:Name="TitleBar" Title="{DynamicResource EveSettingsSyncPage_SyncDialogTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
