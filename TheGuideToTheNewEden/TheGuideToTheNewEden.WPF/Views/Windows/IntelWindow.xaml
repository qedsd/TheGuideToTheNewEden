<Window
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.IntelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uc="clr-namespace:TheGuideToTheNewEden.WPF.Views.UserControls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="IntelWindow"
    Width="640"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="38"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="IntelCautionBrush" Color="#FF8A4C" />
        <SolidColorBrush x:Key="IntelCautionSoftBrush" Color="#18FF8A4C" />
        <SolidColorBrush x:Key="IntelGreenBrush" Color="#46D39B" />
        <SolidColorBrush x:Key="IntelGreenSoftBrush" Color="#1846D39B" />
        <SolidColorBrush x:Key="IntelKillBrush" Color="#FF6262" />
        <SolidColorBrush x:Key="IntelOutlierBrush" Color="#C3A4FF" />

        <Style x:Key="IntelCaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IntelMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IntelChip" TargetType="Border">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IntelIconButton" TargetType="ui:Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <!--  背板：不透明度只作用于这一层（颜色与透明度在代码里按设置生成）  -->
    <Border x:Name="BackdropPlate" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="DrawerRow" Height="43" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Grid Grid.Row="0" Margin="10,0,4,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image
                        Width="18"
                        Height="18"
                        Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
                    <TextBlock
                        x:Name="TitleText"
                        MaxWidth="320"
                        Margin="8,0,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource IntelCaptionText}"
                        Text="频道预警"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="TitleStatusBorder"
                        Margin="8,0,0,0"
                        Padding="7,2"
                        Background="{StaticResource IntelCautionSoftBrush}"
                        CornerRadius="999">
                        <TextBlock
                            x:Name="TitleStatusText"
                            FontSize="9.5"
                            Foreground="{StaticResource IntelCautionBrush}"
                            Text="预警中" />
                    </Border>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        x:Name="MinimizeButton"
                        Width="34"
                        Height="28"
                        Appearance="Transparent"
                        Click="OnMinimizeClick"
                        Icon="{ui:SymbolIcon Subtract24}"
                        ToolTip="{DynamicResource ToolWindow.Minimize}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <ui:Button
                        x:Name="CloseButton"
                        Width="34"
                        Height="28"
                        Appearance="Transparent"
                        Click="OnCloseClick"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{DynamicResource General_Close}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!--  地图  -->
            <Grid Grid.Row="1" Margin="8,0,8,0">
                <uc:IntelMapView x:Name="MapView" />

                <StackPanel
                    Margin="10,0,0,9"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="9.5"
                        Foreground="{StaticResource IntelGreenBrush}"
                        Text="●" />
                    <TextBlock
                        Margin="3,0,8,0"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IntelWindow_Local}" />
                    <TextBlock
                        FontSize="9.5"
                        Foreground="{StaticResource IntelCautionBrush}"
                        Text="●" />
                    <TextBlock
                        Margin="3,0,8,0"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IntelWindow_Alerts}" />
                    <TextBlock
                        FontSize="9.5"
                        Foreground="{StaticResource IntelCautionBrush}"
                        Text="●" />
                    <TextBlock
                        Margin="3,0,8,0"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IntelWindow_Downgraded}" />
                    <TextBlock
                        FontSize="9.5"
                        Foreground="{StaticResource IntelKillBrush}"
                        Text="●" />
                    <TextBlock
                        Margin="3,0,8,0"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource IntelWindow_Kill}" />
                    <TextBlock
                        FontSize="9.5"
                        Foreground="{StaticResource IntelOutlierBrush}"
                        Text="●" />
                    <TextBlock
                        Margin="3,0,0,0"
                        FontSize="9.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource IntelWindow_Outlier}" />
                </StackPanel>

                <StackPanel
                    Margin="0,0,10,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                    <ui:Button
                        x:Name="ResetViewButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Click="OnResetViewClick"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        ToolTip="{DynamicResource IntelWindow_ResetView}" />
                    <ui:Button
                        x:Name="ClearButton"
                        Width="34"
                        Height="32"
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Click="OnClearClick"
                        Icon="{ui:SymbolIcon Eraser24}"
                        ToolTip="{DynamicResource ChannelIntelPage_ClearAllIntel}" />
                    <ui:Button
                        x:Name="StopSoundButton"
                        Width="34"
                        Height="32"
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Click="OnStopSoundClick"
                        Icon="{ui:SymbolIcon SpeakerMute24}"
                        ToolTip="{DynamicResource ChannelIntelPage_StopSound}" />
                    <ui:Button
                        x:Name="ActivateGameButton"
                        Height="30"
                        Margin="0,4,0,0"
                        Padding="10,0"
                        HorizontalAlignment="Right"
                        Appearance="Transparent"
                        Click="OnActivateGameClick"
                        Icon="{ui:SymbolIcon ArrowUpRight24}"
                        ToolTip="{DynamicResource IntelWindow_ActivateGame}" />
                </StackPanel>
            </Grid>

            <!--  频道内容抽屉：拖动这里调整高度  -->
            <GridSplitter
                x:Name="DrawerSplitter"
                Grid.Row="2"
                Height="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource CardStrokeColorDefaultBrush}"
                Cursor="SizeNS"
                DragCompleted="OnDrawerSplitterDragCompleted"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Rows"
                ToolTip="{DynamicResource IntelWindow_ResizeChannel}"
                Visibility="Collapsed" />

            <Grid x:Name="DrawerRoot" Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="43" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="DrawerHeaderButton"
                    Grid.Row="0"
                    Padding="12,0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnDrawerHeaderClick"
                    Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Grid.Column="0"
                            Margin="0,0,7,0"
                            FontSize="14"
                            Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Symbol="Document24" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{DynamicResource ChannelIntelPage_Contents}" />
                            <TextBlock
                                x:Name="DrawerCountText"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9.5"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="0" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LatestSnippetText"
                            Grid.Column="2"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource IntelWindow_NoMessages}"
                            TextTrimming="CharacterEllipsis" />
                        <ui:SymbolIcon
                            x:Name="DrawerChevron"
                            Grid.Column="3"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Symbol="ChevronDown24" />
                    </Grid>
                </Button>

                <Grid
                    x:Name="DrawerBody"
                    Grid.Row="1"
                    Margin="10,0,10,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="FilterAllButton"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Appearance="Secondary"
                            Click="OnFilterClick"
                            Content="{DynamicResource IntelWindow_All}"
                            FontSize="10.5"
                            Tag="All" />
                        <ui:Button
                            x:Name="FilterAlertButton"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Appearance="Secondary"
                            Click="OnFilterClick"
                            Content="{DynamicResource IntelWindow_Alerts}"
                            FontSize="10.5"
                            Tag="Alert" />
                        <ui:Button
                            x:Name="FilterClearButton"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Appearance="Secondary"
                            Click="OnFilterClick"
                            Content="{DynamicResource IntelWindow_Clear}"
                            FontSize="10.5"
                            Tag="Clear" />
                        <ui:Button
                            x:Name="FilterKillButton"
                            Height="26"
                            Padding="10,0"
                            Appearance="Secondary"
                            Click="OnFilterClick"
                            Content="{DynamicResource IntelWindow_Kill}"
                            FontSize="10.5"
                            Tag="Kill" />
                    </StackPanel>

                    <ListBox
                        x:Name="ChatList"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="ChatRowBorder"
                                    Margin="0,1,0,0"
                                    Padding="7,5"
                                    ToolTip="{Binding ToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Alert">
                                                    <Setter Property="Background" Value="#12FF8A4C" />
                                                    <Setter Property="BorderBrush" Value="#FF8A4C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Clear">
                                                    <Setter Property="Background" Value="#0E46D39B" />
                                                    <Setter Property="BorderBrush" Value="#46D39B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Kill">
                                                    <Setter Property="Background" Value="#10FF6262" />
                                                    <Setter Property="BorderBrush" Value="#FF6262" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Info">
                                                    <Setter Property="Background" Value="#0C66A9FF" />
                                                    <Setter Property="BorderBrush" Value="#66A9FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9.5"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding TimeText}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="3,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="3">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="9"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Channel}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="7,0,6,0"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding SystemVisibility}">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding SystemText}" />
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    FontSize="9.5"
                                                    Foreground="{StaticResource IntelCautionBrush}"
                                                    Text="{Binding JumpText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,1,0,0"
                                                FontSize="10.5"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Message}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Meta}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        x:Name="ChatEmptyText"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{DynamicResource IntelWindow_NoMessages}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
