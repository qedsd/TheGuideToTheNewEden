<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.Windows.MailDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.WPF;assembly=HtmlRenderer.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource MailPage_Mail}"
    Width="820"
    Height="640"
    MinWidth="520"
    MinHeight="360"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    ScrollViewer.CanContentScroll="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <!--  内容：顶部留出标题栏高度，避免被标题栏压住  -->
        <Grid Margin="16,48,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  主题  -->
            <TextBlock
                x:Name="SubjectText"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                TextWrapping="Wrap" />

            <!--  发件人（头像 + 名称）+ 日期  -->
            <Grid Grid.Row="1" Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center">
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="24" />
                    <TextBlock
                        x:Name="FromInitial"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border CornerRadius="24">
                        <Border.Background>
                            <ImageBrush x:Name="FromAvatarBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <Grid
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="FromText"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        ToolTip="{DynamicResource MailPage_From}" />
                    <TextBlock
                        x:Name="DateText"
                        Grid.Row="1"
                        FontWeight="Light"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>

            <!--  收件人  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource MailPage_Recipients}" />
                <TextBlock
                    x:Name="RecipientsText"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    FontWeight="Light"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  标签  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource MailPage_Label}" />
                <TextBlock
                    x:Name="LabelsText"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    FontWeight="Light"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap" />
            </Grid>

            <Border
                Grid.Row="4"
                Height="1"
                Margin="0,8"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!--  正文：HTML 原生渲染（替代 WebView2）；远程图片在代码中剥离，保证离线/隐私  -->
            <ScrollViewer
                Grid.Row="5"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <html:HtmlPanel
                    x:Name="BodyPanel"
                    Background="Transparent"
                    Margin="0,4"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Grid>

        <!--  与主窗口一致的标题栏（主题化，避免系统白色标题栏）  -->
        <ui:TitleBar Title="{DynamicResource MailPage_Mail}" />
    </Grid>
</ui:FluentWindow>
