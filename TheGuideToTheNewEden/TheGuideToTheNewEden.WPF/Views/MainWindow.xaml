<ui:FluentWindow
    x:Class="TheGuideToTheNewEden.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charPages="clr-namespace:TheGuideToTheNewEden.WPF.Views.Pages.Characters"
    xmlns:controls="clr-namespace:TheGuideToTheNewEden.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:TheGuideToTheNewEden.WPF.Views.Pages"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource AppDisplayName}"
    Width="1200"
    Height="800"
    MinWidth="960"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
    WindowBackdropType="Mica"
    mc:Ignorable="d">

    <Grid>

        <!--  NavigationView 铺满整窗：其自带的汉堡按钮位于窗口左上角，正好落在标题栏的左侧预留区  -->
        <!--
            注意：FrameMargin 不在此处设置——WPF-UI 绑定 TitleBar 后会将其覆盖为默认值，
            改由 MainWindow.xaml.cs 的 NavigationTopInset 在加载后应用。
        -->
        <ui:NavigationView
            x:Name="NavigationView"
            Margin="0,4,0,0"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="False"
            IsPaneToggleVisible="True"
            IsTopSeparatorVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Home}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.home}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Characters}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type charPages:CharactersShellPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.characters}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Nav.Business}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.business}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Market}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:MarketPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.market}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Order}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:OrderPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.order}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Scalper}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ScalperPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.scalper}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.CompareMarket}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:CompareMarketPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.compareMarket}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Appraisal}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:AppraisalPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.appraisal}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!--  工业：制造计划（BOM）  -->
                <ui:NavigationViewItem Content="{DynamicResource Nav.Industry}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.industry}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.IndustryPlan}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IndustryPlanPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.industry}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.IndustryPlanetary}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IndustryPlanetaryPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.industry}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.IndustryBlueprints}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IndustryBlueprintPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.industry}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.IndustryInventory}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IndustryInventoryPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.industry}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.IndustryRecycle}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IndustryRecyclePage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.industry}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.GamePreview}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:GamePreviewPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.gamePreview}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  AI 助手不在这里：它是**常驻入口**，放在页脚（见文件末尾 FooterMenuItems，阶段 126）  -->

                <ui:NavigationViewItem Content="{DynamicResource Nav.Channel}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.channel}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.ChannelIntel}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ChannelIntelPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.channelIntel}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.ChannelMonitor}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ChannelMonitorPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.channelMonitor}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.ChannelScan}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ChannelScanPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.channelScan}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.ChannelMarket}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ChannelMarketPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.channelMarket}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.GameLogMonitor}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:GameLogMonitorPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.gameLogMonitor}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!--  翻译：AI 翻译（对话式）/ 频道翻译（实时）/ 本地词库，三个子项  -->
                <ui:NavigationViewItem Content="{DynamicResource Nav.Translation}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.translation}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.TranslationAi}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:AiTranslationPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.translationAi}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.ChannelTranslation}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ChannelTranslationPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.channelTranslation}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.TranslationLocal}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:LocalTranslationPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.translationLocal}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <!--  攻略：死亡远征（DED 空间）/ 任务攻略，两个子项  -->
                <ui:NavigationViewItem Content="{DynamicResource Nav.Guides}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.guides}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.DED}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:DEDPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.ded}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Mission}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:MissionPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.mission}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Wormhole}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:WormholePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.wormhole}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Links}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:LinksPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.links}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Map}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:MapPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.map}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.ZKB}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:ZKBPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.zkb}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Database}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:DatabasePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.database}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.EveSettingsSync}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:EveSettingsSyncPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.eveSettingsSync}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Nav.Tools}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.tools}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Tools_IME}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:IMEPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.toolsIME}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Tools_ServerPing}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:ServerPingPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.serverPing}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Tools_KeyboardSpan}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:KeyboardSpanPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.keyboardSpan}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem
                            Content="{DynamicResource Nav.Tools_Taskbar}"
                            NavigationCacheMode="Required"
                            TargetPageType="{x:Type pages:TaskbarPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:ImageIcon
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource NavIcon.taskbar}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!--
                    AI 助手（阶段 126 从上面的滚动菜单搬来）：它是**常驻入口**而不是普通功能项——
                    页脚不随菜单滚动、导航折叠成图标时也在，与「设置」同级。
                    标题栏还另有一个常驻按钮（见下方 TitleBar），导航面板收起时也能进。
                -->
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Assistant}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:AiAssistantPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.assistant}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="{DynamicResource Nav.Settings}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="{StaticResource NavIcon.settings}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--  标题栏叠加在 NavigationView 之上；其左侧留白由 NavigationView 自动为汉堡按钮预留  -->
        <ui:TitleBar x:Name="TitleBar" Title="{DynamicResource AppDisplayName}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/TheGuideToTheNewEden;component/Assets/logo_32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  托盘图标：后台运行（H.NotifyIcon，与 WinUI 版所用的库对应）  -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="pack://application:,,,/TheGuideToTheNewEden;component/Assets/app.ico"
            MenuActivation="RightClick"
            ToolTipText="{DynamicResource AppDisplayName}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayMenuShow" Header="{DynamicResource Tray.Show}" />
                    <Separator />
                    <MenuItem x:Name="TrayMenuExit" Header="{DynamicResource Tray.Exit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!--
            全局等待遮罩与右下角通知栈（对应 WinUI 版 ShowWaiting / InfoBar）。
            声明在最后 → 覆盖在导航内容之上；遮罩留出标题栏高度，等待期间仍可最小化/关闭窗口。
        -->
        <controls:WaitingOverlay x:Name="WaitingOverlay" Margin="0,36,0,0" />
        <!--  只占右下角自身内容大小，否则这个 UserControl 会铺满窗口吃掉所有点击  -->
        <controls:MessageHost
            x:Name="MessageHost"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />
    </Grid>
</ui:FluentWindow>