<Window
    x:Class="EVESimulation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EVESimulation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EVE"
    Width="1080"
    Height="760"
    MinWidth="900"
    MinHeight="640"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  左：可维护的角色列表  -->
        <DockPanel x:Name="CharacterPanel" Grid.Column="0">
            <TextBlock
                Margin="4,0,0,6"
                DockPanel.Dock="Top"
                FontWeight="Bold"
                Text="角色列表" />
            <WrapPanel
                Margin="0,6,0,0"
                DockPanel.Dock="Bottom">
                <Button
                    Width="64"
                    Margin="0,0,4,4"
                    Click="AddCharacter_Click"
                    Content="新增" />
                <Button
                    Width="64"
                    Margin="0,0,4,4"
                    Click="DuplicateCharacter_Click"
                    Content="复制" />
                <Button
                    Width="64"
                    Margin="0,0,4,4"
                    Click="RemoveCharacter_Click"
                    Content="删除" />
                <Button
                    Width="86"
                    Margin="0,0,0,4"
                    Click="ImportFromWpf_Click"
                    Content="从 WPF 导入" />
            </WrapPanel>
            <ListBox
                x:Name="CharacterList"
                DisplayMemberPath="Listener"
                SelectionChanged="CharacterList_SelectionChanged" />
        </DockPanel>

        <GridSplitter
            Grid.Column="1"
            Width="6"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  日志根目录 + 开始/停止  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="日志根目录：" />
                <TextBox
                    x:Name="LogRootPath"
                    Grid.Column="1"
                    Margin="6,0"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="2"
                    Height="30"
                    Margin="0,0,6,0"
                    Padding="10,0"
                    Click="RestoreDefaultPath_Click"
                    Content="恢复默认"
                    ToolTip="恢复到游戏真实日志目录：WPF「设置 → 游戏日志」里的路径，未配置时为「我的文档\EVE\logs」" />
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal">
                    <Button
                        x:Name="StartButton"
                        Width="90"
                        Height="30"
                        Click="StartButton_Click"
                        Content="开始" />
                    <Button
                        x:Name="StopButton"
                        Width="90"
                        Height="30"
                        Click="StopButton_Click"
                        Content="停止"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                Margin="0,6,0,0"
                Foreground="#666"
                Text="未启动" />

            <TabControl
                x:Name="Tabs"
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalContentAlignment="Stretch">

                <!--  ============ 角色 ============  -->
                <TabItem x:Name="CharacterTab" Header="角色" HorizontalContentAlignment="Stretch">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="角色名称" />
                            <TextBox
                                x:Name="CharacterNameBox"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="角色 ID" />
                            <TextBox
                                x:Name="CharacterIdBox"
                                Grid.Column="3"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Text="军团 ticker" />
                            <TextBox
                                x:Name="CorporationBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="舰船（常用）" />
                            <ComboBox
                                x:Name="ShipCombo"
                                Grid.Row="1"
                                Grid.Column="3"
                                DisplayMemberPath="Name"
                                IsEditable="True"
                                SelectionChanged="ShipCombo_SelectionChanged" />

                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Text="舰船中文名" />
                            <TextBox
                                x:Name="ShipNameBox"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="英文 hint" />
                            <TextBox
                                x:Name="ShipHintBox"
                                Grid.Row="2"
                                Grid.Column="3"
                                VerticalAlignment="Center" />

                            <CheckBox
                                x:Name="SimuChatlogCheck"
                                Grid.Row="3"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center"
                                Content="模拟聊天频道" />
                            <CheckBox
                                x:Name="SimuGamelogCheck"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                VerticalAlignment="Center"
                                Content="模拟游戏日志" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.ColumnSpan="4"
                                Margin="0,10,0,0"
                                Foreground="#666"
                                Text="提示：角色 ID 用于日志文件名；军团/舰船用于战斗日志的 localized 行式。新增第二个角色可作为战斗对手。"
                                TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!--  ============ 频道日志 ============  -->
                <TabItem Header="频道日志" HorizontalContentAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <TextBlock FontWeight="Bold" Text="聊天频道" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Click="AddChannel_Click"
                                    Content="添加频道" />
                                <Button
                                    Width="80"
                                    Margin="6,0,0,0"
                                    Click="RemoveChannel_Click"
                                    Content="删除频道" />
                            </StackPanel>
                            <DataGrid
                                x:Name="ChannelGrid"
                                Height="110"
                                Margin="0,6,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="140"
                                        Binding="{Binding ChannelID, UpdateSourceTrigger=PropertyChanged}"
                                        Header="频道 ID" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                                        Header="频道名称" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="Bold"
                                Text="发言人（名称 / 常用舰船）" />
                            <DataGrid
                                x:Name="SpeakerGrid"
                                Height="110"
                                Margin="0,6,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        Header="名称" />
                                    <DataGridTextColumn
                                        Width="180"
                                        Binding="{Binding ShipName, UpdateSourceTrigger=PropertyChanged}"
                                        Header="常用舰船（中文名）" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <Button
                                    Width="90"
                                    Click="AddSpeaker_Click"
                                    Content="添加发言人" />
                                <Button
                                    Width="90"
                                    Margin="6,0,0,0"
                                    Click="RemoveSpeaker_Click"
                                    Content="删除发言人" />
                                <TextBlock
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#666"
                                    Text="自动模拟会随机带上一句舰船名，便于测试情报解析。" />
                            </StackPanel>

                            <GroupBox Margin="0,14,0,0" Header="自动模拟">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox
                                            x:Name="AutoSimuChatlog"
                                            VerticalAlignment="Center"
                                            Checked="AutoSimuChatlog_Checked"
                                            Content="自动生成聊天"
                                            Unchecked="AutoSimuChatlog_Unchecked" />
                                        <TextBlock
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="间隔（秒）" />
                                        <TextBox
                                            x:Name="AutoSimuChatlogSpan"
                                            Width="60"
                                            Margin="6,0,0,0"
                                            Text="5" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,8,0,2"
                                        Foreground="#666"
                                        Text="星域（可多选，随机取星系）" />
                                    <ListBox
                                        x:Name="RegionListBox"
                                        Height="90"
                                        DisplayMemberPath="Name"
                                        SelectionMode="Multiple" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Margin="0,14,0,0" Header="手动发言">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="频道" />
                                        <ComboBox
                                            x:Name="ChatChanels"
                                            Grid.Column="1"
                                            Margin="6,0,12,0"
                                            DisplayMemberPath="ChannelName" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="发言人" />
                                        <ComboBox
                                            x:Name="Speakers"
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            DisplayMemberPath="Name"
                                            IsEditable="True" />
                                    </Grid>
                                    <TextBox
                                        x:Name="SpeakContent"
                                        Height="80"
                                        Margin="0,8,0,0"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Button
                                            x:Name="ChatSpeakButton"
                                            Width="80"
                                            Click="Button_ChatSpeak_Click"
                                            Content="发言" />
                                        <Button
                                            x:Name="ChatOpenLogButton"
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Click="Button_ChatOpenLog_Click"
                                            Content="打开日志" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ============ 战斗日志 ============  -->
                <TabItem Header="战斗日志" HorizontalContentAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="对手角色" />
                                <ComboBox
                                    x:Name="ActorCombo"
                                    Grid.Column="1"
                                    DisplayMemberPath="Listener" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#666"
                                    Text="（在左侧新增/选中另一个角色，可改它的舰船）" />
                            </Grid>

                            <TextBlock
                                Margin="0,14,0,4"
                                FontWeight="Bold"
                                Text="事件类型" />
                            <WrapPanel>
                                <CheckBox
                                    x:Name="DamageCheck"
                                    Margin="0,2,18,2"
                                    Content="伤害" />
                                <CheckBox
                                    x:Name="MissCheck"
                                    Margin="0,2,18,2"
                                    Content="未命中" />
                                <CheckBox
                                    x:Name="NeutCheck"
                                    Margin="0,2,18,2"
                                    Content="毁电" />
                                <CheckBox
                                    x:Name="NosCheck"
                                    Margin="0,2,18,2"
                                    Content="吸电" />
                                <CheckBox
                                    x:Name="RepairCheck"
                                    Margin="0,2,18,2"
                                    Content="遥修" />
                                <CheckBox
                                    x:Name="ScramCheck"
                                    Margin="0,2,18,2"
                                    Content="反跳" />
                                <CheckBox
                                    x:Name="EcmCheck"
                                    Margin="0,2,18,2"
                                    Content="ECM" />
                                <CheckBox
                                    x:Name="OutgoingCheck"
                                    Margin="0,2,18,2"
                                    Content="同时生成出向（我打/我修别人）" />
                            </WrapPanel>

                            <TextBlock
                                Margin="0,14,0,4"
                                FontWeight="Bold"
                                Text="数值" />
                            <WrapPanel>
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="伤害最小" />
                                <TextBox
                                    x:Name="DamageMinBox"
                                    Width="60"
                                    Margin="0,0,18,0" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="伤害最大" />
                                <TextBox
                                    x:Name="DamageMaxBox"
                                    Width="60"
                                    Margin="0,0,18,0" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="毁电 GJ" />
                                <TextBox
                                    x:Name="NeutGjBox"
                                    Width="60"
                                    Margin="0,0,18,0" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="吸电 GJ" />
                                <TextBox
                                    x:Name="NosGjBox"
                                    Width="60"
                                    Margin="0,0,18,0" />
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Text="遥修 HP" />
                                <TextBox
                                    x:Name="RepairHpBox"
                                    Width="60" />
                            </WrapPanel>

                            <GroupBox
                                Margin="0,14,0,0"
                                Header="自动战斗（模拟持续交火）">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="AutoCombatCheck"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        Checked="AutoCombatCheck_Checked"
                                        Content="自动生成"
                                        Unchecked="AutoCombatCheck_Unchecked" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="间隔（秒）" />
                                    <TextBox
                                        x:Name="AutoCombatIntervalBox"
                                        Width="60"
                                        Margin="6,0,0,0"
                                        Text="1.5" />
                                </StackPanel>
                            </GroupBox>

                            <TextBlock
                                Margin="0,14,0,4"
                                FontWeight="Bold"
                                Text="手动发送" />
                            <WrapPanel>
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendDamage_Click"
                                    Content="伤害" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendMiss_Click"
                                    Content="未命中" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendNeut_Click"
                                    Content="毁电" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendNos_Click"
                                    Content="吸电" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendRepair_Click"
                                    Content="遥修" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendScram_Click"
                                    Content="反跳" />
                                <Button
                                    MinWidth="64"
                                    Margin="0,2,6,2"
                                    Click="SendEcm_Click"
                                    Content="ECM" />
                                <Button
                                    MinWidth="100"
                                    Margin="12,2,6,2"
                                    Click="OpenCombatLog_Click"
                                    Content="打开游戏日志" />
                            </WrapPanel>

                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="#666"
                                Text="按真实中文客户端行式生成：模块/舰船为 &lt;localized hint=&quot;英文&quot;&gt;中文*&lt;/localized&gt;，行首 (combat)。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ============ 原始日志 ============  -->
                <TabItem Header="原始日志" HorizontalContentAlignment="Stretch">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="手动写入一行游戏日志（原样写入，不自动加 (combat)）。" />
                        <TextBox
                            x:Name="GamelogContent"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            AcceptsReturn="True"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                            <Button
                                Width="80"
                                Click="Button_Gamelog_Click"
                                Content="写入" />
                            <Button
                                Width="100"
                                Margin="8,0,0,0"
                                Click="Button_GamelogOpenLog_Click"
                                Content="打开日志" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock
                x:Name="HintText"
                Grid.Row="3"
                Margin="0,6,0,0"
                Foreground="#888"
                Text="左侧选中角色 → 右侧配置 → 开始；开始后可在「频道日志 / 战斗日志」里持续发送。"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
