<Page
    x:Class="TheGuideToTheNewEden.WinUI.Views.Business.AppraisalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TheGuideToTheNewEden.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

	<controls:CardControl>
		<controls:CardControl.Header>
			<TextBlock Text="{StaticResource AppraisalPage_Appraisal}" />
		</controls:CardControl.Header>

		<controls:CardControl.CustomContent>
			<Grid ColumnSpacing="12">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="2*" />
				</Grid.ColumnDefinitions>

				<!-- LEFT: user input -->
				<Border
					Grid.Column="0"
					Padding="12"
					BorderThickness="1"
					CornerRadius="8">

					<Grid RowSpacing="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							FontSize="18"
							Text="{StaticResource AppraisalPage_Input}" />

						<TextBox
							x:Name="InputTextBox"
							Grid.Row="1"
							AcceptsReturn="True"
							TextWrapping="Wrap"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							PlaceholderText="{StaticResource AppraisalPage_PasteData}" />

						<Button
							Grid.Row="2"
							HorizontalAlignment="Right"
							Content="Estimate"
							Click="EstimateButton_Click" />

					</Grid>
				</Border>


				<!-- RIGHT: API result -->
				<Border
					Grid.Column="1"
					Padding="12"
					BorderThickness="1"
					CornerRadius="8">

					<Grid RowSpacing="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!-- Appraisal summary -->
						<Grid Grid.Row="0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="{StaticResource AppraisalPage_Market}" />
								<TextBlock
									FontSize="18"
									Text="{x:Bind Market, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Text="{StaticResource AppraisalPage_Volume}" />
								<TextBlock
									FontSize="18"
									Text="{x:Bind AppraisalVolume, Mode=OneWay}" />
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="{StaticResource AppraisalPage_Buy}" />
								<TextBlock
									FontSize="18"
									Text="{x:Bind TotalBuy, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Grid.Column="3">
								<TextBlock Text="{StaticResource AppraisalPage_Split}" />
								<TextBlock
									FontSize="18"
									Text="{x:Bind TotalSplit, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Grid.Column="4">
								<TextBlock Text="{StaticResource AppraisalPage_Sell}" />
								<TextBlock
									FontSize="18"
									Text="{x:Bind TotalSell, Mode=OneWay}" />
							</StackPanel>
						</Grid>

						<!-- Warning -->
						<InfoBar
							x:Name="WarningInfoBar"
							Grid.Row="1"
							IsOpen="False"
							Severity="Warning" />

						<!-- Column titles -->
						<Grid Grid.Row="1" Margin="0,16,0,5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="48" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="80" />
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="140" />
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="1"
								Text="{StaticResource AppraisalPage_Item}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="-19,0,0,0"/>

							<TextBlock
								Grid.Column="2"
								Text="{StaticResource AppraisalPage_Amount}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="-19,0,0,0"/>

							<TextBlock
								Grid.Column="3"
								Text="{StaticResource AppraisalPage_Volume}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="-19,0,0,0"/>

							<TextBlock
								Grid.Column="4"
								Text="{StaticResource AppraisalPage_Buy}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="19,0,0,0"/>

							<TextBlock
								Grid.Column="5"
								Text="{StaticResource AppraisalPage_Sell}"
								VerticalAlignment="Center"
								HorizontalAlignment="Left"
								Margin="-19,0,0,0"/>
						</Grid>
						<!-- Items -->
						<ListView
							x:Name="ResultList"
							Grid.Row="2"
							VerticalAlignment="Stretch"
							MinHeight="200" >

							<ListView.ItemTemplate>
								<DataTemplate>
									<Grid Padding="4">

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="48" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="140" />
											<ColumnDefinition Width="140" />
										</Grid.ColumnDefinitions>

										<Image
											Grid.Column="0"
											Width="40"
											Height="40"
											VerticalAlignment="Center"
											Source="{Binding ImageUrl}" />

										<TextBlock
											Grid.Column="1"
											VerticalAlignment="Center"
											Text="{Binding Name}" />

										<TextBlock
											Grid.Column="2"
											VerticalAlignment="Center"
											Text="{Binding AmountDisplay}" />

										<TextBlock
											Grid.Column="3"
											VerticalAlignment="Center"
											Text="{Binding VolumeDisplay}" />

										<TextBlock
											Grid.Column="4"
											VerticalAlignment="Center"
											Text="{Binding BuyPriceDisplay}" />

										<TextBlock
											Grid.Column="5"
											VerticalAlignment="Center"
											Text="{Binding SellPriceDisplay}" />

									</Grid>
								</DataTemplate>

							</ListView.ItemTemplate>

						</ListView>

					</Grid>
				</Border>

			</Grid>
		</controls:CardControl.CustomContent>
	</controls:CardControl>

</Page>