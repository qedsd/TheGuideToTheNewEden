<Page
    x:Class="TheGuideToTheNewEden.WinUI.Views.PlanetaryOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:viewmodels="using:TheGuideToTheNewEden.WinUI.ViewModels"
    Background="Transparent">
    <Page.DataContext>
        <viewmodels:PlanetaryOverviewViewModel x:Name="VM" />
    </Page.DataContext>
    <Grid Margin="12">
        <ScrollViewer>
            <StackPanel Spacing="8">
                <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemAccentColor}"
                                Text="{x:Bind VM.ColonyCount, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="殖民地" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{StaticResource DefaultGreen}"
                                Text="{x:Bind VM.ExtractorCount, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="采集器" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemAccentColor}"
                                Text="{x:Bind VM.FactoryCount, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="设施" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SystemAccentColor}"
                                Text="{x:Bind VM.AlertCount, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="警报" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="{x:Bind VM.CharacterCount, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="角色" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="{x:Bind VM.UpdateTime, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource SecondaryForegroundBrush}"
                                Text="同步" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="角色总览" />
                        <dataGrid:SfDataGrid
                            HorizontalAlignment="Stretch"
                            AllowDraggingColumns="True"
                            AllowEditing="False"
                            AllowFiltering="False"
                            AllowGrouping="False"
                            AllowResizingColumns="True"
                            AllowSorting="False"
                            AutoExpandGroups="True"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            ColumnWidthMode="Auto"
                            GridLinesVisibility="Horizontal"
                            GroupDropAreaText="{StaticResource General_GroupDropAreaText}"
                            HeaderLinesVisibility="Both"
                            IsGroupDropAreaExpanded="False"
                            ItemsSource="{x:Bind VM.CharacterRows, Mode=OneWay}"
                            SelectionMode="Single"
                            ShowGroupDropArea="False">
                            <dataGrid:SfDataGrid.Columns>
                                <dataGrid:GridTextColumn HeaderText="角色" MappingName="CharacterName" />
                                <dataGrid:GridTextColumn HeaderText="殖民/上限" MappingName="PlanetRatio" />
                                <dataGrid:GridTextColumn HeaderText="采集器" MappingName="ExtractorCount" />
                                <dataGrid:GridTextColumn HeaderText="设施" MappingName="FactoryCount" />
                                <dataGrid:GridTextColumn HeaderText="最近到期" MappingName="NearestExpiry" />
                                <dataGrid:GridTextColumn HeaderText="状态" MappingName="StatusText" />
                            </dataGrid:SfDataGrid.Columns>
                        </dataGrid:SfDataGrid>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefault}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="资源采集" />
                            <dataGrid:SfDataGrid
                                HorizontalAlignment="Stretch"
                                AllowDraggingColumns="True"
                                AllowEditing="False"
                                AllowFiltering="False"
                                AllowGrouping="False"
                                AllowResizingColumns="True"
                                AllowSorting="False"
                                AutoExpandGroups="True"
                                AutoGenerateColumns="False"
                                Background="Transparent"
                                BorderThickness="0"
                                ColumnWidthMode="Auto"
                                GridLinesVisibility="Horizontal"
                                GroupDropAreaText="{StaticResource General_GroupDropAreaText}"
                                HeaderLinesVisibility="Both"
                                IsGroupDropAreaExpanded="False"
                                ItemsSource="{x:Bind VM.ExtractionRows, Mode=OneWay}"
                                SelectionMode="Single"
                                ShowGroupDropArea="False">
                                <dataGrid:SfDataGrid.Columns>
                                    <dataGrid:GridTextColumn HeaderText="资源" MappingName="ResourceName" />
                                    <dataGrid:GridTextColumn HeaderText="等级" MappingName="Tier" />
                                    <dataGrid:GridTextColumn HeaderText="矿头" MappingName="HeadCount" />
                                    <dataGrid:GridTextColumn HeaderText="产量" MappingName="TotalQty" />
                                    <dataGrid:GridTextColumn HeaderText="活跃" MappingName="ActiveCount" />
                                    <dataGrid:GridTextColumn HeaderText="到期" MappingName="ExpiredCount" />
                                </dataGrid:SfDataGrid.Columns>
                            </dataGrid:SfDataGrid>
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefault}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="全球库存" />
                            <dataGrid:SfDataGrid
                                HorizontalAlignment="Stretch"
                                AllowDraggingColumns="True"
                                AllowEditing="False"
                                AllowFiltering="False"
                                AllowGrouping="False"
                                AllowResizingColumns="True"
                                AllowSorting="False"
                                AutoExpandGroups="True"
                                AutoGenerateColumns="False"
                                Background="Transparent"
                                BorderThickness="0"
                                ColumnWidthMode="Auto"
                                GridLinesVisibility="Horizontal"
                                GroupDropAreaText="{StaticResource General_GroupDropAreaText}"
                                HeaderLinesVisibility="Both"
                                IsGroupDropAreaExpanded="False"
                                ItemsSource="{x:Bind VM.InventoryRows, Mode=OneWay}"
                                SelectionMode="Single"
                                ShowGroupDropArea="False">
                                <dataGrid:SfDataGrid.Columns>
                                    <dataGrid:GridTextColumn HeaderText="物品" MappingName="ItemName" />
                                    <dataGrid:GridTextColumn HeaderText="等级" MappingName="Tier" />
                                    <dataGrid:GridTextColumn HeaderText="总量" MappingName="Quantity" />
                                </dataGrid:SfDataGrid.Columns>
                            </dataGrid:SfDataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="加工中" />
                        <dataGrid:SfDataGrid
                            HorizontalAlignment="Stretch"
                            AllowDraggingColumns="True"
                            AllowEditing="False"
                            AllowFiltering="False"
                            AllowGrouping="False"
                            AllowResizingColumns="True"
                            AllowSorting="False"
                            AutoExpandGroups="True"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            ColumnWidthMode="Auto"
                            GridLinesVisibility="Horizontal"
                            GroupDropAreaText="{StaticResource General_GroupDropAreaText}"
                            HeaderLinesVisibility="Both"
                            IsGroupDropAreaExpanded="False"
                            ItemsSource="{x:Bind VM.ProductionRows, Mode=OneWay}"
                            SelectionMode="Single"
                            SelectionChanged="OnProductionSelectionChanged"
                            ShowGroupDropArea="False">
                            <dataGrid:SfDataGrid.Columns>
                                <dataGrid:GridTextColumn HeaderText="配方" MappingName="SchematicName" />
                                <dataGrid:GridTextColumn HeaderText="产物" MappingName="ProductName" />
                                <dataGrid:GridTextColumn HeaderText="等级" MappingName="Tier" />
                                <dataGrid:GridTextColumn HeaderText="投入" MappingName="InputSummary" />
                                <dataGrid:GridTextColumn HeaderText="工厂数" MappingName="FactoryCount" />
                                <dataGrid:GridTextColumn HeaderText="产出/周期" MappingName="TotalOutputQty" />
                                <dataGrid:GridTextColumn HeaderText="周期(s)" MappingName="CycleTime" />
                            </dataGrid:SfDataGrid.Columns>
                        </dataGrid:SfDataGrid>
                        <!-- 加工明细 -->
                        <Border
                            x:Name="ProductionDetailPanel"
                            Visibility="{x:Bind VM.HasSelectedProduction, Mode=OneWay}"
                            Margin="0,8,0,0"
                            Padding="8,4"
                            Background="{ThemeResource CardBackgroundFillColorSecondary}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SecondaryForegroundBrush}"
                                    Text="{x:Bind VM.SelectedProductionRow.SchematicName, Mode=OneWay}" />
                                <dataGrid:SfDataGrid
                                    Height="120"
                                    AutoGenerateColumns="False"
                                    HeaderRowHeight="26"
                                    ItemsSource="{x:Bind VM.CurrentDetails, Mode=OneWay}"
                                    RowHeight="22">
                                    <dataGrid:SfDataGrid.Columns>
                                        <dataGrid:GridTextColumn HeaderText="角色" MappingName="CharacterName" />
                                        <dataGrid:GridTextColumn HeaderText="星球" MappingName="PlanetLabel" />
                                        <dataGrid:GridTextColumn HeaderText="开始" MappingName="CycleStart" />
                                        <dataGrid:GridTextColumn HeaderText="结束" MappingName="CycleEnd" />
                                        <dataGrid:GridTextColumn HeaderText="剩余" MappingName="Remaining" />
                                    </dataGrid:SfDataGrid.Columns>
                                </dataGrid:SfDataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="警报" />
                        <dataGrid:SfDataGrid
                            Height="120"
                            AllowSorting="True"
                            AutoGenerateColumns="False"
                            HeaderRowHeight="28"
                            ItemsSource="{x:Bind VM.AlertRows, Mode=OneWay}"
                            RowHeight="24">
                            <dataGrid:SfDataGrid.Columns>
                                <dataGrid:GridTextColumn HeaderText="角色" MappingName="CharacterName" />
                                <dataGrid:GridTextColumn HeaderText="星球" MappingName="PlanetName" />
                                <dataGrid:GridTextColumn HeaderText="信息" MappingName="Message" />
                                <dataGrid:GridTextColumn HeaderText="等级" MappingName="SeverityName" />
                            </dataGrid:SfDataGrid.Columns>
                        </dataGrid:SfDataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind VM.EmptyVisibility, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource SecondaryForegroundBrush}"
                Text="暂无行星开发数据" />
            <TextBlock
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource SecondaryForegroundBrush}"
                Text="请确保角色已授权 esi-planets.manage_planets.v1 作用域" />
        </StackPanel>
        <Grid Background="#CC000000" Visibility="{x:Bind VM.LoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource SecondaryForegroundBrush}"
                    Text="加载行星数据..." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
