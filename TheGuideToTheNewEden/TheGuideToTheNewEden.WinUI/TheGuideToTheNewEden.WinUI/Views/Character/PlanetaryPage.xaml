<Page
    x:Class="TheGuideToTheNewEden.WinUI.Views.Character.PlanetaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    Background="Transparent">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Margin="0,0,0,6"
            Padding="12,6"
            Background="{ThemeResource CardBackgroundFillColorDefault}">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                        Text="殖民地" />
                    <TextBlock
                        x:Name="StatColonies"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                        Text="提取器" />
                    <TextBlock
                        x:Name="StatExtractors"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource DefaultGreen}"
                        Text="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryForegroundBrush}"
                        Text="生产设施" />
                    <TextBlock
                        x:Name="StatFactories"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Text="0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <dataGrid:SfDataGrid
            x:Name="PlanetGrid"
            Grid.Row="1"
            AllowSorting="True"
            AutoGenerateColumns="False"
            HeaderRowHeight="30"
            RowHeight="34">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn
                    Width="120"
                    HeaderText="星球"
                    MappingName="PlanetName" />
                <dataGrid:GridTextColumn
                    Width="40"
                    HeaderText="类型"
                    MappingName="PlanetTypeEmoji" />
                <dataGrid:GridTextColumn
                    Width="110"
                    HeaderText="星系"
                    MappingName="SolarSystemName" />
                <dataGrid:GridTextColumn
                    Width="40"
                    HeaderText="CC"
                    MappingName="UpgradeLevel" />
                <dataGrid:GridTextColumn
                    Width="60"
                    HeaderText="采集器"
                    MappingName="NumExtractors" />
                <dataGrid:GridTextColumn
                    Width="60"
                    HeaderText="活跃/总数"
                    MappingName="NumActiveExtractors" />
                <dataGrid:GridTextColumn
                    Width="140"
                    HeaderText="生产"
                    MappingName="ProductionSummary" />
                <dataGrid:GridTextColumn
                    Width="60"
                    HeaderText="设施数"
                    MappingName="NumPins" />
                <dataGrid:GridTextColumn
                    Width="60"
                    HeaderText="运行"
                    MappingName="RuntimeDisplay" />
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>
    </Grid>
</Page>
